/* =========================================================
   COVER HEADER
========================================================= */

.uploaded-documents-cover {
    display: block;
}


.uploaded-documents-header {
    display: flex;

    align-items: center;

    border-bottom: 1px solid #222;

    padding-bottom: 7mm;

    margin-bottom: 7mm;
}


.uploaded-documents-logo {
    width: 30%;

    display: flex;

    align-items: center;
}


.uploaded-documents-logo img {
    width: 55px;

    height: auto;

    object-fit: contain;
}


.uploaded-documents-heading {
    width: 70%;

    text-align: center;
}


.uploaded-documents-title {
    font-size: 20px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .3px;
}


.uploaded-documents-code {
    font-size: 10px;

    margin-top: 4px;

    color: #555;
}


/* =========================================================
   EMPLOYEE INFORMATION
========================================================= */

.uploaded-employee-info {
    display: flex;

    justify-content: space-between;

    border: 1px solid #222;

    padding: 9px 12px;

    margin-bottom: 8mm;

    font-size: 10px;
}


.uploaded-employee-info span {
    margin-left: 5px;

    font-family: "Segoe Print",
                 "Comic Sans MS",
                 cursive;
}


/* =========================================================
   SUMMARY
========================================================= */

.uploaded-document-summary {
    border: 1px solid #222;
}


.uploaded-summary-title {
    background: #f1f1f1;

    border-bottom: 1px solid #222;

    padding: 8px 10px;

    font-size: 11px;

    font-weight: bold;

    text-transform: uppercase;
}


.uploaded-summary-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    padding: 8px 10px;
}


.uploaded-summary-item {
    display: flex;

    align-items: center;

    gap: 7px;

    min-height: 25px;

    font-size: 10px;
}


.uploaded-summary-check {
    width: 15px;

    height: 15px;

    border: 1px solid #222;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    font-size: 10px;

    font-weight: bold;
}


/* =========================================================
   EACH DOCUMENT
========================================================= */

.uploaded-document-container {
    width: 210mm;

    margin: 0 auto;

    background: #fff;

    page-break-after: always;

    box-sizing: border-box;
}


.uploaded-document-label {
    width: 210mm;

    box-sizing: border-box;

    padding: 5px 8px;

    border: 1px solid #222;

    border-bottom: none;

    background: #f3f3f3;

    font-size: 11px;

    font-weight: bold;

    text-transform: uppercase;
}


/* =========================================================
   PDF PAGE
========================================================= */

.uploaded-pdf-document {
    width: 210mm;

    box-sizing: border-box;

    background: #fff;
}


.uploaded-pdf-page {
    width: 100%;
    min-height: 0;
    height: auto;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    page-break-after: auto;
    break-after: auto;
}


.uploaded-pdf-canvas {
    display: block;

    width: 100%;
    height: auto;

    max-width: 100%;

    margin: 0;
    padding: 0;
}


/* =========================================================
   IMAGE DOCUMENT
========================================================= */

.uploaded-image-page {
    width: 100%;
    min-height: 0;
    height: auto;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5mm;
    page-break-after: auto;
    break-after: auto;
    overflow: hidden;
}

.uploaded-document-image {
    display: block;

    max-width: 200mm;

    max-height: 287mm;

    width: auto;

    height: auto;

    object-fit: contain;

    margin: 0 auto;
}


/* =========================================================
   LOADING / ERROR
========================================================= */

.pdf-loading {
    width: 210mm;

    min-height: 297mm;

    display: flex;

    justify-content: center;

    align-items: center;

    font-size: 11px;

    color: #555;

    background: #fff;
}


.pdf-error {
    width: 210mm;

    min-height: 50mm;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid #ccc;

    font-size: 11px;

    color: #b00020;
}


/* =========================================================
   SCREEN
========================================================= */

@@media screen {

    .uploaded-document-container {
        margin-top: 15px;

        margin-bottom: 15px;

        box-shadow: 0 0 8px rgba(0,0,0,.15);
    }

    .uploaded-document-label {
        margin: 0;
    }

}


/* =========================================================
   PRINT
========================================================= */

@@media print {

    .uploaded-documents-page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;
        padding: 15mm 15mm 12mm 15mm;
        box-shadow: none;
        break-after: page;
    }

    /* One page break per uploaded document */
    .uploaded-document-container {
        width: 210mm;
        margin: 0;
        box-shadow: none;

        break-after: page;
        page-break-after: always;
    }
    .uploaded-document-container.last-uploaded-document {
    page-break-after: auto !important;
    break-after: auto !important;
}
    .uploaded-document-label {
        width: 210mm;
    }

    /* Do NOT force another page break here */
    .uploaded-pdf-page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;

        break-after: auto;
        page-break-after: auto;
    }

    .uploaded-pdf-canvas {
        width: 210mm;
        max-width: 210mm;
    }

    /* Do NOT force another page break here */
    .uploaded-image-page {
        width: 210mm;
        min-height: 297mm;
        margin: 0;

        break-after: auto;
        page-break-after: auto;
    }
}
</style>


<!-- =============================================================
     JAVASCRIPT
============================================================= -->

<script>

    window.addEventListener("beforeprint", function () {

        document.title =
            "Employment Form - @Safe(employee.FullName)";

    });


    // =========================================================
    // PRINT
    // =========================================================

    function printEmploymentForm() {

        window.print();

    }

</script>

<script>

    pdfjsLib.GlobalWorkerOptions.workerSrc =
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";


    document.addEventListener("DOMContentLoaded", function () {

        const pdfDocuments =
            document.querySelectorAll(".uploaded-pdf-document");


        pdfDocuments.forEach(function (container) {

            const pdfUrl =
                container.getAttribute("data-pdf-url");


            if (!pdfUrl) {
                return;
            }


            pdfjsLib.getDocument(pdfUrl).promise
                .then(function (pdf) {

                    container.innerHTML = "";


                    const renderPromises = [];


                    for (
                        let pageNumber = 1;
                        pageNumber <= pdf.numPages;
                        pageNumber++
                    ) {

                        renderPromises.push(
                            renderPdfPage(
                                pdf,
                                pageNumber,
                                container
                            )
                        );

                    }


                    return Promise.all(renderPromises);

                })
                .catch(function (error) {

                    console.error(
                        "PDF loading error:",
                        error
                    );


                    container.innerHTML =
                        '<div class="pdf-error">' +
                        'Unable to load document.' +
                        '</div>';

                });

        });

    });


    function renderPdfPage(
        pdf,
        pageNumber,
        container
    ) {

        return pdf.getPage(pageNumber)
            .then(function (page) {

                /*
                 * PDF normally uses points.
                 * 1.5 gives enough resolution for
                 * browser display and printing.
                 */

                const viewport =
                    page.getViewport({
                        scale: 1.5
                    });


                const pageWrapper =
                    document.createElement("div");

                pageWrapper.className =
                    "uploaded-pdf-page";


                const canvas =
                    document.createElement("canvas");

                canvas.className =
                    "uploaded-pdf-canvas";


                const context =
                    canvas.getContext("2d");


                canvas.width =
                    viewport.width;

                canvas.height =
                    viewport.height;


                pageWrapper.appendChild(canvas);

                container.appendChild(pageWrapper);


                return page.render({

                    canvasContext: context,

                    viewport: viewport

                }).promise;

            });

    }

</script>
</body>

</html>