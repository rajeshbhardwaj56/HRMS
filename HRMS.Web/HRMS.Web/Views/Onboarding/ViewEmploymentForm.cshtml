    display: grid;

    grid-template-columns:
        1.7fr
        1.5fr
        1.4fr
        .9fr;

    gap: 8px;

    width: 100%;

    align-items: end;

    margin-bottom: 6px;

}


/* =============================================================
   FIELD GROUP
============================================================= */

.undertaking-field-group {

    min-width: 0;

    display: flex;

    align-items: flex-end;

    gap: 4px;

}


.undertaking-field-label {

    font-size: 8.5pt;

    font-weight: 600;

    white-space: nowrap;

}


/* =============================================================
   UNDERLINE FIELD
============================================================= */

.undertaking-signature-line {

    flex: 1;

    min-width: 25px;

    height: 20px;

    border-bottom: 1px solid #222;

    display: inline-flex;

    align-items: flex-end;

    padding: 0 3px 2px 3px;

    font-size: 8.5pt;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


/* =============================================================
   SIGNATURE BOX
============================================================= */

.undertaking-signature-box {

    flex: 1;

    height: 32px;

    min-width: 65px;

    border-bottom: 1px solid #222;

    display: flex;

    align-items: flex-end;

    justify-content: center;

    overflow: hidden;

}


.undertaking-execution-signature {

    max-width: 95px;

    max-height: 29px;

    width: auto;

    height: auto;

    object-fit: contain;

    display: block;

}


/* =============================================================
   WITNESS SECTION
============================================================= */

.undertaking-witness-section {

    margin-top: 9px;

}


.undertaking-witness-title {

    font-size: 8.8pt;

    font-weight: 700;

    margin-bottom: 4px;

}


.undertaking-witness-row {

    display: grid;

    grid-template-columns:
        1.3fr
        2.2fr
        1.2fr;

    gap: 10px;

    width: 100%;

    align-items: end;

}


.undertaking-witness-field {

    display: flex;

    align-items: flex-end;

    gap: 4px;

    min-width: 0;

}


.undertaking-witness-line {

    flex: 1;

    height: 20px;

    border-bottom: 1px solid #222;

    min-width: 30px;

}


/* =============================================================
   PRINT
============================================================= */

@@media print {

    .undertaking-execution {

        break-inside: avoid;

        page-break-inside: avoid;

    }


    .undertaking-signature-row {

        break-inside: avoid;

        page-break-inside: avoid;

    }


    .undertaking-witness-section {

        break-inside: avoid;

        page-break-inside: avoid;

    }

}
    </style>

</head>


<body>


<!-- =============================================================
     PRINT TOOLBAR
============================================================= -->

<div class="print-toolbar no-print">

    <button type="button"
            class="back-btn"
            onclick="history.back()">

        Back

    </button>

    <button type="button"
            class="print-btn"
            onclick="window.print()">

        Print Form

    </button>

</div>


<!-- =============================================================
     PAGE 1
     EMPLOYEE / FAMILY / EDUCATION
============================================================= -->

<div class="a4-page">


    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="document-header">

        <div class="header-left">

            <img src="~/assets/img/logo/PROTALKLOGO.png"
                 class="company-logo"
                 alt="Company Logo"
                 onerror="this.style.display='none';" />

        </div>


        <div class="header-center">

            <div class="header-center-title">
                Employment Form
            </div>

            <div class="header-center-subtitle">
                (PSPL/HRD/SOP/Frm)
            </div>

            <div class="tiny">
                Release No: 04 Date: 20-04-2026
            </div>

        </div>


        <div class="header-right">

            <strong>
                Employment Form
            </strong>

            <br />

            (PSPL/HRD/SOP/Frm)

            <br />

            Release No: 04 Date: 20-04-2026

        </div>

    </div>


    <!-- =========================================================
         TITLE
    ========================================================== -->

    <div class="form-title">

        Employment Form

    </div>


    <!-- =========================================================
         DESIGNATION / EMPLOYEE CODE / DATE
    ========================================================== -->

    <div class="top-info">


        <div class="top-field">

            <span class="top-label">
                Designation:
            </span>

            <div class="top-value handwritten">

                @Safe(employee.Designation)

            </div>

        </div>


        <div class="top-field">

            <span class="top-label">
                Employee Code:
            </span>

            <div class="top-value handwritten">

                @Safe(employee.EmployeeCode)

            </div>

        </div>


        <div class="top-field">

            <span class="top-label">
                Date:
            </span>

            <div class="top-value handwritten">

                @FormatDate(employee.DateOfJoining)

            </div>

        </div>


    </div>


    <!-- =========================================================
         EMPLOYEE DETAILS + PHOTO
    ========================================================== -->

    <div class="employee-main">


        <div class="employee-details">


            <div class="field-row">

                <span class="field-label mandatory">
                    Employee Name:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.FullName)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Father's/Husband's Name:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.FatherHusbandName)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Date of Birth:
                </span>

                <div class="field-value handwritten"
                     style="max-width:115px;">

                    @FormatDate(employee.DateOfBirth)

                </div>


                <span class="field-label"
                      style="margin-left:10px;">

                    Gender:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.Gender)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Marital Status:
                </span>

                <div class="field-value handwritten"
                     style="max-width:125px;">

                    @Safe(employee.MaritalStatus)

                </div>


                <span class="field-label"
                      style="margin-left:10px;">

                    Blood Group:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.BloodGroup)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label mandatory">
                    Personal Email:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.Email)

                </div>

            </div>


        </div>


        <!-- EMPLOYEE PHOTO -->

        <div>

            <div class="photo-container">

                @if (!string.IsNullOrWhiteSpace(employee.EmployeePhoto))
                {
                    <img src="@employee.EmployeePhoto"
                         alt="Employee Photo"
                         onerror="this.style.display='none';" />
                }
                else
                {
                    <div class="photo-placeholder">

                        Employee
                        <br />
                        Photograph

                    </div>
                }

            </div>

        </div>


    </div>


    <!-- =========================================================
         PERMANENT ADDRESS
    ========================================================== -->

    <div class="section-title mandatory">

        Permanent Address:

    </div>


    <div class="address-line handwritten">

        @Safe(employee.PermanentAddress)

    </div>


    <div class="address-meta">


        <div class="field-row">

            <span class="field-label">
                City
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentCity)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                State
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentState)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                PIN Code
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentPINCode)

            </div>

        </div>


    </div>


    <!-- =========================================================
         CONTACT
    ========================================================== -->

    <div class="contact-grid">


        <div class="field-row">

            <span class="field-label">
                Mobile No.:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.Mobile)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Personal Email:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.Email)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Land Line No.:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.LandlineNo)

            </div>

        </div>


    </div>


    <!-- =========================================================
         PRESENT ADDRESS
    ========================================================== -->

    <div class="section-title">

        *Present Address:

    </div>


    <div class="address-line handwritten">

        @Safe(employee.PresentAddress)

    </div>


    <div class="address-meta">


        <div class="field-row">

            <span class="field-label">
                City
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PresentCity)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                State
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PresentState)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                PIN Code
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PresentPINCode)

            </div>

        </div>


    </div>


    <!-- =========================================================
         EMERGENCY CONTACT
    ========================================================== -->

    <div class="section-title">

        *Emergency Contact Details
        (Name of Person, Address and Phone/Mobile Number):

    </div>


    <div class="emergency-grid">


        <div class="field-row">

            <span class="field-label">
                Name:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.EmergencyContactName)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Phone/Mobile No.:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.EmergencyContactMobile)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Relation:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.EmergencyContactRelation)

            </div>

        </div>


    </div>


    <div class="field-row">

        <span class="field-label">
            Address:
        </span>

        <div class="field-value handwritten">

            @Safe(employee.EmergencyContactAddress)

        </div>

    </div>


    <!-- =========================================================
         FAMILY DETAILS
    ========================================================== -->

    <div class="section-title">

        Family Details:

    </div>


    <table class="form-table family-table">

        <thead>

            <tr>

                <th>
                    Relation
                </th>

                <th>
                    Name
                </th>

                <th>
                    Gender/Age
                </th>

                <th>
                    Date of Birth
                </th>

                <th>
                    Occupation
                </th>

                <th>
                    Dependent
                    <br />
                    (Yes/No)
                </th>

            </tr>

        </thead>


        <tbody>

            @if (familyList.Any())
            {

                foreach (var family in familyList)
                {

                    <tr>

                        <td class="handwritten">
                            @Safe(family.Relation)
                        </td>

                        <td class="handwritten">
                            @Safe(family.Name)
                        </td>

                        <td class="handwritten text-center">

                            @Safe(family.Gender)

                            @if (!string.IsNullOrWhiteSpace(family.Age))
                            {
                                <text>
                                    / @family.Age
                                </text>
                            }

                        </td>

                        <td class="handwritten text-center">

                            @FormatDate(family.DateOfBirth)

                        </td>

                        <td class="handwritten">

                            @Safe(family.Occupation)

                        </td>

                        <td class="handwritten text-center">

                            @YesNo(family.IsDependent)

                        </td>

                    </tr>

                }

            }
            else
            {

                for (int i = 0; i < 5; i++)
                {

                    <tr>

                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>

                }

            }

        </tbody>

    </table>


    <!-- =========================================================
         EDUCATION
    ========================================================== -->

    <div class="section-title">

        *Education Details (Matriculation onwards)

    </div>


    <table class="form-table education-table">

        <thead>

            <tr>

                <th>
                    Stream
                </th>

                <th>
                    Year of
                    <br />
                    Passing
                </th>

                <th>
                    Name of School/
                    <br />
                    Institution/College
                </th>

                <th>
                    Board/
                    <br />
                    University
                </th>

                <th>
                    % Marks
                    <br />
                    Obtained
                </th>

                <th>
                    Major Subjects
                </th>

            </tr>

        </thead>


        <tbody>

            @if (educationList.Any())
            {

                foreach (var education in educationList.OrderBy(x => x.RowNo))
                {

                    <tr>

                        <td class="handwritten">
                            @Safe(education.Stream)
                        </td>

                        <td class="handwritten text-center">
                            @(education.PassingYear?.ToString() ?? "")
                        </td>

                        <td class="handwritten">
                            @Safe(education.InstitutionName)
                        </td>

                        <td class="handwritten">
                            @Safe(education.BoardUniversity)
                        </td>

                        <td class="handwritten text-center">
                            @Safe(education.MarksObtained)
                        </td>

                        <td class="handwritten">
                            @Safe(education.MajorSubjects)
                        </td>

                    </tr>

                }

            }
            else
            {

                <tr>

                    <td>10th</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>

                <tr>

                    <td>12th</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>

                <tr>

                    <td>Graduation</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>

                <tr>

                    <td>Others</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>

            }

        </tbody>

    </table>


    <div class="page-footer">

        Employment Form - Page 1

    </div>


</div>


<!-- =============================================================
     PAGE 2
     OTHER PERSONAL INFORMATION
============================================================= -->

<div class="a4-page">


    <div class="document-header">

        <div class="header-left">

            <img src="~/assets/img/logo/PROTALKLOGO.png"
                 class="company-logo"
                 alt="Company Logo"
                 onerror="this.style.display='none';" />

        </div>


        <div class="header-center">

            <div class="header-center-title">
                Employment Form
            </div>

            <div class="header-center-subtitle">
                Personal & Other Information
            </div>

        </div>


        <div class="header-right">

            Employee Code:

            <strong>
                @Safe(employee.EmployeeCode)
            </strong>

            <br />

            Employee:

            <strong>
                @Safe(employee.FullName)
            </strong>

        </div>

    </div>
     <!-- =========================================================
         PREVIOUS EMPLOYMENT
    ========================================================== -->

    <div class="section-title">

        Previous Employment Details

    </div>


    <table class="form-table employment-table">

        <thead>

            <tr>

                <th>
                    From
                </th>

                <th>
                    To
                </th>

                <th>
                    Employer /Address
                </th>


                <th>
                    Designation /
                    Job Title
                </th>

                <th>
                    Annual CTC
                </th>

                <th>
                    Reason
                </th>

            </tr>

        </thead>


        <tbody>

            @if (employmentList.Any())
            {

                foreach (var employment in employmentList)
                {

                    <tr>

                        <td class="handwritten text-center">

                            @FormatDate(employment.FromDate)

                        </td>

                        <td class="handwritten text-center">

                            @FormatDate(employment.ToDate)

                        </td>

                        <td class="handwritten">

                            @Safe(employment.EmployerName) / @Safe(employment.EmployerAddress)

                        </td>



                        <td class="handwritten">

                            @(string.IsNullOrWhiteSpace(employment.Designation)
                                ? Safe(employment.JobTitle)
                                : Safe(employment.Designation))

                        </td>

                        <td class="handwritten text-center">

                            @(employment.AnnualCTC.HasValue
                                ? employment.AnnualCTC.Value.ToString("0.00")
                                : "")

                        </td>

                        <td class="handwritten">

                            @Safe(employment.ReasonOfLiving)

                        </td>

                    </tr>

                }

            }
            else
            {

                <tr>

                    <td colspan="7"
                        class="text-center">

                        No previous employment details available.

                    </td>

                </tr>

            }

        </tbody>

    </table>


    <!-- SOURCE OF HIRING -->

   <div class="section-title">
    Source of Hiring
</div>

<div class="field-row source-hiring-box">

    <span class="field-label">
        Source of Hiring:
    </span>

    <div class="field-value">
        <div class="hiring-options">

            <label>
                <span class="checkbox">
                    @(employee.SourceOfHiring == "Placement Consultant" ? "✓" : "")
                </span>
                Placement Consultant
            </label>

            <label>
                <span class="checkbox">
                    @(employee.SourceOfHiring == "Employee Reference" ? "✓" : "")
                </span>
                Employee Reference
            </label>

            <label>
                <span class="checkbox">
                    @(employee.SourceOfHiring == "Office Walk-in" ? "✓" : "")
                </span>
                Office Walk-in
            </label>

            <label>
                <span class="checkbox">
                    @(employee.SourceOfHiring == "Employment Exchange" ? "✓" : "")
                </span>
                Employment Exchange
            </label>

        </div>
    </div>

</div>
<style>
.source-hiring-box {
    border: 1px solid #555;
    padding: 8px 10px;
    margin-top: 5px;
    min-height: 35px;
    box-sizing: border-box;
}

.hiring-options {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 12px;
}

.hiring-options label {
    display: flex;
    align-items: center;
    white-space: nowrap;
}

.checkbox {
    width: 18px;
    height: 18px;
    border: 1px solid #555;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 5px;
    font-size: 16px;
    line-height: 1;
    font-weight: bold;
    box-sizing: border-box;
}
/* =========================================================
   REFERENCE SECTION
========================================================= */

.reference-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #555;
    margin-bottom: 12px;
    table-layout: fixed;
    font-size: 11px;
}

.reference-table td {
    border: 1px solid #555;
    padding: 2px 5px;
    height: 21px;
    vertical-align: middle;
    box-sizing: border-box;
}

/* First column - Reference number */
.ref-number {
    width: 5%;
    text-align: center;
    vertical-align: middle !important;
    font-weight: normal;
}

/* Second column - Labels */
.ref-label {
    width: 32%;
    font-weight: 600;
    padding-left: 5px !important;
}

/* Third column - Values */
.ref-value {
    width: 63%;
    padding-left: 10px !important;
    font-weight: normal;
}

/* Handwritten value */
.reference-table .handwritten {
    min-height: 20px;
}


/* =========================================================
   OTHER INFORMATION
========================================================= */

.other-info-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #555;
    margin-bottom: 14px;
    table-layout: fixed;
    font-size: 11px;
}

.other-info-table td {
    border: 1px solid #555;
    height: 22px;
    padding: 2px 5px;
    box-sizing: border-box;
}

.other-label {
    width: 28%;
    font-weight: 600;
}

.other-value {
    width: 72%;
    padding-left: 10px !important;
}


/* =========================================================
   DECLARATION
========================================================= */

.declaration-title {
    margin-top: 8px;
}

.declaration-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #555;
    table-layout: fixed;
    font-size: 11px;
}

.declaration-table td {
    border: 1px solid #555;
    height: 25px;
    padding: 2px 5px;
    box-sizing: border-box;
}

.question-cell {
    width: 55%;
    font-weight: 600;
}

.yes-no-cell {
    width: 22.5%;
    text-align: center;
    position: relative;
}

.yes-no-text {
    margin-right: 10px;
}

.declaration-checkbox {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: bold;
    vertical-align: middle;
}


/* =========================================================
   DETAILS / UNDERLINE FIELDS
========================================================= */

.details-label {
    font-size: 11px;
    font-weight: 600;
    margin-top: 10px;
    margin-bottom: 6px;
}

.inline-fields {
    display: flex;
    width: 100%;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 11px;
}

.inline-field {
    display: flex;
    align-items: baseline;
    flex: 1;
    white-space: nowrap;
}

.line-value {
    display: inline-block;
    min-width: 80px;
    flex: 1;
    border-bottom: 1px solid #555;
    min-height: 15px;
    margin-left: 4px;
    padding-left: 3px;
}

.work-details {
    margin-bottom: 5px;
}

.worked-table {
    margin-top: 4px;
}


</style>
<!-- =========================================================
     REFERENCES
========================================================== -->

<div class="section-title">
    *REFERENCE
</div>

<table class="reference-table">

    <tbody>

        <!-- ================= REFERENCE 1 ================= -->

        <tr>

            <td class="ref-number" rowspan="3">
                1
            </td>

            <td class="ref-label">
                Name &amp; Designation
            </td>

            <td class="ref-value handwritten">

                @Safe(employee.Reference1Name)

                @if (!string.IsNullOrWhiteSpace(employee.Reference1Designation))
                {
                    <span>
                        &nbsp;&nbsp;@Safe(employee.Reference1Designation)
                    </span>
                }

            </td>

        </tr>


        <tr>

            <td class="ref-label">
                Company
            </td>

            <td class="ref-value handwritten">
                @Safe(employee.Reference1Company)
            </td>

        </tr>


        <tr>

            <td class="ref-label">
                Phone/Mobile No &amp; Email Id
            </td>

            <td class="ref-value handwritten">

                @Safe(employee.Reference1Mobile)

                @if (!string.IsNullOrWhiteSpace(employee.Reference1Email))
                {
                    <span>
                        &nbsp;&nbsp;@Safe(employee.Reference1Email)
                    </span>
                }

            </td>

        </tr>


        <!-- ================= REFERENCE 2 ================= -->

        <tr>

            <td class="ref-number" rowspan="3">
                2
            </td>

            <td class="ref-label">
                Name &amp; Designation
            </td>

            <td class="ref-value handwritten">

                @Safe(employee.Reference2Name)

                @if (!string.IsNullOrWhiteSpace(employee.Reference2Designation))
                {
                    <span>
                        &nbsp;&nbsp;@Safe(employee.Reference2Designation)
                    </span>
                }

            </td>

        </tr>


        <tr>

            <td class="ref-label">
                Company
            </td>

            <td class="ref-value handwritten">
                @Safe(employee.Reference2Company)
            </td>

