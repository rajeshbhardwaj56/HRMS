========================================================= -->

<div class="declaration">

    <div class="declaration-box">

        <div class="declaration-text">

            I hereby certify that the information provided by me is true to the
            best of my knowledge and belief. Any changes in the particulars
            provided above will be intimated to HR immediately. If any other
            information provided above is found to be false, at any future date,
            the company will have the right to initiate appropriate action.
            It is further declared that there is no police case registered or
            pending against me in any police station and nor are any
            criminal/legal proceedings going on against me in any court.

        </div>


        <!-- Signature / Date / Place -->

        <table class="declaration-table">

            <tr>

                <!-- Employee Name -->
                <td style="width:40%;">

                    <strong>
                        Name of the Employee:
                    </strong>

                    <div class="handwritten"
                         style="margin-top:8px;">

                        @Safe(employee.FullName)

                    </div>

                </td>


                <!-- Signature -->
         <td style="width:30%;">

    <strong>
        Signature:
    </strong>

    <div class="signature-area">

        @if (!string.IsNullOrWhiteSpace(employee.EmployeeSignature))
        {
            <img src="@employee.EmployeeSignature"
                 alt="Employee Signature"
                 style="max-width:220px;
                        max-height:100px;
                        object-fit:contain;" />
        }
        else if (signatureDocument != null &&
                 !string.IsNullOrWhiteSpace(signatureDocument.FilePath))
        {
            var signatureExt = System.IO.Path
                .GetExtension(signatureDocument.FilePath)
                ?.ToLowerInvariant();

            @if (signatureExt == ".jpg" ||
                 signatureExt == ".jpeg" ||
                 signatureExt == ".png")
            {
                <img src="@Url.Content(signatureDocument.FilePath)"
                     alt="Previous Employee Signature"
                     style="max-width:220px;
                            max-height:64px;
                            object-fit:contain;" />
            }
            else
            {
                <div class="signature-line"></div>
            }
        }
        else
        {
            <div class="signature-line"></div>
        }

    </div>

</td>



                <!-- Date -->
                <td style="width:30%;">

                    <strong>
                        Date:
                    </strong>

                    <div class="handwritten"
                         style="margin-top:8px;">

                        @FormatDate(employee.DeclarationDate)

                    </div>

                </td>

            </tr>


            <tr>

                <td></td>

                <td></td>

                <td>

                    <strong>
                        Place:
                    </strong>

                    <div class="handwritten"
                         style="margin-top:8px;">

                        @Safe(employee.DeclarationPlace)

                    </div>

                </td>

            </tr>

        </table>

    </div>

