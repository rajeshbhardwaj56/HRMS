/* ============================================================
   EMPLOYER CERTIFICATE
============================================================ */

.employer-certificate {
    font-size: 7.1pt;

    line-height: 1.3;

    margin-top: 1mm;
}

.certificate-line {
    min-width: 55mm;
}


/* ============================================================
   EMPLOYER SIGNATURE
============================================================ */

.employer-signature-row {
    display: grid;

    grid-template-columns: 1fr 1.25fr;

    column-gap: 10mm;

    margin-top: 2mm;

    align-items: end;
}

.employer-place-date > div {
    margin-bottom: 3mm;
}

.employer-signature {
    text-align: left;

    font-size: 6.8pt;
}

.employer-signature-space {
    height: 9mm;

    display: flex;

    align-items: flex-end;

    justify-content: flex-start;
}

.employer-designation {
    margin-top: 2mm;
    margin-bottom: 1mm;
}


/* ============================================================
   ACKNOWLEDGEMENT
============================================================ */

.acknowledgement-title {
    border-top: 0.25mm dashed #555;

    padding-top: 1.5mm;

    margin-top: 3mm;
}

.acknowledgement-text {
    font-size: 7.1pt;

    margin-top: 1mm;
}

.acknowledgement-row {
    display: grid;

    grid-template-columns: 1fr 1.25fr;

    column-gap: 10mm;

    margin-top: 2mm;

    align-items: end;
}

.acknowledgement-signature {
    text-align: center;

    font-size: 6.8pt;
}


/* ============================================================
   FOOTER
============================================================ */

.form-f-footer {
    position: absolute;

    left: 13mm;
    right: 13mm;

    bottom: 4mm;

    border-top: 0.2mm solid #777;

    padding-top: 1mm;

    display: flex;

    justify-content: space-between;

    font-size: 6.5pt;
}


/* ============================================================
   PRINT
============================================================ */

@@media print {

    .form-f-page {
        width: 210mm;
        height: 297mm;
        min-height: 297mm;

        margin: 0;

        padding: 10mm 13mm 8mm 13mm;

        page-break-after: always;

        overflow: hidden;

        box-shadow: none;
    }

    .form-f-table,
    .form-f-statement-table,
    .witness-table,
    .employer-signature-row,
    .acknowledgement-row {
        page-break-inside: avoid;
    }

    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
    }
}


/* ============================================================
   SCREEN PREVIEW
============================================================ */

@@media screen {

    .form-f-page {
        margin: 15px auto;

        box-shadow: 0 0 8px rgba(0, 0, 0, .18);
    }
}
</style>


<!-- =========================================================
     CRIMINAL / CIVIL PROCEEDINGS
========================================================= -->

<table class="form-section">

