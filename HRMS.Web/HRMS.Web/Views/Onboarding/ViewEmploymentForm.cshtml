    {
        return checklistDocuments.Any(x =>
            !string.IsNullOrWhiteSpace(x.DocumentType)
            &&
            x.DocumentType.Equals(
                documentType,
                StringComparison.OrdinalIgnoreCase)
            &&
            !string.IsNullOrWhiteSpace(
                GetDocumentFilePath(x)
            )
        );
    }


    // ============================================================
    // UPLOADED DOCUMENT STATUS
    // ============================================================

    var hasResume =
        HasDocument("Resume");

    var hasOfferLetter =
        HasDocument("OfferLetter");

    var hasExperienceCertificate =
        HasDocument("ExperienceCertificate");

    var hasSalarySlip =
        HasDocument("SalarySlip");

    var hasEducationCertificate =
        HasDocument("EducationCertificate");

    var hasAadhaar =
        HasDocument("Aadhaar");

    var hasPAN =
        HasDocument("PAN");

    var hasPassport =
        HasDocument("Passport");

    var hasBankDocument =
        HasDocument("BankDocument");


    // ============================================================
    // CHECKLIST LOGIC
    // ============================================================

    // 1 to 7 are checked by default
    var item1Checked = true;
    var item2Checked = true;
    var item3Checked = true;
    var item4Checked = true;
    var item5Checked = true;
    var item6Checked = true;
    var item7Checked = true;

    // Identity Proof
    var item8Checked =
        hasAadhaar
        || hasPAN
        || hasPassport;

    // Address Proof
    var item9Checked =
        hasAadhaar
        || hasPassport;

    // Date of Birth Proof
var item10Checked =
    hasAadhaar
    || hasPAN
    || hasPassport;

    // Educational Proof
    var item11Checked =
        hasEducationCertificate;

    // Experience Certificate
    var item12Checked =
        hasExperienceCertificate;

    // Salary / Bank Statement
    var item13Checked =
        hasSalarySlip
        || hasBankDocument;

    // 14 is checked by default
    var item14Checked = true;

    // Letter of Intent
    // OfferLetter is used because this is the uploaded
    // document type available in the onboarding documents.
    var item15Checked =
        hasOfferLetter;

    // Resume / CV
    var item16Checked =
        hasResume;
}


