========================================================== -->
@{
    var selectedDocumentTypes = new[]
    {
        "Resume",
        "OfferLetter",
        "ExperienceCertificate",
        "SalarySlip",
        "EducationCertificate",
        "Aadhaar",
        "PAN",
        "Passport",
        "BankDocument"
    };

    var selectedDocuments = Model?.DocumnetList?
        .Where(x =>
            !string.IsNullOrWhiteSpace(x.DocumentType) &&
            selectedDocumentTypes.Contains(
                x.DocumentType,
                StringComparer.OrdinalIgnoreCase))
        .ToList()
        ?? new List<EmployeeOnboardingDocumentsModel>();
}


@if (selectedDocuments.Any())
{
    <!-- =====================================================
         UPLOADED DOCUMENTS COVER
    ====================================================== -->

  


      

    <!-- =====================================================
         ACTUAL UPLOADED DOCUMENTS
    ====================================================== -->

@for (int documentIndex = 0; documentIndex < selectedDocuments.Count; documentIndex++)
{
    var document = selectedDocuments[documentIndex];
    var isLastDocument = documentIndex == selectedDocuments.Count - 1;
        var documentPath =
            GetDocumentFilePath(document);

        var documentType =
            document.DocumentType ?? "";

        var displayName = documentType;

        if (documentType.Equals(
            "Resume",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Resume / CV";
        }
        else if (documentType.Equals(
            "OfferLetter",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Offer Letter";
        }
        else if (documentType.Equals(
            "ExperienceCertificate",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Experience Certificate";
        }
        else if (documentType.Equals(
            "SalarySlip",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Salary Slip";
        }
        else if (documentType.Equals(
            "EducationCertificate",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Education Certificate";
        }
        else if (documentType.Equals(
            "Aadhaar",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Aadhaar Card";
        }
        else if (documentType.Equals(
            "PAN",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "PAN Card";
        }
        else if (documentType.Equals(
            "Passport",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Passport";
        }
        else if (documentType.Equals(
            "BankDocument",
            StringComparison.OrdinalIgnoreCase))
        {
            displayName = "Bank Details";
        }


        if (!string.IsNullOrWhiteSpace(documentPath))
        {
            var isPdf =
                documentPath.EndsWith(
                    ".pdf",
                    StringComparison.OrdinalIgnoreCase);

            var isImage =
                documentPath.EndsWith(
                    ".jpg",
                    StringComparison.OrdinalIgnoreCase)
                ||
                documentPath.EndsWith(
                    ".jpeg",
                    StringComparison.OrdinalIgnoreCase)
                ||
                documentPath.EndsWith(
                    ".png",
                    StringComparison.OrdinalIgnoreCase);


            <!-- =================================================
                 PDF
            ================================================== -->

            if (isPdf)
            {
<div class="uploaded-document-container @(isLastDocument ? "last-uploaded-document" : "")">
    <div class="uploaded-document-label">
        @displayName
    </div>

    <div class="uploaded-pdf-document"
                         data-pdf-url="@documentPath"
                         data-document-name="@displayName">

                        <div class="pdf-loading">
                            Loading @displayName...
                        </div>

                    </div>

                </div>
            }


            <!-- =================================================
                 IMAGE
            ================================================== -->

            if (isImage)
            {
<div class="uploaded-document-container @(isLastDocument ? "last-uploaded-document" : "")">
    <div class="uploaded-document-label">
        @displayName
    </div>

    <div class="uploaded-image-page">

                        <img src="@documentPath"
                             class="uploaded-document-image"
                             alt="@displayName"
                             onerror="this.style.display='none';" />

                    </div>

                </div>
            }
        }
    }
