    <tbody>

      @{
    var formFNominees = gratuityNominees
        .Where(x => x != null)
        .Take(5)
        .ToList();

    var rowCount = formFNominees.Count > 0
        ? 5
        : 1;
}

@for (int i = 0; i < 1; i++)
{
    var nominee = i < epfNominees.Count
        ? epfNominees[i]
        : null;

    <tr>
        <td>
            @(i + 1)
        </td>

        <td>
            @if (nominee != null)
            {
                 <span class="handwritten bgv-inline-value">
                    @Safe(nominee.NomineeName)
                </span>
            }
            else
            {
                <span class="form-f-entry"></span>
            }
        </td>

        <td>
            @if (nominee != null)
            {
                 <span class="handwritten bgv-inline-value">
                    @Safe(nominee.Relationship)
                </span>
            }
            else
            {
                <span class="form-f-entry"></span>
            }
        </td>

        <td>
@if (nominee != null)
{
    var nomineeAge = nominee.Age;

    // If Age is not available, calculate it from DateOfBirth
    if (!nomineeAge.HasValue)
    {
        var dob = nominee.DateOfBirth;

        if (dob.HasValue)
        {
            var today = DateTime.Today;

            nomineeAge = today.Year - dob.Value.Year;

            if (dob.Value.Date > today.AddYears(-nomineeAge.Value))
            {
                nomineeAge--;
            }
        }
    }

    <span class="handwritten bgv-inline-value">
        @(nomineeAge?.ToString() ?? "")
    </span>
}
else
{
    <span class="form-f-entry"></span>
}
        </td>

        <td>
            @if (nominee != null)
            {
                var sharePercentage =
                    nominee.SharePercentage ?? nominee.Percentage;

                 <span class="handwritten bgv-inline-value">
                    @(sharePercentage.HasValue
                        ? sharePercentage.Value.ToString("0.##") + "%"
                        : "")
                </span>
            }
            else
            {
                <span class="form-f-entry"></span>
