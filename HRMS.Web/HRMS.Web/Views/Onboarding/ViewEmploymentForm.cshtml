<!-- =============================================================
     PAGE 6
     UPLOADED DOCUMENTS
============================================================= -->

@if (documentList.Any())
{

    <div class="a4-page">


        <div class="document-header">

            <div class="header-left">

                <img src="~/assets/img/logo/PROTALKLOGO.png"
                     class="company-logo"
                     alt="Company Logo"
                     onerror="this.style.display='none';" />

            </div>


            <div class="header-center">

                <div class="header-center-title">

                    Employment Form

                </div>

                <div class="header-center-subtitle">

                    Documents & Attachments

                </div>

            </div>


            <div class="header-right">

                Employee Code:

                <strong>

                    @Safe(employee.EmployeeCode)

                </strong>

                <br />

                Employee:

                <strong>

                    @Safe(employee.FullName)

                </strong>

            </div>

        </div>


        <!-- =====================================================
             DOCUMENTS
        ====================================================== -->

        <div class="section-title">

            Uploaded Documents

        </div>


        <table class="form-table document-table">

            <thead>

                <tr>

                    <th>
                        #
                    </th>

                    <th>
                        Document Name
                    </th>

                    <th>
                        Document Type
                    </th>

                    <th>
                        File Name
                    </th>

                    <th>
                        Uploaded Date
                    </th>

                    <th>
                        Status
                    </th>

                </tr>

            </thead>


            <tbody>

                @{
                    int documentIndex = 1;
                }


                @foreach (var document in documentList)
                {

                    var documentName =
                        GetDocumentValue(
                            document,
                            "DocumentName",
                            "Name",
                            "DocumentTitle",
                            "Title"
                        );

                    var documentType =
                        GetDocumentValue(
                            document,
                            "DocumentType",
                            "Type",
                            "DocumentCategory",
                            "Category"
                        );

                    var fileName =
                        GetDocumentValue(
                            document,
                            "FileName",
                            "OriginalFileName",
                            "UploadedFileName"
                        );

                    var filePath =
                        GetDocumentFilePath(document);

                    var uploadedDate =
                        GetDocumentDate(document);

                    var documentStatus =
                        GetDocumentStatus(document);


                    <tr>

                        <td class="text-center">

                            @documentIndex

                        </td>


                        <td class="handwritten">

                            @Safe(documentName)

                        </td>


                        <td class="handwritten">

                            @Safe(documentType)

                        </td>


                        <td class="handwritten">

                            @Safe(fileName)

                        </td>


                        <td class="handwritten text-center">

                            @Safe(uploadedDate)

                        </td>


                        <td class="handwritten text-center">

                            @Safe(documentStatus)

                        </td>

                    </tr>


                    documentIndex++;

                }

            </tbody>

        </table>


        <!-- =====================================================
             DOCUMENT SUMMARY
        ====================================================== -->

        <div class="section-title">

            Document Summary

        </div>


        <div class="box">

            <div class="field-row">

                <span class="field-label">

                    Total Documents:

                </span>

                <div class="field-value handwritten">

                    @documentList.Count

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">

                    Employee:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.FullName)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">

                    Employee Code:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.EmployeeCode)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">

                    Date of Joining:

                </span>

                <div class="field-value handwritten">

                    @FormatDate(employee.DateOfJoining)

                </div>

            </div>

        </div>


        <div class="section-title">

            Uploaded File References

        </div>


        @foreach (var document in documentList)
        {

            var fileName =
                GetDocumentValue(
                    document,
                    "FileName",
                    "OriginalFileName",
                    "UploadedFileName"
                );

            var filePath =
                GetDocumentFilePath(document);

            <div class="box avoid-break">

                <div class="field-row">

                    <span class="field-label">

                        File:

                    </span>

                    <div class="field-value handwritten">

                        @Safe(fileName)

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(filePath))
                {

                    <div class="field-row">

                        <span class="field-label">

                            File Reference:

                        </span>

                        <div class="field-value small">

                            @Safe(filePath)

                        </div>

                    </div>

                }

            </div>

        }


        <div class="page-footer">

            Employment Form - Documents

        </div>


    </div>

}


<!-- =============================================================
     JAVASCRIPT
============================================================= -->

<script>

    window.addEventListener("beforeprint", function () {

        document.title =
            "Employment Form - @Safe(employee.FullName)";

    });


    // =========================================================
    // PRINT
    // =========================================================

    function printEmploymentForm() {

        window.print();

    }

</script>


</body>

</html>