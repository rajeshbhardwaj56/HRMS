@using HRMS.Models.EmployeeOnboarding
@using System.Reflection
@model EmployeeOnboardingPageViewModel

@{
    Layout = null;

    // =========================================================
    // MAIN DATA
    // =========================================================

    var employee = Model?.EmployeeDetails
                   ?? new EmployeeDetailsOnboardingModel();

    var familyList = Model?.FamilyList
                     ?? new List<EmployeeOnboardingFamilyModel>();

    var educationList = Model?.EducationList
                        ?? new List<EmployeeOnboardingEducationModel>();

    var employmentList = Model?.EmploymentList
                         ?? new List<EmployeeOnboardingEmploymentModel>();

    var bankList = Model?.BankDetailsList
                   ?? new List<EmployeeOnboardingBankDetailsModel>();

    // NOTE:
    // Your existing ViewModel uses "DocumnetList".
    // Keep this spelling if that is the actual property name.
    var documentList = Model?.DocumnetList
                       ?? new List<EmployeeOnboardingDocumentsModel>();

    var epfNominees = Model?.EPFNomineeList
                       ?? new List<EmployeeOnboardingNomineeModel>();

    var epsNominees = Model?.EPSNomineeList
                       ?? new List<EmployeeOnboardingNomineeModel>();

    var gratuityNominees = Model?.GratuityNomineeList
                           ?? new List<EmployeeOnboardingNomineeModel>();

    var interviewList = Model?.InterviewEvaluationList
                        ?? new List<EmployeeOnboardingInterviewEvaluationModel>();

    var interview = interviewList.FirstOrDefault();
    var interviewEvaluation =
        Model.InterviewEvaluationList?
            .FirstOrDefault()
        ?? new EmployeeOnboardingInterviewEvaluationModel();

    /*
     * Existing uploaded documents
     */
    var hrInterviewerSignature =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "HRInterviewerSignature");

    var operationsInterviewerSignature =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "OperationsInterviewerSignature");

    var processOwnerInterviewerSignature =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "ProcessOwnerInterviewerSignature");

    var interviewerSignature =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "InterviewerSignature");

    var signatureDocument =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "Signature");

    var functionalHeadApproval =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "FunctionalHeadApproval");

    var spocHumanResourcesApproval =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "SPOCHumanResourcesApproval");

    var headHumanResourcesApproval =
        Model.DocumnetList?
            .FirstOrDefault(x => x.DocumentType == "HeadHumanResourcesApproval");

    // =========================================================
    // HELPER METHODS
    // =========================================================

    string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd-MM-yyyy")
            : "";
    }

    string FormatDateTime(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd-MM-yyyy HH:mm")
            : "";
    }

    string YesNo(bool? value)
    {
        if (!value.HasValue)
            return "";

        return value.Value ? "Yes" : "No";
    }

    string Safe(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? ""
            : value;
    }

    string SafeObject(object? value)
    {
        return value == null
            ? ""
            : value.ToString() ?? "";
    }

    // =========================================================
    // DOCUMENT HELPER
    // Handles different possible property names safely.
    // =========================================================

    string GetDocumentValue(object? document, params string[] propertyNames)
    {
        if (document == null)
            return "";

        foreach (var propertyName in propertyNames)
        {
            try
            {
                var property = document.GetType()
                    .GetProperty(
                        propertyName,
                        BindingFlags.Public |
                        BindingFlags.Instance |
                        BindingFlags.IgnoreCase);

                if (property != null)
                {
                    var value = property.GetValue(document);

                    if (value != null &&
                        !string.IsNullOrWhiteSpace(value.ToString()))
                    {
                        return value.ToString() ?? "";
                    }
                }
            }
            catch
            {
                // Ignore and continue with next possible property.
            }
        }

        return "";
    }

    string GetDocumentDate(object? document)
    {
        if (document == null)
            return "";

        string[] properties =
        {
            "UploadedDate",
            "UploadDate",
            "CreatedDate",
            "CreatedOn",
            "AddedDate"
        };

        foreach (var propertyName in properties)
        {
            try
            {
                var property = document.GetType()
                    .GetProperty(
                        propertyName,
                        BindingFlags.Public |
                        BindingFlags.Instance |
                        BindingFlags.IgnoreCase);

                if (property == null)
                    continue;

                var value = property.GetValue(document);

                if (value is DateTime date)
                    return date.ToString("dd-MM-yyyy");

                if (value is DateTime?)
                {
                    var nullableDate = (DateTime?)value;

                    if (nullableDate.HasValue)
                        return nullableDate.Value.ToString("dd-MM-yyyy");
                }

                if (value != null &&
                    DateTime.TryParse(value.ToString(), out var parsedDate))
                {
                    return parsedDate.ToString("dd-MM-yyyy");
                }
            }
            catch
            {
            }
        }

        return "";
    }

    string GetDocumentStatus(object? document)
    {
        if (document == null)
            return "";

        var status = GetDocumentValue(
            document,
            "Status",
            "DocumentStatus",
            "UploadStatus"
        );

        if (!string.IsNullOrWhiteSpace(status))
            return status;

        var uploaded = GetDocumentValue(
            document,
            "IsUploaded",
            "Uploaded"
        );

        if (bool.TryParse(uploaded, out var isUploaded))
            return isUploaded ? "Uploaded" : "Not Uploaded";

        return "Uploaded";
    }

    string GetDocumentFilePath(object? document)
    {
        return GetDocumentValue(
            document,
            "DocumentPath",
            "FilePath",
            "FileUrl",
            "DocumentUrl",
            "UploadedFilePath",
            "AttachmentPath"
        );
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Employment Form - @employee.FullName
    </title>


    <style>

        /* =========================================================
           BASIC
        ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #e8e8e8;
            color: #111;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 9.5px;
        }


        /* =========================================================
           A4 PAGE
        ========================================================= */

        .a4-page {

            width: 210mm;
            min-height: 297mm;

            margin: 15px auto;

            background: #fff;

            padding: 9mm 10mm 9mm 10mm;

            box-shadow: 0 0 7px rgba(0,0,0,.30);

            position: relative;

        }


        /* =========================================================
           PRINT
        ========================================================= */

        @@media print {

            html,
            body {
                background: #fff;
                margin: 0;
                padding: 0;
            }

            .a4-page {

                width: 210mm;
                min-height: 297mm;

                margin: 0;

                padding: 9mm 10mm 9mm 10mm;

                box-shadow: none;

                page-break-after: always;

            }

            .no-print {
                display: none !important;
            }

            @@page {

                size: A4 portrait;

                margin: 0;

            }

        }


        /* =========================================================
           PRINT TOOLBAR
        ========================================================= */

        .print-toolbar {

            position: fixed;

            top: 15px;

            right: 20px;

            z-index: 9999;

        }

        .print-btn {

            border: none;

            background: #1c6dd0;

            color: #fff;

            padding: 9px 18px;

            border-radius: 4px;

            cursor: pointer;

            font-size: 12px;

        }

        .back-btn {

            border: none;

            background: #555;

            color: #fff;

            padding: 9px 18px;

            border-radius: 4px;

            cursor: pointer;

            font-size: 12px;

            margin-right: 5px;

        }


        /* =========================================================
           HEADER
        ========================================================= */

        .document-header {

            display: grid;

            grid-template-columns: 28% 44% 28%;

            align-items: start;

            min-height: 42px;

        }

        .header-left {

            text-align: left;

        }

        .company-logo {

            max-width: 62px;

            max-height: 45px;

            object-fit: contain;

        }

        .header-center {

            text-align: center;

            padding-top: 2px;

        }

        .header-center-title {

            font-size: 14px;

            font-weight: 700;

            margin-bottom: 2px;

        }

        .header-center-subtitle {

            font-size: 8px;

            font-weight: 600;

        }

        .header-right {

            text-align: right;

            font-size: 7.5px;

            line-height: 1.3;

        }

        .header-right strong {

            font-size: 9px;

        }


        /* =========================================================
           MAIN TITLE
        ========================================================= */

        .form-title {

            text-align: center;

            font-size: 15px;

            font-weight: bold;

            margin-top: 3px;

            margin-bottom: 7px;

        }


        /* =========================================================
           TOP DETAILS
        ========================================================= */

        .top-info {

            display: grid;

            grid-template-columns: 1.35fr 1fr .85fr;

            gap: 9px;

            margin-bottom: 5px;

        }

        .top-field {

            display: flex;

            align-items: center;

            min-height: 23px;

        }

        .top-label {

            font-weight: bold;

            white-space: nowrap;

            margin-right: 4px;

        }

        .top-value {

            flex: 1;

            border: 1px solid #333;

            min-height: 22px;

            padding: 3px 5px;

        }


        /* =========================================================
           GENERAL FIELD
        ========================================================= */

        .field-row {

            display: flex;

            width: 100%;

            min-height: 21px;

            align-items: center;

            margin-bottom: 2px;

        }

        .field-label {

            font-weight: bold;

            white-space: nowrap;

            margin-right: 4px;

        }

        .field-value {

            flex: 1;

            min-height: 18px;

            border-bottom: 1px solid #222;

            padding: 2px 4px;

        }

        .field-value.no-border {

            border-bottom: none;

        }

        .field-value-box {

            border: 1px solid #333;

            min-height: 21px;

            padding: 3px 5px;

        }


        /* =========================================================
           EMPLOYEE BASIC SECTION
        ========================================================= */

        .employee-main {

            display: grid;

            grid-template-columns: 1fr 82px;

            gap: 8px;

        }

        .employee-details {

            width: 100%;

        }


        /* =========================================================
           PHOTO
        ========================================================= */

        .photo-container {

            width: 77px;

            height: 95px;

            border: 1px solid #222;

            padding: 3px;

            margin-top: 2px;

        }

        .photo-container img {

            width: 100%;

            height: 100%;

            object-fit: cover;

        }

        .photo-placeholder {

            width: 100%;

            height: 100%;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            color: #777;

            font-size: 8px;

        }


        /* =========================================================
           SECTION
        ========================================================= */

        .section-title {

            font-weight: bold;

            font-size: 10px;

            margin-top: 5px;

            margin-bottom: 3px;

        }

        .mandatory::before {

            content: "*";

        }


        /* =========================================================
           ADDRESS
        ========================================================= */

        .address-line {

            border-bottom: 1px solid #222;

            min-height: 20px;

            padding: 2px 4px;

            margin-bottom: 2px;

        }

        .address-meta {

            display: grid;

            grid-template-columns: 1.2fr 1fr 1fr;

            gap: 7px;

        }


        /* =========================================================
           CONTACT
        ========================================================= */

        .contact-grid {

            display: grid;

            grid-template-columns: 1fr 1.25fr 1fr;

            gap: 7px;

        }


        /* =========================================================
           EMERGENCY
        ========================================================= */

        .emergency-grid {

            display: grid;

            grid-template-columns: 1fr 1fr 1.3fr;

            gap: 7px;

        }


        /* =========================================================
           TABLE
        ========================================================= */

        .form-table {

            width: 100%;

            border-collapse: collapse;

            table-layout: fixed;

            margin-top: 2px;

        }

        .form-table th,
        .form-table td {

            border: 1px solid #333;

            padding: 3px 4px;

            vertical-align: middle;

            word-wrap: break-word;

        }

        .form-table th {

            text-align: center;

            font-weight: bold;

            font-size: 8px;

            line-height: 1.15;

        }

        .form-table td {

            font-size: 8.5px;

            min-height: 22px;

            height: 22px;

        }


        /* =========================================================
           FAMILY TABLE
        ========================================================= */

        .family-table th:nth-child(1) {
            width: 14%;
        }

        .family-table th:nth-child(2) {
            width: 23%;
        }

        .family-table th:nth-child(3) {
            width: 12%;
        }

        .family-table th:nth-child(4) {
            width: 17%;
        }

        .family-table th:nth-child(5) {
            width: 20%;
        }

        .family-table th:nth-child(6) {
            width: 14%;
        }


        /* =========================================================
           EDUCATION TABLE
        ========================================================= */

        .education-table th:nth-child(1) {
            width: 11%;
        }

        .education-table th:nth-child(2) {
            width: 13%;
        }

        .education-table th:nth-child(3) {
            width: 28%;
        }

        .education-table th:nth-child(4) {
            width: 14%;
        }

        .education-table th:nth-child(5) {
            width: 13%;
        }

        .education-table th:nth-child(6) {
            width: 21%;
        }


        /* =========================================================
           PREVIOUS EMPLOYMENT
        ========================================================= */

        .employment-table th:nth-child(1) {
            width: 10%;
        }

        .employment-table th:nth-child(2) {
            width: 16%;
        }

        .employment-table th:nth-child(3) {
            width: 17%;
        }

        .employment-table th:nth-child(4) {
            width: 20%;
        }

        .employment-table th:nth-child(5) {
            width: 15%;
        }

        .employment-table th:nth-child(6) {
            width: 12%;
        }

        .employment-table th:nth-child(7) {
            width: 10%;
        }


        /* =========================================================
           NOMINEE
        ========================================================= */

        .nominee-table th:nth-child(1) {
            width: 20%;
        }

        .nominee-table th:nth-child(2) {
            width: 22%;
        }

        .nominee-table th:nth-child(3) {
            width: 16%;
        }

        .nominee-table th:nth-child(4) {
            width: 12%;
        }

        .nominee-table th:nth-child(5) {
            width: 12%;
        }

        .nominee-table th:nth-child(6) {
            width: 18%;
        }


        /* =========================================================
           DOCUMENT TABLE
        ========================================================= */

        .document-table th:nth-child(1) {
            width: 8%;
        }

        .document-table th:nth-child(2) {
            width: 27%;
        }

        .document-table th:nth-child(3) {
            width: 22%;
        }

        .document-table th:nth-child(4) {
            width: 17%;
        }

        .document-table th:nth-child(5) {
            width: 13%;
        }

        .document-table th:nth-child(6) {
            width: 13%;
        }


        /* =========================================================
           TWO COLUMN
        ========================================================= */

        .two-column {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 10px;

        }


        /* =========================================================
           BOX
        ========================================================= */

        .box {

            border: 1px solid #333;

            padding: 5px;

            margin-top: 5px;

        }

        .box-title {

            font-weight: bold;

            font-size: 9px;

            margin-bottom: 4px;

        }


        /* =========================================================
           CHECKBOX
        ========================================================= */

        .check {

            display: inline-block;

            width: 11px;

            height: 11px;

            border: 1px solid #333;

            margin-right: 3px;

            vertical-align: middle;

            text-align: center;

            line-height: 9px;

            font-size: 8px;

        }

        .checked::after {

            content: "✓";

            font-weight: bold;

        }


        /* =========================================================
           SIGNATURE
        ========================================================= */

        .signature-box {

            height: 45px;

            border-bottom: 1px solid #222;

            padding: 3px;

        }

        .signature-box img {

            max-width: 120px;

            max-height: 38px;

            object-fit: contain;

        }


        /* =========================================================
           DOCUMENT STATUS
        ========================================================= */

        .document-uploaded {

            font-weight: bold;

        }


        /* =========================================================
           SMALL
        ========================================================= */

        .small {

            font-size: 7.5px;

        }

        .tiny {

            font-size: 7px;

        }

        .handwritten {

            font-family: "Segoe Print",
                         "Bradley Hand",
                         "Comic Sans MS",
                         cursive;

            font-size: 10px;

        }

        .text-center {

            text-align: center;

        }

        .text-right {

            text-align: right;

        }

        .mt-5 {

            margin-top: 5px;

        }

        .mb-5 {

            margin-bottom: 5px;

        }


        /* =========================================================
           PAGE FOOTER
        ========================================================= */

        .page-footer {

            position: absolute;

            bottom: 5mm;

            left: 10mm;

            right: 10mm;

            text-align: center;

            font-size: 7px;

            color: #555;

        }


        /* =========================================================
           PAGE BREAK
        ========================================================= */

        .avoid-break {

            page-break-inside: avoid;

        }
        .approval-signature {
min-height: 70px;
display: flex;
align-items: center;
justify-content: center;
padding: 5px;
}

.approval-signature-image {
max-width: 150px;
max-height: 60px;
object-fit: contain;
display: block;
}

.approval-file-link {
font-size: 11px;
color: #034aa1;
text-decoration: underline;
}

.approval-label {
text-align: center;
font-weight: 600;
font-size: 12px;
padding-top: 5px;
}

    </style>

</head>


<body>


<!-- =============================================================
     PRINT TOOLBAR
============================================================= -->

<div class="print-toolbar no-print">

    <button type="button"
            class="back-btn"
            onclick="history.back()">

        Back

    </button>

    <button type="button"
            class="print-btn"
            onclick="window.print()">

        Print Form

    </button>

</div>


<!-- =============================================================
     PAGE 1
     EMPLOYEE / FAMILY / EDUCATION
============================================================= -->

<div class="a4-page">


    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="document-header">

        <div class="header-left">

            <img src="~/assets/img/logo/PROTALKLOGO.png"
                 class="company-logo"
                 alt="Company Logo"
                 onerror="this.style.display='none';" />

        </div>


        <div class="header-center">

            <div class="header-center-title">
                Employment Form
            </div>

            <div class="header-center-subtitle">
                (PSPL/HRD/SOP/Frm)
            </div>

            <div class="tiny">
                Release No: 04 Date: 20-04-2026
            </div>

        </div>


        <div class="header-right">

            <strong>
                Employment Form
            </strong>

            <br />

            (PSPL/HRD/SOP/Frm)

            <br />

            Release No: 04 Date: 20-04-2026

        </div>

    </div>


    <!-- =========================================================
         TITLE
    ========================================================== -->

    <div class="form-title">

        Employment Form

    </div>


    <!-- =========================================================
         DESIGNATION / EMPLOYEE CODE / DATE
    ========================================================== -->

    <div class="top-info">


        <div class="top-field">

            <span class="top-label">
                Designation:
            </span>

            <div class="top-value handwritten">

                @Safe(employee.Designation)

            </div>

        </div>


        <div class="top-field">

            <span class="top-label">
                Employee Code:
            </span>

            <div class="top-value handwritten">

                @Safe(employee.EmployeeCode)

            </div>

        </div>


        <div class="top-field">

            <span class="top-label">
                Date:
            </span>

            <div class="top-value handwritten">

                @FormatDate(employee.DateOfJoining)

            </div>

        </div>


    </div>


    <!-- =========================================================
         EMPLOYEE DETAILS + PHOTO
    ========================================================== -->

    <div class="employee-main">


        <div class="employee-details">


            <div class="field-row">

                <span class="field-label mandatory">
                    Employee Name:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.FullName)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Father's/Husband's Name:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.FatherHusbandName)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Date of Birth:
                </span>

                <div class="field-value handwritten"
                     style="max-width:115px;">

                    @FormatDate(employee.DateOfBirth)

                </div>


                <span class="field-label"
                      style="margin-left:10px;">

                    Gender:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.Gender)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label">
                    Marital Status:
                </span>

                <div class="field-value handwritten"
                     style="max-width:125px;">

                    @Safe(employee.MaritalStatus)

                </div>


                <span class="field-label"
                      style="margin-left:10px;">

                    Blood Group:

                </span>

                <div class="field-value handwritten">

                    @Safe(employee.BloodGroup)

                </div>

            </div>


            <div class="field-row">

                <span class="field-label mandatory">
                    Personal Email:
                </span>

                <div class="field-value handwritten">

                    @Safe(employee.Email)

                </div>

            </div>


        </div>


        <!-- EMPLOYEE PHOTO -->

        <div>

            <div class="photo-container">

                @if (!string.IsNullOrWhiteSpace(employee.EmployeePhoto))
                {
                    <img src="@employee.EmployeePhoto"
                         alt="Employee Photo"
                         onerror="this.style.display='none';" />
                }
                else
                {
                    <div class="photo-placeholder">

                        Employee
                        <br />
                        Photograph

                    </div>
                }

            </div>

        </div>


    </div>


    <!-- =========================================================
         PERMANENT ADDRESS
    ========================================================== -->

    <div class="section-title mandatory">

        Permanent Address:

    </div>


    <div class="address-line handwritten">

        @Safe(employee.PermanentAddress)

    </div>


    <div class="address-meta">


        <div class="field-row">

            <span class="field-label">
                City
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentCity)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                State
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentState)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                PIN Code
            </span>

            <div class="field-value handwritten">

                @Safe(employee.PermanentPINCode)

            </div>

        </div>


    </div>


    <!-- =========================================================
         CONTACT
    ========================================================== -->

    <div class="contact-grid">


        <div class="field-row">

            <span class="field-label">
                Mobile No.:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.Mobile)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Personal Email:
            </span>

            <div class="field-value handwritten">

                @Safe(employee.Email)

            </div>

        </div>


        <div class="field-row">

            <span class="field-label">
                Land Line No.:
            </span>

