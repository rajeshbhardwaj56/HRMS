<!-- =================================================
                     DECLARATION
                ================================================== -->

<div class="section-title">
    Declaration
</div>

<div class="declaration-box">

    <p style="font-size:13px; line-height:1.7;">

        I hereby declare that the information provided by me
        in this employee onboarding form is true and correct
        to the best of my knowledge and belief. I understand
        that any incorrect or misleading information may
        result in appropriate action.

    </p>


    <div class="form-check mb-3">

        <input class="form-check-input"
               type="checkbox"
               id="declarationAccepted"
               required />

        <label class="form-check-label"
               for="declarationAccepted">

            I confirm that the above information is correct.

            <span class="required">*</span>

        </label>

    </div>


    <div class="row">

        <div class="col-md-4">

            <label class="form-label">
                Declaration Date
            </label>

            <input type="date"
                   class="form-control"
