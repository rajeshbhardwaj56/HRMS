@using HRMS.Models.EmployeeOnboarding
@model EmployeeUndertakingModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Employee Undertaking</title>


    <style>

            /* =========================================================
                       RESET
                    ========================================================= */

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
            }

            body {
                background: #e5e5e5;
                color: #000;
                font-family: "Times New Roman", Times, serif;
                font-size: 11px;
            }


            /* =========================================================
                       PAGE WRAPPER
                    ========================================================= */

            .page-wrapper {
                width: 100%;
                padding: 25px 0;
            }


            /* =========================================================
                       A4 DOCUMENT
                    ========================================================= */

            .undertaking-page {
                width: 210mm;
                min-height: 297mm;
                margin: 0 auto;
                padding: 9mm 12mm 7mm 12mm;
                background: #fff;
                border: 1px solid #999;
                box-shadow: 0 3px 15px rgba(0, 0, 0, 0.15);
            }


            /* =========================================================
                       HEADER
                    ========================================================= */

            .document-header {
                display: grid;
                grid-template-columns: 85px 1fr 150px;
                align-items: center;
                min-height: 58px;
                padding-bottom: 7px;
                border-bottom: 1px solid #000;
                margin-bottom: 7px;
            }


            .logo-section {
                display: flex;
                align-items: center;
                justify-content: flex-start;
            }


            .company-logo {
                max-width: 70px;
                max-height: 50px;
                object-fit: contain;
            }


            .document-heading {
                text-align: center;
            }


                .document-heading h2 {
                    margin: 0;
                    font-size: 16px;
                    line-height: 19px;
                    font-weight: bold;
                    text-transform: uppercase;
                }


                .document-heading p {
                    margin: 2px 0 0;
                    font-size: 9px;
                    line-height: 11px;
                }


            .document-info {
                text-align: right;
                font-size: 8.5px;
                line-height: 13px;
            }


                .document-info strong {
                    font-weight: bold;
                }


            /* =========================================================
                       TITLE
                    ========================================================= */

            .document-title {
                text-align: center;
                font-size: 12px;
                font-weight: bold;
                text-decoration: underline;
                margin: 4px 0 7px;
            }


            /* =========================================================
                       EMPLOYEE DETAILS
                    ========================================================= */

            .employee-information {
                width: 100%;
                margin-bottom: 7px;
            }


            .info-row {
                display: flex;
                align-items: baseline;
                width: 100%;
                margin-bottom: 4px;
            }


            .info-label {
                white-space: nowrap;
                font-weight: bold;
                margin-right: 4px;
            }


            .info-input {
                flex: 1;
                min-width: 0;
                height: 20px;
                padding: 0 3px;
                border: none;
                border-bottom: 1px solid #000;
                outline: none;
                background: transparent;
                color: #000;
                font-family: "Times New Roman", Times, serif;
                font-size: 11px;
            }


                .info-input:focus {
                    border-bottom: 1px solid #000;
                    outline: none;
                    box-shadow: none;
                }


            .info-row-two {
                display: grid;
                grid-template-columns: 1fr 1fr;
                column-gap: 20px;
            }


                .info-row-two .info-row {
                    margin-bottom: 4px;
                }


            /* =========================================================
                       ADDRESS
                    ========================================================= */

            .address-row {
                display: flex;
                align-items: flex-start;
                width: 100%;
                margin-bottom: 4px;
            }


            .address-label {
                width: 125px;
                min-width: 125px;
                font-weight: bold;
                padding-top: 2px;
            }


            .document-textarea {
                flex: 1;
                min-width: 0;
                min-height: 32px;
                padding: 1px 3px;
                resize: none;
                outline: none;
                border: none;
                border-bottom: 1px solid #000;
                background: transparent;
                color: #000;
                font-family: "Times New Roman", Times, serif;
                font-size: 11px;
                line-height: 14px;
            }


                .document-textarea:focus {
                    border-bottom: 1px solid #000;
                    outline: none;
                    box-shadow: none;
                }


            /* =========================================================
                       CONTACT
                    ========================================================= */

            .contact-grid {
                display: grid;
                grid-template-columns: 1fr 1fr 1.25fr;
                gap: 12px;
                margin-top: 2px;
                margin-bottom: 7px;
            }


            .contact-item {
                display: flex;
                align-items: baseline;
                min-width: 0;
            }


                .contact-item label {
                    white-space: nowrap;
                    font-weight: bold;
                    font-size: 9.5px;
                    margin-right: 3px;
                }


            .contact-input {
                width: 100%;
                min-width: 0;
                height: 19px;
                padding: 0 2px;
                border: none;
                border-bottom: 1px solid #000;
                outline: none;
                background: transparent;
                color: #000;
                font-family: "Times New Roman", Times, serif;
                font-size: 10px;
            }


            /* =========================================================
                       INTRODUCTION
                    ========================================================= */

            .intro-text {
                margin-top: 4px;
                margin-bottom: 6px;
                font-size: 10.5px;
                line-height: 14px;
                text-align: justify;
            }


            /* =========================================================
                       DOCUMENT INLINE VALUES
                    ========================================================= */

            .document-value {
                display: inline;
                min-width: 50px;
                padding: 0 2px;
                border-bottom: 1px solid #000;
                font-weight: normal;
                word-break: break-word;
            }


                .document-value:empty::after {
                    content: "________________";
                }


            .document-value-address {
                display: inline;
                padding: 0 2px;
                border-bottom: 1px solid #000;
                word-break: break-word;
            }


                .document-value-address:empty::after {
                    content: "____________________________";
                }


            /* =========================================================
                       UNDERTAKING HEADING
                    ========================================================= */

            .undertaking-heading {
                text-align: center;
                font-size: 12px;
                font-weight: bold;
                text-decoration: underline;
                margin: 5px 0 6px;
            }


            /* =========================================================
                       UNDERTAKING LIST
                    ========================================================= */

            .undertaking-list {
                margin: 0;
                padding-left: 21px;
            }


                .undertaking-list li {
                    padding-left: 3px;
                    margin-bottom: 4px;
                    font-size: 9.5px;
                    line-height: 13.2px;
                    text-align: justify;
                }


            /* =========================================================
                       DECLARATION
                    ========================================================= */

            .declaration-box {
                margin-top: 7px;
                margin-bottom: 7px;
            }


            .declaration-line {
                display: flex;
                align-items: flex-start;
                gap: 5px;
                font-size: 9.5px;
                line-height: 13px;
                text-align: justify;
            }


            .declaration-checkbox {
                width: 13px;
                height: 13px;
                flex: 0 0 13px;
                margin-top: 0;
            }


            /* =========================================================
                       SIGNATURE SECTION
                    ========================================================= */

            .signature-section {
                margin-top: 9px;
                padding-top: 4px;
            }


            .signature-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }


                .signature-table td {
                    vertical-align: bottom;
                    padding: 4px 3px;
                    font-size: 10px;
                }


            .signature-label {
                width: 180px;
                font-weight: bold;
                white-space: nowrap;
            }


            .signature-value {
                width: 230px;
                height: 30px;
                border-bottom: 1px solid #000;
            }


            .signature-date-label {
                width: 40px;
                padding-left: 15px !important;
                font-weight: bold;
                white-space: nowrap;
            }


            .signature-date {
                width: 105px;
                height: 30px;
                border-bottom: 1px solid #000;
            }


            /* =========================================================
                       SIGNATURE IMAGE
                    ========================================================= */

            .signature-image {
                display: block;
                max-width: 150px;
                max-height: 35px;
                object-fit: contain;
                margin-bottom: -3px;
            }


            /* =========================================================
                       SIGNATURE UPLOAD
                    ========================================================= */

            .signature-upload {
                margin-top: 2px;
            }


            .signature-upload-label {
                display: block;
                margin-bottom: 2px;
                font-family: Arial, sans-serif;
                font-size: 8.5px;
            }


            .signature-upload input[type="file"] {
                width: 100%;
                font-family: Arial, sans-serif;
                font-size: 8px;
            }


            /* =========================================================
                       FOOTER
                    ========================================================= */

            .document-footer {
                margin-top: 6px;
                padding-top: 4px;
                border-top: 1px solid #000;
                text-align: center;
                font-size: 7.5px;
            }


            /* =========================================================
                       ACTION BUTTONS
                    ========================================================= */

            .action-bar {
                width: 210mm;
                margin: 15px auto 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-family: Arial, sans-serif;
            }


            .action-left,
            .action-right {
                display: flex;
                gap: 8px;
            }


            .action-button {
                min-width: 100px;
                border: none;
                border-radius: 4px;
                padding: 9px 15px;
                cursor: pointer;
                font-family: Arial, sans-serif;
                font-size: 12px;
            }


            .btn-back {
                background: #6c757d;
                color: #fff;
            }


            .btn-save {
                background: #198754;
                color: #fff;
            }


            .btn-continue {
                background: #0d6efd;
                color: #fff;
            }


            .btn-print {
                background: #212529;
                color: #fff;
            }


            .action-button:disabled {
                opacity: .6;
                cursor: not-allowed;
            }


            /* =========================================================
                       MOBILE
                    ========================================================= */

            @@media (max-width: 900px) {

                body {
                    background: #fff;
                }

                .page-wrapper {
                    padding: 0;
                }

                .undertaking-page {
                    width: 100%;
                    min-height: auto;
                    margin: 0;
                    padding: 15px;
                    border: none;
                    box-shadow: none;
                }

                .document-header {
                    grid-template-columns: 65px 1fr 100px;
                }

                .info-row-two {
                    grid-template-columns: 1fr;
                }

                .contact-grid {
                    grid-template-columns: 1fr;
                    gap: 5px;
                }

                .action-bar {
                    width: 100%;
                    padding: 10px 15px;
                    flex-direction: column;
                    gap: 10px;
                }

                .action-left,
                .action-right {
                    width: 100%;
                }

                .action-button {
                    flex: 1;
                }
            }


            /* =========================================================
                       PRINT
                    ========================================================= */

            @@media print {

                @@page {
                    size: A4 portrait;
                    margin: 7mm;
                }

                html,
                body {
                    width: 210mm;
                    min-height: 297mm;
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #fff !important;
                }

                .page-wrapper {
                    width: 100%;
                    padding: 0;
                    margin: 0;
                }

                .undertaking-page {
                    width: 100%;
                    min-height: 0;
                    margin: 0;
                    padding: 0;
                    border: none;
                    box-shadow: none;
                }

                .action-bar,
                .no-print,
                .signature-upload {
                    display: none !important;
                }

                input,
                textarea {
                    color: #000 !important;
                    background: transparent !important;
                    border: none !important;
                    box-shadow: none !important;
                }

                .undertaking-list li {
                    break-inside: avoid;
                }

                .signature-section {
                    break-inside: avoid;
                }
            }

    </style>

</head>


<body>


    <div class="page-wrapper">


        <!-- =========================================================
         A4 DOCUMENT
    ========================================================= -->

        <div class="undertaking-page"
             id="undertakingDocument">


            <!-- =====================================================
             HEADER
        ===================================================== -->

            <div class="document-header">


                <!-- LOGO -->

                <div class="logo-section">

                    <img src="~/assets/img/logo/PROTALKLOGO.png"
                         class="company-logo"
                         alt="ProTalk Logo" />

                </div>


                <!-- TITLE -->

                <div class="document-heading">

                    <h2>
                        Employee Undertaking
                    </h2>

                    <p>
                        Employee Undertaking Form
                    </p>

                </div>


                <!-- RELEASE -->

                <div class="document-info">

                    <div>
                        <strong>Release:</strong> 1.4
                    </div>

                    <div>
                        <strong>Release Date:</strong> 20.04.2026
                    </div>

                </div>


            </div>


            <!-- =====================================================
             FORM
        ===================================================== -->

            <form id="employeeUndertakingForm"
                  method="post"
                  enctype="multipart/form-data">


                <!-- =================================================
                 HIDDEN IDs
            ================================================= -->

                <input type="hidden"
                       name="OnboardingID"
                       value="@Model.OnboardingID" />

                <input type="hidden"
                       name="EmployeeUndertakingID"
                       value="@Model.EmployeeUndertakingID" />


                <!-- =================================================
                 DOCUMENT TITLE
            ================================================= -->

                <div class="document-title">

                    EMPLOYEE UNDERTAKING / DECLARATION

                </div>


                <!-- =================================================
                 EMPLOYEE DETAILS
            ================================================= -->

                <div class="employee-information">


                    <!-- EMPLOYEE NAME -->

                    <div class="info-row">

                        <span class="info-label">
                            Employee Name:
                        </span>

                        <input type="text"
                               id="EmployeeName"
                               class="info-input"
                               name="EmployeeName"
                               value="@Model.EmployeeName"
                               required />

                    </div>


                    <!-- FATHER / HUSBAND -->

                    <div class="info-row">

                        <span class="info-label">
                            Father / Husband Name:
                        </span>

                        <input type="text"
                               id="FatherHusbandName"
                               class="info-input"
                               name="FatherHusbandName"
                               value="@Model.FatherHusbandName" />

                    </div>


                    <!-- EMPLOYEE CODE / DESIGNATION -->

                    <div class="info-row-two">


                        <div class="info-row">

                            <span class="info-label">
                                Employee Code:
                            </span>

                            <input type="text"
                                   id="EmployeeCode"
                                   class="info-input"
                                   name="EmployeeCode"
                                   value="@Model.EmployeeCode" />

                        </div>


                        <div class="info-row">

                            <span class="info-label">
                                Designation:
                            </span>

                            <input type="text"
                                   id="Designation"
                                   class="info-input"
                                   name="Designation"
                                   value="@Model.Designation" />

                        </div>


                    </div>


                    <!-- PERMANENT ADDRESS -->

                    <div class="address-row">

                        <div class="address-label">
                            Permanent Address:
                        </div>

                        <textarea id="PermanentAddress"
                                  class="document-textarea"
                                  name="PermanentAddress"
                                  rows="2">@Model.PermanentAddress</textarea>

                    </div>


                    <!-- PRESENT ADDRESS -->

                    <div class="address-row">

                        <div class="address-label">
                            Present / Residential Address:
                        </div>

                        <textarea id="PresentAddress"
                                  class="document-textarea"
                                  name="PresentAddress"
                                  rows="2">@Model.PresentAddress</textarea>

                    </div>


                    <!-- CONTACT NUMBERS -->

                    <div class="contact-grid">


                        <!-- EMPLOYEE -->

                        <div class="contact-item">

                            <label>
                                Contact No.:
                            </label>

                            <input type="text"
                                   id="EmployeeContactNo"
                                   class="contact-input"
                                   name="EmployeeContactNo"
                                   value="@Model.EmployeeContactNo"
                                   maxlength="15" />

                        </div>


                        <!-- FATHER -->

                        <div class="contact-item">

                            <label>
                                Father's Contact:
                            </label>

                            <input type="text"
                                   id="FatherContactNo"
                                   class="contact-input"
                                   name="FatherContactNo"
                                   value="@Model.FatherContactNo"
                                   maxlength="15" />

                        </div>


                        <!-- OTHER -->

                        <div class="contact-item">

                            <label>
                                Alternate Contact:
                            </label>

                            <input type="text"
                                   id="MotherBrotherSisterContactNo"
                                   class="contact-input"
                                   name="MotherBrotherSisterContactNo"
                                   value="@Model.MotherBrotherSisterContactNo"
                                   maxlength="15" />

                        </div>


                    </div>


                </div>


                <!-- =================================================
                 INTRODUCTION
            ================================================= -->

                <div class="intro-text">

                    I,
                    <span id="displayEmployeeName"
                          class="document-value">@Model.EmployeeName</span>,

                    resident of

                    <span id="displayPresentAddress"
                          class="document-value-address">@Model.PresentAddress</span>

                    do hereby solemnly declare and undertake / promise to
                    follow the following terms and conditions during the
                    course of my training and employment at ProTalk Solutions
                    Pvt. Ltd.

                </div>


                <!-- =================================================
                 UNDERTAKING HEADING
            ================================================= -->

                <div class="undertaking-heading">

                    EMPLOYEE UNDERTAKING

                </div>


                <!-- =================================================
                 UNDERTAKING CLAUSES
            ================================================= -->

                <ol class="undertaking-list">


                    <!-- =================================================
                     1
                ================================================= -->

                    <li>

                        That I am a citizen/resident of India and I am presently
                        residing at

                        <span id="displayPresentAddressClause1"
                              class="document-value-address">@Model.PresentAddress</span>

                        and I am presently undergoing training and/or employment
                        with ProTalk Solutions Pvt. Ltd.

                    </li>


                    <!-- =================================================
                     2
                ================================================= -->

                    <li>

                        I further declare that my permanent address is

                        <span id="displayPermanentAddressClause2"
                              class="document-value-address">@Model.PermanentAddress</span>

                        and my contact number is

                        <span id="displayEmployeeContactClause2"
                              class="document-value">@Model.EmployeeContactNo</span>.

                    </li>


                    <!-- =================================================
                     3
                ================================================= -->

                    <li>

                        That during the course of my employment if there is any
                        change in the Permanent / Present address I will intimate
                        the same to the company in writing within 3 days of such change.

                    </li>


                    <!-- =================================================
                     4
                ================================================= -->

                    <li>

                        I do hereby declare that there is no police case registered
                        or pending against me in any police station and nor are any
                        criminal/legal proceedings going on against me in any court.
                        In case this statement is found to be incorrect my services
                        may be terminated and I may be blacklisted by the Company.

                    </li>


                    <!-- =================================================
                     5
                ================================================= -->

                    <li>

                        That I do not indulge in any activity which may lead to
                        getting involved in any criminal / legal proceedings or may
                        lead to damage to the image / reputation of the Company.

                    </li>


                    <!-- =================================================
                     6
                ================================================= -->

                    <li>

                        That I would neither report to office nor board the office
                        cab under the influence of alcohol, intoxicants or illegal drugs.

                    </li>


                    <!-- =================================================
                     7
                ================================================= -->

                    <li>

                        That, not to misuse the customer's / Company's property
                        or resources and I will not touch the customer in my personal
                        capacity for any reason.

                    </li>


                    <!-- =================================================
                     8
                ================================================= -->

                    <li>

                        I have been provided access to various systems /
                        applications / resources of the Company. I agree to use
                        such access only for authorized business purposes and to
                        protect all confidential information.

                    </li>


                    <!-- =================================================
                     9
                ================================================= -->

                    <li>

                        That I will not indulge in any sort of illegal misuse of
                        the facilities provided by the client for myself or any of
                        my acquaintances, whether it involves provisioning of
                        packs, recharging coupons, billing, discounting, providing
                        vouchers, special promotional schemes, misuse of software,
                        ID's etc.

                    </li>


                    <!-- =================================================
                     10
                ================================================= -->

                    <li>

                        That during the training period and my employment with
                        the Company, I will abide by the Company's rules and
                        regulations including all applicable policies and procedures.

                    </li>


                    <!-- =================================================
                     11
                ================================================= -->

                    <li>

                        I will not take my personal cell phone or use it on the
                        floor. I agree that no personal cell phone shall be carried
                        during the working hours unless specifically permitted
                        by management.

                    </li>


                    <!-- =================================================
                     12
                ================================================= -->

                    <li>

                        I will abide by the Company's Code of Conduct Policy and
                        User Acceptable Policy, which have been shared by HR during
                        induction and have been understood by me.

                    </li>


                    <!-- =================================================
                     13
                ================================================= -->

                    <li>

                        That the training, if payable to me, will be released only
                        in the subsequent month of the completion of training and
                        successful certification as per the training fee payout cycle.

                    </li>


                    <!-- =================================================
                     14
                ================================================= -->

                    <li>

                        I further declare that the above undertakings have been
                        made by me of my own free will and under no pressure or
                        coercion from any quarter. In the event of my being found
                        to be delinquent on account of any of the above undertakings
                        or any of my acts of omission/commission, by virtue of which
                        the Company's reputation is at stake or the Company suffers
                        any kind of loss, the Company shall be at liberty to resort
                        to any type of disciplinary/legal action against me.

                    </li>


                </ol>


                <!-- =================================================
                 DECLARATION
            ================================================= -->

                <div class="declaration-box">

                    <div class="declaration-line">


                        <input type="checkbox"
                               class="declaration-checkbox"
                               id="undertakingAccepted"
                               name="IsSubmitted"
                               value="true"
                               required />


                        <label for="undertakingAccepted">

                            I have read and understood the above undertaking
                            and agree to comply with the terms and conditions
                            stated above. I confirm that the information furnished
                            by me is true and correct to the best of my knowledge.

                        </label>


                    </div>

                </div>


                <!-- =================================================
                 SIGNATURE SECTION
            ================================================= -->

                <div class="signature-section">


                    <table class="signature-table">


                        <!-- =================================================
                         EMPLOYEE SIGNATURE DISPLAY
                    ================================================= -->

                        <tr>


                            <td class="signature-label">

                                Employee Name &amp; Signature:

                            </td>


                            <td class="signature-value"
                                id="employeeSignatureDisplay">


                                @if (!string.IsNullOrEmpty(Model.EmployeeSignaturePath))
                                {
                                    <img src="@Model.EmployeeSignaturePath"
                                         class="signature-image"
                                         alt="Employee Signature" />
                                }


                            </td>


                            <td class="signature-date-label">

                                Date:

                            </td>


                            <td class="signature-date">


                                @if (Model.EmployeeSignatureDate.HasValue)
                                {
                                    @Model.EmployeeSignatureDate.Value.ToString("dd-MM-yyyy")
                                }


                            </td>


                        </tr>


                        <!-- =================================================
                         EMPLOYEE SIGNATURE INPUT
                    ================================================= -->

                        <tr class="no-print">


                            <td colspan="2">


                                <div class="signature-upload">


                                    <span class="signature-upload-label">

                                        Upload Employee Signature

                                    </span>


                                    <input type="file"
                                           name="EmployeeSignatureFile"
                                           id="EmployeeSignatureFile"
                                           accept=".jpg,.jpeg,.png" />


                                </div>


                            </td>


                            <td colspan="2">


                                <div class="signature-upload">


                                    <span class="signature-upload-label">

                                        Employee Signature Date

                                    </span>


                                    <input type="date"
                                           class="info-input"
                                           style="width:100%;"
                                           name="EmployeeSignatureDate"
                                           value="@(Model.EmployeeSignatureDate?.ToString("yyyy-MM-dd"))" />


                                </div>


                            </td>


                        </tr>


                        <!-- =================================================
                         HR SIGNATURE DISPLAY
                    ================================================= -->

                        <tr>


                            <td class="signature-label">

                                HR Name &amp; Signature:

                            </td>


                            <td class="signature-value"
                                id="hrSignatureDisplay">


                                @if (!string.IsNullOrEmpty(Model.HRSignaturePath))
                                {
                                    <img src="@Model.HRSignaturePath"
                                         class="signature-image"
                                         alt="HR Signature" />
                                }


                            </td>


                            <td class="signature-date-label">

                                Date:

                            </td>


                            <td class="signature-date">


                                @if (Model.HRSignatureDate.HasValue)
                                {
                                    @Model.HRSignatureDate.Value.ToString("dd-MM-yyyy")
                                }


                            </td>


                        </tr>


                        <!-- =================================================
                         HR INPUTS
                    ================================================= -->

                        <tr class="no-print">


                            <td colspan="2">


                                <div class="signature-upload">


                                    <span class="signature-upload-label">

                                        HR Name

                                    </span>


                                    <input type="text"
                                           id="HRName"
                                           class="info-input"
                                           style="width:100%;"
                                           name="HRName"
                                           value="@Model.HRName"
                                           placeholder="Enter HR Name" />


                                </div>


                            </td>


                            <td colspan="2">


                                <div class="signature-upload">


                                    <span class="signature-upload-label">

                                        Upload HR Signature

                                    </span>


                                    <input type="file"
                                           name="HRSignatureFile"
                                           id="HRSignatureFile"
                                           accept=".jpg,.jpeg,.png" />


                                </div>


                                <div class="signature-upload">


                                    <span class="signature-upload-label">

                                        HR Signature Date

                                    </span>


                                    <input type="date"
                                           class="info-input"
                                           style="width:100%;"
                                           name="HRSignatureDate"
                                           value="@(Model.HRSignatureDate?.ToString("yyyy-MM-dd"))" />


                                </div>


                            </td>


                        </tr>


                    </table>


                </div>


                <!-- =================================================
                 FOOTER
            ================================================= -->

                <div class="document-footer">

                    ProTalk Solutions Pvt. Ltd.
                    &nbsp; | &nbsp;
                    Employee Undertaking
                    &nbsp; | &nbsp;
                    Release 1.4

                </div>


            </form>


        </div>


        <!-- =========================================================
         ACTION BUTTONS
    ========================================================= -->

        <div class="action-bar no-print">


            <!-- BACK -->

            <div class="action-left">

                <button type="button"
                        class="action-button btn-back"
                        onclick="goBack()">

                    ← Back

                </button>

            </div>


            <!-- RIGHT -->

            <div class="action-right">


                <button type="button"
                        class="action-button btn-print"
                        onclick="printDocument()">

                    🖨 Print

                </button>


                <button type="button"
                        class="action-button btn-save"
                        onclick="saveForm(false)">

                    Save

                </button>


                <button type="button"
                        class="action-button btn-continue"
                        onclick="saveForm(true)">

                    Save &amp; Continue →

                </button>


            </div>


        </div>


    </div>


    <script>


            /* =========================================================
               HELPER - SET DISPLAY VALUE
            ========================================================= */

            function setDisplayValue(elementId, value) {

                const element =
                    document.getElementById(elementId);


                if (!element) {

                    return;

                }


                element.textContent =
                    value && value.trim()
                        ? value
                        : "";

            }


            /* =========================================================
               UPDATE DOCUMENT VALUES
            ========================================================= */

            function updateDocumentValues() {


                /* -----------------------------------------------------
                   EMPLOYEE NAME
                ----------------------------------------------------- */

                const employeeName =
                    document.getElementById(
                        "EmployeeName"
                    );


                if (employeeName) {

                    setDisplayValue(
                        "displayEmployeeName",
                        employeeName.value
                    );

                }


                /* -----------------------------------------------------
                   PRESENT ADDRESS
                ----------------------------------------------------- */

                const presentAddress =
                    document.getElementById(
                        "PresentAddress"
                    );


                if (presentAddress) {

                    setDisplayValue(
                        "displayPresentAddress",
                        presentAddress.value
                    );


                    setDisplayValue(
                        "displayPresentAddressClause1",
                        presentAddress.value
                    );

                }


                /* -----------------------------------------------------
                   PERMANENT ADDRESS
                ----------------------------------------------------- */

                const permanentAddress =
                    document.getElementById(
                        "PermanentAddress"
                    );


                if (permanentAddress) {

                    setDisplayValue(
                        "displayPermanentAddressClause2",
                        permanentAddress.value
                    );

                }


                /* -----------------------------------------------------
                   EMPLOYEE CONTACT
                ----------------------------------------------------- */

                const employeeContact =
                    document.getElementById(
                        "EmployeeContactNo"
                    );


                if (employeeContact) {

                    setDisplayValue(
                        "displayEmployeeContactClause2",
                        employeeContact.value
                    );

                }

            }


            /* =========================================================
               INITIALIZE LIVE DOCUMENT UPDATE
            ========================================================= */

            document.addEventListener(
                "DOMContentLoaded",
                function() {


                    const fields = [

                        "EmployeeName",

                        "FatherHusbandName",

                        "EmployeeCode",

                        "Designation",

                        "PermanentAddress",

                        "PresentAddress",

                        "EmployeeContactNo",

                        "FatherContactNo",

                        "MotherBrotherSisterContactNo"

                    ];


                    fields.forEach(
                        function(fieldId) {


                            const field =
                                document.getElementById(
                                    fieldId
                                );


                            if (!field) {

                                return;

                            }


                            field.addEventListener(
                                "input",
                                updateDocumentValues
                            );


                            field.addEventListener(
                                "change",
                                updateDocumentValues
                            );

                        }
                    );


                    updateDocumentValues();

                }
            );


            /* =========================================================
               SAVE FORM
            ========================================================= */

            function saveForm(continueNext) {


                const form =
                    document.getElementById(
                        "employeeUndertakingForm"
                    );


                /* -----------------------------------------------------
                   VALIDATION
                ----------------------------------------------------- */

                if (!form.checkValidity()) {

                    form.reportValidity();

                    return;

                }


                /* -----------------------------------------------------
                   FORM DATA
                ----------------------------------------------------- */

                const formData =
                    new FormData(form);


                /* -----------------------------------------------------
                   BUTTONS
                ----------------------------------------------------- */

                const buttons =
                    document.querySelectorAll(
                        ".action-button"
                    );


                buttons.forEach(
                    function(button) {

                        button.disabled = true;

                    }
                );


                /* -----------------------------------------------------
                   POST
                ----------------------------------------------------- */

                fetch(
                    '@Url.Action(
                                    "AddUpdateEmployeeUndertaking",
                                    "Onboarding"
                                            )',
                        {
                        method: "POST",

                        body: formData
                    }
                )
                    .then(
                        function(response) {


                            if (!response.ok) {

                                throw new Error(
                                    "Server returned an error."
                                );

                            }


                            return response.json();

                        }
                    )
                    .then(
                        function(result) {


                            console.log(
                                "Employee Undertaking Save:",
                                result
                            );


                            if (result.success) {


                                /* =========================================
                                   SAVE & CONTINUE
                                ========================================= */

                                if (continueNext) {


                                    if (result.redirectUrl) {

                                        window.location.href =
                                            result.redirectUrl;

                                    }
                                    else {


                                        window.location.href =
                                            '@Url.Action(
                                                                            "NonDisclosureAgreement",
                                                                            "Onboarding"
                                                                            )'
                                            + '?onboardingID='
                                            + encodeURIComponent(
                                                document.querySelector(
                                                    '[name="OnboardingID"]'
                                                ).value
                                            );

                                    }

                                }


                                /* =========================================
                                   SAVE ONLY
                                ========================================= */

                                else {


                                    alert(
                                        result.message ||
                                        "Employee undertaking saved successfully."
                                    );

                                }


                            }
                            else {


                                alert(
                                    result.message ||
                                    "Unable to save employee undertaking."
                                );

                            }

                        }
                    )
                    .catch(
                        function(error) {


                            console.error(
                                "Employee undertaking error:",
                                error
                            );


                            alert(
                                "Something went wrong while saving the information."
                            );

                        }
                    )
                    .finally(
                        function() {


                            buttons.forEach(
                                function(button) {

                                    button.disabled = false;

                                }
                            );

                        }
                    );

            }


            /* =========================================================
               BACK
            ========================================================= */

            function goBack() {


                const onboardingID =
                    document.querySelector(
                        '[name="OnboardingID"]'
                    ).value;


                window.location.href =
                    '@Url.Action(
                                    "Index",
                                    "Onboarding"
                            )'
                    + '?onboardingID='
                    + encodeURIComponent(
                        onboardingID
                    );

            }


            /* =========================================================
               PRINT
            ========================================================= */

            function printDocument() {

                /*
                 * Make sure latest values are displayed
                 * before opening print dialog.
                 */

                updateDocumentValues();


                window.print();

            }


            /* =========================================================
               EMPLOYEE SIGNATURE PREVIEW
            ========================================================= */

            document.addEventListener(
                "DOMContentLoaded",
                function() {


                    const employeeSignature =
                        document.getElementById(
                            "EmployeeSignatureFile"
                        );


                    if (employeeSignature) {


                        employeeSignature.addEventListener(
                            "change",
                            function(event) {

                                previewSignature(
                                    event.target,
                                    "employeeSignatureDisplay"
                                );

                            }
                        );

                    }


                    const hrSignature =
                        document.getElementById(
                            "HRSignatureFile"
                        );


                    if (hrSignature) {


                        hrSignature.addEventListener(
                            "change",
                            function(event) {

                                previewSignature(
                                    event.target,
                                    "hrSignatureDisplay"
                                );

                            }
                        );

                    }

                }
            );


            /* =========================================================
               SIGNATURE PREVIEW
            ========================================================= */

            function previewSignature(
                input,
                targetId
            ) {


                if (!input.files ||
                    input.files.length === 0) {

                    return;

                }


                const file =
                    input.files[0];


                /* -----------------------------------------------------
                   VALIDATE IMAGE
                ----------------------------------------------------- */

                if (!file.type.startsWith("image/")) {


                    alert(
                        "Please select a valid image file."
                    );


                    input.value = "";


                    return;

                }


                /* -----------------------------------------------------
                   READ FILE
                ----------------------------------------------------- */

                const reader =
                    new FileReader();


                reader.onload =
                    function(event) {


                        const container =
                            document.getElementById(
                                targetId
                            );


                        if (!container) {

                            return;

                        }


                        /*
                         * Remove old preview
                         */

                        const oldImage =
                            container.querySelector(
                                ".signature-image-preview"
                            );


                        if (oldImage) {

                            oldImage.remove();

                        }


                        /*
                         * Create new image
                         */

                        const image =
                            document.createElement(
                                "img"
                            );


                        image.src =
                            event.target.result;


                        image.className =
                            "signature-image signature-image-preview";


                        image.alt =
                            "Signature Preview";


                        container.appendChild(
                            image
                        );

                    };


                reader.readAsDataURL(file);

            }

    </script>


</body>

</html>