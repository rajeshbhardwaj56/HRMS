        /* =========================================================
           REMOVE ROW
        ========================================================= */

        function removeRow(button) {

            const card = button.closest(".dynamic-card");

            if (!card) {
                return;
            }

            const container = card.parentElement;

            const rows =
                container.querySelectorAll(".dynamic-card");

            if (rows.length <= 1) {

                card.querySelectorAll(
                    "input:not([type='hidden']), textarea"
                ).forEach(function(input) {

                    input.value = "";

                });

                card.querySelectorAll(
                    "select"
                ).forEach(function(select) {

                    select.selectedIndex = 0;

                });

                return;
            }

            card.remove();

            reindexDynamicRows();
        }


        /* =========================================================
           REINDEX DYNAMIC LISTS
           IMPORTANT FOR ASP.NET CORE MODEL BINDING
        ========================================================= */

        function reindexDynamicRows() {

            reindexFamily();

            reindexEducation();

            reindexEmployment();
        }


        function reindexFamily() {

            const rows =
                document.querySelectorAll(
                    "#familyContainer .family-row"
                );

            rows.forEach(function(row, index) {

                const title =
                    row.querySelector(".dynamic-card-title");

                if (title) {
                    title.textContent =
                        "Family Member " + (index + 1);
                }

                row.querySelectorAll("[name]").forEach(function(element) {

                    element.name =
                        element.name.replace(
                            /FamilyList\[\d+\]/,
                            "FamilyList[" + index + "]"
                        );

                });

            });

            familyIndex = rows.length;
        }


        function reindexEducation() {

            const rows =
                document.querySelectorAll(
                    "#educationContainer .education-row"
                );

            rows.forEach(function(row, index) {

                const title =
                    row.querySelector(".dynamic-card-title");

                if (title) {
                    title.textContent =
                        "Education " + (index + 1);
                }

                row.querySelectorAll("[name]").forEach(function(element) {

                    element.name =
                        element.name.replace(
                            /EducationList\[\d+\]/,
                            "EducationList[" + index + "]"
                        );

                });

            });

            educationIndex = rows.length;
        }


        function reindexEmployment() {

            const rows =
                document.querySelectorAll(
                    "#employmentContainer .employment-row"
                );

            rows.forEach(function(row, index) {

                const title =
                    row.querySelector(".dynamic-card-title");

                if (title) {
                    title.textContent =
                        "Employment " + (index + 1);
                }

                row.querySelectorAll("[name]").forEach(function(element) {

                    element.name =
                        element.name.replace(
                            /EmploymentList\[\d+\]/,
                            "EmploymentList[" + index + "]"
                        );

                });

            });

            employmentIndex = rows.length;
        }


        /* =========================================================
           FILE VALIDATION
        ========================================================= */

        function validateFile(input, required) {

            if (!input.files || input.files.length === 0) {

                if (required) {

                    return {
                        valid: false,
                        message: "Employee photo is required."
                    };

                }

                return {
                    valid: true
                };
            }

            const file = input.files[0];

            const allowedTypes = [
                "image/jpeg",
                "image/jpg",
                "image/png"
            ];

            if (!allowedTypes.includes(file.type)) {

                return {
                    valid: false,
                    message: "Only JPG and PNG images are allowed."
                };
            }

            if (file.size > 2 * 1024 * 1024) {

                return {
                    valid: false,
                    message: "Image size must not exceed 2 MB."
                };
            }

            return {
                valid: true
            };
        }


        /* =========================================================
           FORM VALIDATION
        ========================================================= */

        function validateForm(isSubmit) {

            const form =
                document.getElementById(
                    "employeeOnboardingForm"
                );

            if (!form.checkValidity()) {

                form.classList.add("was-validated");

                const firstInvalid =
                    form.querySelector(":invalid");

                if (firstInvalid) {

                    firstInvalid.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    firstInvalid.focus();
                }

                return false;
            }


            const photo =
                document.getElementById(
                    "EmployeePhotoFile"
                );

            const photoResult =
                validateFile(
                    photo,
                    photo.hasAttribute("required")
                );

            if (!photoResult.valid) {

                showMessage(
                    photoResult.message,
                    "danger"
                );

                photo.focus();

                return false;
            }


            const signature =
                document.getElementById(
                    "EmployeeSignature"
                );

            if (signature.files.length > 0) {

                const signatureResult =
                    validateFile(
                        signature,
                        false
                    );

                if (!signatureResult.valid) {

                    showMessage(
                        signatureResult.message,
                        "danger"
                    );

                    signature.focus();

                    return false;
                }
            }


            if (isSubmit) {

                const declaration =
                    document.getElementById(
                        "declarationAccepted"
                    );

                if (!declaration.checked) {

                    showMessage(
                        "Please accept the declaration before submitting.",
                        "danger"
                    );

                    declaration.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return false;
                }

            }

            return true;
        }


        /* =========================================================
           SAVE FORM
        ========================================================= */

        function saveForm(isSubmit) {

            if (!validateForm(isSubmit)) {
                return;
            }

            const form =
                document.getElementById(
                    "employeeOnboardingForm"
                );

            const formData =
                new FormData(form);

            /*
             * Add explicit submission status.
             *
             * Your controller can receive:
             *
             * IsSubmit = true / false
             *
             */

            formData.set(
                "IsSubmit",
                isSubmit ? "true" : "false"
            );


            const btnSave =
                document.getElementById(
                    "btnSaveLater"
                );

            const btnSubmit =
                document.getElementById(
                    "btnSubmit"
                );


            btnSave.disabled = true;

            btnSubmit.disabled = true;


            const originalSaveText =
                btnSave.innerHTML;

            const originalSubmitText =
                btnSubmit.innerHTML;


            if (isSubmit) {

                btnSubmit.innerHTML =
                    "Saving...";

            }
            else {

                btnSave.innerHTML =
                    "Saving...";

            }


            /*
             * IMPORTANT:
             *
             * Change this URL if your POST action has
             * a different route.
             *
             */

            fetch(
                '@Url.Action("SaveEmployeeDetailsOnboarding", "EmployeeOnboarding")',
                {
                    method: "POST",
                    body: formData
                }
            )
                .then(function(response) {

                    if (!response.ok) {

                        throw new Error(
                            "Server returned HTTP " +
                            response.status
                        );
                    }

                    return response.json();

                })
                .then(function(result) {

                    if (result.success) {

                        showMessage(
                            result.message ||
                            (
                                isSubmit
                                    ? "Employee onboarding submitted successfully."
                                    : "Employee onboarding saved successfully."
                            ),
                            "success"
                        );


                        /*
                         * Update IDs if the server creates them
                         * during the first save.
                         */

                        if (result.onboardingID) {

                            document.getElementById(
                                "OnboardingID"
                            ).value =
                                result.onboardingID;
                        }


                        if (result.employeeDetailsOnboardingID) {

                            document.getElementById(
                                "EmployeeDetailsOnboardingID"
                            ).value =
                                result.employeeDetailsOnboardingID;
                        }


                        /*
                         * If submit is completed and the server
                         * provides next URL, navigate to next form.
                         */

                        if (isSubmit && result.redirectUrl) {

                            setTimeout(function() {

                                window.location.href =
                                    result.redirectUrl;

                            }, 1000);

                        }

                    }
                    else {

                        showMessage(
                            result.message ||
                            "Unable to save employee onboarding.",
                            "danger"
                        );

                    }

                })
                .catch(function(error) {

                    console.error(error);

                    showMessage(
                        "An error occurred while saving the form. Please try again.",
                        "danger"
                    );

                })
                .finally(function() {

                    btnSave.disabled = false;

                    btnSubmit.disabled = false;

                    btnSave.innerHTML =
                        originalSaveText;

                    btnSubmit.innerHTML =
                        originalSubmitText;

                });
        }


        /* =========================================================
           MESSAGE
        ========================================================= */

        function showMessage(message, type) {

            const messageBox =
                document.getElementById(
                    "formMessage"
                );

            messageBox.className =
                "alert alert-" + type;

            messageBox.innerHTML =
                message;

            messageBox.style.display =
                "block";


            messageBox.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });


            if (type === "success") {

                setTimeout(function() {

                    messageBox.style.display =
                        "none";

                }, 5000);
            }
        }


        /* =========================================================
           NUMERIC INPUT RESTRICTION
        ========================================================= */

        document.addEventListener(
            "input",
            function(event) {

                const element =
                    event.target;

                if (
                    element.name ===
                    "EmergencyContactMobile" ||

                    element.name ===
                    "Reference1Mobile" ||

                    element.name ===
                    "Reference2Mobile" ||

                    element.name ===
                    "PermanentPINCode" ||

                    element.name ===
                    "PresentPINCode"
                ) {

                    element.value =
                        element.value
                            .replace(/\D/g, "");

                }

            }
        );


        /* =========================================================
           INITIALIZATION
        ========================================================= */

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                reindexDynamicRows();

            }
        );

</script>

