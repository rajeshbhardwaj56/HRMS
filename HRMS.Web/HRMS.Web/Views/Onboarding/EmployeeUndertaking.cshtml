    </button>


    <button type="button"
            id="btnSubmit"
            class="btn-primary-custom"
            onclick="saveForm(true)">

        Save & Submit

    </button>

</div>

</form>

</div>

</div>

</div>


<script>

        /* =========================================================
           GLOBAL COUNTERS
        ========================================================= */

        let familyIndex =
