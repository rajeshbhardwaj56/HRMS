@using HRMS.Models.EmployeeOnboarding
@model EmployeeOnboardingPageViewModel

@{
    Layout = null;

    var employee = Model.EmployeeDetails
                   ?? new EmployeeDetailsOnboardingModel();

    var familyList = Model.FamilyList
                     ?? new List<EmployeeOnboardingFamilyModel>();

    var educationList = Model.EducationList
                        ?? new List<EmployeeOnboardingEducationModel>();

    var employmentList = Model.EmploymentList
                         ?? new List<EmployeeOnboardingEmploymentModel>();

    var profilePhoto = !string.IsNullOrEmpty(employee.EmployeePhoto)
        ? employee.EmployeePhoto
        : HRMS.Models.Common.Constants.NoImagePath;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Employee Onboarding</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                background: #f4f7fb;
                font-family: Arial, Helvetica, sans-serif;
                color: #263238;
            }

            .onboarding-wrapper {
                width: 100%;
                padding: 30px 15px 50px;
            }

            .onboarding-container {
                max-width: 1500px;
                margin: 0 auto;
                background: #ffffff;
                border-radius: 14px;
                box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
                overflow: hidden;
            }

            /* =====================================================
                       PROGRESS
                    ====================================================== */

            .progress-container {
                width: 100%;
                padding: 25px 25px 15px;
                background: #ffffff;
                border-bottom: 1px solid #e9edf3;
                overflow-x: auto;
            }

            .progress-steps {
                min-width: 950px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                position: relative;
            }

            .progress-line {
                position: absolute;
                top: 20px;
                left: 5%;
                right: 5%;
                height: 3px;
                background: #05397b;
                z-index: 1;
            }

            .step {
                position: relative;
                z-index: 2;
                width: 12.5%;
                text-align: center;
            }

            .step-circle {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                margin: 0 auto 8px;
                display: flex;
                justify-content: center;
                align-items: center;
                background: #e9ecef;
                color: #6c757d;
                font-weight: 700;
                border: 3px solid #ffffff;
                box-shadow: 0 0 0 1px #dee2e6;
            }

            .step.active .step-circle {
                background: #05397b;
                color: #ffffff;
                box-shadow: 0 0 0 1px #05397b;
            }

            .step-label {
                font-size: 11px;
                line-height: 1.3;
                color: #555;
                font-weight: 600;
                padding: 0 5px;
            }

            .step.active .step-label {
                color: #05397b;
            }

            /* =====================================================
                       FORM CONTENT
                    ====================================================== */

            .form-content {
                padding: 35px 40px 45px;
            }

            .form-title {
                margin: 0;
                font-size: 28px;
                font-weight: 700;
                color: #172b4d;
            }

            .form-subtitle {
                margin: 8px 0 18px;
                color: #6c757d;
                font-size: 14px;
            }

            .required {
                color: #dc3545;
                font-weight: bold;
            }

            .info-box {
                padding: 14px 18px;
                background: #eef6ff;
                border: 1px solid #cfe2ff;
                border-radius: 8px;
                color: #084298;
                font-size: 13px;
                margin-bottom: 25px;
            }

            /* =====================================================
                       SECTION
                    ====================================================== */

            .section-title {
                margin-top: 30px;
                margin-bottom: 18px;
                padding: 12px 15px;
                border-left: 4px solid #05397b;
                background: #f7f9fc;
                color: #172b4d;
                font-size: 17px;
                font-weight: 700;
                border-radius: 5px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            .form-label {
                display: block;
                margin-bottom: 7px;
                font-size: 13px;
                font-weight: 600;
                color: #394867;
            }

            .form-control,
            .form-select {
                min-height: 42px;
                border-radius: 6px;
                border: 1px solid #d6dce5;
                font-size: 13px;
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #05397b;
                    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, .12);
                }

            textarea.form-control {
                min-height: 90px;
                resize: vertical;
            }

            .readonly-field {
                background: #f1f3f5 !important;
                cursor: not-allowed;
            }

            /* =====================================================
                       PHOTO
                    ====================================================== */

            .photo-preview {
                width: 95px;
                height: 110px;
                object-fit: cover;
                border-radius: 8px;
                border: 1px solid #d8dee8;
                background: #f8f9fa;
            }

            .photo-upload-container {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            /* =====================================================
                       DYNAMIC CARD
                    ====================================================== */

            .dynamic-card {
                background: #ffffff;
                border: 1px solid #dee2e6;
                border-radius: 10px;
                padding: 20px;
                margin-bottom: 18px;
                box-shadow: 0 2px 7px rgba(0, 0, 0, .03);
            }

            .dynamic-card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 18px;
                padding-bottom: 10px;
                border-bottom: 1px solid #edf0f3;
            }

            .dynamic-card-title {
                font-weight: 700;
                color: #172b4d;
                font-size: 14px;
            }

            .btn-add {
                border: 0;
                background: #e7f1ff;
                color: #05397b;
                font-size: 12px;
                font-weight: 600;
                padding: 7px 13px;
                border-radius: 6px;
            }

                .btn-add:hover {
                    background: #d7e8ff;
                }

            .btn-remove {
                border: 0;
                background: #fff0f0;
                color: #dc3545;
                font-size: 12px;
                padding: 6px 12px;
                border-radius: 5px;
            }

                .btn-remove:hover {
                    background: #ffe0e0;
                }

            /* =====================================================
                       DOCUMENT
                    ====================================================== */

            .document-card {
                border: 1px solid #e0e5eb;
                padding: 15px;
                border-radius: 8px;
                background: #fafbfd;
            }

            /* =====================================================
                       DECLARATION
                    ====================================================== */

            .declaration-box {
                padding: 20px;
                border: 1px solid #dce3eb;
                border-radius: 10px;
                background: #fafbfd;
            }

            /* =====================================================
                       FOOTER
                    ====================================================== */

            .form-footer {
                margin-top: 35px;
                padding-top: 25px;
                border-top: 1px solid #e8ecf1;
                display: flex;
                justify-content: flex-end;
                gap: 12px;
            }

            .btn-primary-custom,
            .btn-secondary-custom {
                border: 0;
                min-width: 180px;
                padding: 11px 20px;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

            .btn-primary-custom {
                background: #05397b;
                color: #ffffff;
            }

                .btn-primary-custom:hover {
                    background: #0b5ed7;
                }

            .btn-secondary-custom {
                background: #6c757d;
                color: #ffffff;
            }

                .btn-secondary-custom:hover {
                    background: #5c636a;
                }

                .btn-primary-custom:disabled,
                .btn-secondary-custom:disabled {
                    opacity: .65;
                    cursor: not-allowed;
                }

            /* =====================================================
                       ALERT
                    ====================================================== */

            #formMessage {
                display: none;
                margin-bottom: 20px;
            }

            /* =====================================================
                       RESPONSIVE
                    ====================================================== */

            @@media (max-width: 768px) {

                .onboarding-wrapper {
                    padding: 0;
                }

                .onboarding-container {
                    border-radius: 0;
                }

                .form-content {
                    padding: 25px 18px;
                }

                .form-title {
                    font-size: 22px;
                }

                .photo-upload-container {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .form-footer {
                    flex-direction: column;
                }

                .btn-primary-custom,
                .btn-secondary-custom {
                    width: 100%;
                }
            }

    </style>

</head>

<body>

    <div class="onboarding-wrapper">

        <div class="onboarding-container">

            <!-- =====================================================
             PROGRESS
        ====================================================== -->

            <div class="progress-container">

                <div class="progress-steps">

                    <div class="progress-line"></div>

                    <div class="step active">
                        <div class="step-circle">1</div>
                        <div class="step-label">Personal</div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">2</div>
                        <div class="step-label">
                            Employee Undertaking
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">3</div>
                        <div class="step-label">
                            Non-Disclosure Agreement
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">4</div>
                        <div class="step-label">
                            IT Compliance Agreement
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">5</div>
                        <div class="step-label">
                            Employee Background Verification
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">6</div>
                        <div class="step-label">
                            Nomination
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">7</div>
                        <div class="step-label">
                            Form 2 Revised
                        </div>
                    </div>

                    <div class="step active">
                        <div class="step-circle">8</div>
                        <div class="step-label">
                            Declaration Form
                        </div>
                    </div>

                </div>

            </div>


            <!-- =====================================================
             FORM CONTENT
        ====================================================== -->

            <div class="form-content">

                <h1 class="form-title">
                    Employee Onboarding Form
                </h1>

                <p class="form-subtitle">
                    Please provide your complete employment and personal
                    information. Fields marked with
                    <span class="required">*</span>
                    are mandatory.
                </p>

                <div class="info-box">

                    Please ensure that all information provided is correct.
                    You can save the form and continue later.

                </div>

                <div id="formMessage"></div>


                <!-- =================================================
                 FORM
            ================================================== -->

                <form id="employeeOnboardingForm"
                      method="post"
                      enctype="multipart/form-data"
                      novalidate>

                    <input type="hidden"
                           id="OnboardingID"
                           name="OnboardingID"
                           value="@Model.OnboardingID" />

                    <input type="hidden"
                           id="EmployeeDetailsOnboardingID"
                           name="EmployeeDetailsOnboardingID"
                           value="@employee.EmployeeDetailsOnboardingID" />

                    <input type="hidden"
                           name="Key"
                           value="@Model.Key" />


                    <!-- =================================================
                     EMPLOYMENT DETAILS
                ================================================== -->

                    <div class="section-title">
                        Employment Details
                    </div>

                    <div class="row">

                        <div class="col-md-3">

                            <div class="form-group">

                                <label class="form-label">
                                    Date of Joining
                                </label>

                                <input type="date"
                                       class="form-control"
                                       name="DateOfJoining"
                                       value="@(employee.DateOfJoining.HasValue
                                                                       ? employee.DateOfJoining.Value.ToString("yyyy-MM-dd")
                                                                   : DateTime.Today.ToString("yyyy-MM-dd"))" />

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-group">

                                <label class="form-label">
                                    Designation
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="Designation"
                                       value="@employee.Designation" />

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-group">

                                <label class="form-label">
                                    Employee Code
                                </label>

                                <input type="text"
                                       class="form-control readonly-field"
                                       value="@employee.EmployeeCode"
                                       readonly />

                            </div>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">

                                Employee Photo

                                <span class="required">*</span>

                            </label>

                            <div class="photo-upload-container">

                                <img id="employeePhotoPreview"
                                     src="@profilePhoto"
                                     class="photo-preview"
                                     alt="Employee Photo"
                                     onerror="this.onerror=null;this.src='@HRMS.Models.Common.Constants.NoImagePath'" />

                                <div style="flex:1;">

                                    <input type="file"
                                           class="form-control"
                                           id="EmployeePhotoFile"
                                           name="EmployeePhotoFile"
                                           accept="image/jpeg,image/png,image/jpg"
                                           onchange="showPreview(event)"
                                    @(string.IsNullOrEmpty(employee.EmployeePhoto)
                                        ? "required"
                                        : "") />

                                    <small class="text-muted">

                                        JPG or PNG only.
                                        Maximum size: 2 MB.

                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                     PERSONAL DETAILS
                ================================================== -->

                    <div class="section-title">
                        Personal Details
                    </div>

                    <div class="row">

                        <div class="col-md-4">

                            <label class="form-label">
                                Employee Name
                            </label>

                            <input type="text"
                                   class="form-control readonly-field"
                                   value="@employee.FullName"
                                   readonly />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">

                                Father's / Husband's Name

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FatherHusbandName"
                                   value="@employee.FatherHusbandName"
                                   required />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">

                                Date of Birth

                                <span class="required">*</span>

                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="DateOfBirth"
                                   value="@(employee.DateOfBirth.HasValue
                                                               ? employee.DateOfBirth.Value.ToString("yyyy-MM-dd")
                                                           : "")"
                                   required />

                        </div>

                    </div>


                    <div class="row mt-3">

                        <div class="col-md-4">

                            <label class="form-label">

                                Gender

                                <span class="required">*</span>

                            </label>

                            <select class="form-select"
                                    name="Gender"
                                    required>

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="Male"
                                        selected="@(employee.Gender == "Male")">
                                    Male
                                </option>

                                <option value="Female"
                                        selected="@(employee.Gender == "Female")">
                                    Female
                                </option>

                                <option value="Other"
                                        selected="@(employee.Gender == "Other")">
                                    Other
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Marital Status
                            </label>

                            <select class="form-select"
                                    name="MaritalStatus">

                                <option value="">
                                    Select Status
                                </option>

                                <option value="Married"
                                        selected="@(employee.MaritalStatus == "Married")">
                                    Married
                                </option>

                                <option value="Unmarried"
                                        selected="@(employee.MaritalStatus == "Unmarried")">
                                    Unmarried
                                </option>

                                <option value="Divorced"
                                        selected="@(employee.MaritalStatus == "Divorced")">
                                    Divorced
                                </option>

                                <option value="Widowed"
                                        selected="@(employee.MaritalStatus == "Widowed")">
                                    Widowed
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Blood Group
                            </label>

                            <select class="form-select"
                                    name="BloodGroup">

                                <option value="">
                                    Select Blood Group
                                </option>

                                @foreach (var bloodGroup in new[]
                                {
                                "A+", "A-", "B+", "B-",
                                "O+", "O-", "AB+", "AB-"
                            })
                                {
                                    <option value="@bloodGroup"
                                            selected="@(employee.BloodGroup == bloodGroup)">
                                        @bloodGroup
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <!-- =================================================
                     PERMANENT ADDRESS
                ================================================== -->

                    <div class="section-title">
                        Permanent Address
                    </div>

                    <div class="form-group">

                        <label class="form-label">

                            Address

                            <span class="required">*</span>

                        </label>

                        <textarea class="form-control"
                                  name="PermanentAddress"
                                  required>@employee.PermanentAddress</textarea>

                    </div>


                    <div class="row">

                        <div class="col-md-4">

                            <label class="form-label">
                                City
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="PermanentCity"
                                   value="@employee.PermanentCity" />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                State
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="PermanentState"
                                   value="@employee.PermanentState" />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                PIN Code
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="PermanentPINCode"
                                   value="@employee.PermanentPINCode"
                                   maxlength="6"
                                   inputmode="numeric" />

                        </div>

                    </div>


                    <!-- =================================================
                     PRESENT ADDRESS
                ================================================== -->

                    <div class="section-title">

                        Present Address

                        <div class="form-check float-end"
                             style="font-size:12px;">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="sameAddress" />

                            <label class="form-check-label"
                                   for="sameAddress">

                                Same as permanent address

                            </label>

                        </div>

                    </div>


                    <div class="form-group">

                        <label class="form-label">
                            Address
                        </label>

                        <textarea class="form-control"
                                  id="PresentAddress"
                                  name="PresentAddress">@employee.PresentAddress</textarea>

                    </div>


                    <div class="row">

                        <div class="col-md-4">

                            <label class="form-label">
                                City
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="PresentCity"
                                   name="PresentCity"
                                   value="@employee.PresentCity" />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                State
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="PresentState"
                                   name="PresentState"
                                   value="@employee.PresentState" />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                PIN Code
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="PresentPINCode"
                                   name="PresentPINCode"
                                   value="@employee.PresentPINCode"
                                   maxlength="6"
                                   inputmode="numeric" />

                        </div>

                    </div>


                    <!-- =================================================
                     CONTACT
                ================================================== -->

                    <div class="section-title">
                        Contact Information
                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <label class="form-label">
                                Mobile Number
                            </label>

                            <input type="text"
                                   class="form-control readonly-field"
                                   value="@employee.Mobile"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   class="form-control readonly-field"
                                   value="@employee.Email"
                                   readonly />

                        </div>

                    </div>


                    <div class="row mt-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Landline Number
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="LandlineNo"
                                   value="@employee.LandlineNo" />

                        </div>

                    </div>


                    <!-- =================================================
                     EMERGENCY CONTACT
                ================================================== -->

                    <div class="section-title">
                        Emergency Contact Details
                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <label class="form-label">

                                Contact Name

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="EmergencyContactName"
                                   value="@employee.EmergencyContactName"
                                   required />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">

                                Relation

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="EmergencyContactRelation"
                                   value="@employee.EmergencyContactRelation"
                                   required />

                        </div>

                    </div>


                    <div class="row mt-3">

                        <div class="col-md-4">

                            <label class="form-label">

                                Mobile Number

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="EmergencyContactMobile"
                                   value="@employee.EmergencyContactMobile"
                                   maxlength="10"
                                   inputmode="numeric"
                                   required />

                        </div>


                        <div class="col-md-8">

                            <label class="form-label">
                                Address
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="EmergencyContactAddress"
                                   value="@employee.EmergencyContactAddress" />

                        </div>

                    </div>


                    <div class="row mt-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                City
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="EmergencyContactCity"
                                   value="@employee.EmergencyContactCity" />

                        </div>

                    </div>


                    <!-- =================================================
                     SOURCE OF HIRING
                ================================================== -->

                    <div class="section-title">
                        Source of Hiring
                    </div>

                    <div class="row">

                        <div class="col-md-12">

                            @foreach (var source in new[]
                            {
                            "Placement Consultant",
                            "Employee Reference",
                            "Office Walk-in",
                            "Employment Exchange"
                        })
                            {
                                var radioId = "source_" +
                                              source.Replace(" ", "")
                                                    .Replace("-", "");

                                <div class="form-check form-check-inline">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="SourceOfHiring"
                                           id="@radioId"
                                           value="@source"
                                           checked="@(employee.SourceOfHiring == source)" />

                                    <label class="form-check-label"
                                           for="@radioId">

                                        @source

                                    </label>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                     REFERENCES
                ================================================== -->

                    <div class="section-title">
                        References
                    </div>


                    <h6>
                        Reference 1
                    </h6>

                    <div class="row">

                        <div class="col-md-4">

                            <label class="form-label">
                                Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="Reference1Name"
                                   value="@employee.Reference1Name" />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Designation
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="Reference1Designation"
                                   value="@employee.Reference1Designation" />

                        </div>


                        <div class="col-md-4">

