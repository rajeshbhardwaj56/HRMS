                        ).value;

                    document.getElementById("PresentCity").value =
                        document.querySelector(
                            '[name="PermanentCity"]'
                        ).value;

                    document.getElementById("PresentState").value =
                        document.querySelector(
                            '[name="PermanentState"]'
                        ).value;

                    document.getElementById("PresentPINCode").value =
                        document.querySelector(
                            '[name="PermanentPINCode"]'
                        ).value;

                }

            });


        /* =========================================================
