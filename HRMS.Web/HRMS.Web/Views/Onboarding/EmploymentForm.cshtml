    <!-- =====================================================
         INTERVIEWER COMMENTS
         ===================================================== -->

    <div class="form-section">

        <div class="section-subtitle">
            Interviewer Comments
        </div>

        <div class="row">


            <!-- =================================================
                 HR
                 ================================================= -->

            <div class="col-md-4 mb-4">

                <div class="comment-card">

                    <label class="form-label">
                        Comments by Interviewer(s) - HR
                    </label>

                    <textarea class="form-control"
                              name="InterviewEvaluationList[0].HRComments"
                              rows="6"
                              placeholder="Enter HR comments">@interviewEvaluation.HRComments</textarea>


                    <div class="mt-3">

                        <label class="form-label">
                            HR Interviewer Name
                        </label>

<input type="text"
       name="InterviewEvaluationList[0].HRInterviewerName"
       value="@interviewEvaluation.HRInterviewerName"
       class="form-control" />

                    </div>


                    <div class="mt-3">

                        <label class="form-label">
                            HR Interviewer Signature
                        </label>

                        <input type="file"
                               class="form-control"
                               name="HRInterviewerSignatureFile"
                               accept=".pdf,.jpg,.jpeg,.png" />

                        @if (hrInterviewerSignature != null &&
                             !string.IsNullOrWhiteSpace(hrInterviewerSignature.FilePath))
                        {
                            <div class="mt-2">

                                <a href="@hrInterviewerSignature.FilePath"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">
                                    View Existing Signature
                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- =================================================
                 OPERATIONS
                 ================================================= -->

