<script>

document.addEventListener("DOMContentLoaded", function () {

    // =========================================================
    // HR APPROVE & COMPLETE
    // =========================================================

    const approveButton =
        document.getElementById("btnHRApprove");

    if (approveButton) {

        approveButton.addEventListener("click", async function () {

            const reviewConfirmation =
                document.getElementById("HRReviewConfirmation");

            const documentConfirmation =
                document.getElementById("HRDocumentConfirmation");

            const comments =
                document.getElementById("HRApprovalComments");


            // =====================================================
            // 1. CHECK HR REVIEW CONFIRMATION
            // =====================================================

            if (!reviewConfirmation ||
                !reviewConfirmation.checked) {

                alert(
                    "Please confirm that you have reviewed the employee information."
                );

                return;
            }


            // =====================================================
            // 2. CHECK DOCUMENT CONFIRMATION
            // =====================================================

            if (!documentConfirmation ||
                !documentConfirmation.checked) {

                alert(
                    "Please confirm that you have verified the submitted documents."
                );

                return;
            }


            // =====================================================
            // 3. REQUIRED DOCUMENT VERIFICATION
            //
            // Identity Proof
            // Address Proof
            // Date of Birth Proof
            // Educational Proof
            // Passport Photo
            // Letter of Intent
            // Resume
            // =====================================================

            const requiredDocuments = [
                {
                    value: "IdentityProof",
                    name: "Identity Proof"
                },
                {
                    value: "AddressProof",
                    name: "Address Proof"
                },
                {
                    value: "DOBProof",
                    name: "Date of Birth Proof"
                },
                {
                    value: "EducationalProof",
                    name: "Educational Proof"
                },
                {
                    value: "PassportPhoto",
                    name: "Passport Photo"
                },
                {
                    value: "LetterOfIntent",
                    name: "Letter of Intent"
                },
                {
                    value: "Resume",
                    name: "Resume"
                }
            ];


            // =====================================================
            // 4. FIND UNVERIFIED DOCUMENTS
            // =====================================================

            const missingDocuments = [];

            requiredDocuments.forEach(function (documentItem) {

                const checkbox =
                    document.querySelector(
                        'input.hr-document-check[value="' +
                        documentItem.value +
                        '"]'
                    );

                if (!checkbox ||
                    !checkbox.checked) {

                    missingDocuments.push(
                        documentItem.name
                    );
                }

            });


            // =====================================================
            // 5. STOP IF DOCUMENTS ARE NOT VERIFIED
            // =====================================================

            if (missingDocuments.length > 0) {

                alert(
                    "Please verify the following documents before approving:\n\n" +
                    missingDocuments.join("\n")
                );

                return;
            }


            // =====================================================
            // 6. GET ONBOARDING ID
            // =====================================================

            const onboardingElement =
                document.getElementById("OnboardingID");

            if (!onboardingElement ||
                !onboardingElement.value) {

                alert(
                    "Onboarding ID is missing."
                );

                return;
            }


            const onboardingID =
                parseInt(onboardingElement.value);


            if (!onboardingID ||
                onboardingID <= 0) {

                alert(
                    "Invalid onboarding record."
                );

                return;
            }


            // =====================================================
            // 7. CLEAN COMMENTS
            // =====================================================

            const approvalComments =
                comments
                    ? comments.value.trim()
                    : "";


            // =====================================================
            // 8. FINAL CONFIRMATION
            // =====================================================

            const confirmed =
                confirm(
                    "Are you sure you want to approve and complete this employee onboarding?\n\n" +
                    "After confirmation, all onboarding data will be synchronized " +
                    "and the employee record will be created."
                );


            // User clicked Cancel
            if (!confirmed) {

                return;
            }


            // =====================================================
            // 9. DISABLE APPROVE BUTTON
            // =====================================================

            approveButton.disabled = true;

            const originalText =
                approveButton.innerHTML;

            approveButton.innerHTML =
                '<i class="fas fa-spinner fa-spin me-1"></i> Processing...';


            try {

                // =================================================
                // 10. CALL MVC CONTROLLER
                // =================================================

                const response =
                    await fetch(
                        '@Url.Action("CompleteEmployeeOnboarding", "Onboarding")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify({
                                OnboardingID: onboardingID,
                                ApprovalComments: approvalComments
                            })
                        }
                    );


                // =================================================
                // 11. READ RESPONSE
                // =================================================

                const result =
                    await response.json();


                // =================================================
                // 12. HANDLE FAILURE
                // =================================================

                if (!response.ok ||
                    !result.success) {

                    alert(
                        result.message ||
                        "Unable to complete employee onboarding."
                    );

                    return;
                }


                // =================================================
                // 13. SUCCESS
                // =================================================

                alert(
                    result.message ||
                    "Employee onboarding completed successfully."
                );


                // =================================================
                // 14. REDIRECT
                // =================================================

                window.location.href =
                    '@Url.Action("Index", "Onboarding")';

            }
            catch (error) {

                console.error(
                    "CompleteEmployeeOnboarding error:",
                    error
                );

                alert(
                    "An error occurred while completing employee onboarding."
                );

            }
            finally {

                approveButton.disabled = false;

                approveButton.innerHTML =
                    originalText;
            }

        });

    }


    // =========================================================
    // HR REJECT
    // =========================================================

    const rejectButton =
        document.getElementById("btnHRReject");

    if (rejectButton) {

        rejectButton.addEventListener("click", function () {

            const comments =
                document.getElementById("HRApprovalComments");


            // =====================================================
            // REQUIRED REJECTION COMMENT
            // =====================================================

            if (!comments ||
                comments.value.trim() === "") {

                alert(
                    "Please enter HR comments/reason for rejection."
                );

                if (comments) {
                    comments.focus();
                }

                return;
            }


            // =====================================================
            // SET REJECTED STATUS
            // =====================================================

            const approvalStatus =
                document.getElementById("HRApprovalStatus");

            if (approvalStatus) {

                approvalStatus.value =
                    "Rejected";
            }


            // =====================================================
            // SAVE REJECTION
            // =====================================================

            submitOnboardingForm();

        });

    }

});

</script>


</body>

</html>

