            }

            .footer-left button,
            .footer-right button {
                flex: 1;
            }
        }
        /* =========================================================
             LOCKED FUTURE STEPS
               ========================================================= */

            .step.locked {
                cursor: not-allowed !important;
                opacity: 0.55;
            }

            .step.locked .step-circle {
                background: #f3f5f7;
                border-color: #d8dee7;
                color: #9aa3ad;
            }

            .step.locked:hover .step-circle {
                background: #f3f5f7;
                border-color: #d8dee7;
                color: #9aa3ad;
                transform: none;
                box-shadow: none;
            }
              /* ---------------------------------------------------------
       SECTION TITLE
    --------------------------------------------------------- */

    #step-7 .section-title {

        margin-top: 25px;
        margin-bottom: 18px;
        padding: 10px 15px;

        font-size: 17px;
        font-weight: 600;

        border-left: 4px solid #034aa1;

        background: #f5f7fa;
        color: #222;

    }


    /* ---------------------------------------------------------
       RATING INSTRUCTION
    --------------------------------------------------------- */

    #step-7 .rating-instruction {

        margin-bottom: 12px;
        padding: 10px 14px;

        background: #f8f9fa;
        border: 1px solid #dee2e6;

        border-radius: 5px;

        font-size: 13px;
        color: #555;

    }


    /* ---------------------------------------------------------
       RATING TABLE
    --------------------------------------------------------- */

    #step-7 .interview-rating-table {

        margin-bottom: 0;

        vertical-align: middle;

        border-color: #d9dee5;

    }


    #step-7 .interview-rating-table thead th {

        text-align: center;

        vertical-align: middle;

        background: #034aa1;
        color: #fff;

        font-weight: 600;

        padding: 11px;

    }


    #step-7 .interview-rating-table tbody td {

        vertical-align: middle;

        padding: 10px;

    }


    #step-7 .interview-rating-table tbody td:first-child {

        background: #fafbfc;

    }


    #step-7 .rating-select {

        min-width: 150px;

    }


    /* ---------------------------------------------------------
       OVERALL RATING
    --------------------------------------------------------- */

    #step-7 .overall-rating-container {

        display: grid;

        grid-template-columns:
            repeat(5, 1fr);

        gap: 12px;

        margin-top: 5px;

    }


    #step-7 .overall-rating-option {

        position: relative;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        min-height: 100px;

        padding: 12px;

        text-align: center;

        border: 1px solid #d9dee5;

        border-radius: 8px;

        background: #fff;

        cursor: pointer;

        transition: all 0.2s ease;

    }


    #step-7 .overall-rating-option:hover {

        border-color: #034aa1;

        background: #f5f8fc;

    }


    #step-7 .overall-rating-option input {

        margin-bottom: 8px;

        cursor: pointer;

    }


    #step-7 .overall-rating-option input:checked
    + .rating-number {

        background: #034aa1;
        color: #fff;

    }


    #step-7 .rating-number {

        display: flex;

        align-items: center;
        justify-content: center;

        width: 35px;
        height: 35px;

        margin-bottom: 8px;

        border-radius: 50%;

        background: #e9ecef;

        font-weight: 700;

    }


    /* ---------------------------------------------------------
       COMMENT CARD
    --------------------------------------------------------- */

    #step-7 .comment-card {

        height: 100%;

        padding: 15px;

        border: 1px solid #dee2e6;

        border-radius: 7px;

        background: #fff;

    }


    #step-7 .comment-card textarea {

        resize: vertical;

        min-height: 130px;

    }


    /* ---------------------------------------------------------
       SIGNATURE CARD
    --------------------------------------------------------- */

    #step-7 .signature-upload-card {

        height: 100%;

        padding: 15px;

        border: 1px solid #dee2e6;

        border-radius: 8px;

        background: #fff;

    }


    #step-7 .signature-upload-card:hover {

        border-color: #034aa1;

    }


    #step-7 .signature-preview {

        max-width: 220px;

        max-height: 100px;

        object-fit: contain;

        border: 1px solid #dee2e6;

        padding: 5px;

        background: #fff;

    }


    #step-7 .signature-preview-container {

        text-align: center;

    }


    /* ---------------------------------------------------------
       REQUIRED
    --------------------------------------------------------- */

    #step-7 .required {

        color: #dc3545;

        font-weight: 600;

    }


    /* ---------------------------------------------------------
       MOBILE
    --------------------------------------------------------- */

    @@media (max-width: 768px) {

        #step-7 .overall-rating-container {

            grid-template-columns: 1fr;

        }

        #step-7 .interview-rating-table {

            min-width: 750px;

        }

    }
    .onboarding-step {
    display: none;
}

.onboarding-step.active-step {
    display: block;
}

/* =========================================================
   FAMILY-DERIVED READONLY FIELDS
   These values come automatically from Family Details.
========================================================= */

.family-readonly {
    background-color: #f1f3f5 !important;
    color: #6c757d !important;
    border-color: #ced4da !important;
    cursor: not-allowed !important;
    opacity: 0.75;
}

textarea.family-readonly {
    background-color: #f1f3f5 !important;
    color: #6c757d !important;
    border-color: #ced4da !important;
    cursor: not-allowed !important;
    opacity: 0.75;
}

.family-readonly:focus {
    background-color: #f1f3f5 !important;
    color: #6c757d !important;
    border-color: #ced4da !important;
    box-shadow: none !important;
    outline: none !important;
}

.family-readonly::placeholder {
    color: #adb5bd !important;
}

/* Optional visual indication */

.family-readonly-wrapper {
    position: relative;
}

.family-readonly-wrapper::after {
    content: "From Family Details";
    display: block;
    font-size: 10px;
    color: #868e96;
    margin-top: 2px;
}


/* =========================================================
   NORMAL EDITABLE PERCENTAGE FIELD
========================================================= */

.epf-percentage,
.gratuity-percentage {
    background-color: #fff !important;
    color: #212529 !important;
    cursor: text !important;
    opacity: 1 !important;
}


    .declaration-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
        margin-top: 16px;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .declaration-card:hover {
        border-color: #d1d5db;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .declaration-card-header .form-label {
        color: #374151;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }

    .required {
        color: #dc2626;
        margin-left: 3px;
    }

    .radio-group {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .radio-option {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        color: #374151;
        font-size: 14px;
        font-weight: 500;
        user-select: none;
        margin: 0;
    }

    .radio-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .radio-custom {
        width: 18px;
        height: 18px;
        border: 1.5px solid #9ca3af;
        border-radius: 50%;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .radio-option input:checked + .radio-custom {
        border-color: #2563eb;
        background: #2563eb;
        box-shadow: inset 0 0 0 4px #ffffff;
    }

    .radio-option:hover .radio-custom {
        border-color: #2563eb;
    }

    .radio-option input:focus-visible + .radio-custom {
        outline: 3px solid rgba(37, 99, 235, 0.18);
        outline-offset: 2px;
    }

    .radio-text {
        line-height: 18px;
    }

    .conditional-details {
        padding: 18px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .form-label {
        color: #374151;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 7px;
    }

    .form-control {
        min-height: 42px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        color: #374151;
        font-size: 14px;
        padding: 9px 12px;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .form-control::placeholder {
        color: #9ca3af;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    @@media (max-width: 767px) {

        .declaration-card {
            padding: 16px;
        }

        .radio-group {
            gap: 22px;
        }

        .conditional-details {
            padding: 14px;
        }

        .section-title {
            font-size: 18px;
        }

    }
/* ============================================================
   HR / ADMIN READONLY MODE
   Steps other than Interview Evaluation
   ============================================================ */

.hr-admin-readonly input:not([type="hidden"]),
.hr-admin-readonly select,
.hr-admin-readonly textarea {
    background-color: #f8f9fa !important;
    cursor: not-allowed !important;
}

/* Text/date/number/email/etc. */
.hr-admin-readonly input:not([type="hidden"]):not([type="file"]) {
    pointer-events: none;
}

/* Selects */
.hr-admin-readonly select {
    pointer-events: none;
}

/* Textareas */
.hr-admin-readonly textarea {
    pointer-events: none;
}

/* File uploads */
.hr-admin-readonly input[type="file"] {
    pointer-events: none;
    opacity: 0.65;
}

/* Checkboxes / radios */
.hr-admin-readonly input[type="checkbox"],
.hr-admin-readonly input[type="radio"] {
    pointer-events: none;
}

/* Buttons inside readonly sections */
.hr-admin-readonly button:not(.step-navigation-btn),
.hr-admin-readonly .btn:not(.step-navigation-btn) {
    pointer-events: none;
    opacity: 0.65;
}
    </style>

</head>

<body>

<header class="onboarding-header">

    <div class="header-content">

        <img src="~/assets/img/logo/PROTALKLOGO.png"
             class="logo"
             alt="Company Logo" />

        <div class="header-title">
            Employee Onboarding
        </div>

    </div>

</header>


<div class="onboarding-wrapper">

    <div class="onboarding-container">


        <!-- =========================================================
             PROGRESS
        ========================================================== -->

      <div class="progress-container">
    <div class="progress-steps">

        <div class="progress-line"></div>


        <!-- =========================================================
             STEP 1 - EMPLOYEE DETAILS
             ========================================================= -->

        <div class="step @(currentStep == 1 ? "active" : currentStep > 1 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(1)">

            <div class="step-circle">

                @if (currentStep > 1)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>1</span>
                }

            </div>

            <div class="step-label">
                Employee Details
            </div>

        </div>


        <!-- =========================================================
             STEP 2 - FAMILY DETAILS
             ========================================================= -->

        <div class="step @(currentStep == 2 ? "active" : currentStep > 2 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(2)">

            <div class="step-circle">

                @if (currentStep > 2)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>2</span>
                }

            </div>

            <div class="step-label">
                Family Details
            </div>

        </div>


        <!-- =========================================================
             STEP 3 - EDUCATION
             ========================================================= -->

        <div class="step @(currentStep == 3 ? "active" : currentStep > 3 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(3)">

            <div class="step-circle">

                @if (currentStep > 3)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>3</span>
                }

            </div>

            <div class="step-label">
                Education
            </div>

        </div>


        <!-- =========================================================
             STEP 4 - PREVIOUS EMPLOYMENT
             ========================================================= -->

        <div class="step @(currentStep == 4 ? "active" : currentStep > 4 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(4)">

            <div class="step-circle">

                @if (currentStep > 4)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>4</span>
                }

            </div>

            <div class="step-label">
                Previous Employment
            </div>

        </div>


        <!-- =========================================================
             STEP 5 - BANK DETAILS
             ========================================================= -->

        <div class="step @(currentStep == 5 ? "active" : currentStep > 5 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(5)">

            <div class="step-circle">

                @if (currentStep > 5)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>5</span>
                }

            </div>

            <div class="step-label">
                Bank Details
            </div>

        </div>


        <!-- =========================================================
             STEP 6 - NOMINEE
             ========================================================= -->

        <div class="step @(currentStep == 6 ? "active" : currentStep > 6 ? "completed" : "")"
             onclick="openInterviewEvaluationStep(6)">

            <div class="step-circle">

                @if (currentStep > 6)
                {
                    <span>✓</span>
                }
                else
                {
                    <span>6</span>
                }

            </div>

            <div class="step-label">
                Nominee
            </div>

        </div>


        <!-- =========================================================
             STEP 7 - INTERVIEW EVALUATION
             ONLY HR / ADMIN
             ========================================================= -->

        @if (isHROrAdmin)
        {
            <div class="step @(currentStep == 7 ? "active" : currentStep > 7 ? "completed" : "")"
                 onclick="openInterviewEvaluationStep(7)">

                <div class="step-circle">

                    @if (currentStep > 7)
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>7</span>
                    }

                </div>

                <div class="step-label">
                    Interview Evaluation
                </div>

            </div>
        }


        <!-- =========================================================
             OTHER INFORMATION
             
             HR / ADMIN  -> STEP 8
             OTHER USERS -> STEP 7
             ========================================================= -->

        <div class="step @(currentStep == (isHROrAdmin ? 8 : 7) ? "active" : currentStep > (isHROrAdmin ? 8 : 7) ? "completed" : "")"
             onclick="openInterviewEvaluationStep(@(isHROrAdmin ? 8 : 7))">

            <div class="step-circle">

                @if (currentStep > (isHROrAdmin ? 8 : 7))
                {
                    <span>✓</span>
                }
                else
                {
                    <span>@(isHROrAdmin ? 8 : 7)</span>
                }

            </div>

            <div class="step-label">
                Other Information
            </div>

        </div>

    </div>
</div>


        <!-- =========================================================
             FORM
        ========================================================== -->

        <div class="form-content">

            <h1 class="form-title">
                    Employee Onboarding Form
            </h1>

            <p class="form-subtitle">
                    Please provide your complete employment and personal information.
                    Fields marked with <span class="required">*</span> are mandatory.
            </p>

            <div class="info-box">
                    Please ensure that all information provided is correct.
                    You can save the form and continue later.
            </div>


            <form id="employeeOnboardingForm"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>

                <!-- =================================================
                     COMMON HIDDEN VALUES
                ================================================== -->

                <input type="hidden"
                       id="OnboardingID"
                       name="OnboardingID"
                       value="@Model?.OnboardingID" />

@*                 <input type="hidden"
                       id="EmployeeID"
                       name="EmployeeID"
                       value="@Model?.EmployeeID" /> *@

                <input type="hidden"
                       id="Key"
                       name="Key"
                       value="@Model?.Key" />

                <input type="hidden"
                       id="CurrentStep"
                       name="CurrentStep"
                       value="@currentStep" />
                <input type="hidden"
                       id="LastSavedStep"
                       name="LastSavedStep"
                       value="@lastSavedStep" />

                <!-- =================================================
                     STEP 1
                     EMPLOYEE DETAILS
                ================================================== -->

<div id="step-1"
     class="onboarding-step @(currentStep == 1 ? "active-step" : "") @(isHROrAdmin ? "hr-admin-readonly" : "")">

    <!-- =================================================
         EMPLOYMENT DETAILS
    ================================================== -->

    <div class="section-title">
        Employment Details
    </div>

    <div class="row">

        <div class="col-md-3">

            <div class="form-group">

                <label class="form-label">
                    Date of Joining
                </label>

                <input type="date"
                       class="form-control"
                       name="DateOfJoining"
                       value="@(employee?.DateOfJoining.HasValue == true
                                ? employee.DateOfJoining.Value.ToString("yyyy-MM-dd")
                                : DateTime.Today.ToString("yyyy-MM-dd"))" />

            </div>

        </div>


        <div class="col-md-3">

            <div class="form-group">

                <label class="form-label">
                    Designation
                </label>

                <input type="text"
                       class="form-control"
                       name="Designation"
                       value="@employee?.Designation" />

            </div>

        </div>


        @*
        <div class="col-md-3">

            <div class="form-group">

                <label class="form-label">
                    Employee Code
                </label>

                <input type="text"
                       class="form-control readonly-field"
                       value="@employee?.EmployeeCode"
                       readonly />

            </div>

        </div>
        *@


        <div class="col-md-3">

            <label class="form-label">
                Employee Photo
                <span class="required">*</span>
            </label>

            <div class="d-flex align-items-center gap-3">

                <img id="employeePhotoPreview"
                     src="@profilePhoto"
                     class="photo-preview"
                     alt="Employee Photo"
                     onerror="this.onerror=null;this.src='@(HRMS.Models.Common.Constants.NoImagePath)'" />

                <div>

                    <input type="file"
                           class="form-control"
                           id="EmployeePhotoFile"
                           name="EmployeePhotoFile"
                           accept="image/jpeg,image/png,image/jpg"
                           onchange="showPreview(event)"
                           @(string.IsNullOrEmpty(employee?.EmployeePhoto) ? "required" : "") />

                    <small class="text-muted">
                        JPG or PNG only. Maximum size: 2 MB.
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =================================================
         PERSONAL DETAILS
    ================================================== -->

    <div class="section-title">
        Personal Details
    </div>

    <div class="row">

        <div class="col-md-4">

            <div class="form-group">

                <label class="form-label">
                    Employee Name
                </label>

                <input type="text"
                       class="form-control readonly-field"
                       value="@employee?.FullName"
                       readonly />

            </div>

        </div>


        <div class="col-md-4">

            <div class="form-group">

                <label class="form-label">
                    Father's / Husband's Name
                    <span class="required">*</span>
                </label>

                <input type="text"
                       class="form-control"
                       name="FatherHusbandName"
                       value="@employee?.FatherHusbandName"
                       required />

            </div>

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Date of Birth
                <span class="required">*</span>
            </label>

            <input type="date"
                   class="form-control"
                   name="DateOfBirth"
                   value="@(employee?.DateOfBirth.HasValue == true
                            ? employee.DateOfBirth.Value.ToString("yyyy-MM-dd")
                            : "")"
                   required />

        </div>

    </div>


    <div class="row mt-3">

        <div class="col-md-4">

            <label class="form-label">
                Gender
                <span class="required">*</span>
            </label>

            <select class="form-select"
                    name="Gender"
                    required>

                <option value="">
                    Select Gender
                </option>

                @if (employee?.Gender == "Male")
                {
                    <option value="Male" selected>Male</option>
                }
                else
                {
                    <option value="Male">Male</option>
                }

                @if (employee?.Gender == "Female")
                {
                    <option value="Female" selected>Female</option>
                }
                else
                {
                    <option value="Female">Female</option>
                }

                @if (employee?.Gender == "Other")
                {
                    <option value="Other" selected>Other</option>
                }
                else
                {
                    <option value="Other">Other</option>
                }

            </select>

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Marital Status
            </label>

            <select class="form-select"
                    name="MaritalStatus">

                <option value="">
                    Select Status
                </option>

                @if (employee?.MaritalStatus == "Married")
                {
                    <option value="Married" selected>Married</option>
                }
                else
                {
                    <option value="Married">Married</option>
                }

                @if (employee?.MaritalStatus == "Unmarried")
                {
                    <option value="Unmarried" selected>Unmarried</option>
                }
                else
                {
                    <option value="Unmarried">Unmarried</option>
                }

                @if (employee?.MaritalStatus == "Divorced")
                {
                    <option value="Divorced" selected>Divorced</option>
                }
                else
                {
                    <option value="Divorced">Divorced</option>
                }

                @if (employee?.MaritalStatus == "Widowed")
                {
                    <option value="Widowed" selected>Widowed</option>
                }
                else
                {
                    <option value="Widowed">Widowed</option>
                }

            </select>

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Blood Group
            </label>

            <select class="form-select"
                    name="BloodGroup">

                <option value="">
                    Select Blood Group
                </option>

                @foreach (var bloodGroup in new[]
                {
                    "A+", "A-", "B", "B-",
                    "O+", "O-", "AB+", "AB-"
                })
                {
                    if (employee?.BloodGroup == bloodGroup)
                    {
                        <option value="@bloodGroup" selected>
                            @bloodGroup
                        </option>
                    }
                    else
                    {
                        <option value="@bloodGroup">
                            @bloodGroup
                        </option>
                    }
                }

            </select>

        </div>

    </div>


    <!-- =================================================
         RELIGION & PIN CODE
    ================================================== -->

    <div class="row mt-3">

        <div class="col-md-4">

            <label class="form-label">
                Religion
            </label>

            <input type="text"
                   class="form-control"
                   name="Religion"
                   value="@employee?.Religion"
                   maxlength="100" />

        </div>




    </div>


    <!-- =================================================
         PERMANENT ADDRESS
    ================================================== -->

    <div class="section-title">
        Permanent Address
    </div>

    <div class="form-group">

        <label class="form-label">
            Address
            <span class="required">*</span>
        </label>

        <textarea class="form-control"
                  name="PermanentAddress"
                  required>@employee?.PermanentAddress</textarea>

    </div>


    <div class="row">

        <div class="col-md-4">

            <label class="form-label">
                City
            </label>

            <input type="text"
                   class="form-control"
                   name="PermanentCity"
                   value="@employee?.PermanentCity" />

        </div>


        <div class="col-md-4">

            <label class="form-label">
                State
            </label>

            <input type="text"
                   class="form-control"
                   name="PermanentState"
                   value="@employee?.PermanentState" />

        </div>


        <div class="col-md-4">

            <label class="form-label">
                PIN Code
            </label>

            <input type="text"
                   class="form-control"
                   name="PermanentPINCode"
                   value="@employee?.PermanentPINCode"
                   maxlength="6" />

        </div>

    </div>


    <!-- =================================================
         PRESENT ADDRESS
    ================================================== -->

    <div class="section-title">

        Present Address

        <div class="form-check float-end"
             style="font-size:12px;">

            <input class="form-check-input"
                   type="checkbox"
                   id="sameAddress" />

            <label class="form-check-label"
                   for="sameAddress">
                Same as permanent address
            </label>

        </div>

    </div>


    <div class="form-group">

        <label class="form-label">
            Address
        </label>

        <textarea class="form-control"
                  id="PresentAddress"
                  name="PresentAddress">@employee?.PresentAddress</textarea>

    </div>


    <div class="row">

        <div class="col-md-4">

            <label class="form-label">
                City
            </label>

            <input type="text"
                   class="form-control"
                   id="PresentCity"
                   name="PresentCity"
                   value="@employee?.PresentCity" />

        </div>


        <div class="col-md-4">

            <label class="form-label">
                State
            </label>

            <input type="text"
                   class="form-control"
                   id="PresentState"
                   name="PresentState"
                   value="@employee?.PresentState" />

        </div>


        <div class="col-md-4">

            <label class="form-label">
                PIN Code
            </label>

            <input type="text"
                   class="form-control"
                   id="PresentPINCode"
                   name="PresentPINCode"
                   value="@employee?.PresentPINCode"
                   maxlength="6" />

        </div>

    </div>


    <!-- =================================================
         CONTACT INFORMATION
    ================================================== -->

    <div class="section-title">
        Contact Information
    </div>

    <div class="row">

        <div class="col-md-6">

            <label class="form-label">
                Mobile Number
            </label>

            <input type="text"
                   class="form-control readonly-field"
                   value="@employee?.Mobile"
                   readonly />

        </div>


        <div class="col-md-6">

            <label class="form-label">
                Email
            </label>

            <input type="email"
                   class="form-control readonly-field"
                   value="@employee?.Email"
                   readonly />

        </div>

    </div>


    <div class="row mt-3">

        <div class="col-md-6">

            <label class="form-label">
                Landline Number
            </label>

            <input type="text"
                   class="form-control"
                   name="LandlineNo"
                   value="@employee?.LandlineNo" />

        </div>

    </div>


    <!-- =================================================
         EMERGENCY CONTACT DETAILS
    ================================================== -->

    <div class="section-title">
        Emergency Contact Details
    </div>

    <div class="row">

        <div class="col-md-6">

            <label class="form-label">
                Contact Name
                <span class="required">*</span>
            </label>

            <input type="text"
                   class="form-control"
                   name="EmergencyContactName"
                   value="@employee?.EmergencyContactName"
                   required />

        </div>


        <div class="col-md-6">

            <label class="form-label">
                Relation
                <span class="required">*</span>
            </label>

            <input type="text"
                   class="form-control"
                   name="EmergencyContactRelation"
                   value="@employee?.EmergencyContactRelation"
                   required />

        </div>

    </div>


    <div class="row mt-3">

        <div class="col-md-4">

            <label class="form-label">
                Mobile Number
                <span class="required">*</span>
            </label>

            <input type="text"
                   class="form-control"
                   name="EmergencyContactMobile"
                   value="@employee?.EmergencyContactMobile"
                   maxlength="10"
                   required />

        </div>


        <div class="col-md-8">

            <label class="form-label">
                Address
            </label>

            <input type="text"
                   class="form-control"
                   name="EmergencyContactAddress"
                   value="@employee?.EmergencyContactAddress" />

        </div>

    </div>


    <div class="row mt-3">

        <div class="col-md-6">

            <label class="form-label">
                City
            </label>

            <input type="text"
                   class="form-control"
                   name="EmergencyContactCity"
                   value="@employee?.EmergencyContactCity" />

        </div>

    </div>

</div>


                <!-- =================================================
                     STEP 2
                     FAMILY DETAILS
                ================================================== -->



<div id="step-2"
     class="onboarding-step @(currentStep == 2 ? "active-step" : "") @(isHROrAdmin ? "hr-admin-readonly" : "")">

    <div class="section-title">

        <span>Family Details</span>

        <button type="button"
                class="btn-add float-end"
                onclick="addFamily()">
            + Add Family Member
        </button>

    </div>


    <div id="familyContainer">

        @if (familyList.Any())
        {
            for (int i = 0; i < familyList.Count; i++)
            {
                var family = familyList[i];

                <div class="dynamic-card family-row">

                    <div class="dynamic-card-header">

                        <div class="dynamic-card-title">
                            Family Member @(i + 1)
                        </div>

                        <button type="button"
                                class="btn-remove"
                                onclick="removeRow(this)">
                            Remove
                        </button>

                    </div>


                    <input type="hidden"
                           name="FamilyList[@i].FamilyID"
                           value="@family.FamilyID" />


                    <div class="row">

                        <!-- Relation -->
                        <div class="col-md-3">

                            <label class="form-label">
                                Relation
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FamilyList[@i].Relation"
                                   value="@family.Relation" />

                        </div>


                        <!-- Name -->
                        <div class="col-md-3">

                            <label class="form-label">
                                Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FamilyList[@i].Name"
                                   value="@family.Name" />

                        </div>


                        <!-- Gender -->
                        <div class="col-md-2">

                            <label class="form-label">
                                Gender
                            </label>

                            <select class="form-select"
                                    name="FamilyList[@i].Gender">

                                <option value="">Select</option>

                                <option value="Male"
                                        selected="@(family.Gender == "Male")">
                                    Male
                                </option>

                                <option value="Female"
                                        selected="@(family.Gender == "Female")">
                                    Female
                                </option>

                                <option value="Other"
                                        selected="@(family.Gender == "Other")">
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Date of Birth -->
                        <div class="col-md-2">

                            <label class="form-label">
                                Date of Birth
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="FamilyList[@i].DateOfBirth"
                                   value="@(family.DateOfBirth == null
                                       ? ""
                                       : family.DateOfBirth.Value.ToString("yyyy-MM-dd"))" />

                        </div>


                        <!-- Dependent -->
                        <div class="col-md-2">

                            <label class="form-label">
                                Dependent
                            </label>

                            <select class="form-select"
                                    name="FamilyList[@i].IsDependent">

                                <option value="true"
                                        selected="@(family.IsDependent == true)">
                                    Yes
                                </option>

                                <option value="false"
                                        selected="@(family.IsDependent == false)">
                                    No
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="row mt-3">

                        <!-- Age -->
                        <div class="col-md-4">

                            <label class="form-label">
                                Age
                            </label>

                            <input type="number"
                                   class="form-control"
                                   name="FamilyList[@i].Age"
                                   value="@family.Age"
                                   min="0" />

                        </div>


                        <!-- Occupation -->
                        <div class="col-md-4">

                            <label class="form-label">
                                Occupation
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FamilyList[@i].Occupation"
                                   value="@family.Occupation" />

                        </div>


                        <!-- Mobile -->
                        <div class="col-md-4">

                            <label class="form-label">
                                Mobile
                            </label>

                            <input type="text"
                                   class="form-control"
                                   maxlength="10"
                                   name="FamilyList[@i].Mobile"
                                   value="@family.Mobile"
                                   inputmode="numeric" />

                        </div>

                    </div>


                    <!-- =====================================================
                         RESIDING WITH EMPLOYEE
                    ====================================================== -->

                    <div class="row mt-3">

                        <div class="col-md-4">

                            <label class="form-label">
                                Residing With Employee
                            </label>

                            <select class="form-select"
                                    name="FamilyList[@i].ResidingWithEmployee">

                                <option value="true"
                                        selected="@(family.ResidingWithEmployee == true)">
                                    Yes
                                </option>

                                <option value="false"
                                        selected="@(family.ResidingWithEmployee == false)">
                                    No
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- =====================================================
                         ADDRESS
                    ====================================================== -->

                    <div class="row mt-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea class="form-control"
                                      name="FamilyList[@i].Address"
                                      rows="3"
                                      maxlength="500">@family.Address</textarea>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Town
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FamilyList[@i].Town"
                                   value="@family.Town"
                                   maxlength="500" />

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                State
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="FamilyList[@i].State"
                                   value="@family.State"
                                   maxlength="500" />

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <!-- =========================================================
                 NEW ONBOARDING - DEFAULT FIRST FAMILY MEMBER
            ========================================================== -->

            <div class="dynamic-card family-row">

                <div class="dynamic-card-header">

                    <div class="dynamic-card-title">
                        Family Member 1
                    </div>

                    <button type="button"
                            class="btn-remove"
                            onclick="removeRow(this)">
                        Remove
