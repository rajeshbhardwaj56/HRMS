@{
    var passportDocument = Model.DocumnetList?
        .Where(x =>
            x.DocumentType != null &&
            x.DocumentType.Equals("Passport", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(x.FilePath))
        .OrderByDescending(x => x.DocumentID)
        .FirstOrDefault();

    var panDocument = Model.DocumnetList?
        .Where(x =>
            x.DocumentType != null &&
            x.DocumentType.Equals("PAN", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(x.FilePath))
        .OrderByDescending(x => x.DocumentID)
        .FirstOrDefault();

    var aadhaarDocument = Model.DocumnetList?
        .Where(x =>
            x.DocumentType != null &&
            x.DocumentType.Equals("Aadhaar", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(x.FilePath))
        .OrderByDescending(x => x.DocumentID)
        .FirstOrDefault();
}

<div class="row">

    <!-- =====================================================
         PASSPORT
    ====================================================== -->

    <div class="col-md-4 mb-3">

        <label class="form-label">
            Passport Number
        </label>

