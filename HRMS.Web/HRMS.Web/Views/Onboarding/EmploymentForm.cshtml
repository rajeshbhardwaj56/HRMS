                ) {

                    if (onboardingInput) {

                        onboardingInput.value =
                            result.onboardingID;
                    }
                }


                /* ========================================================
                   UPDATE LAST SAVED STEP
                ======================================================== */

                if (
                    result.lastSavedStep !== undefined &&
                    result.lastSavedStep !== null
                ) {

                    const returnedLastSavedStep =
                        parseInt(
                            result.lastSavedStep
                        );

                    if (
                        !isNaN(returnedLastSavedStep) &&
                        returnedLastSavedStep > lastSavedStep
                    ) {

                        lastSavedStep =
                            returnedLastSavedStep;
                    }

                }
                else {

                    if (step > lastSavedStep) {

                        lastSavedStep = step;
