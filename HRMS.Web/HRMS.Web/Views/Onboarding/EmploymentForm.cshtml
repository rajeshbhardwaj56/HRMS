<script>

document.addEventListener("DOMContentLoaded", function () {

    function updateHRDocumentSummary() {

        const allRows =
            document.querySelectorAll(".hr-document-check");

        let uploaded = 0;
        let missing = 0;
        let verified = 0;


        allRows.forEach(function (checkbox) {

            /*
             * Rows 1-7 are treated as uploaded by default.
             * Other rows use their actual disabled/upload state.
             */

            if (checkbox.dataset.uploaded === "true") {

                uploaded++;

            }
            else if (checkbox.disabled) {

                missing++;

            }
            else {

                uploaded++;

            }


            if (checkbox.checked) {

                verified++;

            }

        });


        const uploadedElement =
            document.getElementById(
                "hrUploadedCount"
            );

        const missingElement =
            document.getElementById(
                "hrMissingCount"
            );

        const verifiedElement =
            document.getElementById(
                "hrVerifiedCount"
            );


        if (uploadedElement) {

            uploadedElement.innerText =
                uploaded;

        }


        if (missingElement) {

            missingElement.innerText =
                missing;

        }


        if (verifiedElement) {

            verifiedElement.innerText =
                verified;

        }

    }


    document
        .querySelectorAll(".hr-document-check")
        .forEach(function (checkbox) {

            checkbox.addEventListener(
                "change",
                updateHRDocumentSummary
            );

        });


    updateHRDocumentSummary();

});
                   
</script>


