/* ================================================================
   EPF TOTAL
================================================================ */

function calculateEPFTotal() {

    const fields =
        document.querySelectorAll(
            ".epf-percentage"
        );


    let total = 0;


    fields.forEach(function (field) {

        const value =
            parseFloat(field.value);

        if (!isNaN(value)) {
            total += value;
        }

    });


    total =
        Math.round(total * 100) / 100;


    const totalElement =
        document.getElementById(
            "epfNomineeTotal"
        );


    if (totalElement) {

        totalElement.textContent =
            `Total EPF Nomination: ${total}%`;


        if (total === 100) {

            totalElement.classList.add(
                "text-success"
            );

            totalElement.classList.remove(
                "text-danger"
            );

        }
        else {

            totalElement.classList.add(
                "text-danger"
            );

            totalElement.classList.remove(
                "text-success"
            );
        }
    }


    return total;
}


