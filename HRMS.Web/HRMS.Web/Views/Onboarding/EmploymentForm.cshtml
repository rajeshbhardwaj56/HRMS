/* ================================================================
   GET FAMILY MEMBER
================================================================ */

function getFamilyMember(familyID) {

    if (!familyID) {
        return null;
    }

    return familyMembers.find(function (family) {

        return String(family.FamilyID) === String(familyID);

    }) || null;
}


/* ================================================================
   GET FAMILY VALUE
================================================================ */

function getFamilyValue(family, propertyName) {

    if (!family) {
        return "";
    }

    return family[propertyName] ?? "";
}


/* ================================================================
   SET FIELD VALUE
================================================================ */

function setNomineeField(card, selector, value) {

    const field = card.querySelector(selector);

    if (!field) {
        return;
    }

    field.value = value ?? "";
}


/* ================================================================
   FORMAT DATE
================================================================ */

function formatDateForInput(value) {

    if (!value) {
        return "";
    }

    /*
       If already yyyy-MM-dd
    */

    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
        return value;
    }

    /*
       Handle ASP.NET JSON date
       /Date(123456789)/
    */

    if (typeof value === "string") {

        const match = value.match(/\/Date\((\d+)\)\//);

        if (match) {

            const dateFromJson =
                new Date(parseInt(match[1]));

            if (!isNaN(dateFromJson.getTime())) {

                return dateFromJson
                    .toISOString()
                    .substring(0, 10);
            }
        }
    }

    const date = new Date(value);

    if (isNaN(date.getTime())) {
        return "";
    }

    const year =
        date.getFullYear();

    const month =
        String(date.getMonth() + 1)
            .padStart(2, "0");

    const day =
        String(date.getDate())
            .padStart(2, "0");

    return `${year}-${month}-${day}`;
}


/* ================================================================
   EPF - FILL FROM FAMILY
================================================================ */

function fillEPFNomineeFromFamily(selectElement) {

    const card =
        selectElement.closest(".epf-nominee-row");

    if (!card) {
        return;
    }

    const family =
        getFamilyMember(selectElement.value);

    if (!family) {

        clearNomineeFields(card, "EPF");

        return;
    }


    /*
       Check duplicate family member
    */

    if (isFamilyMemberAlreadySelected(
        "epf-nominee-row",
        selectElement
    )) {

        alert(
            "This family member is already selected as an EPF nominee."
        );

        selectElement.value = "";

        clearNomineeFields(card, "EPF");

        return;
    }


    /*
       Populate fields
    */

    setNomineeField(
        card,
        ".nominee-name",
        getFamilyValue(family, "Name")
    );

    setNomineeField(
        card,
        ".nominee-relationship",
        getFamilyValue(family, "Relation")
    );

    setNomineeField(
        card,
        ".nominee-dob",
        formatDateForInput(
            getFamilyValue(family, "DateOfBirth")
        )
    );

    setNomineeField(
        card,
        ".nominee-mobile",
        getFamilyValue(family, "Mobile")
    );

    setNomineeField(
        card,
        ".nominee-address",
        getFamilyValue(family, "Address")
    );

    setNomineeField(
        card,
        ".nominee-city",
        getFamilyValue(family, "Town")
    );

    setNomineeField(
        card,
        ".nominee-pin",
        getFamilyValue(family, "PINCode")
    );
}


