        /* ================================================================
           CLEAR NOMINEE FIELDS
        ================================================================ */

        function clearNomineeFields(card, type) {

            const fields = [
                ".nominee-name",
                ".nominee-relationship",
                ".nominee-dob",
                ".nominee-mobile",
                ".nominee-address",
                ".nominee-city",
                ".nominee-pin"
            ];

            fields.forEach(function (selector) {

                const field =
                    card.querySelector(selector);

                if (field) {
                    field.value = "";
                }

            });


            if (type === "EPS") {

                const age =
                    card.querySelector(".eps-age");

                if (age) {
                    age.value = "";
                }
            }
        }


        /* ================================================================
           DUPLICATE FAMILY MEMBER CHECK
        ================================================================ */

        function isFamilyMemberAlreadySelected(
            rowClass,
            currentSelect
        ) {

            const container =
                currentSelect.closest(
                    rowClass === "epf-nominee-row"
                        ? "#epfNomineeContainer"
                        : rowClass === "eps-nominee-row"
                            ? "#epsNomineeContainer"
                            : "#gratuityNomineeContainer"
                );

            if (!container) {
                return false;
            }

            const selectedValue =
                currentSelect.value;

            if (!selectedValue) {
                return false;
            }

            const selects =
                container.querySelectorAll(
                    "select.family-member-select"
                );

            let count = 0;

            selects.forEach(function (select) {

                if (
                    select !== currentSelect &&
                    String(select.value) === String(selectedValue)
                ) {

                    count++;
                }

            });

            return count > 0;
        }


        /* ================================================================
           ESCAPE HTML
        ================================================================ */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        /* ================================================================
           FAMILY DROPDOWN HTML
        ================================================================ */

        function getFamilyDropdownHtml(
            listName,
            index,
            changeFunction
        ) {

            let html = `
                <select
                    class="form-control family-member-select"
                    name="${listName}[${index}].FamilyID"
                    onchange="${changeFunction}(this)"
                    required>

                    <option value="">
                        -- Select Family Member --
                    </option>
            `;


            familyMembers.forEach(function (family) {

                html += `
                    <option value="${family.FamilyID}">
                        ${escapeHtml(family.Name)}
                        -
                        ${escapeHtml(family.Relation)}
                    </option>
                `;

            });


            html += `
                </select>
            `;

            return html;
        }


