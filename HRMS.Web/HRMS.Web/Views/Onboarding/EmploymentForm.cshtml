        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 768px) {

            .onboarding-header {
                padding: 12px 15px;
            }

            .header-content {
                flex-direction: column;
                gap: 10px;
            }

            .header-title {
                font-size: 18px;
            }

            .form-content {
