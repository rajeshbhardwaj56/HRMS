/* ================================================================
   EPS AGE
================================================================ */

function calculateEPSAge(input) {

    if (!input) {
        return;
    }


    const card =
        input.closest(
            ".eps-nominee-row"
        );


    if (!card) {
        return;
    }


    const ageField =
        card.querySelector(
            ".eps-age"
        );


    if (!ageField) {
        return;
    }


    if (!input.value) {

        ageField.value = "";

        return;
    }


    const dob =
        new Date(input.value);


    if (isNaN(dob.getTime())) {

        ageField.value = "";

        return;
    }


    const today =
        new Date();


    let age =
        today.getFullYear() -
        dob.getFullYear();


    const monthDifference =
        today.getMonth() -
        dob.getMonth();


    if (
        monthDifference < 0 ||
        (
            monthDifference === 0 &&
            today.getDate() < dob.getDate()
        )
    ) {

        age--;
    }


    if (age < 0) {
        age = 0;
    }


    ageField.value = age;
}


