
@using System
@using System.Linq
@using HRMS.Models.Common
@using HRMS.Models.EmployeeOnboarding
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IConfiguration _configuration
@model EmployeeOnboardingPageViewModel

@{
    Layout = null;

    var employee = Model.EmployeeDetails
               ?? new EmployeeDetailsOnboardingModel();

    var familyList = Model.FamilyList
                     ?? new List<EmployeeOnboardingFamilyModel>();

    var educationList = Model.EducationList
                        ?? new List<EmployeeOnboardingEducationModel>();

    var employmentList = Model.EmploymentList
                         ?? new List<EmployeeOnboardingEmploymentModel>();

    var bankDetails = Model.BankDetailsList?.FirstOrDefault()
                      ?? new EmployeeOnboardingBankDetailsModel();

    var documentList = Model.DocumnetList
                       ?? new List<EmployeeOnboardingDocumentsModel>();

    var interviewEvaluation =
        Model.InterviewEvaluationList?.FirstOrDefault()
        ?? new EmployeeOnboardingInterviewEvaluationModel();

    var profilePhoto = !string.IsNullOrEmpty(employee.EmployeePhoto)
        ? employee.EmployeePhoto
        : HRMS.Models.Common.Constants.NoImagePath;


    // ============================================================
    // ROLE ID
    // ============================================================

    var roleIdString = Context.Session.GetString(Constants.RoleID);

    int roleId = 0;

    int.TryParse(roleIdString, out roleId);


    // ============================================================
    // HR / ADMIN CHECK
    // ============================================================

    bool isHROrAdmin =
        roleId == (int)Roles.Admin ||
        roleId == (int)Roles.SuperAdmin ||
        roleId == (int)Roles.HR;


    // ============================================================
    // NORMAL CURRENT STEP
    // ============================================================

    int currentStep = Model?.CurrentStep > 0
        ? Model.CurrentStep
        : 1;

    int lastSavedStep = Model?.LastSavedStep > 0
        ? Model.LastSavedStep
        : 1;


    // ============================================================
    // HR / ADMIN
    // SHOULD OPEN DIRECTLY ON STEP 7
    // ============================================================

    if (isHROrAdmin)
    {
        currentStep = 7;
    }


    // ============================================================
    // LIMIT STEP RANGE
    // ============================================================

    currentStep = Math.Max(1, Math.Min(currentStep, 8));

    lastSavedStep = Math.Max(1, Math.Min(lastSavedStep, 8));
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Employee Onboarding</title>
    <link rel="shortcut icon"
          href="~/assets/img/favicon/Protalkfavicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

            body {
                margin: 0;
                font-family: 'Public Sans', sans-serif;
                background: #f5f7fa;
                color: #2f3349;
            }

        /* =========================================================
           HEADER
        ========================================================= */

        .onboarding-header {
            background: #05397b;
            color: white;
            padding: 18px 30px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-content {
                max-width: 1200px;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
        }

        .logo {
            max-height: 50px;
            max-width: 190px;
            object-fit: contain;
        }

        .header-title {
            font-size: 18px;
            font-weight: 600;

        }

        /* =========================================================
           MAIN
        ========================================================= */

        .onboarding-wrapper {
            padding: 30px 15px 50px;
        }

        .onboarding-container {
        max-width: 1200px;
        margin: auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, .07);
        overflow: hidden;
    }

            /* =========================================================
               PROGRESS
            ========================================================= */

            .progress-container {
                padding: 30px 25px 25px;
                background: #ffffff;
                border-bottom: 1px solid #edf0f5;
                overflow-x: auto;
            }

            .progress-steps {
                min-width: 900px;
                position: relative;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

            .progress-line {
                position: absolute;
                top: 19px;
                left: 5%;
                right: 5%;
                height: 3px;
                background: #dfe5ec;
                z-index: 1;
            }

            .step {
                width: 14.28%;
                position: relative;
                z-index: 2;
                text-align: center;
                cursor: pointer;
            }

            /* =========================================================
               STEP CIRCLE
            ========================================================= */

            .step-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                margin: 0 auto 9px;
                background: #ffffff;
                border: 3px solid #d8dee7;
                color: #7b8794;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 14px;
                font-weight: 700;
                transition: all 0.25s ease;
            }

            /* =========================================================
               STEP LABEL
            ========================================================= */

            .step-label {
                font-size: 12px;
                font-weight: 600;
                color: #7b8794;
                line-height: 1.3;
                padding: 0 5px;
                transition: all 0.25s ease;
            }

            /* =========================================================
               ACTIVE STEP
            ========================================================= */

            .step.active .step-circle {
                background: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
                box-shadow: 0 0 0 5px rgba(3, 74, 161, .12);
                transform: scale(1.15);
            }

            .step.active .step-label {
                color: #0d6efd;
                font-weight: 700;
            }

            /* =========================================================
               COMPLETED STEP
            ========================================================= */

            .step.completed .step-circle {
                background: #198754;
                border-color: #198754;
                color: #ffffff;
            }

            .step.completed .step-label {
                color: #198754;
                font-weight: 600;
            }

            /* =========================================================
               HOVER EFFECT
            ========================================================= */

            /* Hover on future/inactive steps */
            .step:not(.active):hover .step-circle {
                background: #eaf3ff;
                border-color: #0d6efd;
                color: #0d6efd;
                transform: scale(1.08);
                box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.10), 0 3px 8px rgba(0, 0, 0, 0.12);
            }

            .step:not(.active):hover .step-label {
                color: #0d6efd;
                font-weight: 600;
            }

            /* Hover on completed steps */
            .step.completed:hover .step-circle {
                background: #e8f7ef;
                border-color: #198754;
                color: #198754;
                transform: scale(1.08);
                box-shadow: 0 0 0 5px rgba(25, 135, 84, 0.10), 0 3px 8px rgba(0, 0, 0, 0.12);
            }

            .step.completed:hover .step-label {
                color: #198754;
            }

            /* Hover on currently active step */
            .step.active:hover .step-circle {
                background: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
                transform: scale(1.18);
                box-shadow: 0 0 0 6px rgba(13, 110, 253, 0.15), 0 4px 10px rgba(0, 0, 0, 0.15);
            }

            .step.active:hover .step-label {
                color: #0d6efd;
                font-weight: 700;
            }

            /* =========================================================
               CLICKABLE CURSOR
            ========================================================= */

            .step,
            .step-circle,
            .step-label {
                cursor: pointer;
            }

            /* =========================================================
               RESPONSIVE
            ========================================================= */

            @@media (max-width: 768px) {

                .progress-container {
                    padding: 20px 10px;
                }

                .progress-steps {
                    min-width: 900px;
                }

                .step-label {
                    font-size: 10px;
                }

                .step-circle {
                    width: 36px;
                    height: 36px;
                    font-size: 12px;
                }
            }

        /* =========================================================
           FORM CONTENT
        ========================================================= */

        .form-content {
            padding: 35px;
        }

        .form-title {
            font-size: 24px;
            font-weight: 600;
            color: #05397b;
            margin-bottom: 5px;
        }

        .form-subtitle {
            color: #6c757d;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .info-box {
        background: #f5f8fc;
            border: 1px solid #dfe8f3;
            border-radius: 6px;
            padding: 12px 15px;
            font-size: 12px;
            color: #666;
            margin-bottom: 20px;
        }

        /* =========================================================
           STEP CONTENT
        ========================================================= */

        .onboarding-step {
            display: none;
        }

        .onboarding-step.active-step {
            display: block;
        }

        .section-title {
            margin-top: 28px;
            margin-bottom: 18px;
            padding: 11px 15px;
            background: #f3f7fc;
            border-left: 4px solid #05397b;
            color: #05397b;
            font-size: 16px;
            font-weight: 700;
