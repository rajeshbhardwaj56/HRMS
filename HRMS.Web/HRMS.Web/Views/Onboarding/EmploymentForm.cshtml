                <label class="form-label">
                    Email
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.EmployeeDetails?.Email"
                       readonly />

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- DOCUMENT DATA -->
        <!-- ========================================================= -->

        @{
            var hrDocuments = Model.DocumnetList?
                .Where(x => !string.IsNullOrWhiteSpace(x.FilePath))
                .OrderByDescending(x => x.DocumentID)
                .ToList()
                ?? new List<EmployeeOnboardingDocumentsModel>();


            // =========================================================
            // HELPER - GET LATEST DOCUMENT
            // =========================================================

            EmployeeOnboardingDocumentsModel? GetHRDocument(
                params string[] documentTypes)
            {
                return hrDocuments
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.DocumentType) &&
                        documentTypes.Any(type =>
                            x.DocumentType.Equals(
                                type,
                                StringComparison.OrdinalIgnoreCase)))
                    .OrderByDescending(x => x.DocumentID)
                    .FirstOrDefault();
            }


            // =========================================================
            // 1. EMPLOYMENT APPLICATION
            // =========================================================

            var hrEmploymentApplication =
                GetHRDocument(
                    "EmploymentApplication",
                    "EmploymentApplicationForm",
                    "EmploymentForm");


            // =========================================================
            // 2. EMPLOYEE UNDERTAKING
            // =========================================================

            var hrEmployeeUndertaking =
                GetHRDocument(
                    "EmployeeUndertaking",
                    "Undertaking");


            // =========================================================
            // 3. NDA
            // =========================================================

            var hrNdaDocument =
                GetHRDocument(
                    "NDA",
                    "NonDisclosureAgreement");


            // =========================================================
            // 4. IT COMPLIANCE
            // =========================================================

            var hrItCompliance =
                GetHRDocument(
                    "ITComplianceAgreement",
                    "ITCompliance");


            // =========================================================
            // 5. FORM F
            // =========================================================

            var hrFormF =
                GetHRDocument(
                    "FormF",
                    "GratuityNomination",
                    "Gratuity");


            // =========================================================
            // 6. FORM 2
            // =========================================================

            var hrForm2 =
                GetHRDocument(
                    "Form2",
                    "Form2Revised",
                    "EPFNomination");


            // =========================================================
            // 7. FORM 1
            // =========================================================

            var hrForm1 =
                GetHRDocument(
                    "Form1",
                    "ESI",
                    "ESIDeclaration");


            // =========================================================
            // 8. IDENTITY PROOF
            // =========================================================

            var hrIdentityDocuments =
                hrDocuments
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.DocumentType)
                        &&
                        (
                            x.DocumentType.Equals(
                                "Aadhaar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Aadhar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "PAN",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Passport",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "DrivingLicense",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "ElectionCard",
                                StringComparison.OrdinalIgnoreCase)
                        ))
                    .OrderByDescending(x => x.DocumentID)
                    .ToList();


            // =========================================================
            // 9. ADDRESS PROOF
            // =========================================================

            var hrAddressDocuments =
                hrDocuments
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.DocumentType)
                        &&
                        (
                            x.DocumentType.Equals(
                                "AddressProof",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Aadhaar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Aadhar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Passport",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "RationCard",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "ElectricityBill",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Registry",
                                StringComparison.OrdinalIgnoreCase)
                        ))
                    .OrderByDescending(x => x.DocumentID)
                    .ToList();


            // =========================================================
            // 10. DOB PROOF
            // Matriculation / Birth Certificate / Aadhaar /
            // Passport / PAN
            // =========================================================

            var hrDobDocuments =
                hrDocuments
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.DocumentType)
                        &&
                        (
                            x.DocumentType.Equals(
                                "DOBProof",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "DateOfBirthProof",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "BirthCertificate",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Matriculation",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "MatriculationCertificate",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Aadhaar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Aadhar",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "Passport",
                                StringComparison.OrdinalIgnoreCase)

                            || x.DocumentType.Equals(
                                "PAN",
                                StringComparison.OrdinalIgnoreCase)
                        ))
                    .OrderByDescending(x => x.DocumentID)
                    .ToList();


            // =========================================================
            // DOB PROOF AVAILABLE
            // =========================================================

            bool hrHasDobProof =
                hrDocuments.Any(x =>
                    !string.IsNullOrWhiteSpace(x.DocumentType)
                    &&
                    (
                        x.DocumentType.Equals(
                            "DOBProof",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "DateOfBirthProof",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "BirthCertificate",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "Matriculation",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "MatriculationCertificate",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "Aadhaar",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "Aadhar",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "Passport",
                            StringComparison.OrdinalIgnoreCase)

                        || x.DocumentType.Equals(
                            "PAN",
                            StringComparison.OrdinalIgnoreCase)
                    ));



    // =========================================================
    // EDUCATION QUALIFICATION AUTO CHECK
    // =========================================================

    bool IsEducationDocument(string? documentType)
    {
        if (string.IsNullOrWhiteSpace(documentType))
            return false;

        return
            documentType.Equals(
                "Education",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "EducationCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "Marksheet",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "DegreeCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "DiplomaCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "EducationalProof",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "Graduation",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "GraduationCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "PostGraduation",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "PostGraduationCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "Intermediate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "IntermediateCertificate",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "Matriculation",
                StringComparison.OrdinalIgnoreCase)

            || documentType.Equals(
                "MatriculationCertificate",
                StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // GET EDUCATION DOCUMENTS
    // =========================================================

    var hrEducationDocuments =
        hrDocuments
            .Where(x => IsEducationDocument(x.DocumentType))
            .OrderByDescending(x => x.DocumentID)
            .ToList();


    // =========================================================
    // QUALIFICATION FROM EMPLOYEE EDUCATION DATA
    // =========================================================

    var employeeEducationList =
        Model.EducationList?
            .Where(x => !string.IsNullOrWhiteSpace(x.EducationLevel))
            .ToList()
            ?? new List<EmployeeOnboardingEducationModel>();


    // =========================================================
    // MATRICULATION
    // =========================================================

    bool hrHasMatriculation =
        hrEducationDocuments.Any(x =>
            x.DocumentType.Equals(
                "Matriculation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.DocumentType.Equals(
                "MatriculationCertificate",
                StringComparison.OrdinalIgnoreCase))
        ||
        employeeEducationList.Any(x =>
            x.EducationLevel.Equals(
                "Matriculation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "10th",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "High School",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Secondary",
                StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // INTERMEDIATE
    // =========================================================

    bool hrHasIntermediate =
        hrEducationDocuments.Any(x =>
            x.DocumentType.Equals(
                "Intermediate",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.DocumentType.Equals(
                "IntermediateCertificate",
                StringComparison.OrdinalIgnoreCase))
        ||
        employeeEducationList.Any(x =>
            x.EducationLevel.Equals(
                "Intermediate",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "12th",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Higher Secondary",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Senior Secondary",
                StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // GRADUATION
    // =========================================================

    bool hrHasGraduation =
        hrEducationDocuments.Any(x =>
            x.DocumentType.Equals(
                "Graduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.DocumentType.Equals(
                "GraduationCertificate",
                StringComparison.OrdinalIgnoreCase))
        ||
        employeeEducationList.Any(x =>
            x.EducationLevel.Equals(
                "Graduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Graduate",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Bachelor",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Bachelor's",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Degree",
                StringComparison.OrdinalIgnoreCase));


    // =========================================================
    // POST GRADUATION
    // =========================================================

    bool hrHasPostGraduation =
        hrEducationDocuments.Any(x =>
            x.DocumentType.Equals(
                "PostGraduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.DocumentType.Equals(
                "PostGraduationCertificate",
                StringComparison.OrdinalIgnoreCase))
        ||
        employeeEducationList.Any(x =>
            x.EducationLevel.Equals(
                "Post Graduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Post-Graduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "PostGraduation",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Master",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Master's",
                StringComparison.OrdinalIgnoreCase)
            ||
            x.EducationLevel.Equals(
                "Masters",
                StringComparison.OrdinalIgnoreCase));



            // =========================================================
            // 12. EXPERIENCE
            // =========================================================

            var hrExperienceDocument =
                GetHRDocument(
                    "ExperienceCertificate",
                    "ResignationAcceptance",
                    "PreviousEmployment");


            // =========================================================
            // 13. SALARY
            // =========================================================

            var hrSalaryDocument =
                GetHRDocument(
                    "SalarySlip",
                    "SalaryStatement",
                    "LastSalaryDrawal",
