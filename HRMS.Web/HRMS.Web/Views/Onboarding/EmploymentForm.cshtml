            min-height: 40px;
            border: 1px solid #d9e0e8;
            border-radius: 5px;
            font-size: 13px;
        }

        textarea.form-control {
            min-height: 90px;
            resize: vertical;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #034aa1;
            box-shadow: 0 0 0 .15rem rgba(3, 74, 161, .10);
        }

        .readonly-field {
            background: #f3f5f7 !important;
            cursor: not-allowed;
        }

        .required {
