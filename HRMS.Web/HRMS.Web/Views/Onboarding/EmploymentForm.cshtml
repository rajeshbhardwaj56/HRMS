<!-- =============================================================
     FAMILY DATA FOR JAVASCRIPT
============================================================== -->

<script>

    const familyMembers =
        @Html.Raw(
            Newtonsoft.Json.JsonConvert.SerializeObject(
                familyMembers
            )
        );


    /* =========================================================
       FIND FAMILY MEMBER
    ========================================================== */

    function getFamilyMember(familyId) {

        if (!familyId) {
            return null;
        }

        return familyMembers.find(function (family) {

            return String(family.FamilyID) === String(familyId);

        });
    }


    /* =========================================================
       FORMAT DATE
    ========================================================== */

    function formatFamilyDate(dateValue) {

        if (!dateValue) {
            return "";
        }

        let dateString = String(dateValue);


        // ASP.NET JSON date

        if (dateString.indexOf("/Date(") === 0) {

            const timestamp =
                parseInt(
                    dateString
                        .replace("/Date(", "")
                        .replace(")/", ""),
                    10
                );

            if (!isNaN(timestamp)) {

                const date =
                    new Date(timestamp);

                return date.getFullYear()
                    + "-"
                    + String(
                        date.getMonth() + 1
                    ).padStart(2, "0")
                    + "-"
                    + String(
                        date.getDate()
                    ).padStart(2, "0");
            }
        }


        // ISO date

        if (dateString.length >= 10) {

            return dateString.substring(0, 10);

        }


        return "";
    }


    /* =========================================================
       EPF FAMILY MEMBER
    ========================================================== */

   function fillEPFNomineeFromFamily(select) {

    const familyId = select.value;

    if (!familyId) {
        return;
    }

    const family = getFamilyMember(familyId);

    if (!family) {
        console.warn(
            "Family member not found for FamilyID:",
            familyId
        );
        return;
    }

    const row = select.closest(".dynamic-card");

    if (!row) {
        return;
    }

    const nameInput =
        row.querySelector(".epf-nominee-name");

    const relationshipInput =
        row.querySelector(".epf-nominee-relationship");

    const dobInput =
        row.querySelector(".epf-nominee-dob");

    const mobileInput =
        row.querySelector(".epf-nominee-mobile");

    const addressInput =
        row.querySelector(".epf-nominee-address");

    const cityInput =
        row.querySelector(".epf-nominee-city");


    if (nameInput) {
        nameInput.value = family.Name || "";
    }

    if (relationshipInput) {
        relationshipInput.value = family.Relation || "";
    }

    if (dobInput) {
        dobInput.value = formatFamilyDate(
            family.DateOfBirth
        );
    }

    if (mobileInput) {
        mobileInput.value = family.Mobile || "";
    }

    if (addressInput) {
        addressInput.value = family.Address || "";
    }

    if (cityInput) {
        cityInput.value = family.Town || "";
    }

    console.log(
        "EPF nominee populated from Family Details:",
        family
    );
}


    /* =========================================================
       EPS FAMILY MEMBER
    ========================================================== */

    function fillEPSNomineeFromFamily(select) {

    const familyId = select.value;

    if (!familyId) {
        return;
    }

    const family = getFamilyMember(familyId);

    if (!family) {
        console.warn(
            "Family member not found for FamilyID:",
            familyId
        );
        return;
    }

    const row = select.closest(".dynamic-card");

    if (!row) {
        return;
    }

    const nameInput =
        row.querySelector(".eps-nominee-name");

    const relationshipInput =
        row.querySelector(".eps-nominee-relationship");

    const dobInput =
        row.querySelector(".eps-nominee-dob");

    const ageInput =
        row.querySelector(".eps-age");

    const addressInput =
        row.querySelector(".eps-nominee-address");

    const cityInput =
        row.querySelector(".eps-nominee-city");


    if (nameInput) {
        nameInput.value = family.Name || "";
    }

    if (relationshipInput) {
        relationshipInput.value = family.Relation || "";
    }

    if (dobInput) {
        dobInput.value = formatFamilyDate(
            family.DateOfBirth
        );
    }

    if (ageInput && dobInput) {
        calculateEPSAge(dobInput);
    }

    if (addressInput) {
        addressInput.value = family.Address || "";
    }

    if (cityInput) {
        cityInput.value = family.Town || "";
    }

    console.log(
        "EPS nominee populated from Family Details:",
        family
    );
}


    /* =========================================================
       GRATUITY FAMILY MEMBER
    ========================================================== */
function fillGratuityNomineeFromFamily(select) {

    const familyId = select.value;

    if (!familyId) {
        return;
    }

    const family = getFamilyMember(familyId);

    if (!family) {
        console.warn(
            "Family member not found for FamilyID:",
            familyId
        );
        return;
    }

    const row = select.closest(".dynamic-card");

    if (!row) {
        return;
    }

    const nameInput =
        row.querySelector(".gratuity-nominee-name");

    const relationshipInput =
        row.querySelector(".gratuity-nominee-relationship");

    const dobInput =
        row.querySelector(".gratuity-nominee-dob");

    const mobileInput =
        row.querySelector(".gratuity-nominee-mobile");

    const addressInput =
        row.querySelector(".gratuity-nominee-address");

    const cityInput =
        row.querySelector(".gratuity-nominee-city");


    if (nameInput) {
        nameInput.value = family.Name || "";
    }

    if (relationshipInput) {
        relationshipInput.value = family.Relation || "";
    }

    if (dobInput) {
        dobInput.value = formatFamilyDate(
            family.DateOfBirth
        );
    }

    if (mobileInput) {
        mobileInput.value = family.Mobile || "";
    }

    if (addressInput) {
        addressInput.value = family.Address || "";
    }

    if (cityInput) {
        cityInput.value = family.Town || "";
    }

    console.log(
        "Gratuity nominee populated from Family Details:",
        family
    );
}


    /* =========================================================
       EPS AGE
    ========================================================== */

    function calculateEPSAge(input) {

        if (!input) {
            return;
        }


        const card =
            $(input).closest(
                ".eps-nominee-row"
            );

        const dobValue =
            $(input).val();

        const ageInput =
            card.find(".eps-age");


        if (!dobValue) {

            ageInput.val("");

            return;
        }


        const dob =
            new Date(dobValue);


        if (isNaN(dob.getTime())) {

            ageInput.val("");

            return;
        }


        const today =
            new Date();


        let age =
            today.getFullYear() -
            dob.getFullYear();


        const monthDifference =
            today.getMonth() -
            dob.getMonth();


        if (
            monthDifference < 0 ||
            (
                monthDifference === 0 &&
                today.getDate() < dob.getDate()
            )
        ) {

            age--;

        }


        ageInput.val(
            age >= 0
                ? age
                : ""
        );
    }


    /* =========================================================
       EPF TOTAL
    ========================================================== */

    function calculateEPFTotal() {

        let total = 0;


        $("#epfNomineeContainer .epf-percentage")
            .each(function () {

                const value =
                    parseFloat(
                        $(this).val()
                    ) || 0;

                total += value;

            });


        $("#epfNomineeTotal")
            .text(
                "Total EPF Nomination: "
                + total.toFixed(2)
                + "%"
            );
    }


    /* =========================================================
       GRATUITY TOTAL
    ========================================================== */

    function calculateGratuityTotal() {

        let total = 0;


        $("#gratuityNomineeContainer .gratuity-percentage")
            .each(function () {

                const value =
                    parseFloat(
                        $(this).val()
                    ) || 0;

                total += value;

            });


        $("#gratuityNomineeTotal")
            .text(
                "Total Gratuity Nomination: "
                + total.toFixed(2)
                + "%"
            );
    }


    /* =========================================================
       INITIALIZE EXISTING NOMINEES
    ========================================================== */

    $(document).ready(function () {


        /*
         * EPF total
         */

        calculateEPFTotal();


        /*
         * Gratuity total
         */

        calculateGratuityTotal();


        /*
         * Existing EPS age
         */

        $("#epsNomineeContainer .eps-dob")
            .each(function () {

                if ($(this).val()) {

                    calculateEPSAge(this);

                }

            });


        /*
         * IMPORTANT:
         * Existing saved records are also refreshed
         * from Family Details.
         *
         * This ensures that if FamilyID exists,
         * Name / Relation / DOB / Address etc.
         * come from the current Family Details.
         */

        $("#epfNomineeContainer .family-member-select")
            .each(function () {

                if ($(this).val()) {

                    fillEPFNomineeFromFamily(this);

                }

            });


        $("#epsNomineeContainer .family-member-select")
            .each(function () {

                if ($(this).val()) {

                    fillEPSNomineeFromFamily(this);

                }

            });


        $("#gratuityNomineeContainer .family-member-select")
            .each(function () {

                if ($(this).val()) {

                    fillGratuityNomineeFromFamily(this);

                }

            });

    });

</script>





