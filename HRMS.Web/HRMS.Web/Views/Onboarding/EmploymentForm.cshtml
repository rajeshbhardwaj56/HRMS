/* ============================================================
   SAVE CURRENT STEP
============================================================ */

function saveCurrentStep(goNext) {

    console.log("=================================");
    console.log("SAVE CURRENT STEP");
    console.log("Current Step:", currentInterviewStep);
    console.log("Go Next:", goNext);
    console.log("=================================");
    if (isSavingStep) { console.log( "Save already in progress. Ignoring request." ); return; } isSavingStep = true;
    const form =
        document.getElementById("employeeOnboardingForm");

    if (!form) {

        console.error(
            "employeeOnboardingForm not found."
        );

        return;
    }

    const step =
        parseInt(currentInterviewStep);

    if (isNaN(step) || step < 1 || step > totalInterviewSteps) {

        console.error(
            "Invalid current step:",
            currentInterviewStep
        );

        return;
    }


    /* ============================================================
       GET CURRENT STEP CONTAINER
    ============================================================ */

    const currentContainer =
        document.getElementById(
            "step-" + step
        );

    if (!currentContainer) {

        console.error(
            "Step container not found:",
            "step-" + step
        );

        return;
    }


    /* ============================================================
       VALIDATE ONLY WHEN NEXT IS CLICKED
    ============================================================ */

    if (goNext === true) {

        console.log(
            "Validating Step:",
            step
        );

        const requiredFields =
            currentContainer.querySelectorAll(
                "input[required], select[required], textarea[required]"
            );

        for (
            let i = 0;
            i < requiredFields.length;
            i++
        ) {

            const field =
                requiredFields[i];

            if (!field.checkValidity()) {

                console.log(
                    "Validation failed:",
                    field.name
                );

                field.reportValidity();

                field.focus();

                return;
            }
        }
    }


    /* ============================================================
       CREATE FORM DATA
       ONLY CURRENT STEP
    ============================================================ */

    const formData =
        new FormData();


    const fields =
        currentContainer.querySelectorAll(
            "input[name], select[name], textarea[name]"
        );


    fields.forEach(function (field) {

        if (field.disabled) {
            return;
        }


        /* ========================================================
           CHECKBOX
        ======================================================== */

        if (field.type === "checkbox") {

            formData.append(
                field.name,
                field.checked
                    ? (field.value || "true")
                    : "false"
            );

            return;
        }


        /* ========================================================
           RADIO
        ======================================================== */

        if (field.type === "radio") {

            if (field.checked) {

                formData.append(
                    field.name,
                    field.value
                );
            }

            return;
        }


        /* ========================================================
           FILE
        ======================================================== */

        if (field.type === "file") {

            if (
                field.files &&
                field.files.length > 0
            ) {

                for (
                    let i = 0;
                    i < field.files.length;
                    i++
                ) {

                    formData.append(
                        field.name,
                        field.files[i]
                    );
                }
            }

            return;
        }


        /* ========================================================
           NORMAL INPUT
        ======================================================== */

        formData.append(
            field.name,
            field.value
        );

    });


    /* ============================================================
       COMMON VALUES
    ============================================================ */

    const onboardingInput =
        document.getElementById(
            "OnboardingID"
        );

    const onboardingID =
        onboardingInput
            ? (
                onboardingInput.value ||
                "0"
            )
            : "0";


    formData.set(
        "OnboardingID",
        onboardingID
    );


    formData.set(
        "CurrentStep",
        step.toString()
    );


    formData.set(
        "FormAction",
        "Save"
    );


    /* ============================================================
       ANTI FORGERY TOKEN
    ============================================================ */

    const token =
        form.querySelector(
            'input[name="__RequestVerificationToken"]'
        );

    if (token) {

        formData.append(
            "__RequestVerificationToken",
            token.value
        );
    }


    /* ============================================================
       BUTTONS
    ============================================================ */

    const saveButton =
        document.getElementById(
            "saveButton"
        );

    const nextButton =
        document.getElementById(
            "nextButton"
        );


    if (saveButton) {

        saveButton.disabled = true;
        saveButton.innerText = "Saving...";
    }


    if (nextButton) {

        nextButton.disabled = true;
    }


    /* ============================================================
       AJAX SAVE
    ============================================================ */
fetch(
    '@Url.Action("AddUpdateEmployeeDetailsOnboarding", "Onboarding")',
    {
        method: "POST",
        body: formData,
        headers: {
            "X-Requested-With": "XMLHttpRequest",
            "Accept": "application/json"
        }
    }
)
.then(async function (response) {

    console.log("=================================");
    console.log("FETCH RESPONSE");
    console.log("HTTP Status:", response.status);
    console.log("HTTP OK:", response.ok);
    console.log("Content-Type:", response.headers.get("content-type"));
    console.log("URL:", response.url);
    console.log("=================================");

    const responseText = await response.text();

    console.log("RAW SERVER RESPONSE:");
    console.log(responseText);

    if (!response.ok) {
        throw new Error(
            "Server returned HTTP " +
            response.status +
            "\n\n" +
            responseText.substring(0, 500)
        );
    }

    if (!responseText) {
        throw new Error("Server returned an empty response.");
    }

    let result;

    try {
        result = JSON.parse(responseText);
    }
    catch (e) {

        console.error("JSON PARSE ERROR:", e);
        console.error("SERVER RETURNED:", responseText);

        throw new Error(
            "Server did not return JSON. Check the RAW SERVER RESPONSE in Console."
        );
    }

    return result;
})
    .then(function (result) {

        console.log(
            "SERVER RESPONSE:",
            result
        );


        /* ========================================================
           SAVE FAILED
        ======================================================== */

        if (
            !result ||
            result.success !== true
        ) {

            alert(
                result &&
                result.message
                    ? result.message
                    : "Unable to save Step " + step
            );

            return;
        }


        /* ========================================================
           UPDATE ONBOARDING ID
        ======================================================== */

        if (
            result.onboardingID !== undefined &&
            result.onboardingID !== null
        ) {

            if (onboardingInput) {

                onboardingInput.value =
                    result.onboardingID;
            }
        }


        /* ========================================================
           UPDATE LAST SAVED STEP
        ======================================================== */

        if (
            result.lastSavedStep !== undefined &&
            result.lastSavedStep !== null
        ) {

            const returnedLastSavedStep =
                parseInt(
                    result.lastSavedStep
                );

            if (
                !isNaN(returnedLastSavedStep) &&
                returnedLastSavedStep > lastSavedStep
            ) {

                lastSavedStep =
                    returnedLastSavedStep;
            }

        }
        else {

            if (step > lastSavedStep) {

                lastSavedStep = step;
            }
        }


        /* ========================================================
           UPDATE HIDDEN LAST SAVED STEP
        ======================================================== */

        const lastSavedInput =
            document.getElementById(
                "LastSavedStep"
            );

        if (lastSavedInput) {

            lastSavedInput.value =
                lastSavedStep;
        }


        /* ========================================================
           SAVE BUTTON
           DO NOT MOVE
        ======================================================== */

        if (goNext === false) {

            updateProgress(
                currentInterviewStep
            );

            alert(
                "Step " +
                step +
                " saved successfully."
            );

            return;
        }


        /* ========================================================
           NEXT BUTTON
           MOVE TO NEXT STEP
        ======================================================== */

        if (goNext === true) {

            if (
                step >= totalInterviewSteps
            ) {

                alert(
                    "All onboarding steps have been completed."
                );

                return;
            }


            const nextStep =
                step + 1;


            console.log(
                "================================="
            );

            console.log(
                "SAVE SUCCESSFUL"
            );

            console.log(
                "Moving from Step:",
                step
            );

            console.log(
                "Moving to Step:",
                nextStep
            );

            console.log(
                "================================="
            );


            /* ====================================================
               UPDATE CURRENT STEP
            ==================================================== */

            currentInterviewStep =
                nextStep;


            const currentStepInput =
                document.getElementById(
                    "CurrentStep"
                );

            if (currentStepInput) {

                currentStepInput.value =
                    nextStep;
            }


            /* ====================================================
               SHOW NEXT STEP
            ==================================================== */

            showInterviewStep(
                nextStep
            );
        }

    })
    .catch(function (error) {

        console.error(
            "SAVE ERROR:",
            error
        );

        alert(
            "Something went wrong while saving."
        );

    })
    .finally(function () {
         isSavingStep = false;
        if (saveButton) {

            saveButton.disabled = false;
            saveButton.innerText = "Save";
        }


        if (nextButton) {

            nextButton.disabled = false;
        }

    });
}

    /* =============================================================
       NOMINEE TOTAL VALUE
    ============================================================= */

    function calculateNomineeTotalValue() {

        let total = 0;


        document
            .querySelectorAll(".nominee-percentage")
            .forEach(function (input) {

                const value =
                    parseFloat(input.value);

                if (!isNaN(value)) {

                    total += value;

                }

            });


        return Number(total.toFixed(2));

    }


    /* =============================================================
       IF USER PRESSES ENTER
    ============================================================= */

    document.addEventListener("keydown", function (event) {

        if (event.key !== "Enter") {
            return;
        }


        const target =
            event.target;


        if (target.tagName === "TEXTAREA") {
            return;
        }


        if (target.tagName === "INPUT" ||
            target.tagName === "SELECT") {

            event.preventDefault();

        }

    });
    /* ============================================================
   SAVE FORM
============================================================ */

      
/* ================================================================
   STEP 8 - YES / NO CONDITIONAL SECTIONS
   ================================================================ */

/* ================================================================
   STEP 8 - YES / NO CONDITIONAL FIELDS
   ================================================================ */
/* ================================================================
   STEP 8 - YES / NO CONDITIONAL SECTIONS
   ================================================================ */

/* ================================================================
   STEP 8 - CONDITIONAL SECTIONS
   ================================================================ */

function initializeStep8() {

    console.log("STEP 8: initializeStep8() started");

    const step8 = document.getElementById("step-8");

    if (!step8) {
        console.error("STEP 8: #step-8 not found");
        return;
    }


    /* ============================================================
       GET RADIO VALUE
       ============================================================ */

    function getRadioValue(name) {

        const radio = step8.querySelector(
            'input[type="radio"][name="' + name + '"]:checked'
        );

        if (!radio) {
            return null;
        }

        return radio.value
            .toString()
            .trim()
            .toLowerCase();
    }


    /* ============================================================
       TOGGLE SECTION
       ============================================================ */

    function toggleSection(radioName, sectionId) {

        const section =
            document.getElementById(sectionId);

        if (!section) {
            console.error(
                "STEP 8: Section not found:",
                sectionId
            );
            return;
        }

        const value =
            getRadioValue(radioName);

        console.log(
            "STEP 8:",
            radioName,
            "=",
            value
        );


        if (value === "true") {

            section.style.display = "block";

            console.log(
                "STEP 8: Showing",
                sectionId
            );

        }
        else {

            section.style.display = "none";

            console.log(
                "STEP 8: Hiding",
                sectionId
            );
        }
    }


    /* ============================================================
       PREVIOUSLY INTERVIEWED
       ============================================================ */

    function updatePreviouslyInterviewed() {

        toggleSection(
            "PreviouslyInterviewed",
            "previousInterviewDetails"
        );
    }


    /* ============================================================
       PREVIOUSLY WORKED
       ============================================================ */

    function updatePreviouslyWorked() {

        toggleSection(
            "PreviouslyWorked",
            "previousEmploymentDetails"
        );
    }


    /* ============================================================
       CRIMINAL / CIVIL PROCEEDINGS
       ============================================================ */

    function updateCriminalCivil() {

        toggleSection(
            "HaveCriminalCivilProceedings",
            "criminalCivilProceedingsDetails"
        );
    }


    /* ============================================================
       CHANGE EVENTS
       ============================================================ */

    step8.addEventListener(
        "change",
        function (event) {

            const target = event.target;

            if (!target.matches(
                'input[type="radio"]'
            )) {
                return;
            }


            if (
                target.name ===
                "PreviouslyInterviewed"
            ) {

                updatePreviouslyInterviewed();
            }


            if (
                target.name ===
                "PreviouslyWorked"
            ) {

                updatePreviouslyWorked();
            }


            if (
                target.name ===
                "HaveCriminalCivilProceedings"
            ) {

                updateCriminalCivil();
            }

        }
    );


    /* ============================================================
       INITIAL LOAD
       ============================================================ */

    updatePreviouslyInterviewed();

    updatePreviouslyWorked();

    updateCriminalCivil();


    console.log(
        "STEP 8: initializeStep8() completed"
    );
}


/* ================================================================
   INITIALIZE
   ================================================================ */

if (document.readyState === "loading") {

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            console.log(
                "STEP 8: DOMContentLoaded"
            );

            initializeStep8();

        }
    );

}
else {

    initializeStep8();

}

</script>
<script>

    function initializeStep8() {

        const previouslyInterviewed =
            document.querySelector(
                'input[name="PreviouslyInterviewed"]:checked'
            );

        const previouslyWorked =
            document.querySelector(
                'input[name="PreviouslyWorked"]:checked'
            );

        const criminalProceedings =
            document.querySelector(
                'input[name="HaveCriminalCivilProceedings"]:checked'
            );


        // Previously Interviewed
        const interviewDetails =
            document.getElementById("previousInterviewDetails");

        if (interviewDetails) {

            interviewDetails.style.display =
                previouslyInterviewed &&
                previouslyInterviewed.value === "true"
                    ? "block"
                    : "none";
        }


        // Previously Worked
        const employmentDetails =
            document.getElementById("previousEmploymentDetails");

        if (employmentDetails) {

            employmentDetails.style.display =
                previouslyWorked &&
                previouslyWorked.value === "true"
                    ? "block"
                    : "none";
        }


        // Criminal / Civil Proceedings
        const criminalDetails =
            document.getElementById(
                "criminalCivilProceedingsDetails"
            );

        if (criminalDetails) {

            criminalDetails.style.display =
                criminalProceedings &&
                criminalProceedings.value === "true"
                    ? "block"
                    : "none";
        }

    }


    // Initialize when page loads
    document.addEventListener("DOMContentLoaded", function () {
        initializeStep8();
    });

</script>

</body>

