/* ============================================================
   SIGNATURE SYSTEM
   Upload + Draw + Type
   ============================================================ */

const signatureCanvases = {};

function initializeSignature(signatureKey) {

    const canvas = document.getElementById(
        "signatureCanvas_" + signatureKey
    );

    if (!canvas) {
        return;
    }

    const ctx = canvas.getContext("2d");

    signatureCanvases[signatureKey] = {
        canvas: canvas,
        ctx: ctx,
        drawing: false
    };

    function getPosition(event) {

        const rect = canvas.getBoundingClientRect();

        let clientX;
        let clientY;

        if (event.touches && event.touches.length > 0) {

            clientX = event.touches[0].clientX;
            clientY = event.touches[0].clientY;

        }
        else {

            clientX = event.clientX;
            clientY = event.clientY;

        }

        return {
            x: clientX - rect.left,
            y: clientY - rect.top
        };
    }

    function startDrawing(event) {

        event.preventDefault();

        const position = getPosition(event);

        signatureCanvases[signatureKey].drawing = true;

        ctx.beginPath();

        ctx.moveTo(
            position.x,
            position.y
        );
    }

    function draw(event) {

        if (!signatureCanvases[signatureKey].drawing) {
            return;
        }

        event.preventDefault();

        const position = getPosition(event);

        ctx.lineWidth = 2;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.strokeStyle = "#000";

        ctx.lineTo(
            position.x,
            position.y
        );

        ctx.stroke();
    }

    function stopDrawing(event) {

        if (event) {
            event.preventDefault();
        }

        signatureCanvases[signatureKey].drawing = false;
    }

    canvas.addEventListener(
        "mousedown",
        startDrawing
    );

    canvas.addEventListener(
        "mousemove",
        draw
    );

    canvas.addEventListener(
        "mouseup",
        stopDrawing
    );

    canvas.addEventListener(
        "mouseleave",
        stopDrawing
    );

    canvas.addEventListener(
        "touchstart",
        startDrawing,
        { passive: false }
    );

    canvas.addEventListener(
        "touchmove",
        draw,
        { passive: false }
    );

    canvas.addEventListener(
        "touchend",
        stopDrawing,
        { passive: false }
    );
}


/* ============================================================
   SELECT SIGNATURE METHOD
   ============================================================ */

function selectSignatureMethod(
    signatureKey,
    method
) {

    const wrapper =
        document.getElementById(
            "signatureWrapper_" + signatureKey
        );

    if (!wrapper) {
        return;
    }

    wrapper
        .querySelectorAll(".signature-method-btn")
        .forEach(function (button) {

            button.classList.remove("active");

        });

    const selectedButton =
        wrapper.querySelector(
            '[data-method="' + method + '"]'
        );

    if (selectedButton) {
        selectedButton.classList.add("active");
    }

    wrapper
        .querySelectorAll(".signature-option")
        .forEach(function (option) {

            option.classList.remove("active");

        });

    const selectedOption =
        wrapper.querySelector(
            '[data-signature-option="' + method + '"]'
        );

    if (selectedOption) {

        selectedOption.classList.add("active");
    }

    const methodInput =
        document.getElementById(
            "signatureMethod_" + signatureKey
        );

    if (methodInput) {

        methodInput.value = method;
    }

    if (method === "draw") {

        initializeSignature(signatureKey);
    }
}


/* ============================================================
   CLEAR DRAWING
   ============================================================ */

function clearSignature(signatureKey) {

    const signature =
        signatureCanvases[signatureKey];

    if (!signature) {
        return;
    }

    signature.ctx.clearRect(
        0,
        0,
        signature.canvas.width,
        signature.canvas.height
    );

    const base64Input =
        document.getElementById(
            "signatureBase64_" + signatureKey
        );

    if (base64Input) {
        base64Input.value = "";
    }
}


/* ============================================================
   SAVE DRAW SIGNATURE TO HIDDEN FIELD
   ============================================================ */

function saveDrawSignature(signatureKey) {

    const signature =
        signatureCanvases[signatureKey];

    if (!signature) {

        initializeSignature(signatureKey);

        return;
    }

    const canvas =
        signature.canvas;

    const base64 =
        canvas.toDataURL("image/png");

    const base64Input =
        document.getElementById(
            "signatureBase64_" + signatureKey
        );

    if (base64Input) {

        base64Input.value = base64;
    }

    const preview =
        document.getElementById(
            "signaturePreview_" + signatureKey
        );

    if (preview) {

        preview.src = base64;
        preview.style.display = "block";
    }

    alert("Signature saved.");
}


/* ============================================================
   TYPE SIGNATURE
   ============================================================ */

function saveTypedSignature(signatureKey) {

    const input =
        document.getElementById(
            "signatureType_" + signatureKey
        );

    if (!input) {
        return;
    }

    const text =
        input.value.trim();

    if (!text) {

        alert("Please enter your signature.");

        return;
    }

    const canvas =
        document.createElement("canvas");

    canvas.width = 700;
    canvas.height = 180;

    const ctx =
        canvas.getContext("2d");

    ctx.fillStyle = "#ffffff";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.fillStyle = "#000000";

    ctx.font =
        '48px "Brush Script MT", "Segoe Script", cursive';

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        text,
        canvas.width / 2,
        canvas.height / 2
    );

    const base64 =
        canvas.toDataURL("image/png");

    const base64Input =
        document.getElementById(
            "signatureBase64_" + signatureKey
        );

    if (base64Input) {

        base64Input.value = base64;
    }

    const preview =
        document.getElementById(
            "signaturePreview_" + signatureKey
        );

    if (preview) {

        preview.src = base64;
        preview.style.display = "block";
    }

    alert("Signature saved.");
}
