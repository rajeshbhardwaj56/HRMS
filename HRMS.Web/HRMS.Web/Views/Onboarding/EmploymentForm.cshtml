<div id="step-5"
     class="onboarding-step @(currentStep == 5 ? "active-step" : "") @(isHROrAdmin ? "hr-admin-readonly" : "")">

    <div class="section-title">
        Bank Account Details
    </div>


    <div class="info-box">

        Please provide the employee's bank account details carefully.
        The account details should match the employee's bank records.

    </div>


    <input type="hidden"
           name="BankDetailID"
           value="@bankDetails.BankDetailID" />


    <input type="hidden"
           name="BankDetailsList[0].BankDetailID"
           value="@bankDetails.BankDetailID" />

    <input type="hidden"
           name="BankDetailsList[0].OnboardingID"
           value="@bankDetails.OnboardingID" />


    <div class="row">

        <!-- Account Holder Name -->

        <div class="col-md-4">

            <label class="form-label">

                Account Holder Name
                <span class="required">*</span>

            </label>

            <input type="text"
                   class="form-control"
                   name="BankDetailsList[0].AccountHolderName"
                   value="@bankDetails.AccountHolderName"
                   maxlength="200"
                   required />

        </div>


        <!-- Bank Name -->

        <div class="col-md-4">

            <label class="form-label">

                Bank Name
                <span class="required">*</span>

            </label>

            <input type="text"
                   class="form-control"
                   name="BankDetailsList[0].BankName"
                   value="@bankDetails.BankName"
                   maxlength="200"
                   required />

        </div>


        <!-- Branch Name -->

        <div class="col-md-4">

            <label class="form-label">
                Branch Name
            </label>

            <input type="text"
                   class="form-control"
                   name="BankDetailsList[0].BranchName"
                   value="@bankDetails.BranchName"
                   maxlength="200" />

        </div>

    </div>


    <div class="row mt-3">

        <!-- Account Number -->

        <div class="col-md-4">

            <label class="form-label">

                Account Number
                <span class="required">*</span>

            </label>

            <input type="text"
                   class="form-control"
                   name="BankDetailsList[0].AccountNumber"
                   value="@bankDetails.AccountNumber"
                   maxlength="30"
                   inputmode="numeric"
                   required />

        </div>


        <!-- IFSC -->

        <div class="col-md-4">

            <label class="form-label">

                IFSC Code
                <span class="required">*</span>

            </label>

            <input type="text"
                   class="form-control"
                   name="BankDetailsList[0].IFSCCode"
                   value="@bankDetails.IFSCCode"
                   maxlength="11"
                   style="text-transform:uppercase;"
                   required />

        </div>


        <!-- Account Type -->

        <div class="col-md-4">

            <label class="form-label">
                Account Type
            </label>

            <select class="form-select"
                    name="BankDetailsList[0].AccountType">

                <option value="">
                    Select Account Type
                </option>

                <option value="Savings"
                        selected="@(bankDetails.AccountType == "Savings")">
                    Savings
                </option>

                <option value="Current"
                        selected="@(bankDetails.AccountType == "Current")">
                    Current
                </option>

                <option value="Salary"
                        selected="@(bankDetails.AccountType == "Salary")">
                    Salary
                </option>

            </select>

        </div>

    </div>


    <!-- ============================================================
         BANK DOCUMENT
    ============================================================ -->

    <div class="section-title mt-4">
        Bank Document
    </div>


    <div class="row">

        <div class="col-md-6">

            <label class="form-label">

                Bank Passbook / Cancelled Cheque
                <span class="required">*</span>

            </label>


            <input type="file"
                   class="form-control"
                   name="BankDocumentFile"
                   id="BankDocumentFile"
                   accept=".pdf,.jpg,.jpeg,.png" />


            <small class="text-muted">

                Upload cancelled cheque, bank passbook or bank statement.
                PDF/JPG/JPEG/PNG only. Maximum size 5 MB.

