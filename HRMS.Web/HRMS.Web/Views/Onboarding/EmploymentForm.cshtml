        function removeRow(button) {

            if (!button) {
                return;
            }

            // Find the closest dynamic row/card
            const card = button.closest(
                ".family-row, " +
                ".education-card, " +
                ".employment-row, " +
                ".nominee-row"
            );

            if (!card) {
                console.warn("Remove: row/card not found.");
                return;
            }

            const container = card.parentElement;

            if (!container) {
                return;
            }

            /* =========================================================
               NOMINEE ROW
               Keep existing nominee-specific behavior
            ========================================================= */

            if (card.classList.contains("nominee-row")) {

                const rows = container.querySelectorAll(".nominee-row");

                // Do not remove the last nominee row
                if (rows.length <= 1) {

                    const select =
                        card.querySelector(".family-member-select");

                    if (select) {
                        select.value = "";
                    }

                    if (typeof clearNomineeFields === "function") {
                        clearNomineeFields(
                            card,
                            card.classList.contains("eps-nominee-row")
                                ? "EPS"
                                : "Nominee"
                        );
                    }

                    const percentageFields =
                        card.querySelectorAll(
                            ".epf-percentage, .gratuity-percentage"
                        );

                    percentageFields.forEach(function (field) {
                        field.value = "";
                    });

                    if (typeof calculateEPFTotal === "function") {
                        calculateEPFTotal();
                    }

                    if (typeof calculateGratuityTotal === "function") {
                        calculateGratuityTotal();
                    }

                    return;
                }

                // Remove nominee
                card.remove();

                // Re-index nominee rows
                if (container.id === "epfNomineeContainer") {

                    reindexNomineeRows(
                        container,
                        "EPFNomineeList",
                        "EPF"
                    );

                    updateNomineeTitles(
                        "epf-nominee-row",
                        "EPF Nominee"
                    );

                    if (typeof calculateEPFTotal === "function") {
                        calculateEPFTotal();
                    }
                }

                if (container.id === "epsNomineeContainer") {

                    reindexNomineeRows(
                        container,
                        "EPSNomineeList",
                        "EPS"
                    );

                    updateNomineeTitles(
                        "eps-nominee-row",
                        "EPS Family Member"
                    );
                }

                if (container.id === "gratuityNomineeContainer") {

                    reindexNomineeRows(
                        container,
                        "GratuityNomineeList",
                        "Gratuity"
                    );

                    updateNomineeTitles(
                        "gratuity-nominee-row",
                        "Gratuity Nominee"
                    );

                    if (typeof calculateGratuityTotal === "function") {
                        calculateGratuityTotal();
                    }
                }

                return;
            }


            /* =========================================================
               FAMILY / EDUCATION / EMPLOYMENT
            ========================================================= */

            card.remove();

            // Update titles after removing the row
            if (typeof updateDynamicTitles === "function") {
                updateDynamicTitles();
            }

        }


        /* ================================================================
           RE-INDEX NOMINEE ROWS
        ================================================================ */

        function reindexNomineeRows(
            container,
            listName,
            nomineeType
        ) {

            const rows =
                container.querySelectorAll(
                    ".nominee-row"
                );


            rows.forEach(function (row, index) {

                /*
                   Update every input/select/textarea name.
                */

                const controls =
                    row.querySelectorAll(
                        "input, select, textarea"
                    );


                controls.forEach(function (control) {

                    if (!control.name) {
                        return;
                    }


                    /*
                       Replace:
                       EPFNomineeList[old].Field

                       with:
                       EPFNomineeList[index].Field
                    */

                    const regex =
                        new RegExp(
                            "^" +
                            listName.replace(
                                /[.*+?^${}()|[\]\\]/g,
                                "\\$&"
                            ) +
                            "\\[\\d+\\]"
                        );


                    control.name =
                        control.name.replace(
                            regex,
                            listName + "[" + index + "]"
                        );

                });


                /*
                   Make sure NomineeType is correct.
                */

                const typeField =
                    row.querySelector(
                        `input[name*=".NomineeType"]`
                    );

                if (typeField) {
                    typeField.value =
                        nomineeType;
                }


                /*
                   Update select onchange.
                */

                const select =
                    row.querySelector(
                        ".family-member-select"
                    );

                if (select) {

                    if (nomineeType === "EPF") {

                        select.setAttribute(
                            "onchange",
                            "fillEPFNomineeFromFamily(this)"
                        );

                    }
                    else if (nomineeType === "EPS") {

                        select.setAttribute(
                            "onchange",
                            "fillEPSNomineeFromFamily(this)"
                        );

                    }
                    else if (
                        nomineeType === "Gratuity"
                    ) {

                        select.setAttribute(
                            "onchange",
                            "fillGratuityNomineeFromFamily(this)"
                        );
                    }
                }

            });
        }

