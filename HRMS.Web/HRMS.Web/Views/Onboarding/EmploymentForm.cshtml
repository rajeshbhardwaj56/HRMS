        function saveCurrentStep(goNext) {

            console.log("=================================");
            console.log("SAVE CURRENT STEP");
            console.log("Current Step:", currentInterviewStep);
            console.log("Go Next:", goNext);
            console.log("=================================");
            if (isSavingStep) { console.log( "Save already in progress. Ignoring request." ); return; } isSavingStep = true;
            const form =
                document.getElementById("employeeOnboardingForm");

            if (!form) {

                console.error(
                    "employeeOnboardingForm not found."
                );

                return;
            }

            const step =
                parseInt(currentInterviewStep);

            if (isNaN(step) || step < 1 || step > totalInterviewSteps) {

                console.error(
                    "Invalid current step:",
                    currentInterviewStep
                );

                return;
            }


            /* ============================================================
               GET CURRENT STEP CONTAINER
            ============================================================ */

            const currentContainer =
                document.getElementById(
                    "step-" + step
                );

            if (!currentContainer) {

                console.error(
                    "Step container not found:",
                    "step-" + step
                );

                return;
            }


           /* ============================================================
   VALIDATE CURRENT STEP
   SAVE + NEXT BOTH VALIDATE REQUIRED FIELDS
============================================================ */

console.log("Validating Step:", step);

const requiredFields =
    currentContainer.querySelectorAll(
        "input[required], select[required], textarea[required]"
    );

for (let i = 0; i < requiredFields.length; i++) {

    const field = requiredFields[i];

    /*
       Ignore disabled fields because disabled fields
       should not be required/validated.
    */
    if (field.disabled) {
        continue;
    }

    if (!field.checkValidity()) {

        console.log(
            "Validation failed:",
            field.name,
            "Value:",
            field.value
        );

        field.reportValidity();
        field.focus();

        isSavingStep = false;

        return;
    }
}

            /* ============================================================
               CREATE FORM DATA
               ONLY CURRENT STEP
            ============================================================ */

            const formData =
                new FormData();


            const fields =
                currentContainer.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                );


            fields.forEach(function (field) {

                if (field.disabled) {
                    return;
                }


                /* ========================================================
                   CHECKBOX
                ======================================================== */

                if (field.type === "checkbox") {

                    formData.append(
                        field.name,
                        field.checked
                            ? (field.value || "true")
                            : "false"
                    );

                    return;
                }


                /* ========================================================
                   RADIO
                ======================================================== */

                if (field.type === "radio") {

                    if (field.checked) {

                        formData.append(
                            field.name,
                            field.value
                        );
                    }

                    return;
                }


                /* ========================================================
                   FILE
                ======================================================== */

                if (field.type === "file") {

                    if (
                        field.files &&
                        field.files.length > 0
                    ) {

                        for (
                            let i = 0;
                            i < field.files.length;
                            i++
                        ) {

                            formData.append(
                                field.name,
                                field.files[i]
                            );
                        }
                    }

                    return;
                }


                /* ========================================================
                   NORMAL INPUT
                ======================================================== */

                formData.append(
                    field.name,
                    field.value
                );

            });


            /* ============================================================
               COMMON VALUES
            ============================================================ */

            const onboardingInput =
                document.getElementById(
                    "OnboardingID"
                );

            const onboardingID =
                onboardingInput
                    ? (
                        onboardingInput.value ||
                        "0"
                    )
                    : "0";


            formData.set(
                "OnboardingID",
                onboardingID
            );


            formData.set(
                "CurrentStep",
                step.toString()
            );


            formData.set(
                "FormAction",
                "Save"
            );


            /* ============================================================
               ANTI FORGERY TOKEN
            ============================================================ */

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            if (token) {

                formData.append(
                    "__RequestVerificationToken",
                    token.value
                );
            }


            /* ============================================================
               BUTTONS
            ============================================================ */

            const saveButton =
                document.getElementById(
                    "saveButton"
                );

            const nextButton =
                document.getElementById(
                    "nextButton"
                );


            if (saveButton) {

                saveButton.disabled = true;
                saveButton.innerText = "Saving...";
            }


            if (nextButton) {

                nextButton.disabled = true;
            }


            /* ============================================================
               AJAX SAVE
            ============================================================ */
        fetch(
            '@Url.Action("AddUpdateEmployeeDetailsOnboarding", "Onboarding")',
            {
                method: "POST",
                body: formData,
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Accept": "application/json"
                }
            }
        )
        .then(async function (response) {

            console.log("=================================");
            console.log("FETCH RESPONSE");
            console.log("HTTP Status:", response.status);
            console.log("HTTP OK:", response.ok);
            console.log("Content-Type:", response.headers.get("content-type"));
            console.log("URL:", response.url);
            console.log("=================================");

            const responseText = await response.text();

            console.log("RAW SERVER RESPONSE:");
            console.log(responseText);

            if (!response.ok) {
                throw new Error(
                    "Server returned HTTP " +
                    response.status +
                    "\n\n" +
                    responseText.substring(0, 500)
                );
            }

            if (!responseText) {
                throw new Error("Server returned an empty response.");
            }

            let result;

            try {
                result = JSON.parse(responseText);
            }
            catch (e) {

                console.error("JSON PARSE ERROR:", e);
                console.error("SERVER RETURNED:", responseText);

                throw new Error(
                    "Server did not return JSON. Check the RAW SERVER RESPONSE in Console."
                );
            }

            return result;
        })
            .then(function (result) {

                console.log(
                    "SERVER RESPONSE:",
                    result
                );


                /* ========================================================
                   SAVE FAILED
                ======================================================== */

                if (
                    !result ||
                    result.success !== true
                ) {

                    alert(
                        result &&
                        result.message
                            ? result.message
                            : "Unable to save Step " + step
                    );

                    return;
                }


                /* ========================================================
                   UPDATE ONBOARDING ID
                ======================================================== */

                if (
                    result.onboardingID !== undefined &&
