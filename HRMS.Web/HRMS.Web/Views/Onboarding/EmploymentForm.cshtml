@using System
@using System.Linq
@using HRMS.Models.Common
@using HRMS.Models.EmployeeOnboarding
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IConfiguration _configuration
@model EmployeeOnboardingPageViewModel

@{
    Layout = null;

    var employee = Model.EmployeeDetails
               ?? new EmployeeDetailsOnboardingModel();

    var familyList = Model.FamilyList
                     ?? new List<EmployeeOnboardingFamilyModel>();

    var educationList = Model.EducationList
                        ?? new List<EmployeeOnboardingEducationModel>();

    var employmentList = Model.EmploymentList
                         ?? new List<EmployeeOnboardingEmploymentModel>();

    var bankDetails = Model.BankDetailsList?.FirstOrDefault()
                      ?? new EmployeeOnboardingBankDetailsModel();

    var documentList = Model.DocumnetList
                       ?? new List<EmployeeOnboardingDocumentsModel>();

    var interviewEvaluation =
        Model.InterviewEvaluationList?.FirstOrDefault()
        ?? new EmployeeOnboardingInterviewEvaluationModel();
    var reportingManagerList =
        Model.ReportingManagerList
        ?? new List<EmployeeOnboardingReportingManagerModel>();

    var witnessList =
        Model.WitnessList
        ?? new List<EmployeeOnboardingWitnessModel>();
    var profilePhoto = !string.IsNullOrEmpty(employee.EmployeePhoto)
        ? employee.EmployeePhoto
        : HRMS.Models.Common.Constants.NoImagePath;


    // ============================================================
    // ROLE ID
    // ============================================================

    var roleIdString = Context.Session.GetString(Constants.RoleID);

    int roleId = 0;

    int.TryParse(roleIdString, out roleId);


    // ============================================================
    // HR / ADMIN CHECK
    // ============================================================

    bool isHROrAdmin =
        roleId == (int)Roles.Admin ||
        roleId == (int)Roles.SuperAdmin ||
        roleId == (int)Roles.HR;


    // ============================================================
    // NORMAL CURRENT STEP
    // ============================================================

    int currentStep = Model?.CurrentStep > 0
        ? Model.CurrentStep
        : 1;

    int lastSavedStep = Model?.LastSavedStep > 0
        ? Model.LastSavedStep
        : 0;


    // ============================================================
    // HR / ADMIN
    // SHOULD OPEN DIRECTLY ON STEP 7
    // ============================================================
// ============================================================
// ROLE-BASED STEP LIMIT
// ============================================================

// HR/Admin:
// Step 1 to Step 9 are available.
//
// Employee:
// Step 1 to Step 7 are available.
// If HR has already moved the onboarding to Step 8 or 9,
// employee must still open the last employee-visible step: Step 7.

int maxStep = isHROrAdmin ? 9 : 7;

// Normalize current step according to the user's role
currentStep = Math.Max(1, Math.Min(currentStep, maxStep));

// Keep the actual saved progress,
// but don't allow employee-side navigation beyond Step 7.
lastSavedStep = Math.Max(0, lastSavedStep);

if (!isHROrAdmin && lastSavedStep > 7)
{
    lastSavedStep = 7;
}

if (isHROrAdmin && lastSavedStep > 9)
{
    lastSavedStep = 9;
}
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Employee Onboarding</title>
    <link rel="shortcut icon"
          href="~/assets/img/favicon/Protalkfavicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Public Sans', sans-serif;
                background: #f5f7fa;
                color: #2f3349;
            }

            /* =========================================================
                       HEADER
                    ========================================================= */

            .onboarding-header {
                background: #05397b;
                color: white;
                padding: 18px 30px;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .header-content {
                max-width: 1200px;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .logo {
                max-height: 50px;
                max-width: 190px;
                object-fit: contain;
            }

            .header-title {
                font-size: 18px;
                font-weight: 600;
            }

            /* =========================================================
                       MAIN
                    ========================================================= */

            .onboarding-wrapper {
                padding: 30px 15px 50px;
            }

            .onboarding-container {
                max-width: 1200px;
                margin: auto;
                background: white;
                border-radius: 12px;
                box-shadow: 0 5px 25px rgba(0, 0, 0, .07);
                overflow: hidden;
            }

            /* =========================================================
                           PROGRESS
                        ========================================================= */

            .progress-container {
                padding: 30px 25px 25px;
                background: #ffffff;
                border-bottom: 1px solid #edf0f5;
                overflow-x: auto;
            }

            .progress-steps {
                min-width: 900px;
                position: relative;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-top:10px;
            }

            .progress-line {
                position: absolute;
                top: 19px;
                left: 5%;
                right: 5%;
                height: 3px;
                background: #dfe5ec;
                z-index: 1;
            }

            .step {
                width: 14.28%;
                position: relative;
                z-index: 2;
                text-align: center;
                cursor: pointer;
            }

            /* =========================================================
                           STEP CIRCLE
                        ========================================================= */

            .step-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                margin: 0 auto 9px;
                background: #ffffff;
                border: 3px solid #d8dee7;
                color: #7b8794;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 14px;
                font-weight: 700;
                transition: all 0.25s ease;
            }

            /* =========================================================
                           STEP LABEL
                        ========================================================= */

            .step-label {
                font-size: 12px;
                font-weight: 600;
                color: #7b8794;
                line-height: 1.3;
                padding: 0 5px;
                transition: all 0.25s ease;
            }

            /* =========================================================
                           ACTIVE STEP
                        ========================================================= */

            .step.active .step-circle {
                background: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
                box-shadow: 0 0 0 5px rgba(3, 74, 161, .12);
                transform: scale(1.15);
            }

            .step.active .step-label {
                color: #0d6efd;
                font-weight: 700;
            }

            /* =========================================================
                           COMPLETED STEP
                        ========================================================= */

            .step.completed .step-circle {
                background: #198754;
                border-color: #198754;
                color: #ffffff;
            }

            .step.completed .step-label {
                color: #198754;
                font-weight: 600;
            }

            /* =========================================================
                           HOVER EFFECT
                        ========================================================= */

            /* Hover on future/inactive steps */
            .step:not(.active):hover .step-circle {
                background: #eaf3ff;
                border-color: #0d6efd;
                color: #0d6efd;
                transform: scale(1.08);
                box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.10), 0 3px 8px rgba(0, 0, 0, 0.12);
            }

            .step:not(.active):hover .step-label {
                color: #0d6efd;
                font-weight: 600;
            }

            /* Hover on completed steps */
            .step.completed:hover .step-circle {
                background: #e8f7ef;
                border-color: #198754;
                color: #198754;
                transform: scale(1.08);
                box-shadow: 0 0 0 5px rgba(25, 135, 84, 0.10), 0 3px 8px rgba(0, 0, 0, 0.12);
            }

            .step.completed:hover .step-label {
                color: #198754;
            }

            /* Hover on currently active step */
            .step.active:hover .step-circle {
                background: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
                transform: scale(1.18);
                box-shadow: 0 0 0 6px rgba(13, 110, 253, 0.15), 0 4px 10px rgba(0, 0, 0, 0.15);
            }

            .step.active:hover .step-label {
                color: #0d6efd;
                font-weight: 700;
            }

            /* =========================================================
                           CLICKABLE CURSOR
                        ========================================================= */

            .step,
            .step-circle,
            .step-label {
                cursor: pointer;
            }

            /* =========================================================
                           RESPONSIVE
                        ========================================================= */

            @@media (max-width: 768px) {

                .progress-container {
                    padding: 20px 10px;
                }

                .progress-steps {
                    min-width: 900px;
                }

                .step-label {
                    font-size: 10px;
                }

                .step-circle {
                    width: 36px;
                    height: 36px;
                    font-size: 12px;
                }
            }

            /* =========================================================
                       FORM CONTENT
                    ========================================================= */

            .form-content {
                padding: 35px;
            }

            .form-title {
                font-size: 24px;
                font-weight: 600;
                color: #05397b;
                margin-bottom: 5px;
            }

            .form-subtitle {
                color: #6c757d;
                margin-bottom: 20px;
                font-size: 14px;
            }

            .info-box {
                background: #f5f8fc;
                border: 1px solid #dfe8f3;
                border-radius: 6px;
                padding: 12px 15px;
                font-size: 12px;
                color: #666;
                margin-bottom: 20px;
            }

            /* =========================================================
                       STEP CONTENT
                    ========================================================= */

            .onboarding-step {
                display: none;
            }

                .onboarding-step.active-step {
                    display: block;
                }

            .section-title {
                margin-top: 28px;
                margin-bottom: 18px;
                padding: 11px 15px;
                background: #f3f7fc;
                border-left: 4px solid #05397b;
                color: #05397b;
                font-size: 16px;
                font-weight: 700;
                border-radius: 4px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            .form-label {
                font-size: 13px;
                font-weight: 500;
                margin-bottom: 7px;
                color: #444;
            }

            .form-control,
            .form-select {
                min-height: 40px;
                border: 1px solid #d9e0e8;
                border-radius: 5px;
                font-size: 13px;
            }

            textarea.form-control {
                min-height: 90px;
                resize: vertical;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: #034aa1;
                box-shadow: 0 0 0 .15rem rgba(3, 74, 161, .10);
            }

            .readonly-field {
                background: #f3f5f7 !important;
                cursor: not-allowed;
            }

            .required {
                color: #dc3545;
            }

            /* =========================================================
                       DYNAMIC CARDS
                    ========================================================= */

            .dynamic-card {
                background: #ffffff;
                border: 1px solid #e0e6ed;
                border-radius: 8px;
                padding: 18px;
                margin-bottom: 18px;
                box-shadow: 0 2px 7px rgba(0, 0, 0, .03);
            }

            .dynamic-card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 18px;
                padding-bottom: 10px;
                border-bottom: 1px solid #edf0f4;
            }

            .dynamic-card-title {
                font-size: 14px;
                font-weight: 600;
                color: #05397b;
            }

            .btn-add {
                border: none;
                background: #05397b;
                color: #ffffff;
                padding: 7px 13px;
                border-radius: 5px;
                font-size: 12px;
                font-weight: 600;
            }

                .btn-add:hover {
                    background: #023777;
                }

            .btn-remove {
                border: none;
                background: #dc3545;
                color: #ffffff;
                padding: 6px 11px;
                border-radius: 4px;
                font-size: 11px;
            }

            /* =========================================================
                       INTERVIEW RATING
                    ========================================================= */

            .rating-card {
                border: 1px solid #e0e6ed;
                border-radius: 8px;
                padding: 18px;
                margin-bottom: 15px;
                background: #fff;
            }

            .rating-title {
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 12px;
            }

            .rating-options {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
            }

            .rating-option {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 13px;
            }

            .recommendation-box {
                padding: 20px;
                border: 1px solid #dce3eb;
                border-radius: 8px;
                background: #f9fbfd;
            }

            /* =========================================================
                       FOOTER BUTTONS
                    ========================================================= */

            .form-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-top: 35px;
                padding-top: 20px;
                border-top: 1px solid #e7ebef;
            }

            .footer-left,
            .footer-right {
                display: flex;
                gap: 10px;
            }

            .btn-primary-custom {
                border: none;
                background: #034aa1;
                color: #ffffff;
                padding: 10px 22px;
                border-radius: 5px;
                font-size: 13px;
                font-weight: 600;
            }

                .btn-primary-custom:hover {
                    background: #023777;
                }

            .btn-secondary-custom {
                border: 1px solid #cfd6df;
                background: #ffffff;
                color: #374151;
                padding: 10px 22px;
                border-radius: 5px;
                font-size: 13px;
                font-weight: 600;
            }

                .btn-secondary-custom:hover {
                    background: #f4f6f8;
                }

            .btn-success-custom {
                border: none;
                background: #198754;
                color: #ffffff;
                padding: 10px 22px;
                border-radius: 5px;
                font-size: 13px;
                font-weight: 600;
            }

            /* =========================================================
                       PHOTO
                    ========================================================= */

            .photo-preview {
                width: 90px;
                height: 105px;
                object-fit: cover;
                border: 1px solid #dce2e9;
                border-radius: 5px;
                background: #f4f6f8;
            }

            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 768px) {

                .onboarding-header {
                    padding: 12px 15px;
                }

                .header-content {
                    flex-direction: column;
                    gap: 10px;
                }

                .header-title {
                    font-size: 18px;
                }

                .form-content {
                    padding: 20px 15px;
                }

                .form-footer {
                    flex-direction: column;
                    align-items: stretch;
                }

                .footer-left,
                .footer-right {
                    width: 100%;
                }

                    .footer-left button,
                    .footer-right button {
                        flex: 1;
                    }
            }
            /* =========================================================
                         LOCKED FUTURE STEPS
                           ========================================================= */

            .step.locked {
                cursor: not-allowed !important;
                opacity: 0.55;
            }

                .step.locked .step-circle {
                    background: #f3f5f7;
                    border-color: #d8dee7;
                    color: #9aa3ad;
                }

                .step.locked:hover .step-circle {
                    background: #f3f5f7;
                    border-color: #d8dee7;
                    color: #9aa3ad;
                    transform: none;
                    box-shadow: none;
                }
            /* ---------------------------------------------------------
                   SECTION TITLE
                --------------------------------------------------------- */

            #step-8 .section-title {
                margin-top: 25px;
                margin-bottom: 18px;
                padding: 10px 15px;
                font-size: 17px;
                font-weight: 600;
                border-left: 4px solid #034aa1;
                background: #f5f7fa;
                color: #222;
            }


            /* ---------------------------------------------------------
                   RATING INSTRUCTION
                --------------------------------------------------------- */

            #step-8 .rating-instruction {
                margin-bottom: 12px;
                padding: 10px 14px;
                background: #f8f9fa;
                border: 1px solid #dee2e6;
                border-radius: 5px;
                font-size: 13px;
                color: #555;
            }


            /* ---------------------------------------------------------
                   RATING TABLE
                --------------------------------------------------------- */

            #step-8 .interview-rating-table {
                margin-bottom: 0;
                vertical-align: middle;
                border-color: #d9dee5;
            }


                #step-8 .interview-rating-table thead th {
                    text-align: center;
                    vertical-align: middle;
                    background: #034aa1;
                    color: #fff;
                    font-weight: 600;
                    padding: 11px;
                }


                #step-8 .interview-rating-table tbody td {
                    vertical-align: middle;
                    padding: 10px;
                }


                    #step-8 .interview-rating-table tbody td:first-child {
                        background: #fafbfc;
                    }


            #step-8 .rating-select {
                min-width: 150px;
            }


            /* ---------------------------------------------------------
                   OVERALL RATING
                --------------------------------------------------------- */

            #step-8 .overall-rating-container {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 12px;
                margin-top: 5px;
            }


            #step-8 .overall-rating-option {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100px;
                padding: 12px;
                text-align: center;
                border: 1px solid #d9dee5;
                border-radius: 8px;
                background: #fff;
                cursor: pointer;
                transition: all 0.2s ease;
            }


                #step-8 .overall-rating-option:hover {
                    border-color: #034aa1;
                    background: #f5f8fc;
                }


                #step-8 .overall-rating-option input {
                    margin-bottom: 8px;
                    cursor: pointer;
                }


                    #step-8 .overall-rating-option input:checked + .rating-number {
                        background: #034aa1;
                        color: #fff;
                    }


            #step-8 .rating-number {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 35px;
                height: 35px;
                margin-bottom: 8px;
                border-radius: 50%;
                background: #e9ecef;
                font-weight: 700;
            }


            /* ---------------------------------------------------------
                   COMMENT CARD
                --------------------------------------------------------- */

            #step-8 .comment-card {
                height: 100%;
                padding: 15px;
                border: 1px solid #dee2e6;
                border-radius: 7px;
                background: #fff;
            }


                #step-8 .comment-card textarea {
                    resize: vertical;
                    min-height: 130px;
                }


            /* ---------------------------------------------------------
                   SIGNATURE CARD
                --------------------------------------------------------- */

            #step-8 .signature-upload-card {
                height: 100%;
                padding: 15px;
                border: 1px solid #dee2e6;
                border-radius: 8px;
                background: #fff;
            }


                #step-8 .signature-upload-card:hover {
                    border-color: #034aa1;
                }


            #step-8 .signature-preview {
                max-width: 220px;
                max-height: 100px;
                object-fit: contain;
                border: 1px solid #dee2e6;
                padding: 5px;
                background: #fff;
            }


            #step-8 .signature-preview-container {
                text-align: center;
            }


            /* ---------------------------------------------------------
                   REQUIRED
                --------------------------------------------------------- */

            #step-8 .required {
                color: #dc3545;
                font-weight: 600;
            }


            /* ---------------------------------------------------------
                   MOBILE
                --------------------------------------------------------- */

            @@media (max-width: 768px) {

                #step-8 .overall-rating-container {
                    grid-template-columns: 1fr;
                }

                #step-8 .interview-rating-table {
                    min-width: 750px;
                }
            }

            .onboarding-step {
                display: none;
            }

                .onboarding-step.active-step {
                    display: block;
                }

            /* =========================================================
               FAMILY-DERIVED READONLY FIELDS
               These values come automatically from Family Details.
            ========================================================= */

            .family-readonly {
                background-color: #f1f3f5 !important;
                color: #6c757d !important;
                border-color: #ced4da !important;
                cursor: not-allowed !important;
                opacity: 0.75;
            }

            textarea.family-readonly {
                background-color: #f1f3f5 !important;
                color: #6c757d !important;
                border-color: #ced4da !important;
                cursor: not-allowed !important;
                opacity: 0.75;
            }

            .family-readonly:focus {
                background-color: #f1f3f5 !important;
                color: #6c757d !important;
                border-color: #ced4da !important;
                box-shadow: none !important;
                outline: none !important;
            }

            .family-readonly::placeholder {
                color: #adb5bd !important;
            }

            /* Optional visual indication */

            .family-readonly-wrapper {
                position: relative;
            }

                .family-readonly-wrapper::after {
                    content: "From Family Details";
                    display: block;
                    font-size: 10px;
                    color: #868e96;
                    margin-top: 2px;
                }


            /* =========================================================
               NORMAL EDITABLE PERCENTAGE FIELD
            ========================================================= */

            .epf-percentage,
            .gratuity-percentage {
                background-color: #fff !important;
                color: #212529 !important;
                cursor: text !important;
                opacity: 1 !important;
            }


            .declaration-card {
                background: #ffffff;
                border: 1px solid #e5e7eb;
                border-radius: 10px;
                padding: 20px;
                margin-top: 16px;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .declaration-card:hover {
                    border-color: #d1d5db;
                    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
                }

            .declaration-card-header .form-label {
                color: #374151;
                font-size: 14px;
                font-weight: 600;
                line-height: 1.5;
            }

            .required {
                color: #dc2626;
                margin-left: 3px;
            }

            .radio-group {
                display: flex;
                align-items: center;
                gap: 28px;
            }

            .radio-option {
                position: relative;
                display: inline-flex;
                align-items: center;
                gap: 9px;
                cursor: pointer;
                color: #374151;
                font-size: 14px;
                font-weight: 500;
                user-select: none;
                margin: 0;
            }

                .radio-option input {
                    position: absolute;
                    opacity: 0;
                    pointer-events: none;
                }

            .radio-custom {
                width: 18px;
                height: 18px;
                border: 1.5px solid #9ca3af;
                border-radius: 50%;
                background: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s ease;
            }

            .radio-option input:checked + .radio-custom {
                border-color: #2563eb;
                background: #2563eb;
                box-shadow: inset 0 0 0 4px #ffffff;
            }

            .radio-option:hover .radio-custom {
                border-color: #2563eb;
            }

            .radio-option input:focus-visible + .radio-custom {
                outline: 3px solid rgba(37, 99, 235, 0.18);
                outline-offset: 2px;
            }

            .radio-text {
                line-height: 18px;
            }

            .conditional-details {
                padding: 18px;
                background: #f8fafc;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
            }

            .form-label {
                color: #374151;
                font-size: 13px;
                font-weight: 500;
                margin-bottom: 7px;
            }

            .form-control {
                min-height: 42px;
                border: 1px solid #d1d5db;
                border-radius: 7px;
                color: #374151;
                font-size: 14px;
                padding: 9px 12px;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .form-control::placeholder {
                    color: #9ca3af;
                }

                .form-control:focus {
                    border-color: #2563eb;
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
                }

            textarea.form-control {
                min-height: 100px;
                resize: vertical;
            }

            @@media (max-width: 767px) {

                .declaration-card {
                    padding: 16px;
                }

                .radio-group {
                    gap: 22px;
                }

                .conditional-details {
                    padding: 14px;
                }

                .section-title {
                    font-size: 18px;
                }
            }
            /* ============================================================
               HR / ADMIN READONLY MODE
               Steps other than Interview Evaluation
               ============================================================ */

            .hr-admin-readonly input:not([type="hidden"]),
            .hr-admin-readonly select,
            .hr-admin-readonly textarea {
                background-color: #f8f9fa !important;
                cursor: not-allowed !important;
            }

                /* Text/date/number/email/etc. */
                .hr-admin-readonly input:not([type="hidden"]):not([type="file"]) {
                    pointer-events: none;
                }

            /* Selects */
            .hr-admin-readonly select {
                pointer-events: none;
            }

            /* Textareas */
            .hr-admin-readonly textarea {
                pointer-events: none;
            }

            /* File uploads */
            .hr-admin-readonly input[type="file"] {
                pointer-events: none;
                opacity: 0.65;
            }

            /* Checkboxes / radios */
            .hr-admin-readonly input[type="checkbox"],
            .hr-admin-readonly input[type="radio"] {
                pointer-events: none;
            }

            /* Buttons inside readonly sections */
            .hr-admin-readonly button:not(.step-navigation-btn),
            .hr-admin-readonly .btn:not(.step-navigation-btn) {
                pointer-events: none;
                opacity: 0.65;
            }
/* ============================================================
   SIGNATURE OPTIONS
   ============================================================ */

.signature-method-wrapper {
    margin-top: 10px;
}

.signature-method-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.signature-method-btn {
    border: 1px solid #d9e0e8;
    background: #fff;
    color: #495057;
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s ease;
}

.signature-method-btn:hover {
    border-color: #05397b;
    color: #05397b;
}

.signature-method-btn.active {
    background: #05397b;
    border-color: #05397b;
    color: #fff;
}

.signature-option {
    display: none;
}

.signature-option.active {
    display: block;
}

.signature-canvas-wrapper {
    border: 1px solid #d9e0e8;
    border-radius: 7px;
    background: #fff;
    padding: 10px;
    max-width: 600px;
}

.signature-canvas {
    width: 100%;
    height: 180px;
    border: 1px dashed #adb5bd;
    border-radius: 5px;
    background: #fff;
    cursor: crosshair;
    touch-action: none;
}

.signature-actions {
    margin-top: 10px;
    display: flex;
    gap: 8px;
}

.signature-type-input {
    font-family: "Brush Script MT",
                 "Segoe Script",
                 cursive;
    font-size: 34px;
    height: 70px;
}

.signature-preview-box {
    margin-top: 12px;
    border: 1px solid #d9e0e8;
    border-radius: 6px;
    background: #fff;
    padding: 10px;
    width: 260px;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.signature-preview-box img {
    max-width: 240px;
    max-height: 100px;
    object-fit: contain;
}

.signature-existing {
    margin-top: 12px;
}

.signature-existing img {
    max-width: 240px;
    max-height: 100px;
    object-fit: contain;
}
    </style>

</head>

<body>

    <header class="onboarding-header">

        <div class="header-content">

            <img src="~/assets/img/logo/PROTALKLOGO.png"
                 class="logo"
                 alt="Company Logo" />

            <div class="header-title">
                Employee Onboarding
            </div>

        </div>

    </header>


    <div class="onboarding-wrapper">

        <div class="onboarding-container">


            <!-- =========================================================
             PROGRESS
        ========================================================== -->

            <div clas="progress-container">
                <div class="progress-steps">

                    <div class="progress-line"></div>


                    <!-- =========================================================
             STEP 1 - EMPLOYEE DETAILS
             ========================================================= -->

                    <div class="step @(currentStep == 1 ? "active" : currentStep > 1 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(1)">

                        <div class="step-circle">

                            @if (currentStep > 1)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>1</span>
                            }

                        </div>

                        <div class="step-label">
                            Employee Details
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 2 - FAMILY DETAILS
             ========================================================= -->

                    <div class="step @(currentStep == 2 ? "active" : currentStep > 2 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(2)">

                        <div class="step-circle">

                            @if (currentStep > 2)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>2</span>
                            }

                        </div>

                        <div class="step-label">
                            Family Details
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 3 - EDUCATION
             ========================================================= -->

                    <div class="step @(currentStep == 3 ? "active" : currentStep > 3 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(3)">

                        <div class="step-circle">

                            @if (currentStep > 3)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>3</span>
                            }

                        </div>

                        <div class="step-label">
                            Education
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 4 - PREVIOUS EMPLOYMENT
             ========================================================= -->

                    <div class="step @(currentStep == 4 ? "active" : currentStep > 4 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(4)">

                        <div class="step-circle">

                            @if (currentStep > 4)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>4</span>
                            }

                        </div>

                        <div class="step-label">
                            Previous Employment
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 5 - BANK DETAILS
             ========================================================= -->

                    <div class="step @(currentStep == 5 ? "active" : currentStep > 5 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(5)">

                        <div class="step-circle">

                            @if (currentStep > 5)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>5</span>
                            }

                        </div>

                        <div class="step-label">
                            Bank Details
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 6 - NOMINEE
             ========================================================= -->

                    <div class="step @(currentStep == 6 ? "active" : currentStep > 6 ? "completed" : "")"
                         onclick="openInterviewEvaluationStep(6)">

                        <div class="step-circle">

                            @if (currentStep > 6)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>6</span>
                            }

                        </div>

                        <div class="step-label">
                            Nominee
                        </div>

                    </div>


                    <!-- =========================================================
             STEP 7 - INTERVIEW EVALUATION
             ONLY HR / ADMIN
             ========================================================= -->

                        <div class="step @(currentStep == 7 ? "active" : currentStep > 7 ? "completed" : "")"
                             onclick="openInterviewEvaluationStep(7)">

                            <div class="step-circle">

                                @if (currentStep > 7)
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>7</span>
                                }

                            </div>

                            <div class="step-label">
                                Other Information
                            </div>

                        </div>



                    <!-- =========================================================
             OTHER INFORMATION

HR / ADMIN  -> STEP 8
             OTHER USERS -> STEP 7
             ========================================================= -->
                    @if (isHROrAdmin)
                    {
                        <div class="step @(currentStep == 8 ? "active" : currentStep > 8 ? "completed" : "")"
                             onclick="openInterviewEvaluationStep(8)">

                        <div class="step-circle">

                            @if (currentStep > 8)
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>8</span>
                                }


                        </div>

                        <div class="step-label">
                           
                             Interview Evaluation
                        </div>

                    </div>

                        <div class="step @(currentStep == 9 ? "active" : currentStep > 9 ? "completed" : "")"
                             onclick="openInterviewEvaluationStep(9)">

                            <div class="step-circle">

                                @if (currentStep > 9)
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>9</span>
                                }

                            </div>

                            <div class="step-label">
                               HR Review & Document Verification
                            </div>

                        </div>
                    }
                </div>
            </div>


            <!-- =========================================================
             FORM
        ========================================================== -->

            <div class="form-content">

                <h1 class="form-title">
                    Employee Onboarding Form
                </h1>

                <p class="form-subtitle">
                    Please provide your complete employment and personal information.
                    Fields marked with <span class="required">*</span> are mandatory.
                </p>

                <div class="info-box">
                    Please ensure that all information provided is correct.
                    You can save the form and continue later.
                </div>


                <form id="employeeOnboardingForm"
                      method="post"
                      enctype="multipart/form-data"
                      >

                    <!-- =================================================
                     COMMON HIDDEN VALUES
                ================================================== -->

                    <input type="hidden"
                           id="OnboardingID"
                           name="OnboardingID"
                           value="@Model?.OnboardingID" />

                    @*                 <input type="hidden"
                       id="EmployeeID"
                       name="EmployeeID"
                       value="@Model?.EmployeeID" /> *@

                    <input type="hidden"
                           id="Key"
                           name="Key"
                           value="@Model?.Key" />

                    <input type="hidden"
                           id="CurrentStep"
                           name="CurrentStep"
                           value="@currentStep" />
                    <input type="hidden"
                           id="LastSavedStep"
                           name="LastSavedStep"
                           value="@lastSavedStep" />

                    <!-- =================================================
                     STEP 1
                     EMPLOYEE DETAILS
                ================================================== -->

                    <div id="step-1"
                         class="onboarding-step @(currentStep == 1 ? "active-step" : "") @(isHROrAdmin ? "hr-admin-readonly" : "")">

                        <!-- =================================================
         EMPLOYMENT DETAILS
    ================================================== -->

                        <div class="section-title">
                            Employment Details
                        </div>

                        <div class="row">

                            <div class="col-md-3">

                                <div class="form-group">

                                    <label class="form-label">
                                        Date of Joining
                                    </label>

                                    <input type="date"
                                           class="form-control"
                                           name="DateOfJoining"
                                           value="@(employee?.DateOfJoining.HasValue == true
                                                                    ? employee.DateOfJoining.Value.ToString("yyyy-MM-dd")
                                                                    : DateTime.Today.ToString("yyyy-MM-dd"))" />

                                </div>

                            </div>


@*                             <div class="col-md-3">

                                <div class="form-group">

                                    <label class="form-label">
                                        Designation
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           name="Designation"
                                           value="@employee?.Designation" />

                                </div>

                            </div> *@


                            @*
        <div class="col-md-3">

            <div class="form-group">

                <label class="form-label">
                    Employee Code
                </label>

                <input type="text"
                       class="form-control readonly-field"
                       value="@employee?.EmployeeCode"
                       readonly />

            </div>

        </div>
        *@


                            <div class="col-md-3">

                                <label class="form-label">
                                    Employee Photo
                                    <span class="required">*</span>
                                </label>

                                <div class="d-flex align-items-center gap-3">

                                    <img id="employeePhotoPreview"
                                         src="@profilePhoto"
                                         class="photo-preview"
                                         alt="Employee Photo"
                                         onerror="this.onerror=null;this.src='@(HRMS.Models.Common.Constants.NoImagePath)'" />

                                    <div>

                                        <input type="file"
                                               class="form-control"
                                               id="EmployeePhotoFile"
                                               name="EmployeePhotoFile"
                                               accept="image/jpeg,image/png,image/jpg"
                                               onchange="showPreview(event)"
                                        @(string.IsNullOrEmpty(employee?.EmployeePhoto) ? "required" : "") />

                                        <small class="text-muted">
                                            JPG or PNG only. Maximum size: 2 MB.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
         PERSONAL DETAILS
    ================================================== -->

                        <div class="section-title">
                            Personal Details
                        </div>

                        <div class="row">

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label class="form-label">
                                        Employee Name
                                    </label>

                                    <input type="text"
                                           class="form-control readonly-field"
                                           value="@employee?.FullName"
                                           readonly />

                                </div>

                            </div>


                            <div class="col-md-4">

                                <div class="form-group">

                                    <label class="form-label">
                                        Father's / Husband's Name
                                        <span class="required">*</span>
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           name="FatherHusbandName"
                                           value="@employee?.FatherHusbandName"
                                           required />

                                </div>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Date of Birth
                                    <span class="required">*</span>
                                </label>

                                <input type="date"
                                       class="form-control"
                                       name="DateOfBirth"
                                       value="@(employee?.DateOfBirth.HasValue == true
                                                            ? employee.DateOfBirth.Value.ToString("yyyy-MM-dd")
                                                            : "")"
                                       required />

                            </div>

                        </div>


                        <div class="row mt-3">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Gender
                                    <span class="required">*</span>
                                </label>

                                <select class="form-select"
                                        name="Gender"
                                        required>

                                    <option value="">
                                        Select Gender
                                    </option>

                                    @if (employee?.Gender == "Male")
                                    {
                                        <option value="Male" selected>Male</option>
                                    }
                                    else
                                    {
                                        <option value="Male">Male</option>
                                    }

                                    @if (employee?.Gender == "Female")
                                    {
                                        <option value="Female" selected>Female</option>
                                    }
                                    else
                                    {
                                        <option value="Female">Female</option>
                                    }

                                    @if (employee?.Gender == "Other")
                                    {
                                        <option value="Other" selected>Other</option>
                                    }
                                    else
                                    {
                                        <option value="Other">Other</option>
                                    }

                                </select>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Marital Status
                                </label>

                                <select class="form-select"
                                        name="MaritalStatus">

                                    <option value="">
                                        Select Status
                                    </option>

                                    @if (employee?.MaritalStatus == "Married")
                                    {
                                        <option value="Married" selected>Married</option>
                                    }
                                    else
                                    {
                                        <option value="Married">Married</option>
                                    }

                                    @if (employee?.MaritalStatus == "Unmarried")
                                    {
                                        <option value="Unmarried" selected>Unmarried</option>
                                    }
                                    else
                                    {
                                        <option value="Unmarried">Unmarried</option>
                                    }

                                    @if (employee?.MaritalStatus == "Divorced")
                                    {
                                        <option value="Divorced" selected>Divorced</option>
                                    }
                                    else
                                    {
                                        <option value="Divorced">Divorced</option>
                                    }

                                    @if (employee?.MaritalStatus == "Widowed")
                                    {
                                        <option value="Widowed" selected>Widowed</option>
                                    }
                                    else
                                    {
                                        <option value="Widowed">Widowed</option>
                                    }

                                </select>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Blood Group
                                </label>

                                <select class="form-select"
                                        name="BloodGroup">

                                    <option value="">
                                        Select Blood Group
                                    </option>

                                    @foreach (var bloodGroup in new[]
                                    {
                    "A+", "A-", "B", "B-",
                    "O+", "O-", "AB+", "AB-"
                })
                                    {
                                        if (employee?.BloodGroup == bloodGroup)
                                        {
                                            <option value="@bloodGroup" selected>
                                                @bloodGroup
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@bloodGroup">
                                                @bloodGroup
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>


                        <!-- =================================================
         RELIGION & PIN CODE
    ================================================== -->

                        <div class="row mt-3">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Religion
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="Religion"
                                       value="@employee?.Religion"
                                       maxlength="100" />

                            </div>




                        </div>


                        <!-- =================================================
         PERMANENT ADDRESS
    ================================================== -->

                        <div class="section-title">
                            Permanent Address
                        </div>

                        <div class="form-group">

                            <label class="form-label">
                                Address
                                <span class="required">*</span>
                            </label>

                            <textarea class="form-control"
                                      name="PermanentAddress"
                                      required>@employee?.PermanentAddress</textarea>

                        </div>


                        <div class="row">

                            <div class="col-md-4">

                                <label class="form-label">
                                    City
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="PermanentCity"
                                       value="@employee?.PermanentCity" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    State
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="PermanentState"
                                       value="@employee?.PermanentState" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    PIN Code
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="PermanentPINCode"
                                       value="@employee?.PermanentPINCode"
                                       maxlength="6" />

                            </div>

                        </div>


                        <!-- =================================================
         PRESENT ADDRESS
    ================================================== -->

                        <div class="section-title">

                            Present Address

                            <div class="form-check float-end"
                                 style="font-size:12px;">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="sameAddress" />

                                <label class="form-check-label"
                                       for="sameAddress">
                                    Same as permanent address
                                </label>

                            </div>

                        </div>


                        <div class="form-group">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea class="form-control"
                                      id="PresentAddress"
                                      name="PresentAddress">@employee?.PresentAddress</textarea>

                        </div>


                        <div class="row">

                            <div class="col-md-4">

                                <label class="form-label">
                                    City
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="PresentCity"
                                       name="PresentCity"
                                       value="@employee?.PresentCity" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    State
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="PresentState"
                                       name="PresentState"
                                       value="@employee?.PresentState" />

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    PIN Code
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="PresentPINCode"
                                       name="PresentPINCode"
                                       value="@employee?.PresentPINCode"
                                       maxlength="6" />

                            </div>

                        </div>


                        <!-- =================================================
         CONTACT INFORMATION
    ================================================== -->

                        <div class="section-title">
                            Contact Information
                        </div>

                        <div class="row">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Mobile Number
                                </label>

                                <input type="text"
                                       class="form-control readonly-field"
                                       value="@employee?.Mobile"
                                       readonly />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       class="form-control readonly-field"
                                       value="@employee?.Email"
                                       readonly />

                            </div>

                        </div>


                        <div class="row mt-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Landline Number
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="LandlineNo"
                                       value="@employee?.LandlineNo" />

                            </div>

                        </div>


                        <!-- =================================================
         EMERGENCY CONTACT DETAILS
    ================================================== -->

                        <div class="section-title">
                            Emergency Contact Details
                        </div>

                        <div class="row">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Contact Name
                                    <span class="required">*</span>
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="EmergencyContactName"
                                       value="@employee?.EmergencyContactName"
                                       required />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Relation
                                    <span class="required">*</span>
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="EmergencyContactRelation"
                                       value="@employee?.EmergencyContactRelation"
                                       required />

                            </div>

                        </div>


                        <div class="row mt-3">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Mobile Number
                                    <span class="required">*</span>
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="EmergencyContactMobile"
                                       value="@employee?.EmergencyContactMobile"
                                       maxlength="10"
                                       required />

                            </div>


                            <div class="col-md-8">

                                <label class="form-label">
                                    Address
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="EmergencyContactAddress"
                                       value="@employee?.EmergencyContactAddress" />

                            </div>

                        </div>


                        <div class="row mt-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    City
                                </label>

                                <input type="text"
                                       class="form-control"
                                       name="EmergencyContactCity"
                                       value="@employee?.EmergencyContactCity" />

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                     STEP 2
                     FAMILY DETAILS
                ================================================== -->



                    <div id="step-2"
                         class="onboarding-step @(currentStep == 2 ? "active-step" : "") @(isHROrAdmin ? "hr-admin-readonly" : "")">

                        <div class="section-title">

                            <span>Family Details</span>

                            <button type="button"
                                    class="btn-add float-end"
                                    onclick="addFamily()">
                                + Add Family Member
                            </button>

                        </div>


                        <div id="familyContainer">

                            @if (familyList.Any())
                            {
                                for (int i = 0; i < familyList.Count; i++)
                                {
                                    var family = familyList[i];

                                    <div class="dynamic-card family-row">

                                        <div class="dynamic-card-header">

                                            <div class="dynamic-card-title">
                                                Family Member @(i + 1)
                                            </div>

                                            <button type="button"
                                                    class="btn-remove"
                                                    onclick="removeRow(this)">
                                                Remove
