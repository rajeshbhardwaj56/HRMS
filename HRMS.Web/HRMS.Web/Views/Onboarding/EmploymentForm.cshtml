document.addEventListener("change", function (e) {

    if (!e.target.classList.contains("education-document")) {
        return;
    }

    const fileInput = e.target;

    const file = fileInput.files[0];

    if (!file) {
        return;
    }


    // =========================================================
    // PDF VALIDATION
    // =========================================================

    const fileName = file.name.toLowerCase();

    const isPdf =
        file.type === "application/pdf" ||
        fileName.endsWith(".pdf");


    if (!isPdf) {

        alert("Only PDF files are allowed for education documents.");

        fileInput.value = "";

        return;
    }


    // =========================================================
    // MAX SIZE = 5 MB
    // =========================================================

    const maxSize =
        5 * 1024 * 1024;


    if (file.size > maxSize) {

        alert("Education document size cannot exceed 5 MB.");

        fileInput.value = "";

        return;
    }


    // =========================================================
    // DISPLAY SELECTED FILE
    // =========================================================

    const card =
        fileInput.closest(".education-row");

    if (!card) {
        return;
    }


    const fileInfo =
        card.querySelector(".education-file-info");

    const fileNameElement =
        card.querySelector(".education-file-name");


    if (fileInfo && fileNameElement) {

        fileNameElement.textContent =
            file.name;

        fileInfo.style.display =
            "block";
    }

});


