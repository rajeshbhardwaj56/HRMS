<div id="step-witness">

    <div class="section-title">

        <span>Witnesses</span>

        <button type="button"
                class="btn-add float-end"
                id="btnAddWitness">

            + Add Witness

        </button>

    </div>


    <div id="witnessContainer">

        @if (Model.WitnessList != null &&
             Model.WitnessList.Any())
        {
            for (int i = 0;
                     i < Model.WitnessList.Count;
                     i++)
            {
                var witness =
                    Model.WitnessList[i];

                <div class="dynamic-card witness-row">

                    <div class="dynamic-card-header">

                        <div class="dynamic-card-title">
                            Witness @(i + 1)
                        </div>

                        <button type="button"
                                class="btn-remove btn-remove-witness">

                            Remove

                        </button>

                    </div>


                    <input type="hidden"
                           name="WitnessList[@i].WitnessID"
                           value="@witness.WitnessID" />

                    <input type="hidden"
                           name="WitnessList[@i].OnboardingID"
                           value="@Model.OnboardingID" />

                    <input type="hidden"
                           name="WitnessList[@i].SignatureFileName"
                           value="@witness.SignatureFileName" />

                    <input type="hidden"
                           name="WitnessList[@i].SignatureFilePath"
                           value="@witness.SignatureFilePath" />


                   <div class="row">

                        <div class="col-md-4">

                            <label class="form-label">
                                Witness Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="WitnessList[@i].WitnessName"
                                   value="@witness.WitnessName"
                                   placeholder="Enter witness name"
                                   required />

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Witness Address <span class="text-danger">*</span>
                            </label>

                            <textarea class="form-control"
                                      name="WitnessList[@i].WitnessAddress"
                                      rows="2"
                                      placeholder="Enter witness address"
                                      required>@witness.WitnessAddress</textarea>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Witness Mobile <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="WitnessList[@i].WitnessMobile"
                                   value="@witness.WitnessMobile"
                                   maxlength="10"
                                   minlength="10"
                                   inputmode="numeric"
                                   
                                   placeholder="Enter 10-digit mobile number"
                                   required />

                        </div>

                    </div>


                    <!-- =========================================
                         WITNESS SIGNATURE
                    ========================================== -->

                    <div class="row mt-3">

                        <div class="col-md-12">

                            <label class="form-label">
                                Witness Signature
                            </label>


                            <div class="signature-method-wrapper"
                                 id="signatureWrapper_Witness_@i">


                                <input type="hidden"
                                       id="signatureMethod_Witness_@i"
                                       name="WitnessList[@i].SignatureMethod"
                                       value="upload" />

                                <input type="hidden"
                                       id="signatureBase64_Witness_@i"
                                       name="WitnessList[@i].SignatureBase64" />


                                <div class="signature-method-buttons">

                                    <button type="button"
                                            class="signature-method-btn active"
                                            data-method="upload"
                                            onclick="selectSignatureMethod('Witness_@i','upload')">

                                        Upload Signature

                                    </button>


                                    <button type="button"
                                            class="signature-method-btn"
                                            data-method="draw"
                                            onclick="selectSignatureMethod('Witness_@i','draw')">

                                        ✍ Draw Signature

                                    </button>


                                    <button type="button"
                                            class="signature-method-btn"
                                            data-method="type"
                                            onclick="selectSignatureMethod('Witness_@i','type')">

                                        Type Signature

                                    </button>

                                </div>


                                <!-- UPLOAD -->

                                <div class="signature-option active"
                                     data-signature-option="upload">

                                    <input type="file"
                                           class="form-control witness-signature"
                                           name="WitnessList[@i].SignatureFile"
                                           accept=".jpg,.jpeg,.png" />

                                </div>


                                <!-- DRAW -->

                                <div class="signature-option"
                                     data-signature-option="draw">

                                    <div class="signature-canvas-wrapper">

                                        <canvas id="signatureCanvas_Witness_@i"
                                                class="signature-canvas"
                                                width="700"
                                                height="180">
                                        </canvas>


                                        <div class="signature-actions">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    onclick="clearSignature('Witness_@i')">

                                                Clear

                                            </button>


                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    onclick="saveDrawSignature('Witness_@i')">

                                                Save Signature

                                            </button>

                                        </div>

                                    </div>

                                </div>


                                <!-- TYPE -->

                                <div class="signature-option"
                                     data-signature-option="type">

                                    <input type="text"
