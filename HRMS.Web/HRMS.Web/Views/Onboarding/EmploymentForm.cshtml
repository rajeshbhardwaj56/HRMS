               class="form-control"
               name="PassportNumber"
               value="@Model.EmployeeDetails?.PassportNumber"
               placeholder="Enter passport number" />

        <label class="form-label mt-3">
            Passport Document
        </label>

        <input type="file"
               class="form-control"
               name="PassportFile"
               accept=".pdf,.jpg,.jpeg,.png" />

        @if (passportDocument != null)
        {
            var passportExt =
                System.IO.Path.GetExtension(passportDocument.FilePath)
                    ?.ToLowerInvariant();

            <div class="mt-3">

                <div class="small text-muted mb-2">
                    Previous Passport Document
                </div>

                @if (passportExt == ".jpg" ||
                     passportExt == ".jpeg" ||
