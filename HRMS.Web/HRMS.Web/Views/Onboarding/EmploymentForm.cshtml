        }

        .btn-secondary-custom {
            border: 1px solid #cfd6df;
            background: #ffffff;
            color: #374151;
            padding: 10px 22px;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 600;
        }

        .btn-secondary-custom:hover {
            background: #f4f6f8;
        }

        .btn-success-custom {
            border: none;
            background: #198754;
            color: #ffffff;
            padding: 10px 22px;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 600;
        }

        /* =========================================================
           PHOTO
        ========================================================= */

        .photo-preview {
            width: 90px;
            height: 105px;
            object-fit: cover;
            border: 1px solid #dce2e9;
            border-radius: 5px;
            background: #f4f6f8;
