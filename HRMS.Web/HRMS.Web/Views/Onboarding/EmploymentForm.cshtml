    );

    return;
}
            /*
               ============================================================
               CURRENT STEP ALREADY SAVED
               ============================================================
               Example:

               Current Step = 1
               Last Saved Step = 1

               Therefore:
               DO NOT SAVE AGAIN
               Just move to Step 2
            */

            if (currentStep <= lastSavedStep) {

                console.log(
                    "Step",
                    currentStep,
                    "is already saved."
                );

                console.log(
                    "No save required. Moving directly to next step."
                );

                const nextStep = currentStep + 1;

                currentInterviewStep = nextStep;

                const currentStepInput =
                    document.getElementById("CurrentStep");

                if (currentStepInput) {
                    currentStepInput.value = nextStep;
                }

                showInterviewStep(nextStep);

                return;
            }

            /*
               ============================================================
               CURRENT STEP NOT SAVED
               ============================================================
               Example:

               Current Step = 2
               Last Saved Step = 1

               Therefore:
               SAVE STEP 2 FIRST
               Then move to Step 3 only after successful save.
            */

            console.log(
                "Step",
                currentStep,
                "is NOT saved."
            );

            console.log(
