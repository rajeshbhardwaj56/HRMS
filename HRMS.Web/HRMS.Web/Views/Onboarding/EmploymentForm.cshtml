<script>

let currentInterviewStep = @currentStep;
let lastSavedStep = @lastSavedStep;
let isSavingStep = false;

const totalInterviewSteps = 8;

    /* =============================================================
       INITIALIZE
    ============================================================= */




    /* =============================================================
       SHOW STEP
    ============================================================= */

    function showInterviewStep(step) {

    step = parseInt(step);

    if (step < 1) {
        step = 1;
    }

    if (step > totalInterviewSteps) {
        step = totalInterviewSteps;
    }

    currentInterviewStep = step;



    // Update hidden CurrentStep
    const currentStepInput =
        document.getElementById("CurrentStep");

    if (currentStepInput) {

        currentStepInput.value =
            step;
    }

    // Hide all steps
    document
        .querySelectorAll(".onboarding-step")
        .forEach(function (container) {

            container.classList.remove(
                "active-step"
            );
        });

    // Show current step
    const currentContainer =
        document.getElementById(
            "step-" + step
        );

    if (currentContainer) {

        currentContainer.classList.add(
            "active-step"
        );


    }
    else {

        console.error(
            "Could not find:",
            "step-" + step
        );
    }

    updateProgress(step);
    updateNavigationButtons(step);

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


    /* =============================================================
       PROGRESS
    ============================================================= */


function updateProgress(step) {

    const steps =
        document.querySelectorAll(".step");

    steps.forEach(function (stepElement, index) {

        const stepNumber = index + 1;

        stepElement.classList.remove(
            "active",
            "completed",
            "locked"
        );

        /*
         * CURRENT STEP
         */
        if (stepNumber === step) {

            stepElement.classList.add("active");

            return;
        }

        /*
         * ALL SAVED STEPS
         */
        if (stepNumber <= lastSavedStep) {

            stepElement.classList.add("completed");

            return;
        }

        /*
         * IMMEDIATELY NEXT STEP
         * AFTER LAST SAVED STEP
         */
        if (stepNumber === lastSavedStep + 1) {

            return;
        }

        /*
         * FUTURE UNSAVED STEPS
         */
        if (stepNumber > lastSavedStep + 1) {

            stepElement.classList.add("locked");
        }
    });
}




    /* =============================================================
       NAVIGATION BUTTONS
    ============================================================= */

    function updateNavigationButtons(step) {

        const previousButton =
            document.getElementById("previousButton");

        const nextButton =
            document.getElementById("nextButton");

        const submitButton =
            document.getElementById("submitButton");


        if (step === 1) {

            previousButton.style.display = "none";

        }
        else {

            previousButton.style.display = "inline-block";

        }


        if (step === totalInterviewSteps) {

            nextButton.style.display = "none";

            submitButton.style.display = "inline-block";

        }
        else {

            nextButton.style.display = "inline-block";

            submitButton.style.display = "none";

        }

    }


    /* =============================================================
       OPEN STEP
    ============================================================= */


/* =============================================================
   OPEN STEP
============================================================= */

function openInterviewEvaluationStep(step) {

    step = parseInt(step);



    if (isNaN(step) || step < 1 || step > totalInterviewSteps) {
        console.error("Invalid step:", step);
        return;
    }

    // Find selected step
    const targetContainer = document.getElementById("step-" + step);

    if (!targetContainer) {
        console.error("Step container NOT FOUND: step-" + step);
        return;
    }



    // Remove active class from ALL steps
    document.querySelectorAll(".onboarding-step")
        .forEach(function (container) {
            container.classList.remove("active-step");
        });

    // Add active class to selected step
    targetContainer.classList.add("active-step");

    // Update current step
    currentInterviewStep = step;

    // Update hidden CurrentStep
    const currentStepInput =
        document.getElementById("CurrentStep");

    if (currentStepInput) {
        currentStepInput.value = step;
    }

    // Update progress
    updateProgress(step);

    // Update navigation buttons
    updateNavigationButtons(step);

    console.log("SUCCESS: Step " + step + " is now visible");
}


    /* =============================================================
       VALIDATE CURRENT STEP
    ============================================================= */

    function validateCurrentStep() {

        const currentContainer =
            document.getElementById("step-" + currentInterviewStep);

        if (!currentContainer) {
            return true;
        }


        const requiredFields =
            currentContainer.querySelectorAll(
                "input[required], select[required], textarea[required]"
            );


        for (let i = 0; i < requiredFields.length; i++) {

            const field = requiredFields[i];


            if (!field.checkValidity()) {

                field.reportValidity();

                field.focus();

                return false;

            }

        }


        return true;

    }


    /* =============================================================
       NEXT
    ============================================================= */


function nextInterviewStep() {

    console.log("=================================");
    console.log("NEXT BUTTON CLICKED");
    console.log("Current Step:", currentInterviewStep);
    console.log("Last Saved Step:", lastSavedStep);
    console.log("=================================");

    if (isSavingStep) {
        console.log("Save already in progress. Ignoring Next click.");
        return;
    }

    if (currentInterviewStep >= totalInterviewSteps) {
        return;
    }

    const currentStep = parseInt(currentInterviewStep);

    /*
       ============================================================
       CURRENT STEP ALREADY SAVED
       ============================================================
       Example:

       Current Step = 1
       Last Saved Step = 1

       Therefore:
       DO NOT SAVE AGAIN
       Just move to Step 2
    */

    if (currentStep <= lastSavedStep) {

        console.log(
            "Step",
            currentStep,
            "is already saved."
        );

        console.log(
            "No save required. Moving directly to next step."
        );

        const nextStep = currentStep + 1;

        currentInterviewStep = nextStep;

        const currentStepInput =
            document.getElementById("CurrentStep");

        if (currentStepInput) {
            currentStepInput.value = nextStep;
        }

        showInterviewStep(nextStep);

        return;
    }

    /*
       ============================================================
       CURRENT STEP NOT SAVED
       ============================================================
       Example:

       Current Step = 2
       Last Saved Step = 1

       Therefore:
       SAVE STEP 2 FIRST
       Then move to Step 3 only after successful save.
    */

    console.log(
        "Step",
        currentStep,
        "is NOT saved."
    );

    console.log(
        "Saving current step before navigation..."
    );

    saveCurrentStep(true);
}



    /* =============================================================
       PREVIOUS
    ============================================================= */

function previousInterviewStep() {

    if (currentInterviewStep <= 1) {
        return;
    }

    currentInterviewStep--;

    document.getElementById("CurrentStep").value =
        currentInterviewStep;

    showInterviewStep(currentInterviewStep);
}
            /* ============================================================
            PHOTO PREVIEW
            ============================================================ */

            function showPreview(event) {

                const input = event.target;
                const file = input.files[0];

                if (!file) {
                    return;
                }

                const allowedTypes = [
                    "image/jpeg",
                    "image/jpg",
                    "image/png"
                ];

                if (!allowedTypes.includes(file.type)) {

                    alert("Please select a JPG or PNG image.");

                    input.value = "";

                    return;
                }

                if (file.size > 2 * 1024 * 1024) {

                    alert("Image size must be less than 2 MB.");

                    input.value = "";

                    return;
                }

                const reader = new FileReader();

                reader.onload = function(e) {

                    document.getElementById(
                        "employeePhotoPreview"
                    ).src = e.target.result;

                };

                reader.readAsDataURL(file);
            }


