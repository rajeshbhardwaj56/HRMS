        }

        /* =========================================================
           DYNAMIC CARDS
        ========================================================= */

        .dynamic-card {
            background: #ffffff;
            border: 1px solid #e0e6ed;
            border-radius: 8px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: 0 2px 7px rgba(0, 0, 0, .03);
        }

        .dynamic-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid #edf0f4;
