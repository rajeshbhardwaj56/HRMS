    <input type="hidden" id="hdnRoleName" value="@Convert.ToInt64(Context.Session.GetString(Constants.RoleID))" />
    <script>

        $('.close').on('click', function () {
            $('#dateModal').modal('hide');
        });


        $(function () {

            const today = moment();
            const payroll = getPayrollMonthForToday(today);

            populateYearDropdown(payroll.year);
            populateMonthDropdown(payroll.month);

            renderPayrollCalendar();

            $('#yearDropdown, #monthDropdown').on('change', function () {
                renderPayrollCalendar();
            });
        });
        function updatePayrollRangeText(year, month) {
            const payroll = getPayrollRange(year, month);
            
            $('#payrollRangeText').text(
                payroll.start.format('DD MMM YYYY') +
                ' – ' +
                payroll.end.format('DD MMM YYYY')
            );
        }
        function getPayrollMonthForToday(today) {

            const year = today.year();
            const month = today.month(); // 0-based
            const day = today.date();
            const leap = today.isLeapYear();

            // JANUARY
            if (month === 0) {
                return day >= 21
                    ? { year, month: 1 }  // Feb payroll
                    : { year, month: 0 }; // Jan payroll
            }

            // FEBRUARY
            if (month === 1) {
                const febEnd = leap ? 19 : 18;
                return day <= febEnd
                    ? { year, month: 1 } // Feb payroll
                    : { year, month: 2 }; // March payroll
            }

            // ALL OTHER MONTHS
            return day >= 21
                ? { year, month: month + 1 }
                : { year, month };
        }
        function isLeapYear(year) {
            return moment([year]).isLeapYear();
        }
        function populateYearDropdown(selectedYear) {

            const yearDropdown = $('#yearDropdown');
            yearDropdown.empty();

            for (let y = selectedYear - 1; y <= selectedYear + 1; y++) {
                yearDropdown.append(`<option value="${y}">${y}</option>`);
            }

            yearDropdown.val(selectedYear);
        }
        function populateMonthDropdown(selectedMonth) {

            const monthDropdown = $('#monthDropdown');
            monthDropdown.empty();

            for (let m = 0; m < 12; m++) {
                monthDropdown.append(
                    `<option value="${m + 1}">${moment().month(m).format('MMMM')}</option>`
                );
            }

            // selectedMonth is 0-based
            monthDropdown.val(selectedMonth + 1);
        }
        function getPayrollRange(year, month) {
            const leap = moment([year]).isLeapYear();
            if (month === 0) {
                return {
                    start: moment([year - 1, 11, 21]), 
                    end: moment([year, 0, 20])         
                };
            }
       
            if (month === 1) {
                return {
                    start: moment([year, 0, 21]),
                    end: moment([year, 1, leap ? 18 : 17])
                };
            }
            if (month === 2) {
                return {
                    start: moment([year, 1, leap ? 19 : 18]),
                    end: moment([year, 2, 20])
                };
            }

    
            return {
                start: moment([year, month - 1, 21]),
                end: moment([year, month, 20])
            };
        }


        function renderPayrollCalendar() {

            const year = parseInt($('#yearDropdown').val());
            const month = parseInt($('#monthDropdown').val()) - 1;

            const payroll = getPayrollRange(year, month);
            updatePayrollRangeText(year, month);
            const gridStart = payroll.start.clone().startOf('week');
            const gridEnd = payroll.end.clone().endOf('week');

            $('#calendarBody').empty();

            let row = $('<tr></tr>');
            let day = gridStart.clone();

            while (day.isSameOrBefore(gridEnd)) {

                const isOutside =
                    day.isBefore(payroll.start, 'day') ||
                    day.isAfter(payroll.end, 'day');

                const td = $('<td></td>')
                    .toggleClass('disabled', isOutside)
                    .attr('data-date', day.format('YYYY-MM-DD'))
                    .append(`<span class="day-number">${day.date()}</span>`);

                if (!isOutside) {
                    td.on('click', function () {
                        showAttendanceDetails($(this).data('date'));
                    });
                }

                row.append(td);

                if (row.children().length === 7) {
                    $('#calendarBody').append(row);
                    row = $('<tr></tr>');
                }

                day.add(1, 'day');
            }
            if (row.children().length > 0) {
                while (row.children().length < 7) {
                    row.append('<td class="disabled"></td>');
                }
                $('#calendarBody').append(row);
            }
            loadAttendanceData()
        }
        function loadAttendanceData() {
            const year = parseInt($('#yearDropdown').val());
            const month = parseInt($('#monthDropdown').val()); 
            $.ajax({
                url: '/employee/Attendance/AttendenceCalendarList',
                type: 'POST',
                data: {
                    Year: year,
                    Month: month
                },
                success: function (response) {

                    $("#employeeFullName").text(response.employeeFullName);

                    if (!response || !response.data || !Array.isArray(response.data.dailyStatuses)) {
                        return;
                    }

                    response.data.dailyStatuses.forEach(item => {

                  
                        const normalizedDate = moment(item.date).format('YYYY-MM-DD');
                        const cell = $(`td[data-date="${normalizedDate}"]`);
                        if (!cell.length) return;

                        let statusText = '';
                        let statusClass = '';

                        switch (item.status) {
                            case 'Present':
                                statusText = 'Present';
                                statusClass = 'status-present';
                                break;

                            case 'Pending':
                                statusText = 'Pending';
                                statusClass = 'status-pending';
                                break;

                            case 'Absent':
                                statusText = 'Absent';
                                statusClass = 'status-absent';
                                break;

                            case 'Leave':
                                statusText = 'Leave';
                                statusClass = 'status-leave';
                                break;

                            case 'Holiday':
                                statusText = 'Holiday';
                                statusClass = 'status-holiday';
                                break;

                            case 'Week Off':
                                statusText = 'Week Off';
                                statusClass = 'status-weekoff';
                                break;

                            case 'EarnedCompOff':
                                statusText = 'Comp Off';
                                statusClass = 'status-compoff';
                                break;
                            case 'HalfLeave/HalfAbsent':
                                statusText = 'HalfLeave/HalfAbsent';
                                statusClass = 'status-halfday';
                                break;

                            case 'HalfDay/HalfLeave':
                                statusText = 'HalfDay/HalfLeave';
                                statusClass = 'status-halfday';
                                break;
                            case 'Half Day':
                                statusText = 'Half Day';
                                statusClass = 'status-halfday';
                                break;

                            default:
                                return;
                        }

                        // prevent duplicate badge
                        cell.find('.attendance-cell-badge').remove();

                        // append centered badge
                        cell.append(`
       <div class="attendance-cell-wrapper">
        <span class="attendance-cell-badge ${statusClass}">
            ${statusText}
        </span>
    </div>
`);
                    });
                },
                error: function () {
                    alert('Failed to load attendance data.');
                }
            });
        }




        function formatDate(dateStr) {
            if (!dateStr) return "-";
            const date = new Date(dateStr);
            const day = String(date.getDate()).padStart(2, '0');
            const month = date.toLocaleString('default', { month: 'short' });
            const year = date.getFullYear();
            return `${day}-${month}-${year}`;
        }

        const getStatusColors = (status) => {
            switch (status?.toLowerCase()) {
                case 'present': return '#28a745'; // Green
                case 'absent': return '#dc3545'; // Red
                case 'leave': return '#ffc107'; // Yellow
                case 'half day': return '#05397b'; // Blue
                default: return '#6c757d'; // Grey fallback
            }
        };
        function formatDateTime(dateStr) {
            if (!dateStr) return "-";
            const date = new Date(dateStr);

            const day = String(date.getDate()).padStart(2, '0');
            const month = date.toLocaleString('default', { month: 'short' });
            const year = date.getFullYear();

            let hours = date.getHours();
            const minutes = String(date.getMinutes()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12;
            hours = hours ? hours : 12; // Convert 0 to 12
            const strTime = `${String(hours).padStart(2, '0')}:${minutes} ${ampm}`;

            return `${day}-${month}-${year} ${strTime}`;
        }



        function formatTimeOnly(dateStr) {
            return new Date(dateStr).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        // Format time as "Xh Ym" (e.g., "2h 30m")
        function formatSqlTimeToHoursMinutes(timeStr) {
            if (!timeStr || typeof timeStr !== 'string') return '-';

            const parts = timeStr.split(':');
            if (parts.length < 2) return '-';

            const hours = parseInt(parts[0], 10);
            const minutes = parseInt(parts[1], 10);

            let result = '';
            if (hours > 0) result += `${hours}h `;
            if (minutes > 0) result += `${minutes}m`;

            return result.trim() || '0m';
        }

        // Format date (e.g., "Jun 24, 2025")
        function formatDate(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        // Format date and time (e.g., "Jun 24, 2025, 09:30 AM")
        function formatDateTime(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            return date.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        // Format check-in and check-out based on whether dates are same or not
        function formatDateOrTime(start, end) {
            const startDate = new Date(start);
            const endDate = new Date(end);

            const sameDay = startDate.toDateString() === endDate.toDateString();

            const timeOnlyOptions = { hour: '2-digit', minute: '2-digit' };
            const dateTimeOptions = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };

            return {
                startFormatted: startDate.toLocaleString('en-US', sameDay ? timeOnlyOptions : dateTimeOptions),
                endFormatted: endDate.toLocaleString('en-US', sameDay ? timeOnlyOptions : dateTimeOptions)
            };
        }

        function showAttendanceDetails(selectedDate) {
            $('#dateModal').data('workdate', selectedDate);
            $('#modalDateText').html('Loading details for: ' + selectedDate + '...');
            $('#dateModal').modal('show');

            $.ajax({
                url: '/employee/MyInfo/GetAttendanceDetails',
                type: 'GET',
                data: { date: selectedDate },

                success: function (data) {

                    let html = "";

                    const getStatusColor = (status) => {
                        switch (status?.toLowerCase()) {
                            case 'present': return '#28a745';
                            case 'absent': return '#dc3545';
                            case 'leave': return '#ffc107';
                            case 'half day': return '#05397b';
                            default: return '#6c757d';
                        }
                    };

                    /* ---------------- ATTENDANCE ---------------- */

                    /* -------- ATTENDANCE -------- */

                    if (data.attendance && data.attendance.firstLogDate) {

                        const first = new Date(data.attendance.firstLogDate);
                        const last = new Date(data.attendance.lastLogDate);
                        const sameDay = first.toDateString() === last.toDateString();

                        html += `
<div class="card shadow-sm border-0 mb-3">
<div class="card-body">

<h6 class="text-primary">Attendance</h6>

<div class="row mb-2">
<div class="col-md-6"><strong>Date:</strong> ${formatDate(data.attendance.workDate)}</div>

<div class="col-md-6">
<strong>Status:</strong>
<span class="badge" style="background:${getStatusColor(data.attendance.attendanceStatus)}">
${data.attendance.attendanceStatus ?? '-'}
</span>
</div>
</div>

<div class="row mb-2">

<div class="col-md-6">
<strong>Check-in:</strong>
${sameDay ? formatTimeOnly(data.attendance.firstLogDate) : formatDateTime(data.attendance.firstLogDate)}
</div>

<div class="col-md-6">
<strong>Check-out:</strong>
${sameDay ? formatTimeOnly(data.attendance.lastLogDate) : formatDateTime(data.attendance.lastLogDate)}
</div>

</div>

<div class="row mb-2">
<div class="col-md-6">
<strong>Hours Worked:</strong>
${formatSqlTimeToHoursMinutes(data.attendance.hoursWorked)}
</div>
</div>

</div>
</div>`;
                    }

                    /* -------- WEEK OFF -------- */

                    if (data.weekOffs && data.weekOffs.length > 0) {

                        data.weekOffs.forEach(w => {

                            html += `
<div class="card shadow-sm border-0 mb-3">

<div class="card-body">

<h6 class="text-primary">Week Off</h6>

<strong>Date:</strong> ${formatDate(w.matchingDayOff)}

</div>
</div>`;

                        });

                    }

                    /* -------- HOLIDAY -------- */

                    if (data.holidays && data.holidays.length > 0) {

                        data.holidays.forEach(h => {

                            html += `
<div class="card shadow-sm border-0 mb-3">

<div class="card-body">

<h6 class="text-success">Holiday</h6>

<div><strong>Name:</strong> ${h.holidayName}</div>

<div><strong>Description:</strong> ${h.description ?? "-"}</div>

<div>
<strong>From:</strong> ${formatDate(h.fromDate)}  
<strong>To:</strong> ${formatDate(h.toDate)}
</div>

</div>
</div>`;

                        });

                    }

                    /* -------- LEAVE -------- */

                    if (data.leaves && data.leaves.length > 0) {

                        data.leaves.forEach(l => {

                            let dateHtml = "";

                            // If Half Day → show only start date
                            if (l.leaveDurationTypeName?.toLowerCase() === "half day") {

                                dateHtml = `
<div><strong>Date:</strong> ${formatDate(l.startDate)}</div>
`;

                            } else {

                                // Full day / multiple days
                                dateHtml = `
<div><strong>Start:</strong> ${formatDate(l.startDate)}</div>
<div><strong>End:</strong> ${formatDate(l.endDate)}</div>
`;
                            }

                            html += `
<div class="card shadow-sm border-0 mb-3">

<div class="card-body">

<h6 class="text-warning">Leave</h6>

<div class="row mb-2">
    <div class="col-md-6">
        <strong>Reason:</strong> ${l.reason}
    </div>

    <div class="col-md-6 text-end">
        <strong>Duration:</strong> ${l.leaveDurationTypeName ?? '-'}
    </div>
</div>

${dateHtml}

<div>
<strong>Status:</strong>
<span class="LeaveApproved">${l.leaveStatusID}</span>
</div>

</div>
</div>`;
                        });

                    }

                    /* ---------------- STATUS CHANGES ---------------- */

                    html += renderStatusChanges(data.statusChange);

                    /* ---------------- STATUS EDITOR ---------------- */

                    html += renderStatusEditor(selectedDate, data);

                    /* ---------------- NO RECORD ---------------- */

                    if (html.trim() === "") {

                        html = `
<div class="alert alert-warning text-center">
<i class="bi bi-info-circle-fill"></i>
No attendance record found for this day.
</div>

${renderStatusEditor(selectedDate, data)}
`;
                    }

                    $('#modalDateText').html(html);
                },

                error: function () {

                    $('#modalDateText').html(
                        '<span style="color:red;">Failed to load attendance details.</span>'
                    );
                }
            });
        }

        function renderStatusChanges(changes) {

            if (!changes || changes.length === 0) return "";

            let rows = changes.map(c => `
              <tr>
              <td style="display:none;">
      <input type="hidden" id="encryptedStatusChangeID" value="${c.encryptedStatusChangeID ?? ''}" />
  </td>
                <td>${formatDateTime(c.insertedDate)}</td>
                <td> <span class="badge" style="background-color: ${getStatusColors(c.attendanceStatus)}; color: white;">
                      ${c.attendanceStatus ?? '-'}
                    </span></td>
                <td>${c.remarks ?? '-'}</td>
                <td>${c.insertedByUserName ?? '-'}</td>
                <td>${c.approvedByUserName ?? '-'}</td>
                <td>${c.statusState ?? '-'}</td>
              </tr>
`).join("");

            return `
              <div class="mt-3">
                <h6>Updated Status</h6>
                <table class="table table-sm table-bordered">
                  <thead>
                    <tr>
                    <th style="display:none;">Encrypted ID</th>
                      <th>Date</th>
                      <th>Attendance Type</th>
                      <th>Remarks</th>
                      <th>Applied By</th>
                      <th>Approved By</th>
                      <th>Approval State </th>
                    </tr>
                  </thead>
                  <tbody>
                    ${rows}
                  </tbody>
                </table>
              </div>
`;
        }


        const renderStatusEditor = (fullDate, data) => {
            if (!data)
                return "";
            const empTypeID = Number(data.leaveSummary.employeeTypeID);
            if (empTypeID !== 3) return "";
            
            if (!canEditStatus(fullDate)) return "";

            return `

         <form id="statusForm">

        <div class="row g-3 align-items-end">

            <!-- STATUS -->
            <div class="col-md-4">
                <label for="statusSelect" class="form-label fw-semibold">
                    Change Status
                </label>
                <select class="form-select" id="statusSelect" required>
                    <option value="">Select status</option>
                    <option value="P">Present</option>
                    <option value="A">Absent</option>
                    <option value="HD">Half Day</option>
                    <option value="WO">Week Off</option>
                </select>
            </div>

            <!-- COMMENT -->
            <div class="col-md-8">
                <label for="statusComment" class="form-label fw-semibold">
                    Comment
                </label>
                 <div class="comment-wrapper">
                <textarea

                    id="statusComment"
                    rows="2"
                    placeholder="Write comment..."
                    required></textarea>
            </div>
            </div>
        </div>

        <!-- BUTTON -->
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary">
                💾 Save Status
            </button>
        </div>

</form>
            `;
        };
        function canEditStatus(workDateStr) {

            const RoleName = parseInt(document.getElementById('hdnRoleName').value);
            if (RoleName === 5 || RoleName === 2) {
                return true;
            }


            const todayIST = new Date(
                new Date().toLocaleString("en-US", { timeZone: "Asia/Kolkata" })
            );


            const workDate = parseISTDate(workDateStr);
            if (workDate > todayIST) return false;
            let payrollStart, payrollEnd, cutoffDate;

            if (workDate.getDate() >= 21) {
                payrollStart = new Date(workDate.getFullYear(), workDate.getMonth(), 21);
                payrollEnd = new Date(workDate.getFullYear(), workDate.getMonth() + 1, 20);
                cutoffDate = new Date(workDate.getFullYear(), workDate.getMonth() + 1, 20);
            } else {

                payrollStart = new Date(workDate.getFullYear(), workDate.getMonth() - 1, 21);
                payrollEnd = new Date(workDate.getFullYear(), workDate.getMonth(), 20);
                cutoffDate = new Date(workDate.getFullYear(), workDate.getMonth(), 20);
            }


            return todayIST <= cutoffDate;
        }
        function parseISTDate(dateStr) {
            const [year, month, day] = dateStr.split("-").map(Number);
            return new Date(year, month - 1, day);
        }
        function toastEMessage(type, message) {
            $.toast({
                heading: type,
                text: message,
                showHideTransition: 'slide',
                icon: 'error',
                position: 'top-right',
            });
        }
        function toastMessage(type, message) {
            $.toast({
                heading: type,
                text: message,
                showHideTransition: 'slide',
                icon: 'success',
                position: 'top-right',
            });
        }
        $(document).ready(function () {
            let isSubmitting = false;
            $(document).on("submit", "#statusForm", function (e) {
                e.preventDefault();
                const status = $("#statusSelect").val();
                const remarks = $("#statusComment").val();
                const workDate = $('#dateModal').data('workdate');
                const encryptedStatusId = $("#encryptedStatusChangeID").val();


                if (!status) {
                    toastEMessage('Error', "Please select a status before saving.");
                    return;
                }
                if (!remarks) {
                    toastEMessage('Error', "Please enter comment before saving..");
                    return;
                }
                $.ajax({
                    url: '/employee/Attendance/SaveMyAttendanceStatus',
                    type: 'POST',
                    data: {
                        Status: status,
                        Remarks: remarks,
                        WorkDate: workDate,
                        EncryptedStatusChangeID: encryptedStatusId
                    },
                    success: function (response) {

                        if (response.data.pkNo > 0) {
                            toastMessage('Success', "Attendance status updated successfully!");
                            $("#dateModal").modal("hide");


                        } else {
                            toastEMessage('Error', "Failed to update attendance.");
                        }
                    },
                    error: function (xhr, status, error) {
                        toastEMessage('Error', "Failed to update attendance.");
                    }
                });
            });

        });
    </script>

</body>
</html>

