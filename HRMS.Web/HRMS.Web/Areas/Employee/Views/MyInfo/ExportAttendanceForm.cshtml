@using HRMS.Models.Common
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IConfiguration _configuration


@{
    Layout = String.Format("~/Areas/{0}/Views/Shared/_Layout.cshtml", @HttpContextAccessor.HttpContext.Session.GetString(HRMS.Models.Common.Constants.AreaName));
    ViewData["Title"] = "Export Attendance";
}

<style>
    .btn-export {
        background-color: #05397b ;
        color: white ;
        padding: 8px 18px;
        font-size: 14px;
        font-weight: 600;
        height: 40px;
        min-width: 120px;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 2px 6px rgba(13, 110, 253, 0.25);
    }

       
	</style>

	<div class="card shadow-sm p-4">

		<h4 class="mb-4">Export Attendance Report</h4>

        <div class="row g-3">

            <!-- From Date -->
            <!-- Search -->
            @*<div class="col-md-3">
            <label class="form-label">Search</label>

            <input type="text"
                   id="search-box"
                   class="form-control"
                   placeholder="Name or Employee No" />
        </div>*@

            <!-- Location -->
            <div class="col-md-2">
                <label class="form-label">Location</label>

                <select id="jobLocationDropdown"
                        class="form-select">
                    <option value="">Select Location</option>
                </select>
            </div>

            <!-- Manager -->
            <div class="col-md-3">
                <label class="form-label">Manager</label>

                <select id="managerDropdown"
                        class="form-select">
                    <option value="">Select Manager</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date <span class="text-danger">*</span></label>

                <input type="date"
                       id="export-from-date"
                       class="form-control" />
            </div>

            <!-- To Date -->
            <div class="col-md-2">
                <label class="form-label">To Date <span class="text-danger">*</span></label>

                <input type="date"
                       id="export-to-date"
                       class="form-control" />
            </div>
            <!-- Export Button -->
            <div class="col-md-2 d-flex align-items-end">

                <button id="export-btn"
                        class="btn btn-export">
                    <i class="fa fa-file-export me-1"></i> Export 
                </button>

            </div>

        </div>

	</div>



<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>

	// Load Filters
	$(document).ready(function () {

		loadFilters();

	});

    function loadFilters() {

        $.ajax({
            url: '/employee/MyInfo/GetExportFilters',
            type: 'GET',

            success: function (res) {
                const locations = res.data.joblocationList || [];
                const $location = $("#jobLocationDropdown");
                $location.empty();
                $location.append(
                    '<option value="">Select Location</option>'
                );
                $.each(locations, function (i, loc) {

                    $location.append(
                        `<option value="${loc.jobLocationID}">
                        ${loc.jobLocationName}
                    </option>`
                    );

                });
                const managers = res.data.managerList || [];
                const $manager = $("#managerDropdown");
                $manager.empty();
                $manager.append(
                    '<option value="">Select Manager</option>'
                );
                $.each(managers, function (i, manager) {

                    $manager.append(
                        `<option value="${manager.employeeID}">
                        ${manager.employeNumber} - ${manager.employeeName}
                    </option>`
                    );

                });

            },

            error: function () {

                alert("Failed to load filters.");

            }
        });
    }

	// Export Attendance
	async function exportAttendance() {

		const fromDate =
			$("#export-from-date").val();

		const toDate =
			$("#export-to-date").val();

		//const searchTerm =
		//	$("#search-box").val().trim();

		const jobLocationId =
			$("#jobLocationDropdown").val() || 0;

		const managerId =
			$("#managerDropdown").val() || 0;

		// Validation
		if (!fromDate || !toDate) {

			alert("Please select From and To dates.");

			return;
		}

		if (new Date(toDate) < new Date(fromDate)) {

			alert("To Date cannot be before From Date.");

			return;
		}

		// API URL
		const url =
			`/employee/MyInfo/ExportAttendance` +
			`?FromDate=${fromDate}` +
			`&ToDate=${toDate}` +
			/*`&SearchTerm=${encodeURIComponent(searchTerm)}` +*/
			`&JobLocationID=${jobLocationId}` +
			`&ManagerId=${managerId}`;

		const $btn = $("#export-btn");

		$btn.prop("disabled", true)
			.text("Please wait...");

		try {

			const response = await fetch(url, {
				method: "GET"
			});

			if (!response.ok) {

                const errorMessage =
                    await response.text();

                throw new Error(
                    errorMessage || "Failed to download file"
                );

			}

			const contentDisposition =
				response.headers.get(
					"Content-Disposition"
				);

			let fileName =
				"AttendanceExport.xlsx";

			if (
				contentDisposition &&
				contentDisposition.includes("filename=")
			) {

				const matches =
					/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/
						.exec(contentDisposition);

				if (matches && matches[1]) {

					fileName =
						matches[1]
							.replace(/['"]/g, "");

				}
			}

			const blob =
				await response.blob();

			const link =
				document.createElement("a");

			const downloadUrl =
				window.URL.createObjectURL(blob);

			link.href = downloadUrl;

			link.download = fileName;

			document.body.appendChild(link);

			link.click();

			link.remove();

			window.URL.revokeObjectURL(downloadUrl);

		}
		catch (error) {

			alert(
				
				error.message
			);

		}
		finally {

			$btn.prop("disabled", false)
                .html('<i class="fa fa-download me-1"></i> Export');

		}

	}

	// Button Click
	$("#export-btn").on(
		"click",
		exportAttendance
	);

</script>