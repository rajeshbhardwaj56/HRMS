    async function exportEmployeeLeaves() {

        const $btn = $("#leave-export-btn"); 
        $btn.prop("disabled", true).text("Please wait...");

        try {
            const url = `/employee/MyInfo/ExportEmployeeLeaves`;

            const response = await fetch(url, { method: "GET" });

            if (!response.ok) {
                throw new Error("Failed to download leave file");
            }

            const contentDisposition = response.headers.get("Content-Disposition");
            let fileName = "Employee_Leaves.xlsx"; 

            if (contentDisposition && contentDisposition.includes("filename=")) {
                const matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(contentDisposition);
                if (matches && matches[1]) {
                    fileName = matches[1].replace(/['"]/g, "");
                }
            }

            const blob = await response.blob();
            const link = document.createElement("a");
            const downloadUrl = window.URL.createObjectURL(blob);
            link.href = downloadUrl;
            link.download = fileName;

            document.body.appendChild(link);
            link.click();
            link.remove();

            window.URL.revokeObjectURL(downloadUrl);

        } catch (error) {
            alert("Error while exporting leaves: " + error.message);
        } finally {
            $btn.prop("disabled", false).text("Export Leaves");
        }
    }

    function isLeapYear(year) {
        return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
    }

