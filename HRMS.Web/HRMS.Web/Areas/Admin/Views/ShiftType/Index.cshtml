<script>
    document.getElementById('cancelButton').addEventListener('click', function () {
        window.location.href = '@Url.Action("ShiftTypeListing", "ShiftType")';
    });
</script>

<script>

    let validationRequest = null;
    let latestValidationToken = 0;
    let validationTimeout = null;

    function enableSubmitButton() {

        $('#btnSubmit')
            .prop('disabled', false)
            .css({
                'opacity': '1',
                'cursor': 'pointer'
            });
    }

    function disableSubmitButton() {

        $('#btnSubmit')
            .prop('disabled', true)
            .css({
                'opacity': '0.5',
                'cursor': 'not-allowed'
            });
    }

    function clearValidationMessages() {

        $('#shiftNameValidationMessage').html('');
        $('#startTimeValidationMessage').html('');
        $('#endTimeValidationMessage').html('');
    }

    function validateShiftType() {

        const shiftTypeName = $('#ShiftTypeName').val().trim();
        const startTime = $('#StartTime').val();
        const endTime = $('#EndTime').val();

        clearValidationMessages();

        if (!shiftTypeName || !startTime || !endTime) {

            enableSubmitButton();
            return;
        }

        const model = {

            ShiftTypeID: $('#ShiftTypeID').val(),
            ShiftTypeName: shiftTypeName,
            StartTime: startTime,
            EndTime: endTime
        };

        const currentToken = ++latestValidationToken;

        if (validationRequest) {

            validationRequest.abort();
        }

        validationRequest = $.ajax({

            url: '@Url.Action("ValidateShiftType", "ShiftType")',
            type: 'POST',
            data: model,

          success: function (response) {

        if (currentToken !== latestValidationToken) {
            return;
        }

        clearValidationMessages();

        console.log(response);

        // SUCCESS
        if (response.pkNo == 1) {

            enableSubmitButton();
            return;
        }

        // FAILED VALIDATION
        disableSubmitButton();

        if (response.message &&
            response.message.includes('Shift Type Name')) {

            $('#shiftNameValidationMessage')
                .html('<span class="text-danger">' + response.message + '</span>');
        }

        else if (response.message &&
            response.message.includes('cannot be same')) {

            $('#endTimeValidationMessage')
                .html('<span class="text-danger">' + response.message + '</span>');
        }

        else if (response.message &&
            response.message.includes('timing already exists')) {

            $('#endTimeValidationMessage')
                .html('<span class="text-danger">' + response.message + '</span>');
        }
    },

            error: function (xhr, status) {

                if (status === "abort") {

                    return;
                }

                enableSubmitButton();
            }
        });
    }

    function triggerValidation() {

        clearTimeout(validationTimeout);

        validationTimeout = setTimeout(function () {

            validateShiftType();

        }, 300);
    }

    $(document).ready(function () {

        $('#ShiftTypeName').on('blur', function () {

            triggerValidation();
        });

        $('#StartTime').on('change', function () {

            triggerValidation();
        });

        $('#EndTime').on('change', function () {

            triggerValidation();
        });

        enableSubmitButton();
    });
        $('#shiftTypeForm').on('submit', function (e) {

        const shiftTypeName = $('#ShiftTypeName').val().trim();
        const startTime = $('#StartTime').val();
        const endTime = $('#EndTime').val();

        clearValidationMessages();

        // Required validation
        if (!shiftTypeName) {

            $('#shiftNameValidationMessage')
                .html('<span class="text-danger">Shift Type Name is required.</span>');

            e.preventDefault();
            return false;
        }

        if (!startTime) {

            $('#startTimeValidationMessage')
                .html('<span class="text-danger">Start Time is required.</span>');

            e.preventDefault();
            return false;
        }

        if (!endTime) {

            $('#endTimeValidationMessage')
                .html('<span class="text-danger">End Time is required.</span>');

            e.preventDefault();
            return false;
        }

        // Same time validation
        if (startTime === endTime) {

            $('#endTimeValidationMessage')
                .html('<span class="text-danger">Start Time and End Time cannot be same.</span>');

            e.preventDefault();
            return false;
        }

        // Prevent submit if button disabled
        if ($('#btnSubmit').prop('disabled')) {

            e.preventDefault();
            return false;
        }

        return true;
    });
</script>