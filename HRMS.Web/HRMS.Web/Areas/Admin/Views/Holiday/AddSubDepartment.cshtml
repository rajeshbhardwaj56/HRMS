@using HRMS.Models
@model SubDepartmentModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sub Department";
}

<div class="main-header anim" style="--delay: 0s">
    Sub Department Details
</div>

<form method="post" id="submitForm">

    <div class="group-box anim" style="--delay: .3s">
        <div class="Container">
            <div class="row">

                <div class="col-md-4 form-group">
                    <div class="col-md-12">
                        Department <label class="Mandetory">*</label>
                    </div>
                    <div class="col-md-12">
                        @Html.DropDownListFor(
                            x => x.DepartmentID,
                            Model.DepartmentList,
                            "-- Select Department --",
                            new
                            {
                                @class = "form-control",
                                @required = "required",
                                @id = "DepartmentID"
                            })
                    </div>
                </div>

                <div class="col-md-4 form-group">
                    <div class="col-md-12">
                        Sub Department Name <label class="Mandetory">*</label>
                    </div>
                    <div class="col-md-12">

                        @Html.HiddenFor(x => x.SubDepartmentID, new { id = "SubDepartmentID" })

                        @Html.TextBoxFor(
                            x => x.Name,
                            new
                            {
                                @class = "form-control",
                                @required = "required",
                                @id = "SubDepartmentName"
                            })

                        <span id="subDepartmentError" class="text-danger"></span>

                    </div>
                </div>

                <div class="col-md-4 form-group">
                    <div class="col-md-12">
                        Active
                    </div>
                    <div class="col-md-12">
                        @Html.CheckBoxFor(x => x.IsActive)
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">

            <input id="submitBtn"
                   type="submit"
                   value="Submit"
                   class="btn btn-success" />

            <input id="cancelButton"
                   type="button"
                   value="Cancel"
                   class="btn btn-danger"
                   style="margin-left:10px;" />

        </div>
    </div>

</form>

<script>

    var isDuplicateSubDepartment = false;

    function checkDuplicateSubDepartment(callback) {

        var subDepartmentName = $("#SubDepartmentName").val().trim();
        var subDepartmentId = $("#SubDepartmentID").val();
        var departmentId = $("#DepartmentID").val();

        if (subDepartmentName === "") {

            $("#subDepartmentError").text("Sub Department Name is required.");
            callback(false);
            return;
        }

        $.ajax({

            url: '/Admin/Holiday/CheckDuplicateSubDepartment',
            type: 'POST',
            dataType: 'json',

            data: {
                subDepartmentName: subDepartmentName,
                subDepartmentId: subDepartmentId,
                departmentId: departmentId
            },

            success: function (response) {

                if (response.isDuplicate) {

                    $("#subDepartmentError").text("Sub Department already exists.");
                    callback(false);
                }
                else {

                    $("#subDepartmentError").text("");
                    callback(true);
                }
            }
        });
    }

    $("#SubDepartmentName").on("blur", function () {

        checkDuplicateSubDepartment(function () { });

    });

    $("#submitForm").on("submit", function (e) {

        e.preventDefault();

        var departmentId = $("#DepartmentID").val();

        if (departmentId == "" || departmentId == "0") {

            alert("Please select Department.");

            return false;
        }

        checkDuplicateSubDepartment(function (isValid) {

            if (isValid) {

                document.getElementById("submitForm").submit();

            }

        });

    });

    $("#cancelButton").on("click", function () {

        window.location.href = '@Url.Action("SubDepartmentListings", "Holiday")';

    });

</script>