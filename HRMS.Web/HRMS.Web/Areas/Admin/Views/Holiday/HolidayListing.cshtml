@using HRMS.Models.Common;

<link href="~/assets/pages/gridlist.css" rel="stylesheet" />

@{
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "Holiday";

	var success = TempData["Success"];
	var Err = TempData["Error"];
}

<div class="main-header anim" style="--delay: 0s">Holiday List
	<div class="col-md-3 col-sm-6 mb-2 mb-md-0">
		<div class="d-flex align-items-center">
			<label for="locationDropdown" class="mr-2 mb-0" style="font-size: 12px; white-space: nowrap;">Select Location: </label>
			<select id="locationDropdown" class="form-control form-control-sm">
				<option value="">All Locations</option>				
			</select>
		</div>
	</div>
	<div class="col-md-3 col-sm-6 mb-2 mb-md-0">
		<div class="d-flex align-items-center">
			<label for="subDepartmentDropdown" class="mr-2 mb-0" style="font-size:12px; white-space:nowrap;">
				Select Process:
			</label>

			<select id="subDepartmentDropdown" class="form-control form-control-sm">
				<option value="">All Process</option>
			</select>
		</div>
	</div>
	<a href="~/Admin/Holiday">
	<button type="button" class="btn btn-addBtn" id="openFormBtn">Add Holiday</button></a>
	
</div>
@* <div class="addcomp px-4">
    <h4>Holiday List</h4>
    <a href="~/Admin/Holiday"> <button type="button" class="btn btn-addcompany" id="openFormBtn">Add Holiday</button></a>
</div> *@


<div class="table-responsive py-3">
	
	<table id="tblHolidayListing" class="table table-striped body-text" style="width:100%">
		<thead>
			
			<tr>
				<th class="first" style="visibility:hidden"> /th>
				<th>Holiday Name</th>
				<th>From Date</th>
				<th>To Date</th>
				<th>Description</th>
				<th>Location</th> 
			    <th>Process</th>
				<th>Status</th>	
				<th>Action</th>
			</tr>
		</thead>

	</table>
</div>



<script type="text/javascript">
		$('#locationDropdown').change(function () {
		$('#tblHolidayListing').DataTable().ajax.reload();
	});
			$('#subDepartmentDropdown').change(function () {
			$('#tblHolidayListing').DataTable().ajax.reload();
		});
	$(document).ready(function () {
		$('#tblHolidayListing').DataTable({
			"ajax": {
				"url": "HolidayListings/",
				"type": "POST",
				"datatype" :"json",
				 "data": function (d) {
				
				d.locationId = $('#locationDropdown').val();
				d.subDepartmentId = $('#subDepartmentDropdown').val();
			},
					dataSrc: function (json) {

			// Location
			var location = $('#locationDropdown');
			var selectedLocation = location.val();

			location.empty();
			location.append('<option value="">All Locations</option>');

			if (json.locations) {

				$.each(json.locations, function (i, item) {

					location.append(
						$('<option></option>')
							.val(item.jobLocationID)
							.text(item.jobLocationName)
					);

				});

			}

			location.val(selectedLocation);


			// Process
			var process = $('#subDepartmentDropdown');
			var selectedProcess = process.val();

			process.empty();
			process.append('<option value="">All Process</option>');

			if (json.subDepartments) {

				$.each(json.subDepartments, function (i, item) {

					process.append(
						$('<option></option>')
							.val(item.subDepartmentID)
							.text(item.name)
					);

				});

			}

			process.val(selectedProcess);

			return json.data;

		}
			},
			"ordering": true,
			"paging": true,
			"searching": true,
			"info": true,
			"columns": [
				{ "data": "holidayID", "autoWidth": true, },
				{ "data": "holidayName", "autoWidth": true, },
				{
					"data": "fromDate", "autoWidth": true, "render": function (data, type, row) {
						var dateObj = new Date(data);
						var day = String(dateObj.getDate()).padStart(2, '0');
		var month = String(dateObj.getMonth() + 1).padStart(2, '0'); // Months are zero-based
		var year = dateObj.getFullYear();
		return `${day}/${month}/${year}`;

					}
				},
				{
					"data": "toDate", "autoWidth": true, "render": function (data, type, row) {
						var dateObj = new Date(data);
						  var day = String(dateObj.getDate()).padStart(2, '0');
		var month = String(dateObj.getMonth() + 1).padStart(2, '0');
		var year = dateObj.getFullYear();
		return `${day}/${month}/${year}`;
					}
				},
				{ "data": "description", "autoWidth": true },
				{ "data": "location", "autoWidth": true },
					{ "data": "processName", "autoWidth": true },
				{  "data": "status",
	"autoWidth": true,
	"render": function (data, type, row) {
		return data === true || data === "true" ? "Active" : "Inactive";
	} },

				{
					// this is Actions Column
					mRender: function (data, type, row) {
						var linkEdit = '<div class="table-data-feature"><a data-toggle="tooltip" data-placement="top"  class="item" href="Index?id=' + row.encodedId + '"  title=""  data-original-title="Edit"><img src="/assets/img/edit.png" width="20" height="20" /></a>';
						return linkEdit;
					}
				},
			],
			"columnDefs": [
				{
					target: 2,
					visible: false,
					searchable: false
				},

				{

					"targets": [0], //first and last not sortable
					"orderable": false,
					"visible": false
				},

				{

					"targets": [1], //first and last not sortable
					"orderable": true,
					"defaultContent": " "
				}

			]
			, "responsive": true

		});

	});
</script>