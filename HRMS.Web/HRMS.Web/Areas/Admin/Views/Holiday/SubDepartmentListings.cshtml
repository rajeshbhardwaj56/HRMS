@using HRMS.Models.Common;

<link href="~/assets/pages/gridlist.css" rel="stylesheet" />

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sub Department";

    var success = TempData["Success"];
    var Err = TempData["Error"];
}

<div class="main-header anim" style="--delay: 0s">
    Sub Department List

    <a href="~/Admin/Holiday/AddSubDepartment">
        <button type="button" class="btn btn-addBtn">
            Add Sub Department
        </button>
    </a>
</div>

<div class="table-responsive py-3">

    <table id="tblSubDepartmentListing"
           class="table table-striped body-text"
           style="width:100%">
        <thead>
            <tr>
                <th style="display:none;">ID</th>
                <th>Sub Department Name</th>
                <th>Department</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>

</div>

<script>

    $(document).ready(function () {

        $('#tblSubDepartmentListing').DataTable({

            "ajax": {
                "url": "SubDepartmentListings/",
                "type": "POST",
                "datatype": "json",
                "dataSrc": "data"
            },

            "ordering": true,
            "order": [[0, "desc"]],
            "paging": true,
            "searching": true,
            "info": true,

            "columns": [

                {
                    "data": "subDepartmentID",
                    "visible": false
                },

                {
                    "data": "name",
                    "autoWidth": true
                },

                {
                    "data": "departmentName",
                    "autoWidth": true
                },

                {
                    "data": "isActive",
                    "autoWidth": true,
                    "render": function (data) {
                        return data ? "Active" : "Inactive";
                    }
                },

                {
                    mRender: function (data, type, row) {

                        return '<div class="table-data-feature">' +
                            '<a class="item" href="AddSubDepartment?id=' + row.encodedId + '">' +
                            '<img src="/assets/img/edit.png" width="20" height="20" />' +
                            '</a>' +
                            '</div>';
                    }
                }
            ],

            "responsive": true
        });

    });

</script>