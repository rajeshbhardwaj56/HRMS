@using HRMS.Models.Common
@model HRMS.Models.PayRoll.EmployeeSalaryRequestModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@{
    Layout = null;

    var Logo = this.HttpContextAccessor.HttpContext.Session.GetString(Constants.CompanyLogo);

}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>
        SalarySlip_@(Model.EmployeeName)_@(Model.MonthName)_@(Model.Year)
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #eee;
            font-family: Arial, Helvetica, sans-serif;
            color: #000;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 15px auto;
            background: white;
            padding: 10mm;
        }

        .salary-slip {
            width: 100%;
            border: 1px solid #000;
            background: #fff;
        }

        /* =========================
           HEADER
           ========================= */

        .header {
            min-height: 42mm;
            border-bottom: 1px solid #000;
            position: relative;
            text-align: center;
            padding: 7mm 5mm 4mm 40mm;
        }

        .logo {
            position: absolute;
            left: 8mm;
            top: 4mm;
            width: 32mm;
            height: 27mm;
            object-fit: contain;
        }

        .company-name {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .company-cin {
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .company-address {
            font-size: 10px;
            font-weight: bold;
        }

        /* =========================
           TITLE
           ========================= */

        .slip-title {
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            padding: 5px;
            border-bottom: 1px solid #000;
        }

        /* =========================
           EMPLOYEE DETAILS
           ========================= */

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td,
        th {
            border: 1px solid #000;
            padding: 4px 5px;
            font-size: 10px;
        }

        .label {
            font-weight: bold;
            width: 23%;
        }

        .value {
            width: 27%;
        }

        /* =========================
           SALARY TABLE
           ========================= */

        .salary-table th {
            text-align: center;
            font-weight: bold;
            background: #f5f5f5;
        }

        .salary-table td {
            height: 22px;
        }

        .amount {
            text-align: right;
        }

        .total-row td {
            font-weight: bold;
        }



            /* =========================
               NET PAY
               ========================= */

            .net-section {
                height: 35mm;
                padding: 0 4px 6px 4px;
                border-top: 1px solid #000;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                font-size: 11px;
                line-height: 18px;
            }


            /* =========================
               FOOTER
               ========================= */

            .footer {
                height: 25mm;
                padding: 0 4px 6px 4px;
                border-top: 1px solid #000;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                font-size: 11px;
                line-height: 18px;
            }

        /* =========================
           PRINT BUTTON
           ========================= */

        .print-area {
            text-align: center;
            margin: 20px;
        }

            button#printbtn {
                background: #053879;
                color: white;
                width: 100px;
                border-radius: 12px;
                border: none;
                padding: 7px;
            }

        @@media print {

            @@page {
                size: A4;
                margin: 0;
            }

            html,
            body {
                width: 210mm;
                min-height: 297mm;
                background: white;
            }

            .page {
                width: 210mm;
                min-height: 297mm;
                margin: 0;
                padding: 10mm;
            }

            .print-area {
                display: none !important;
            }

            .salary-slip {
                width: 100%;
                border: 1px solid #000;
            }

            table,
            tr,
            td,
            th {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

        }

    </style>

</head>

<body>
    <div class="print-area">
        <button type="button"
                class="print-btn" id="printbtn"
                onclick="window.print()">

            <i class="fa fa-print"></i>
            Print

        </button>
    </div>

    <div class="page">

        <div class="salary-slip">

            <!-- ================= HEADER ================= -->

            <div class="header">

                @* Replace with your actual logo path *@
                <img src="@Logo"
                     class="logo"
                     alt="Company Logo" />

                <div class="company-name">
                    PROTALK SOLUTIONS PRIVATE LIMITED
                </div>

                <div class="company-cin">
                    CIN-U62099PB2023PTC057998
                </div>

                <div class="company-address">
                    C-126, INDUSTRIAL AREA, PHASE – 8,
                    MOHALI, PUNJAB – 160055, INDIA
                </div>

            </div>


            <!-- ================= TITLE ================= -->

            <div class="slip-title">

                Payslip for the month of
                @Model.MonthName-@Model.Year.ToString().Substring(2)

            </div>


            <!-- ================= EMPLOYEE DETAILS ================= -->

            <table>

                <tr>

                    <td class="label">
                        Emp Code
                    </td>

                    <td class="value">
                        @Model.EmployeeNumber
                    </td>

                    <td class="label">
                        Name
                    </td>

                    <td class="value">
                        @Model.EmployeeName
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Designation
                    </td>

                    <td class="value">
                        @Model.Designation
                    </td>

                    <td class="label">
                        Department
                    </td>

                    <td class="value">
                        @Model.Department
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Date of Joining
                    </td>

                    <td class="value">
                        @Model.DateOfJoining
                    </td>

                    <td class="label">
                        Bank
                    </td>

                    <td class="value">
                        @Model.BankName
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Location
                    </td>

                    <td class="value">
                        @Model.Location
                    </td>

                    <td class="label">
                        SB Account No
                    </td>

                    <td class="value">
                        @Model.BankAccountNumber
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Month Days
                    </td>

                    <td class="value">
                        @Model.MonthDays
                    </td>

                    <td class="label">
                        Paid Days
                    </td>

                    <td class="value">
                        @Model.PayableDays
                    </td>

                </tr>

            </table>


            <!-- ================= SALARY ================= -->

            <table class="salary-table">

                <tr>

                    <th style="width:28%;">
                        Earning
                    </th>

                    <th style="width:20%;">
                        Salary
                    </th>

                    <th style="width:20%;">
                        Earned
                    </th>

                    <th style="width:20%;">
                        Deductions
                    </th>

                    <th style="width:12%;">
                        Monthly
                    </th>

                </tr>


                <tr>

                    <td>Basic/Stipend</td>

                    <td class="amount">
                        @Model.BasicFixed
                    </td>

                    <td class="amount">
                        @Model.BasicPayable
                    </td>

                    <td>
                        Employee PF
                    </td>

                    <td class="amount">
                        @Model.EMPPF
                    </td>

                </tr>


                <tr>

                    <td>House Rent Allowance</td>

                    <td class="amount">
                        @Model.HRAFixed
                    </td>

                    <td class="amount">
                        @Model.HRAPayable
                    </td>

                    <td>
                        Employee ESI
                    </td>

                    <td class="amount">
                        @Model.EMPESI
                    </td>

                </tr>


                <tr>

                    <td>Conveyance Allowance</td>

                    <td class="amount">
                        @Model.ConveyanceFixed
                    </td>

                    <td class="amount">
                        @Model.ConveyancePayable
                    </td>

                    <td>
                        TDS
                    </td>

                    <td class="amount">
                        @Model.TDS
                    </td>

                </tr>


                <tr>

                    <td>Special Allowance</td>

                    <td class="amount">
                        @Model.SpecialAllowanceFixed
                    </td>

                    <td class="amount">
                        @Model.SpecialAllowancePayable
                    </td>

                    <td>
                        Professional Tax
                    </td>

                    <td class="amount">
                        @Model.PTAX
                    </td>

                </tr>


                <tr>

                    <td>Bonus</td>

                    <td class="amount">0</td>

                    <td class="amount">0</td>

                    <td>
                        Labor Welfare Fund
                    </td>

                    <td class="amount">
                        @Model.EMPLWF
                    </td>

                </tr>


                <tr>

                    <td>Performance Linked Incentive</td>

                    <td class="amount">
                        @Model.PLI
                    </td>

                    <td class="amount">
                        @Model.PLI
                    </td>

                    <td>
                        Advance
                    </td>

                    <td class="amount">
                        @Model.Advanceded
                    </td>

                </tr>


                <tr>

                    <td>Other Addition</td>

                    <td class="amount">
                        @Model.OtherAdditonArrear
                    </td>

                    <td class="amount">
                        @Model.OtherAdditonArrear
                    </td>

                    <td>
                        Other Deduction
                    </td>

                    <td class="amount">
                        @Model.OtherDeduction
                    </td>

                </tr>


                <tr class="total-row">

                    <td style="background: #f5f5f5;">
                        Gross Earning
                    </td>

                    <td class="amount" style="background: #f5f5f5;">
                        @Model.GrossSalaryFixed
                    </td>

                    <td class="amount" style="background: #f5f5f5;">
                        @Model.GrossSalaryPayable
                    </td>

                    <td style="background: #f5f5f5;">
                        Gross Deduction
                    </td>

                    <td class="amount" style="background: #f5f5f5;">
                        @Model.TotalDeduction
                    </td>

                </tr>

            </table>


            <!-- ================= NET ================= -->

            <div class="net-section">

                <div>
                    Net Amount:
                    <strong>
                        @Model.NetPayable.ToString("0.00") /-
                    </strong>

                    (Net Pay in Words:
                    <strong>
                        @Model.NetPayableInWords
                    </strong>)
                </div>

            </div>


            <!-- ================= FOOTER ================= -->

            <div class="footer">
                <strong>
                This is a computer generated pay slip hence
                signature is not required
                </strong>

            </div>

        </div>

    </div>


</body>
</html>