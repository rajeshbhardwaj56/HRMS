        const empId = $dropdown.val();

        if (empId) {

            // Employee is selected
            // Get employee's salary details for new Year/Month
            setPayableDaysMode(true);

            fetchPayrollData(empId);

        } else {

            // No employee selected
            // Only get payroll period / MonthDays
            setPayableDaysMode(false);

            fetchPayrollPeriodDetails();
        }
    });

    if (isEditMode && initialEmployee && initialEmployee.id) {

        const option = new Option(
            initialEmployee.text,
            initialEmployee.id,
            true,
            true
        );

        $dropdown.append(option).trigger('change');

        $dropdown.prop('disabled', true);

        // Payroll Type should also be readonly in edit mode
        setPayrollTypeReadonly(true);

        fetchPayrollData(initialEmployee.id);
    }
