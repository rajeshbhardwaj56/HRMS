@model HRMS.Models.PayRoll.EmployeeSalaryRequestModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Edit Salary";

    bool isEditMode = Model.SalaryID > 0;
    var selectedYear = Model.Year > 0 ? Model.Year : DateTime.Now.Year;
    var selectedMonth = Model.Month > 0 ? Model.Month : DateTime.Now.Month;
    var GrossSalary = Model.RevisedGross;
}
<style>

    .salary-slip-modal-body {
        background: #e9ecef !important;
        overflow: auto !important;
        padding: 20px !important;
    }

    .salary-slip-preview-container {
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        overflow-y: visible;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

        .salary-slip-preview-container .salary-slip-preview-root {
            flex: 0 0 210mm;
        }

</style>
<div class="card">
    <div class="card-header">
        <h4>Calculate Salary</h4>
    </div>

    <div class="card-body">

        <div class="row">
            <input type="hidden" asp-for="PayrollTypeID" id="PayrollTypeIDHidden" />

            <div class="col-md-3">
                <label>Employee</label>
                <select asp-for="EmployeeID"
                        class="form-select"
                        id="empTypeDropdown"
                    @(isEditMode ? "disabled" : "")>
                </select>
            </div>

            <div class="col-md-3">
                <label>Payroll Type<span class="Mandetory">*</span></label>

                <select class="form-select"
                        id="PayrollTypeID"
                    @(isEditMode ? "disabled" : "")>

                    <option value="" selected>-- Select Payroll Type --</option>
                    <option value="1">Regular</option>
                    <option value="2">OJT</option>
                    <option value="3">NAPS</option>
                    <option value="4">NATS</option>
                </select>
            </div>

            <div class="col-md-3">
                <label>Year</label>
                <select asp-for="SalaryYear"
                        class="form-select"
                        id="YearDropdown"
                    @(isEditMode ? "disabled" : "")>
                </select>
            </div>

            <div class="col-md-3">
                <label>Month</label>
                <select asp-for="SalaryMonth"
                        class="form-select"
                        id="MonthDropdown"
                    @(isEditMode ? "disabled" : "")>
                </select>
            </div>
        </div>

        <br />

        <!-- Input Fields -->
        <div class="row">
            <div class="col-md-3">
                <label>Gross Salary</label>
                <input type="number"
                       class="form-control"
                       id="RevisedGross"
                       name="RevisedGross"
                       step="0.01"
                       value="@Model.RevisedGross" 
                        />
            </div>

            <div class="col-md-3">
                <label>Month Days</label>
                <input type="number"
                       class="form-control"
                       id="MonthDays"
                       name="MonthDays"
                       step="0.01"
                       value="@Model.MonthDays"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Payable Days</label>
                <input type="number"
                       class="form-control"
                       id="PayableDays"
                       name="PayableDays"
                       step="0.01"
                       value="@Model.PayableDays" />

                <small id="PayableDaysInfo" class="text-muted" style="font-size:11px;">
                    Payable days are calculated from attendance.
                </small>
            </div>

            <div class="col-md-3">
                <label>Client Incentive</label>
                <input type="number"
                       class="form-control"
                       id="ClientIncentive"
                       name="ClientIncentive"
                       step="0.01"
                       value="@Model.ClientIncentive" />
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-3">
                <label>PLI</label>
                @Html.TextBoxFor(m => m.PLI, new { @class = "form-control", type = "number", step = "0.01", id = "PLI" })
            </div>

            <div class="col-md-3">
                <label>Floor Incentive</label>
                @Html.TextBoxFor(m => m.FloorIncentive, new { @class = "form-control", type = "number", step = "0.01", id = "FloorIncentive" })
            </div>

            <div class="col-md-3">
                <label>Employee Referral</label>
                @Html.TextBoxFor(m => m.EmpReferal, new { @class = "form-control", type = "number", step = "0.01", id = "EmpReferal" })
            </div>

            <div class="col-md-3">
                <label>Training Fee</label>
                @Html.TextBoxFor(m => m.TrainingFee, new { @class = "form-control", type = "number", step = "0.01", id = "TrainingFee" })
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-3">
                <label>GWR</label>
                @Html.TextBoxFor(m => m.GWR, new { @class = "form-control", type = "number", step = "0.01", id = "GWR" })
            </div>

            <div class="col-md-3">
                <label>Other Addition/Arrear</label>
                @Html.TextBoxFor(m => m.OtherAdditonArrear, new { @class = "form-control", type = "number", step = "0.01", id = "OtherAdditonArrear" })
            </div>

            <div class="col-md-3">
                <label>EMPLWF</label>
                @Html.TextBoxFor(m => m.EMPLWF, new { @class = "form-control", type = "number", step = "0.01", id = "EMPLWF" })
            </div>

            <div class="col-md-3">
                <label>TDS</label>
                @Html.TextBoxFor(m => m.TDS, new { @class = "form-control", type = "number", step = "0.01", id = "TDS" })
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-3">
                <label>DBT Deduction</label>
                @Html.TextBoxFor(m => m.DbtDeduction, new { @class = "form-control", type = "number", step = "0.01", id = "DbtDeduction" })
            </div>

            <div class="col-md-3">
                <label>Advance DED</label>
                @Html.TextBoxFor(m => m.Advanceded, new { @class = "form-control", type = "number", step = "0.01", id = "Advanceded" })
            </div>

            <div class="col-md-3">
                <label>Insurance Deduction</label>
                @Html.TextBoxFor(m => m.InsuranceDeduction, new { @class = "form-control", type = "number", step = "0.01", id = "InsuranceDeduction" })
            </div>

            <div class="col-md-3">
                <label>Other Deduction</label>
                @Html.TextBoxFor(m => m.OtherDeduction, new { @class = "form-control", type = "number", step = "0.01", id = "OtherDeduction" })
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-12 d-flex align-items-center mt-3">

                <button type="button"
                        class="btn btn-primary me-2"
                        onclick="calculateSalary()">
                    Calculate Salary
                </button>

                <button type="button"
                        class="btn btn-primary me-2"
                        id="btnSaveSalary"
                        onclick="saveSalary()"
                        title="Please calculate salary first">
                    Save Salary
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="printSalaryBtn"
                        onclick="openSalarySlipModal()"
                        title="Please save the salary first to generate the correct salary slip.">
                    <i class="fa fa-print me-1"></i>
                    Print Salary Slip
                </button>

            </div>
        </div>

        <hr />

        <h5>Calculated Salary</h5>

        <!-- ===================================================== -->
        <!-- FIXED SALARY -->
        <!-- ===================================================== -->

        <h6>Fixed Salary</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Basic Fixed</label>
                <input type="number"
                       class="form-control"
                       id="BasicFixed"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>HRA Fixed</label>
                <input type="number"
                       class="form-control"
                       id="HRAFixed"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Conveyance Fixed</label>
                <input type="number"
                       class="form-control"
                       id="ConveyanceFixed"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Special Allowance Fixed</label>
                <input type="number"
                       class="form-control"
                       id="SpecialAllowanceFixed"
                       step="0.01"
                       readonly />
            </div>

        </div>

        <br />

        <div class="row">

            <div class="col-md-3">
                <label>Gross Salary Fixed</label>
                <input type="number"
                       class="form-control"
                       id="GrossSalaryFixed"
                       step="0.01"
                       readonly />
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PAYABLE SALARY -->
        <!-- ===================================================== -->

        <h6 class="mt-3">Payable Salary</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Basic Payable</label>
                <input type="number"
                       class="form-control"
                       id="BasicPayable"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>HRA Payable</label>
                <input type="number"
                       class="form-control"
                       id="HRAPayable"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Conveyance Payable</label>
                <input type="number"
                       class="form-control"
                       id="ConveyancePayable"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Special Allowance Payable</label>
                <input type="number"
                       class="form-control"
                       id="SpecialAllowancePayable"
                       step="0.01"
                       readonly />
            </div>

        </div>

        <br />

        <div class="row">

            <div class="col-md-3">
                <label>Gross Salary Payable</label>
                <input type="number"
                       class="form-control"
                       id="GrossSalaryPayable"
                       step="0.01"
                       readonly />
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- EMPLOYEE STATUTORY -->
        <!-- ===================================================== -->

        <h6 class="mt-3">Employee Statutory Deductions</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Employee PF</label>
                <input type="number"
                       class="form-control"
                       id="EMPPF"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Employee ESI</label>
                <input type="number"
                       class="form-control"
                       id="EMPESI"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Professional Tax</label>
                <input type="number"
                       class="form-control"
                       id="PTAX"
                       step="0.01"
                       readonly />
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- CALCULATED DEDUCTIONS -->
        <!-- IMPORTANT: DIFFERENT IDs -->
        <!-- ===================================================== -->

        <h6 class="mt-3">Calculated Employee Deductions</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Employee LWF</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedEMPLWF"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>TDS</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedTDS"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>DBT Deduction</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedDbtDeduction"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Advance Deduction</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedAdvanceded"
                       step="0.01"
                       readonly />
            </div>

        </div>

        <br />

        <div class="row">

            <div class="col-md-3">
                <label>Insurance Deduction</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedInsuranceDeduction"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Other Deduction</label>
                <input type="number"
                       class="form-control"
                       id="CalculatedOtherDeduction"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Total Deduction</label>
                <input type="number"
                       class="form-control"
                       id="TotalDeduction"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Net Payable</label>
                <input type="number"
                       class="form-control"
                       id="NetPayable"
                       step="0.01"
                       readonly />
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- EMPLOYER CONTRIBUTION -->
        <!-- ===================================================== -->

        <h6 class="mt-3">Employer Contribution</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Employer PF</label>
                <input type="number"
                       class="form-control"
                       id="EmployerPF"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Employer ESI</label>
                <input type="number"
                       class="form-control"
                       id="EmployerESI"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Employer LWF</label>
                <input type="number"
                       class="form-control"
                       id="EmployerLWF"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>Total Employer Contribution</label>
                <input type="number"
                       class="form-control"
                       id="TotalEmployerContribution"
                       step="0.01"
                       readonly />
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PF / EPS / EDLI -->
        <!-- ===================================================== -->

        <h6 class="mt-3">PF / EPS / EDLI</h6>

        <div class="row">

            <div class="col-md-3">
                <label>EPF Wages</label>
                <input type="number"
                       class="form-control"
                       id="EPFWages"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>EPS Wages</label>
                <input type="number"
                       class="form-control"
                       id="EPSWages"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>EDLI Wages</label>
                <input type="number"
                       class="form-control"
                       id="EDLIWages"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>EPF Admin Charges</label>
                <input type="number"
                       class="form-control"
                       id="EPFAdminCharges"
                       step="0.01"
                       readonly />
            </div>

        </div>

        <br />

        <div class="row">

            <div class="col-md-3">
                <label>EDLI Contribution</label>
                <input type="number"
                       class="form-control"
                       id="EDLIContribution"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>EDLI Admin Charges</label>
                <input type="number"
                       class="form-control"
                       id="EDLIAdminCharges"
                       step="0.01"
                       readonly />
            </div>

            <div class="col-md-3">
                <label>CTC</label>
                <input type="number"
                       class="form-control"
                       id="CTC"
                       step="0.01"
                       readonly />
            </div>

        </div>


    </div>

</div>
<!-- Salary Slip Preview Modal -->
<div class="modal fade"
     id="salarySlipModal"
     tabindex="-1"
     aria-labelledby="salarySlipModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="salarySlipModalLabel">
                    Salary Slip Preview
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body p-0 salary-slip-modal-body">

                <div id="salarySlipLoader"
                     class="text-center p-5">

                    <div class="spinner-border text-primary"
                         role="status">
                    </div>

                    <div class="mt-2">
                        Loading salary slip...
                    </div>

                </div>

                <div id="salarySlipPreviewContainer"
                     class="salary-slip-preview-container"
                     style="display:none;">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        onclick="printSalarySlip()">

                    <i class="fa fa-print me-1"></i>
                    Print

                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="downloadSalarySlipPdf(event)">

                    <i class="fa fa-file-pdf me-1"></i>
                    Download PDF

                </button>
                <button type="button"
                        class="btn btn-primary"
                        onclick="emailSalarySlip()">
                    <i class="fa fa-envelope me-1"></i>
                    Share 
                </button>
            </div>

        </div>

    </div>

</div>
<script>
      $(document).ready(function () {

        const isEditMode = @isEditMode.ToString().ToLower();

        const initialEmployee = {
            id: '@Model.EmployeeID',
            text: '@Model.EmployeeNumber - @Model.EmployeeName'
        };

        const selectedYear = @selectedYear;
        const selectedMonth = @selectedMonth;

        const employeeId = '@Model.EmployeeID';
        const payrollTypeId = '@Model.PayrollTypeID';

        const currentYear = new Date().getFullYear();

        const $yearDropdown = $('#YearDropdown');
        const $monthDropdown = $('#MonthDropdown');

        // =========================
        // YEAR
        // =========================

        for (let y = currentYear; y >= currentYear - 5; y--) {

            const selected = (y === selectedYear) ? 'selected' : '';

            $yearDropdown.append(
                `<option value="${y}" ${selected}>${y}</option>`
            );
        }

        // =========================
        // MONTH
        // =========================

        const monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];

        for (let m = 1; m <= 12; m++) {

            const selected = (m === selectedMonth) ? 'selected' : '';

            $monthDropdown.append(
                `<option value="${m}" ${selected}>${monthNames[m - 1]}</option>`
            );
        }

        // =========================
        // PAYROLL TYPE
        // =========================

        if (payrollTypeId) {

            $("#PayrollTypeID").val(payrollTypeId);

            $("#PayrollTypeIDHidden").val(payrollTypeId);
        }

        // =========================
        // EMPLOYEE DROPDOWN
        // =========================

        initializeEmployeeDropdown(initialEmployee, isEditMode);


        // =========================
        // IMPORTANT
        // =========================

        const empId = $("#empTypeDropdown").val();

        if (empId) {

            // Employee already selected
            // Get employee salary details
             setPayableDaysMode(true);

             fetchPayrollData(empId);

        } else {

            // No employee selected
            // Get MonthDays for current selected Year/Month
               setPayableDaysMode(false);

            fetchPayrollPeriodDetails();
        }
            $("#PayrollTypeID").on("change", function () {

        var payrollTypeId = parseInt($(this).val()) || 0;

        $("#PayrollTypeIDHidden").val(payrollTypeId);

        console.log("Selected Payroll Type:", payrollTypeId);
    });
    });
    function getVal(id) {
        return parseFloat($(id).val()) || 0;
    }

    function getInt(id) {
        return parseInt($(id).val()) || 0;
    }


    function saveSalary() {

        var monthDays = parseFloat($("#MonthDays").val()) || 0;
        var payableDays = parseFloat($("#PayableDays").val()) || 0;

        $("#PayableDaysError").hide().text("");

        if (payableDays < 0) {
            $("#PayableDaysError")
                .text("Payable days cannot be negative")
                .show();
            return;
        }

        if (payableDays > monthDays) {
            $("#PayableDaysError")
                .text("Payable days cannot be greater than month days")
                .show();
            return;
        }

        const salaryData = {

            // BASIC
            EmployeeID: getInt("#empTypeDropdown"),
            PayrollTypeID: getInt("#PayrollTypeIDHidden"),
            Year: getInt("#YearDropdown"),
            Month: getInt("#MonthDropdown"),

            RevisedGross: getVal("#RevisedGross"),
            MonthDays: getVal("#MonthDays"),
            PayableDays: getVal("#PayableDays"),

            // FIXED
            BasicFixed: getVal("#BasicFixed"),
            HRAFixed: getVal("#HRAFixed"),
            ConveyanceFixed: getVal("#ConveyanceFixed"),
            SpecialAllowanceFixed: getVal("#SpecialAllowanceFixed"),
            GrossSalaryFixed: getVal("#GrossSalaryFixed"),

            // PAYABLE
            BasicPayable: getVal("#BasicPayable"),
            HRAPayable: getVal("#HRAPayable"),
            ConveyancePayable: getVal("#ConveyancePayable"),
            SpecialAllowancePayable: getVal("#SpecialAllowancePayable"),
            GrossSalaryPayable: getVal("#GrossSalaryPayable"),

            // EARNINGS
            ClientIncentive: getVal("#ClientIncentive"),
            PLI: getVal("#PLI"),
            FloorIncentive: getVal("#FloorIncentive"),
            EmpReferal: getVal("#EmpReferal"),
            TrainingFee: getVal("#TrainingFee"),
            GWR: getVal("#GWR"),
            OtherAdditonArrear: getVal("#OtherAdditonArrear"),

            // EMPLOYEE DEDUCTIONS
            EMPLWF: getVal("#EMPLWF"),
            TDS: getVal("#TDS"),
            DbtDeduction: getVal("#DbtDeduction"),
            Advanceded: getVal("#Advanceded"),
            InsuranceDeduction: getVal("#InsuranceDeduction"),
            OtherDeduction: getVal("#OtherDeduction"),

            // EMPLOYEE STATUTORY
            EMPPF: getVal("#EMPPF"),
            EMPESI: getVal("#EMPESI"),
            PTAX: getVal("#PTAX"),

            // TOTALS
            TotalDeduction: getVal("#TotalDeduction"),
            NetPayable: getVal("#NetPayable"),

            // EMPLOYER
            EmployerPF: getVal("#EmployerPF"),
            EmployerESI: getVal("#EmployerESI"),
            EmployerLWF: getVal("#EmployerLWF"),
            TotalEmployerContribution: getVal("#TotalEmployerContribution"),

            // EPF / EPS / EDLI
            EPFWages: getVal("#EPFWages"),
            EPSWages: getVal("#EPSWages"),
            EDLIWages: getVal("#EDLIWages"),
            EPFAdminCharges: getVal("#EPFAdminCharges"),
            EDLIContribution: getVal("#EDLIContribution"),
            EDLIAdminCharges: getVal("#EDLIAdminCharges"),

            // CTC
            CTC: getVal("#CTC")
        };

        if (!salaryData.EmployeeID || !salaryData.PayrollTypeID) {
            alert("Please select Employee and Payroll Type");
            return;
        }

        $.ajax({
            url: '/Admin/Payroll/SaveSalary',
            type: 'POST',
            data: JSON.stringify(salaryData),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',

            success: function (response) {

                if (response.success) {

                    $.toast({
                        heading: 'Success',
                        text: response.message || "Salary saved successfully!",
                        showHideTransition: 'slide',
                        icon: 'success',
                        position: 'top-right'
                    });

                } else {

                    $.toast({
                        heading: 'Error',
                        text: response.message || "Failed to save salary.",
                        showHideTransition: 'slide',
                        icon: 'error',
                        position: 'top-right'
                    });
                }
            },

            error: function (xhr) {


                $.toast({
                    heading: 'Error',
                    text: "An unexpected error occurred while saving salary.",
                    showHideTransition: 'slide',
                    icon: 'error',
                    position: 'top-right'
                });
            }
        });
    }


           function calculateSalary() {

        var employeeId = parseInt($("#empTypeDropdown").val()) || 0;
        var payrollTypeId = parseInt($("#PayrollTypeID").val()) || 0;

        var month = parseInt($("#MonthDropdown").val()) || 0;
        var year = parseInt($("#YearDropdown").val()) || 0;

        var monthDays = parseFloat($("#MonthDays").val()) || 0;
        var payableDays = parseFloat($("#PayableDays").val()) || 0;

