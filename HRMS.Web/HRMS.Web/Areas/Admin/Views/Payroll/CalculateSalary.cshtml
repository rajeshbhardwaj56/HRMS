    // =========================================================
    // EMPLOYEE DROPDOWN
    // =========================================================

    function initializeEmployeeDropdown(
        initialEmployee = null,
        isEditMode = false
    ) {

        const $dropdown =
            $('#empTypeDropdown');


        $dropdown.select2({

            placeholder:
                "-- Select Employee --",

            allowClear:
                true,

            minimumInputLength:
                3,

            ajax: {

                url:
                    '/employee/myinfo/GetLastLevelEmployeeDropdown/',

                type:
                    'POST',

                dataType:
                    'json',

                delay:
                    250,

                data: function (params) {

                    return {

                        searchTerm:
                            params.term
                    };

                },

                processResults: function (data) {

                    if (
                        !data ||
                        !data.data
                    ) {

                        return {

                            results: []
                        };
                    }


                    return {

                        results:
                            data.data.map(
                                emp => ({

                                    id:
                                        emp.employeeID,

                                    text:
                                        `${emp.employeeNumber} - ${emp.employeeName}`

                                })
                            )

                    };
                }
            }
        });


        // -----------------------------------------------------
        // Employee Selected
        // -----------------------------------------------------

        $dropdown.on(
            'select2:select',
            function (e) {

                const employeeId =
                    e.params.data.id;


                setPayrollTypeReadonly(true);

                setPayableDaysMode(true);

                        // Employee selected = Gross Salary readonly
                      setGrossSalaryMode();
                fetchPayrollData(
                    employeeId
                );
            }
        );


        // -----------------------------------------------------
        // Employee Cleared
        // -----------------------------------------------------

        $dropdown.on(
            'select2:clear',
            function () {

                setPayrollTypeReadonly(false);

                setPayableDaysMode(false);


                $("#PayrollTypeIDHidden")
                    .val(
                        $("#PayrollTypeID").val()
                    );
                // Employee cleared:
                // Gross Salary becomes editable again
                setGrossSalaryMode();

                fetchPayrollPeriodDetails();
            }
        );


        // -----------------------------------------------------
        // Edit Mode
        // -----------------------------------------------------

            if (
        isEditMode &&
        initialEmployee &&
        initialEmployee.id
    ) {

        const option =
            new Option(
                initialEmployee.text,
                initialEmployee.id,
                true,
                true
            );

        $dropdown
            .append(option)
            .trigger('change');

        $dropdown.prop(
            'disabled',
            true
        );

        setPayrollTypeReadonly(true);

        // REMOVE fetchPayrollData() from here
            // Employee exists in edit mode
    // so Gross Salary is readonly
    setGrossSalaryMode();
    }
    }


