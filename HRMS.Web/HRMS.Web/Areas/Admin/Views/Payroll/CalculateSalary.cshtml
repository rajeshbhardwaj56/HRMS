          function setGrossSalaryMode() {

        const payrollTypeId =
            parseInt($("#PayrollTypeID").val()) || 0;

        const employeeId =
            parseInt($("#empTypeDropdown").val()) || 0;

        // -------------------------------------------------
        // Employee selected
        // -------------------------------------------------
        if (employeeId > 0) {

            $("#RevisedGross")
                .prop("disabled", false)
                .prop("readonly", true);

            return;
        }

        // -------------------------------------------------
        // No employee, but Payroll Type selected
        // -------------------------------------------------
        if (payrollTypeId > 0) {

            $("#RevisedGross")
                .prop("disabled", false)
                .prop("readonly", false);

            return;
        }

        // -------------------------------------------------
        // Nothing selected
        // -------------------------------------------------
        $("#RevisedGross")
            .prop("disabled", true)
            .prop("readonly", true);
    }
