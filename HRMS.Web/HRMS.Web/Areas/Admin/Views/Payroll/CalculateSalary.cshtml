                            "Failed to save salary.",

                        showHideTransition:
                            'slide',

                        icon:
                            'error',

                        position:
                            'top-right'
                    });
                }

            },

            error: function (xhr) {

                console.error(
                    "Save Salary Error:",
                    xhr.responseText
                );


                $.toast({

                    heading:
                        'Error',

                    text:
                        "An unexpected error occurred while saving salary.",

                    showHideTransition:
                        'slide',

                    icon:
                        'error',

                    position:
                        'top-right'
                });

            }

        });
    }


