    // =========================================================
    // GET LATEST PAYROLL PERIOD
    // =========================================================

    function getLatestPayrollPeriod(data) {

        let latest = null;

        data.forEach(function (item) {

            const year =
                parseInt(
                    item.year ??
                    item.Year ??
                    item.salaryYear ??
                    item.SalaryYear ??
                    item.payrollYear ??
                    item.PayrollYear ??
                    0
                );

            const month =
                parseInt(
                    item.month ??
                    item.Month ??
                    item.salaryMonth ??
                    item.SalaryMonth ??
                    item.payrollMonth ??
                    item.PayrollMonth ??
                    0
                );

            if (
                !year ||
                !month ||
                month < 1 ||
                month > 12
            ) {
                return;
            }

            if (!latest) {

                latest = {
                    year: year,
                    month: month
                };

                return;
            }

            if (year > latest.year) {

                latest = {
                    year: year,
                    month: month
                };

                return;
            }

            if (
                year === latest.year &&
                month > latest.month
            ) {

                latest = {
                    year: year,
                    month: month
                };

            }

        });


        if (!latest) {

            const now = new Date();

            latest = {

                year:
                    now.getFullYear(),

                month:
                    now.getMonth() + 1

            };

        }


        return latest;
    }


    // =========================================================
    // POPULATE YEAR DROPDOWN
    // =========================================================

    function populateYearDropdown(data, selectedYear) {

        const $yearDropdown =
            $("#YearDropdown");

        $yearDropdown.empty();

        $yearDropdown.append(
            '<option value="">-- Select Year --</option>'
        );


        const years = [];


        data.forEach(function (item) {

            const year =
                parseInt(
                    item.payrollYear ??
                    item.PayrollYear ??
                    item.year ??
                    item.Year ??
                    0
                );


            if (
                year &&
                !years.includes(year)
            ) {

                years.push(year);

            }

        });


        // Newest year first

        years.sort(function (a, b) {

            return b - a;

        });


        years.forEach(function (year) {

            const option =
                new Option(
                    year,
                    year,
                    year === parseInt(selectedYear),
                    year === parseInt(selectedYear)
                );


            $yearDropdown.append(option);

        });


        // Explicitly select

        if (selectedYear) {

            $yearDropdown.val(
                String(selectedYear)
            );

        }


        console.log(
            "Selected Year:",
            $yearDropdown.val()
        );
    }


    // =========================================================
    // POPULATE MONTH DROPDOWN
    // =========================================================

    function populateMonthDropdown(
        selectedYear,
        selectedMonth
    ) {

        const $monthDropdown =
            $("#MonthDropdown");


        $monthDropdown.empty();


        $monthDropdown.append(
            '<option value="">-- Select Month --</option>'
        );


        if (!selectedYear) {

            return;

        }


        const availableMonths = [];


        payrollPeriods.forEach(function (item) {

            const year =
                parseInt(
                    item.payrollYear ??
                    item.PayrollYear ??
                    item.year ??
                    item.Year ??
                    0
                );


            const month =
                parseInt(
                    item.payrollMonth ??
                    item.PayrollMonth ??
                    item.month ??
                    item.Month ??
                    0
                );


            const monthName =
                item.payrollMonthName ??
                item.PayrollMonthName ??
                "";


            if (
                year === parseInt(selectedYear) &&
                month >= 1 &&
                month <= 12
            ) {

                availableMonths.push({

                    month: month,

                    monthName:
                        monthName

                });

            }

        });


        // Sort months

        availableMonths.sort(function (a, b) {

            return a.month - b.month;

        });


        availableMonths.forEach(function (item) {

            const isSelected =
                item.month === parseInt(selectedMonth);


            const option =
                new Option(

                    item.monthName ||
                    getMonthName(item.month),

                    item.month,

                    isSelected,

                    isSelected

                );


            $monthDropdown.append(option);

        });


        // Explicitly select month

        if (selectedMonth) {

            $monthDropdown.val(
                String(selectedMonth)
            );

        }


        console.log(
            "Selected Month:",
            $monthDropdown.val()
        );
    }

        function getMonthName(month) {

        const monthNames = [

            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"

        ];

        return monthNames[month - 1] || "";

    }



    // =========================================================
    // YEAR / MONTH CHANGE
    // =========================================================

    $("#MonthDropdown, #YearDropdown").on("change", function () {

        const employeeId =
            $("#empTypeDropdown").val();

        const selectedYear =
            parseInt($("#YearDropdown").val()) || 0;

        const selectedMonth =
            parseInt($("#MonthDropdown").val()) || 0;


        console.log("Year/Month changed:", {
            employeeId: employeeId,
            year: selectedYear,
            month: selectedMonth
        });


        // ---------------------------------------------------------
        // If Year is changed
        // ---------------------------------------------------------

        if ($(this).attr("id") === "YearDropdown") {

            if (!selectedYear) {

                $("#MonthDropdown")
                    .empty()
                    .append(
                        '<option value="">-- Select Month --</option>'
                    );

                $("#MonthDays").val(0);

                setPayableDaysMode(false);

                return;
            }


            // Get available months for selected year

            let monthsForYear = [];


            payrollPeriods.forEach(function (item) {

                const year =
                    parseInt(
                        item.payrollYear ??
                        item.PayrollYear ??
                        item.year ??
                        item.Year ??
                        item.salaryYear ??
                        item.SalaryYear ??
                        0
                    );


                const month =
                    parseInt(
                        item.payrollMonth ??
                        item.PayrollMonth ??
                        item.month ??
                        item.Month ??
                        item.salaryMonth ??
                        item.SalaryMonth ??
                        0
                    );


                if (
                    year === selectedYear &&
                    month >= 1 &&
                    month <= 12
                ) {

                    monthsForYear.push(month);
                }

            });


            let selectedMonthForYear = 0;


            if (monthsForYear.length > 0) {

                selectedMonthForYear =
                    Math.max(...monthsForYear);
            }


            // Populate months

            populateMonthDropdown(
                selectedYear,
                selectedMonthForYear
            );
        }


        // ---------------------------------------------------------
        // Get final selected month after Year/Month change
        // ---------------------------------------------------------

        const finalMonth =
            parseInt($("#MonthDropdown").val()) || 0;


        const finalYear =
            parseInt($("#YearDropdown").val()) || 0;


        // ---------------------------------------------------------
        // Load Month Days
        // ---------------------------------------------------------

        if (
            finalYear &&
            finalMonth
        ) {

            fetchPayrollPeriodDetails();

        }
        else {

            $("#MonthDays").val(0);
        }


        // ---------------------------------------------------------
        // Employee selected
        // ---------------------------------------------------------

        if (employeeId) {

            setPayableDaysMode(true);

            fetchPayrollData(employeeId);

        }
        else {

            setPayableDaysMode(false);
        }

    });


    // =========================================================
    // FETCH PAYROLL PERIOD DETAILS
    // =========================================================

    function fetchPayrollPeriodDetails() {

        var salaryMonth = parseInt($("#MonthDropdown").val()) || 0;
        var salaryYear = parseInt($("#YearDropdown").val()) || 0;

        if (!salaryMonth || !salaryYear) {
            $("#MonthDays").val(0);
