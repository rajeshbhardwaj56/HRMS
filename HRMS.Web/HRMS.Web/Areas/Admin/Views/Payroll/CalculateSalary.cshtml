    // =========================================================
    // CALCULATE SALARY
    // =========================================================

    function calculateSalary() {

        const employeeId =
            parseInt(
                $("#empTypeDropdown").val()
            ) || 0;


        const payrollTypeId =
            parseInt(
                $("#PayrollTypeID").val()
            ) || 0;


        const month =
            parseInt(
                $("#MonthDropdown").val()
            ) || 0;


        const year =
            parseInt(
                $("#YearDropdown").val()
            ) || 0;


        const monthDays =
            parseFloat(
                $("#MonthDays").val()
            ) || 0;


        const payableDays =
            parseFloat(
                $("#PayableDays").val()
            ) || 0;


        $("#PayableDaysError")
            .hide()
            .text("");


        $("#PayrollTypeIDHidden")
            .val(payrollTypeId);


        if (!payrollTypeId) {

            $.toast({

                heading:
                    'Error',

                text:
                    'Please select Payroll Type.',

                icon:
                    'error',

                position:
                    'top-right'
            });

            return;
        }


        if (
            !month ||
            !year
        ) {

            $.toast({

                heading:
                    'Error',

                text:
                    'Please select Month and Year.',

                icon:
                    'error',

                position:
                    'top-right'
            });

            return;
        }


        if (
            payableDays < 0
        ) {

            $("#PayableDaysError")
                .text(
                    "Payable days cannot be negative"
                )
                .show();

            return;
        }


        if (
            monthDays > 0 &&
            payableDays > monthDays
        ) {

            $("#PayableDaysError")
                .text(
                    "Payable days cannot be greater than month days"
                )
                .show();

            return;
        }


        const model = {

            EmployeeID:
                employeeId,

            PayrollTypeID:
                payrollTypeId,

            Month:
                month,

            Year:
                year,

            RevisedGross:
                $("#RevisedGross").val(),

            MonthDays:
                $("#MonthDays").val(),

            PayableDays:
                $("#PayableDays").val(),

            ClientIncentive:
                $("#ClientIncentive").val(),

            PLI:
                $("#PLI").val(),

            FloorIncentive:
                $("#FloorIncentive").val(),

            EmpReferal:
                $("#EmpReferal").val(),

            TrainingFee:
                $("#TrainingFee").val(),

            GWR:
                $("#GWR").val(),

            OtherAdditonArrear:
                $("#OtherAdditonArrear").val(),

            EMPLWF:
                $("#EMPLWF").val(),

            TDS:
                $("#TDS").val(),

            DbtDeduction:
                $("#DbtDeduction").val(),

            Advanceded:
                $("#Advanceded").val(),

            InsuranceDeduction:
                $("#InsuranceDeduction").val(),

            OtherDeduction:
                $("#OtherDeduction").val()
        };


        console.log(
            "Salary Calculation Request:",
            model
        );


        $.ajax({

            url:
                '/Admin/Payroll/CalculateSalary',

            type:
                'POST',

            data:
                model,

            success: function(data) {

                console.log(
                    "Salary Calculation Response:",
                    data
                );

                // -----------------------------------------
                // CUTOFF / VALIDATION ERROR
                // -----------------------------------------

                if (data && data.success === false) {

                    $.toast({

                        heading: 'Error',

                        text: data.message || 'Salary calculation is not allowed.',

                        icon: 'error',

                        position: 'top-right'
                    });

                    return;
                }


                // -----------------------------------------
                // NO RESPONSE
                // -----------------------------------------

                if (!data) {

                    $.toast({

                        heading: 'Error',

                        text: 'Salary calculation failed.',

                        icon: 'error',

                        position: 'top-right'
                    });

                    return;
                }


                // -----------------------------------------
                // SUCCESS RESPONSE
                // -----------------------------------------

                const salaryData =
                    data.data ??
                    data.result ??
                    data;


                console.log(
                    "Salary Data:",
                    salaryData
                );


                fillPayrollFields(
                    salaryData
                );


                $.toast({

                    heading: 'Success',

                    text: 'Salary calculated successfully.',

                    icon: 'success',

                    position: 'top-right'
                });

            },

            error: function(xhr) {

                console.log(
                    "Calculate Salary Error:",
                    xhr.responseText
                );

                let message = 'Unable to calculate salary.';

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                $.toast({

                    heading: 'Error',

                    text: message,

                    icon: 'error',

                    position: 'top-right',

                    // Keep toast visible for 10 seconds
                    hideAfter: 20000,

                    // Allow user to close it manually
                    hideAfter: false,

                    stack: false
                });
            }


        });
    }


