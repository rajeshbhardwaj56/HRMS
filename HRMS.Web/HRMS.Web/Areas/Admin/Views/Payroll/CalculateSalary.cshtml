    // =========================================================
    // DOWNLOAD PDF
    // =========================================================

    function downloadSalarySlipPdf(event) {

        const employeeId =
            $("#empTypeDropdown").val();


        const salaryMonth =
            $("#MonthDropdown").val();


        const salaryYear =
            $("#YearDropdown").val();


        if (
            !employeeId ||
            employeeId === "0"
        ) {

            $.toast({

                heading:
                    "Warning",

                text:
                    "Please select an employee.",

                icon:
                    "warning",

                position:
                    "top-right"
            });

            return;
        }


        if (
            !salaryMonth ||
            salaryMonth === "0"
        ) {

            $.toast({

                heading:
                    "Warning",

                text:
                    "Please select salary month.",

                icon:
                    "warning",

                position:
                    "top-right"
            });

            return;
        }


        if (
            !salaryYear ||
            salaryYear === "0"
        ) {

            $.toast({

                heading:
                    "Warning",

                text:
                    "Please select salary year.",

                icon:
                    "warning",

                position:
                    "top-right"
            });

            return;
        }


        const button =
            event.currentTarget;


        const originalHtml =
            button.innerHTML;


        button.disabled =
            true;


        button.innerHTML = `

            <span class="spinner-border spinner-border-sm"></span>
            Generating...

        `;


        $.ajax({

            url:
                "/Admin/Payroll/SalarySlipPdf",

            type:
                "POST",

            data: {

                EmployeeID:
                    employeeId,

                SalaryMonth:
                    salaryMonth,

                SalaryYear:
                    salaryYear
            },

            xhrFields: {

                responseType:
                    "blob"
            },

            success: function (
                data,
                status,
                xhr
            ) {

                const blob =
                    new Blob(
                        [data],
                        {
                            type:
                                "application/pdf"
                        }
                    );


                const url =
                    window.URL
                        .createObjectURL(
                            blob
                        );


                const a =
                    document.createElement(
                        "a"
                    );


                a.style.display =
                    "none";


                a.href =
                    url;


                let fileName =
                    "SalarySlip.pdf";


                const contentDisposition =
                    xhr.getResponseHeader(
                        "Content-Disposition"
                    );


                if (
                    contentDisposition
                ) {

                    let match;


                    match =
                        contentDisposition.match(
                            /filename\*\s*=\s*UTF-8''([^;]+)/i
                        );


                    if (
                        match &&
                        match[1]
                    ) {

                        try {

                            fileName =
                                decodeURIComponent(
                                    match[1].trim()
                                );

                        }
                        catch (e) {

                            fileName =
                                match[1].trim();
                        }
                    }


                    if (!match) {

                        match =
                            contentDisposition.match(
                                /filename\s*=\s*"([^"]+)"/i
                            );


                        if (
                            match &&
                            match[1]
                        ) {

                            fileName =
                                match[1].trim();
                        }
                    }


                    if (!match) {

                        match =
                            contentDisposition.match(
                                /filename\s*=\s*([^;]+)/i
                            );


                        if (
                            match &&
                            match[1]
                        ) {

                            fileName =
                                match[1].trim();
                        }
                    }
                }


                fileName =
                    fileName
                        .replace(
                            /^["']|["']$/g,
                            ""
                        )
                        .trim();


                if (
                    fileName.includes(";") ||
                    fileName.includes("filename_") ||
                    fileName.includes("Content-Disposition")
                ) {

                    fileName =
                        "SalarySlip.pdf";
                }


                if (
                    !fileName
                        .toLowerCase()
                        .endsWith(".pdf")
                ) {

                    fileName += ".pdf";
                }


                a.download =
                    fileName;


                document.body
                    .appendChild(a);


                a.click();


                a.remove();


                setTimeout(
                    function () {

                        window.URL
                            .revokeObjectURL(
                                url
                            );

                    },
                    100
                );

            },

            error: function (xhr) {

                console.error(
                    "Salary slip PDF error:",
                    xhr
                );


                $.toast({

                    heading:
                        "Error",

                    text:
                        "Unable to generate salary slip PDF.",

                    icon:
                        "error",

                    position:
                        "top-right"
                });

            },

            complete: function () {

                button.disabled =
                    false;


                button.innerHTML =
                    originalHtml;
            }

        });
    }


    // =========================================================
    // PRINT SALARY SLIP
    // =========================================================

    function printSalarySlip() {

        const container =
            document.getElementById(
                "salarySlipPreviewContainer"
            );


        if (
            !container ||
            !container.innerHTML.trim()
        ) {

            $.toast({

                heading:
                    "Warning",

                text:
                    "Salary slip preview is not loaded.",

                icon:
                    "warning",

                position:
                    "top-right"
            });

            return;
        }


        const printWindow =
            window.open(
                "",
                "_blank",
                "width=1000,height=800"
            );


        if (!printWindow) {

            $.toast({

                heading:
                    "Error",

                text:
                    "Please allow pop-ups in your browser.",

                icon:
                    "error",

                position:
                    "top-right"
            });

            return;
        }


        const salaryHtml =
            container.innerHTML;


        const doc =
            printWindow.document;


        doc.title =
            "Salary Slip";


        const bootstrapLink =
            doc.createElement(
                "link"
            );


        bootstrapLink.rel =
            "stylesheet";


        bootstrapLink.href =
            "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";


        doc.head.appendChild(
            bootstrapLink
        );


        const style =
            doc.createElement(
                "style"
            );


        style.textContent = `

            html,
            body {

                margin:
                    0 !important;

                padding:
                    0 !important;

                background:
                    white !important;
            }


            body {

                -webkit-print-color-adjust:
                    exact !important;

                print-color-adjust:
                    exact !important;
            }


            table {

                page-break-inside:
                    auto;
            }


            tr {

                page-break-inside:
                    avoid;

                page-break-after:
                    auto;
            }


            thead {

                display:
                    table-header-group;
            }


            tfoot {

                display:
                    table-footer-group;
            }


            img {

                max-width:
                    100%;
            }


            .no-print {

                display:
                    none !important;
            }


            .modal-footer {

                display:
                    none !important;
            }

        `;


        doc.head.appendChild(
            style
        );


        doc.body.innerHTML =
            salaryHtml;


        bootstrapLink.onload =
            function () {

                printSalaryWindow(
                    printWindow
                );
            };


        setTimeout(
            function () {

                printSalaryWindow(
                    printWindow
                );

            },
            1500
        );
    }


    function printSalaryWindow(
        printWindow
    ) {

        if (
            !printWindow ||
            printWindow.closed
        ) {

            return;
        }


        const images =
            printWindow
                .document
                .images;


        let remainingImages =
            images.length;


        if (
            remainingImages === 0
        ) {

            doPrint(
                printWindow
            );

            return;
        }


        function imageFinished() {

            remainingImages--;


            if (
                remainingImages <= 0
            ) {

                doPrint(
                    printWindow
                );
            }
        }


        for (
            let i = 0;
            i < images.length;
            i++
        ) {

            if (
                images[i].complete
            ) {

                imageFinished();

            }
            else {

                images[i]
                    .addEventListener(
                        "load",
                        imageFinished
                    );


                images[i]
                    .addEventListener(
                        "error",
                        imageFinished
                    );
            }
        }


        setTimeout(
            function () {

                if (
                    !printWindow.closed
                ) {

                    doPrint(
                        printWindow
                    );
                }

            },
            3000
        );
    }


    function doPrint(
        printWindow
    ) {

        if (
            !printWindow ||
            printWindow.closed
        ) {

            return;
        }


        printWindow.focus();


        setTimeout(
            function () {

                printWindow.print();

            },
            500
        );
    }


