    function saveSalary() {

        const monthDays =
            parseFloat(
                $("#MonthDays").val()
            ) || 0;


        const payableDays =
            parseFloat(
                $("#PayableDays").val()
            ) || 0;


        $("#PayableDaysError")
            .hide()
            .text("");


        if (
            payableDays < 0
        ) {

            $("#PayableDaysError")
                .text(
                    "Payable days cannot be negative"
                )
                .show();

            return;
        }


        if (
            payableDays > monthDays
        ) {

            $("#PayableDaysError")
                .text(
                    "Payable days cannot be greater than month days"
                )
                .show();

            return;
        }


        const salaryData = {

            EmployeeID:
                getInt("#empTypeDropdown"),

            PayrollTypeID:
                getInt("#PayrollTypeIDHidden"),

            Year:
                getInt("#YearDropdown"),

            Month:
                getInt("#MonthDropdown"),

            RevisedGross:
                getVal("#RevisedGross"),

            MonthDays:
                getVal("#MonthDays"),

            PayableDays:
                getVal("#PayableDays"),


            BasicFixed:
                getVal("#BasicFixed"),

            HRAFixed:
                getVal("#HRAFixed"),

            ConveyanceFixed:
                getVal("#ConveyanceFixed"),

            SpecialAllowanceFixed:
                getVal("#SpecialAllowanceFixed"),

            GrossSalaryFixed:
                getVal("#GrossSalaryFixed"),


            BasicPayable:
                getVal("#BasicPayable"),

            HRAPayable:
                getVal("#HRAPayable"),

            ConveyancePayable:
                getVal("#ConveyancePayable"),

            SpecialAllowancePayable:
                getVal("#SpecialAllowancePayable"),

            GrossSalaryPayable:
                getVal("#GrossSalaryPayable"),


            ClientIncentive:
                getVal("#ClientIncentive"),

            PLI:
                getVal("#PLI"),

            FloorIncentive:
                getVal("#FloorIncentive"),

            EmpReferal:
                getVal("#EmpReferal"),

            TrainingFee:
                getVal("#TrainingFee"),

            GWR:
                getVal("#GWR"),

            OtherAdditonArrear:
                getVal("#OtherAdditonArrear"),


            EMPLWF:
                getVal("#EMPLWF"),

            TDS:
                getVal("#TDS"),

            DbtDeduction:
                getVal("#DbtDeduction"),

            Advanceded:
                getVal("#Advanceded"),

            InsuranceDeduction:
                getVal("#InsuranceDeduction"),

            OtherDeduction:
                getVal("#OtherDeduction"),


            EMPPF:
                getVal("#EMPPF"),

            EMPESI:
                getVal("#EMPESI"),

            PTAX:
                getVal("#PTAX"),


            TotalDeduction:
                getVal("#TotalDeduction"),

            NetPayable:
                getVal("#NetPayable"),


            EmployerPF:
                getVal("#EmployerPF"),

            EmployerESI:
                getVal("#EmployerESI"),

            EmployerLWF:
                getVal("#EmployerLWF"),

            TotalEmployerContribution:
                getVal("#TotalEmployerContribution"),


            EPFWages:
                getVal("#EPFWages"),

            EPSWages:
                getVal("#EPSWages"),

            EDLIWages:
                getVal("#EDLIWages"),

            EPFAdminCharges:
                getVal("#EPFAdminCharges"),

            EDLIContribution:
                getVal("#EDLIContribution"),

            EDLIAdminCharges:
                getVal("#EDLIAdminCharges"),


            CTC:
                getVal("#CTC")
        };


        if (
            !salaryData.EmployeeID ||
            !salaryData.PayrollTypeID
        ) {

            alert(
                "Please select Employee and Payroll Type"
            );

            return;
        }


        $.ajax({

            url:
                '/Admin/Payroll/SaveSalary',

            type:
                'POST',

            data:
                JSON.stringify(salaryData),

            contentType:
                'application/json; charset=utf-8',

            dataType:
                'json',

            success: function (response) {

                if (response.success) {

                    $.toast({

                        heading:
                            'Success',

                        text:
                            response.message ||
                            "Salary saved successfully!",

                        showHideTransition:
                            'slide',

                        icon:
                            'success',

                        position:
                            'top-right'
                    });

                }
                else {

                    $.toast({

                        heading:
                            'Error',

                        text:
