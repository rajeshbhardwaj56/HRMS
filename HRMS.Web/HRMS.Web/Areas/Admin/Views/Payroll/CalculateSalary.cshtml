                salaryYear: salaryYear
            },

            success: function (data) {

                if (!data) {
                    $("#MonthDays").val(0);
                    return;
                }

                $("#MonthDays").val(
                    data.monthDays ??
                    data.MonthDays ??
                    0
                );

