@using HRMS.Models.PayRoll
@model List<HRMS.Models.PayRoll.SalaryDetails>

<link href="~/assets/pages/gridlist.css" rel="stylesheet" />

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Monthly Salary";

    var success = TempData["Success"];
    var Err = TempData["Error"];
    bool showAutoCalculateMonthSalary =
    ViewBag.ShowAutoCalculateMonthSalary ?? false;
}

<div class="main-header anim" style="--delay: 0s">
    Monthly Salary List

    <section class="right-button-salary">

        <!-- Import -->
        <a href="~/Admin/Dashboard/ImportBulkSalaryExcel">
            <button type="button"
                    class="btn btn-addBtn">
                <i class="bi bi-upload"></i>
                Import
            </button>
        </a>

        <!-- Export -->
        <button type="button"
                class="btn btn-addBtn"
                id="btnExportSalary">
            <i class="bi bi-download"></i>
            Export
        </button>

        <!-- Add Salary -->
        <a href="~/Admin/Payroll/CalculateSalary">
            <button type="button"
                    class="btn btn-addBtn"
                    id="openFormBtn">
                <i class="bi bi-plus-lg"></i>
                Add Salary
            </button>
        </a>
        @if (showAutoCalculateMonthSalary)
        {
            <!-- Calculate Month Salary -->
            <button type="button"
                    class="btn btn-addBtn"
                    id="btnAutoCalculateSalary">
                <i class="bi bi-calculator"></i>
                Calculate Month Salary For All Users
            </button>
        }
        <button type="button"
                class="btn btn-addBtn"
                id="btnSendSelectedEmail"
                style="display:none;">
            <i class="bi bi-envelope"></i>
            Send Email
        </button>

        <button type="button"
                class="btn btn-addBtn"
                id="btnVerifySelected"
                style="display:none;">
            <i class="bi bi-check-circle"></i>
            Verify Salary
        </button>
    </section>
</div>


<div class="table-responsive py-3">

    <!-- ============================= -->
    <!-- FILTERS -->
    <!-- ============================= -->

    <div class="row mb-3">

        <div class="col-md-2">

            <label for="yearDropdown">
                Year
            </label>

            <div class="custom-select-wrapper">

                <select class="form-select custom-select"
                        id="yearDropdown">
                </select>

            </div>

        </div>


        <div class="col-md-2">

            <label for="monthDropdown">
                Month
            </label>

            <div class="custom-select-wrapper">

                <select class="form-select custom-select"
                        id="monthDropdown">
                </select>

            </div>

        </div>


    </div>

    <!-- ===================================================== -->
    <!-- SALARY CALCULATION RESULT -->
    <!-- ===================================================== -->

    <div id="salaryCalculationResult"
         class="mb-3"
         style="display:none;">

        <!-- SUMMARY -->
        <div class="salary-summary d-flex align-items-center flex-wrap gap-4 p-3 border rounded bg-light">

            <div>
                <strong>Total:</strong>
                <span id="salaryTotalProcessed">0</span>
            </div>

            <div>
                <strong>Inserted:</strong>
                <span id="salaryInsertedRecords"
                      class="text-success">
                    0
                </span>
            </div>

            <div>
                <strong>Updated:</strong>
                <span id="salaryUpdatedRecords"
                      class="text-primary">
                    0
                </span>
            </div>

            <div>
                <strong>Skipped:</strong>
                <span id="salarySkippedRecords"
                      class="text-warning">
                    0
                </span>
            </div>

            <div>
                <strong>Failed:</strong>
                <span id="salaryFailedRecords"
                      class="text-danger">
                    0
                </span>
            </div>

        </div>


        <!-- ERROR MESSAGES -->
        <div id="salaryCalculationErrors"
             class="mt-3"
             style="display:none;">

            <div class="alert alert-danger mb-2">

                <strong>
                    Salary Calculation Errors
                </strong>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>

                            <th>
                                Employee ID
                            </th>

                            <th>
                                Payroll Type
                            </th>

                            <th>
                                Gross Salary
                            </th>

                            <th>
                                Error Message
                            </th>

                            <th>
                                Error Date
                            </th>

                        </tr>

                    </thead>

                    <tbody id="salaryCalculationErrorBody">
                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- ============================= -->
    <!-- SALARY TABLE -->
    <!-- ============================= -->

    <table id="tblMonthlySalary"
           class="table table-striped body-text"
           style="width:100%">

        <thead>
            <tr>

                <!-- Employee Selection -->
                <th>
                    <input type="checkbox"
                           id="selectAllEmployees"
                           class="form-check-input"
                           title="Select All Employees">
                </th>

                <!-- Employee Number -->
                <th>
                    Employee Number
                </th>

                <!-- Employee Name -->
                <th>
                    Employee Name
                </th>

                <!-- Payroll Type -->
                <th>
                    Payroll Type
                </th>

                <!-- Salary Month -->
                    <th>
                        Salary Month
                    </th>

                <!-- Revised Gross -->
                <th>
                    Revised Gross
                </th>

                <!-- Basic -->
                <th>
                    Basic
                </th>

                <!-- HRA -->
                <th>
                    HRA
                </th>

                <!-- Conveyance -->
                <th>
                    Conveyance
                </th>

                <!-- Special Allowance -->
                <th>
                    Special Allowance
                </th>

                <!-- Net Payable -->
                <th>
                    Net Payable
                </th>

                <!-- Verification Status -->
                <th>
                    Verification Status
                </th>

                <!-- Action -->
                <th>
                    Action
                </th>

            </tr>
        </thead>

    </table>

</div>


<!-- ===================================================== -->
<!-- EMAIL SALARY SLIP MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="emailSalaryModal"
     tabindex="-1"
     aria-labelledby="emailSalaryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="emailSalaryModalLabel">

                    Email Salary Slips

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->

            <div class="modal-body">

                <!-- Employee ID -->

                <input type="hidden"
                       id="selectedEmployeeID" />


                <!-- Employee Name -->

                <div class="mb-3">

                    <label class="form-label">
                        Employee
                    </label>

                    <input type="text"
                           id="selectedEmployeeName"
                           class="form-control"
                           readonly />

                </div>


                <!-- Salary Months -->

                <div class="mb-3">

                    <label class="form-label">
                        Select Salary Months
                    </label>


                    <div id="salaryMonthList"
                         class="border rounded p-3">

                        <div class="text-muted">
                            Loading salary months...
                        </div>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-danger mt-1" type="reset
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button type="button"
                        class="btn btn-primary"
                        id="btnSendSalaryEmail">

                    <i class="bi bi-envelope"></i>

                    Send Email

                </button>

            </div>

        </div>

    </div>

</div>

<script type="text/javascript">

    $(document).ready(function () {

        var payrollPeriods = [];
        var salaryTable = null;

        // =====================================================
        // GLOBAL SELECTION
        // =====================================================

        // Stores selected Employee IDs across ALL DataTable pages
        var selectedEmployeeIDs = new Set();

        // Indicates that Select All across pages is active
        var selectAllAcrossPages = false;


        // =====================================================
        // INITIAL LOAD
        // =====================================================

        loadPayrollPeriods();


        // =====================================================
        // YEAR CHANGE
        // =====================================================

        $('#yearDropdown').on('change', function () {

            var selectedYear = $(this).val();

            // Clear previous selections when payroll period changes
            clearEmployeeSelection();

            if (!selectedYear) {

                $('#monthDropdown').empty();

                $('#monthDropdown').append(
                    new Option("Select Month", "")
                );

                if ($.fn.DataTable.isDataTable('#tblMonthlySalary')) {

                    $('#tblMonthlySalary')
                        .DataTable()
                        .ajax
                        .reload();
                }

                return;
            }

            loadPayrollMonths(
                payrollPeriods,
                selectedYear,
                null
            );

            $('#monthDropdown').trigger('change');

        });


        // =====================================================
        // MONTH CHANGE
        // =====================================================

        $('#monthDropdown').on('change', function () {

            var year = $('#yearDropdown').val();
            var month = $('#monthDropdown').val();

            console.log(
                "Payroll filter changed:",
                {
                    year: year,
                    month: month
                }
            );

            // Clear previous selections when payroll period changes
            clearEmployeeSelection();

            if (!year || !month) {
                return;
            }

            if ($.fn.DataTable.isDataTable('#tblMonthlySalary')) {

                $('#tblMonthlySalary')
                    .DataTable()
                    .ajax
                    .reload(null, false);
            }

        });


        // =====================================================
        // LOAD PAYROLL PERIODS
        // =====================================================

        function loadPayrollPeriods() {

            $.ajax({

                url: '@Url.Action("GetPayrollPeriodsForDropdown", "Payroll")',

                type: 'POST',

                dataType: 'json',

                success: function (response) {

                    console.log(
                        "Payroll Period Response:",
                        response
                    );

                    if (!response || response.length === 0) {

                        $.toast({
                            heading: "Warning",
                            text: "No payroll periods available.",
                            icon: "warning",
                            position: "top-right"
                        });

                        return;
                    }

                    payrollPeriods = response;

                    var yearDropdown =
                        $('#yearDropdown');

                    var monthDropdown =
                        $('#monthDropdown');

                    yearDropdown.empty();
                    monthDropdown.empty();

                    yearDropdown.append(
                        new Option(
                            "Select Year",
                            ""
                        )
                    );

                    monthDropdown.append(
                        new Option(
                            "Select Month",
                            ""
                        )
                    );


                    // =====================================================
                    // YEARS
                    // =====================================================

                    var years = [];

                    response.forEach(function (item) {

                        var year =
                            parseInt(item.payrollYear);

                        if (!years.includes(year)) {

                            years.push(year);

                            yearDropdown.append(
                                new Option(
                                    year,
                                    year
                                )
                            );
                        }

                    });


                    // =====================================================
                    // FIND CURRENT PAYROLL PERIOD
                    // =====================================================

                    var currentPeriod =
                        response.find(function (item) {

                            return (
                                item.isCurrentPeriod === true ||
                                item.isCurrentPeriod === 1
                            );

                        });


                    console.log(
                        "Current Payroll Period:",
                        currentPeriod
                    );


                    // =====================================================
                    // DEFAULT PERIOD
                    // =====================================================

                    if (currentPeriod) {

                        yearDropdown.val(
                            currentPeriod.payrollYear
                        );

                        loadPayrollMonths(
                            response,
                            currentPeriod.payrollYear,
                            currentPeriod
                        );

                    }
                    else {

                        // If API does not return IsCurrentPeriod,
                        // select latest payroll period.

                        var latestPeriod =
                            response
                                .slice()
                                .sort(function (a, b) {

                                    return (
                                        parseInt(b.payrollYear) -
                                        parseInt(a.payrollYear)
                                    ) ||
                                    (
                                        parseInt(b.payrollMonth) -
                                        parseInt(a.payrollMonth)
                                    );

                                })[0];


                        if (latestPeriod) {

                            yearDropdown.val(
                                latestPeriod.payrollYear
                            );

                            loadPayrollMonths(
                                response,
                                latestPeriod.payrollYear,
                                latestPeriod
                            );
                        }
                    }


                    // =====================================================
                    // INITIALIZE DATATABLE ONLY ONCE
                    // =====================================================

                    initializeDataTable();

                },

                error: function (xhr) {

                    console.log(
                        "Payroll Period Error:",
                        xhr.responseText
                    );

                    $.toast({
                        heading: "Error",
                        text: "Unable to load payroll periods.",
                        icon: "error",
                        position: "top-right"
                    });

                }

            });

        }


        // =====================================================
        // LOAD MONTHS
        // =====================================================

        function loadPayrollMonths(
            periods,
            selectedYear,
            currentPeriod
        ) {

            var monthDropdown =
                $('#monthDropdown');

            monthDropdown.empty();

            monthDropdown.append(
                new Option(
                    "Select Month",
                    ""
                )
            );


            var yearPeriods =
                periods.filter(function (item) {

                    return (
                        parseInt(item.payrollYear) ===
                        parseInt(selectedYear)
                    );

                });


            console.log(
                "Periods for year:",
                selectedYear,
                yearPeriods
            );


            yearPeriods.forEach(function (item) {

                var option =
                    new Option(
                        item.payrollMonthName,
                        item.payrollMonth
                    );


                $(option).attr(
                    'data-period-id',
                    item.payrollPeriodID
                );

                $(option).attr(
                    'data-start-date',
                    item.payrollStartDate
                );

                $(option).attr(
                    'data-end-date',
                    item.payrollEndDate
                );


                monthDropdown.append(option);

            });


            // =====================================================
            // SELECT CURRENT PERIOD
            // =====================================================

            if (
                currentPeriod &&
                parseInt(currentPeriod.payrollYear) ===
                parseInt(selectedYear)
            ) {

                monthDropdown.val(
                    currentPeriod.payrollMonth
                );

            }


            console.log(
                "Selected Payroll Year:",
                $('#yearDropdown').val()
            );

            console.log(
                "Selected Payroll Month:",
                $('#monthDropdown').val()
            );

        }


        // =====================================================
        // DATATABLE
        // =====================================================

        function initializeDataTable() {

            // Prevent double initialization
            if ($.fn.DataTable.isDataTable('#tblMonthlySalary')) {

                $('#tblMonthlySalary')
                    .DataTable()
                    .destroy();

            }


            salaryTable =
                $('#tblMonthlySalary').DataTable({

                    processing: true,

                    serverSide: true,

                    destroy: true,

                    responsive: true,


                    // =================================================
                    // IMPORTANT
                    // Restore selected checkboxes after every draw
                    // =================================================

                    drawCallback: function () {

                        updateCurrentPageCheckboxes();

                    },


                    ajax: {

                        url:
                            '@Url.Action("MonthlySalary", "Payroll")',

                        type: 'POST',

                        dataType: 'json',


                        data: function (d) {

                            var sortColumn =
                                d.order &&
                                d.order.length > 0
                                    ? d.columns[
                                        d.order[0].column
                                      ].data
                                    : 'EmployeeID';


                            var sortDirection =
                                d.order &&
                                d.order.length > 0
                                    ? d.order[0].dir
                                    : 'asc';


                            var year =
                                $('#yearDropdown').val();


                            var month =
                                $('#monthDropdown').val();


                            console.log(
                                "MonthlySalary Request:",
                                {
                                    year: year,
                                    month: month
                                }
                            );


                            return {

                                sEcho:
                                    d.draw,

                                iDisplayStart:
                                    d.start,

                                iDisplayLength:
                                    d.length,

                                sSearch:
                                    d.search.value,

                                sortCol:
                                    sortColumn,

                                sortDir:
                                    sortDirection,

                                year:
                                    year,

                                month:
                                    month

                            };

                        },


                        error: function (
                            xhr,
                            error,
                            thrown
                        ) {

                            console.log(
                                "MonthlySalary DataTable Error:",
                                xhr.responseText
                            );

                        }

                    },


                    columns: [

                        // =================================================
                        // Employee Checkbox
                        // =================================================

                        {
                            data: null,

                            orderable: false,

                            searchable: false,

                            render: function (
                                data,
                                type,
                                row
                            ) {

                                return `
                                    <input type="checkbox"
                                           class="form-check-input employee-select"
                                           value="${row.employeeID}"
                                           data-name="${row.employeeName || ''}"
                                           data-email="${row.officialEmail || ''}"
                                           title="Select Employee">
                                `;

                            }

                        },


                        // =================================================
                        // Employee Number
                        // =================================================

                        {
                            data: "employeeNumber"
                        },


                        // =================================================
                        // Employee Name
                        // =================================================

                        {
                            data: "employeeName"
                        },


                        // =================================================
                        // Payroll Type
                        // =================================================

                        {
                            data: "payrollTypeName",
                            title: "Payroll Type"
                        },


                        // =================================================
                        // Salary Month
                        // =================================================

                        {
                            data: null,

                            title: "Salary Month",

                            render: function (
                                data,
                                type,
                                row
                            ) {

                                if (
                                    row.salaryMonth == null ||
                                    row.salaryYear == null
                                ) {

                                    return "";

                                }


                                var months = [

                                    "January",
                                    "February",
                                    "March",
                                    "April",
                                    "May",
                                    "June",
                                    "July",
                                    "August",
                                    "September",
                                    "October",
                                    "November",
                                    "December"

                                ];


                                var month =
                                    parseInt(
                                        row.salaryMonth
                                    );


                                if (
                                    month < 1 ||
                                    month > 12
                                ) {

                                    return "";

                                }


                                return (
                                    months[month - 1] +
                                    " " +
                                    row.salaryYear
                                );

                            }

                        },


                        // =================================================
                        // Revised Gross
                        // =================================================

                        {
                            data: "revisedGross"
                        },


                        // =================================================
                        // Basic
                        // =================================================

                        {
                            data: "basicFixed"
                        },


                        // =================================================
                        // HRA
                        // =================================================

                        {
                            data: "hraFixed"
                        },


                        // =================================================
                        // Conveyance
                        // =================================================

                        {
                            data: "conveyanceFixed"
                        },


                        // =================================================
                        // Special Allowance
                        // =================================================

                        {
                            data: "specialAllowanceFixed"
                        },


                        // =================================================
                        // Net Payable
                        // =================================================

                        {
                            data: "netPayable"
                        },


                        // =================================================
                        // Verification Status
                        // =================================================

                        {
                            data: "isVerified",

                            orderable: false,

                            searchable: false,

                            render: function (
                                data,
                                type,
                                row
                            ) {

                                if (
                                    data === true ||
                                    data === 1 ||
                                    data === "1"
                                ) {

                                    return `
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Verified
                                        </span>
                                    `;

                                }


                                return `
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock"></i>
                                        Not Verified
                                    </span>
                                `;

                            }

                        },


                        // =================================================
                        // Action
                        // =================================================

                        {
                            data: null,

                            orderable: false,

                            searchable: false,

                            render: function (
                                data,
                                type,
                                row
                            ) {

                                return `
                                    <a class="item text-success"
                                       href="/admin/Payroll/CalculateSalary?id=${row.encryptedSalaryID}"
                                       data-bs-toggle="tooltip"
                                       title="Edit Salary">

                                        <i class="bi bi-pencil-fill"
                                           style="font-size:18px;">
                                        </i>

                                    </a>
                                `;

                            }

                        }

                    ]

                });

        }


        // =========================================================
        // UPDATE CURRENT PAGE CHECKBOXES
        // =========================================================

        function updateCurrentPageCheckboxes() {

            $('.employee-select').each(function () {

                var employeeID =
                    parseInt($(this).val());


                $(this).prop(
                    'checked',
                    selectedEmployeeIDs.has(employeeID)
                );

            });


            // =====================================================
            // UPDATE HEADER CHECKBOX
            // =====================================================

            if (
                selectAllAcrossPages &&
                selectedEmployeeIDs.size > 0
            ) {

                $('#selectAllEmployees')
                    .prop('checked', true);

            }
            else {

                $('#selectAllEmployees')
                    .prop('checked', false);

            }

        }


        // =========================================================
        // CLEAR EMPLOYEE SELECTION
        // =========================================================

        function clearEmployeeSelection() {

            selectedEmployeeIDs.clear();

            selectAllAcrossPages = false;

            $('.employee-select')
                .prop('checked', false);

            $('#selectAllEmployees')
                .prop('checked', false);

            updateSelectedSalaryButtons();

        }


        // =========================================================
        // SELECT / UNSELECT INDIVIDUAL EMPLOYEE
        // =========================================================

        $(document).on(
            'change',
            '.employee-select',
            function () {

                var employeeID =
                    parseInt($(this).val());


                if ($(this).is(':checked')) {

                    selectedEmployeeIDs.add(
                        employeeID
                    );

                }
                else {

                    selectedEmployeeIDs.delete(
                        employeeID
                    );

                    // One employee was manually unchecked
                    selectAllAcrossPages = false;

                    $('#selectAllEmployees')
                        .prop(
                            'checked',
                            false
                        );

                }


                updateCurrentPageCheckboxes();

                updateSelectedSalaryButtons();

            }
        );


        // =========================================================
        // SELECT ALL EMPLOYEES - ALL PAGES
        // =========================================================

        $(document).on(
            'change',
            '#selectAllEmployees',
            function () {

                var isChecked =
                    $(this).is(':checked');


                var year =
                    $('#yearDropdown').val();


                var month =
                    $('#monthDropdown').val();


                // =================================================
                // VALIDATION
                // =================================================

                if (!year || !month) {

                    $.toast({
                        heading: "Warning",
                        text: "Please select Year and Month.",
                        icon: "warning",
                        position: "top-right"
                    });


                    $(this)
                        .prop(
                            'checked',
                            false
                        );


                    return;

                }


                // =================================================
                // SELECT ALL
                // =================================================

                if (isChecked) {

                    selectAllAcrossPages = true;


                    // Show loading



                    // =================================================
                    // GET ALL EMPLOYEE IDS
                    // =================================================

                    $.ajax({

                        url:
                            '@Url.Action("GetMonthlySalaryEmployeeIDs", "Payroll")',

                        type: 'POST',

                        contentType: 'application/json',

                        data: JSON.stringify({

                            year:
                                parseInt(year),

                            month:
                                parseInt(month)

                        }),


                        success: function (response) {

                            console.log(
                                "All Employee IDs Response:",
                                response
                            );


                            if (
                                !response ||
                                response.success === false
                            ) {

                                selectAllAcrossPages = false;

                                $('#selectAllEmployees')
                                    .prop(
                                        'checked',
                                        false
                                    );


                                $.toast({
                                    heading: "Error",
                                    text:
                                        response?.message ||
                                        "Unable to select all employees.",
                                    icon: "error",
                                    position: "top-right"
                                });


                                return;

                            }


                            // =================================================
                            // CLEAR OLD SELECTION
                            // =================================================

                            selectedEmployeeIDs.clear();


                            // =================================================
                            // ADD ALL EMPLOYEE IDS
                            // =================================================

                            if (
                                response.employeeIDs &&
                                response.employeeIDs.length > 0
                            ) {

                                response.employeeIDs.forEach(
                                    function (id) {

                                        selectedEmployeeIDs.add(
                                            parseInt(id)
                                        );

                                    }
                                );

                            }


                            console.log(
                                "Total Selected Employees:",
                                selectedEmployeeIDs.size
                            );


                            // =================================================
                            // UPDATE CURRENT PAGE
                            // =================================================

                            updateCurrentPageCheckboxes();

                            updateSelectedSalaryButtons();




                        },


                        error: function (xhr) {

                            console.log(
                                "Select All Error:",
                                xhr.responseText
                            );


                            selectAllAcrossPages = false;


                            selectedEmployeeIDs.clear();


                            $('#selectAllEmployees')
                                .prop(
                                    'checked',
                                    false
                                );


                            $('.employee-select')
                                .prop(
                                    'checked',
                                    false
                                );


                            updateSelectedSalaryButtons();


                            $.toast({
                                heading: "Error",
                                text: "Unable to select all employees.",
                                icon: "error",
                                position: "top-right"
                            });

                        }

                    });

                }


                // =================================================
                // UNSELECT ALL
                // =================================================

                else {

                    selectAllAcrossPages = false;


                    selectedEmployeeIDs.clear();


                    $('.employee-select')
                        .prop(
                            'checked',
                            false
                        );


                    updateSelectedSalaryButtons();

                }

            }
