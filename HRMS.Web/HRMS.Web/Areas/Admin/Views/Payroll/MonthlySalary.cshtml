        // =========================================================
        // UPDATE VERIFY / EMAIL BUTTONS
        // =========================================================

        function updateSelectedSalaryButtons() {

            var selectedCount =
                selectedEmployeeIDs.size;


            // Hide buttons first
            $('#btnSendSelectedEmail')
                .hide();

            $('#btnVerifySelected')
                .hide();


            // Nothing selected
            if (selectedCount === 0) {

                return;

            }


            // =====================================================
            // VERIFY
            // =====================================================

            // Verify works for SINGLE and MULTIPLE
            $('#btnVerifySelected')
                .show();


            // =====================================================
            // EMAIL
            // =====================================================

            // Email works only for SINGLE employee
            if (selectedCount === 1) {

                $('#btnSendSelectedEmail')
                    .show();

            }

        }


        // =========================================================
        // LOAD EMPLOYEE SALARY MONTHS
        // =========================================================

        function loadSalaryMonths(employeeId) {

            $.ajax({

                url:
                    '@Url.Action("GetEmployeeSalaryMonths", "Payroll")',

                type: 'GET',

                data: {

                    employeeId:
                        employeeId

                },


                success: function (response) {

                    var html = '';


                    // =================================================
                    // NO RECORDS
                    // =================================================

                    if (
                        !response ||
                        response.length === 0
                    ) {

                        html = `

                            <div class="text-muted">

                                No salary records available.

                            </div>

                        `;

                    }


                    // =================================================
                    // SALARY RECORDS
                    // =================================================

                    else {

                        response.forEach(
                            function (item) {

                                html += `

                                    <div class="form-check mb-2">

                                        <input type="checkbox"

                                               class="form-check-input salary-month"

                                               value="${item.month}-${item.year}"

                                               data-month="${item.month}"

                                               data-year="${item.year}">


                                        <label class="form-check-label">

                                            ${item.monthName}
                                            ${item.year}

                                        </label>

                                    </div>

                                `;

                            }
                        );

                    }


                    $('#salaryMonthList')
                        .html(html);

                },


                error: function () {

                    $('#salaryMonthList')
                        .html(`

                            <div class="text-danger">

                                Unable to load salary months.

                            </div>

                        `);


                    $.toast({

                        heading:
                            "Error",

                        text:
                            "Unable to load salary months.",

                        icon:
                            "error",

                        position:
                            "top-right"

                    });

                }

            });

        }


