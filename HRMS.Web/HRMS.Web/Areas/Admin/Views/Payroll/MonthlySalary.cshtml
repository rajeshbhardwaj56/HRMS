                                    heading:
                                        "Success",

                                    text:
                                        response.message,

                                    icon:
                                        "success",

                                    position:
                                        "top-right"

                                });


                                // Remove employee from selection

                                selectedEmployeeIDs.delete(
                                    parseInt(employeeId)
