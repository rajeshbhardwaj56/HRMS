@using HRMS.Models.PayRoll
@model List<HRMS.Models.PayRoll.SalaryDetails>

<link href="~/assets/pages/gridlist.css" rel="stylesheet" />

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Monthly Salary";

    var success = TempData["Success"];
    var Err = TempData["Error"];
    bool showAutoCalculateMonthSalary =
    ViewBag.ShowAutoCalculateMonthSalary ?? false;
}

<div class="main-header anim" style="--delay: 0s">
    Monthly Salary List

    <section class="right-button-salary">

        <!-- Import -->
        <a href="~/Admin/Dashboard/ImportBulkSalaryExcel">
            <button type="button"
                    class="btn btn-addBtn">
                <i class="bi bi-upload"></i>
                Import
            </button>
        </a>

        <!-- Export -->
        <button type="button"
                class="btn btn-addBtn"
                id="btnExportSalary">
            <i class="bi bi-download"></i>
            Export
        </button>

        <!-- Add Salary -->
        <a href="~/Admin/Payroll/CalculateSalary">
            <button type="button"
                    class="btn btn-addBtn"
                    id="openFormBtn">
                <i class="bi bi-plus-lg"></i>
                Add Salary
            </button>
        </a>
        @if (showAutoCalculateMonthSalary)
        {
            <!-- Calculate Month Salary -->
            <button type="button"
                    class="btn btn-addBtn"
                    id="btnAutoCalculateSalary">
                <i class="bi bi-calculator"></i>
                Calculate Month Salary For All Users
            </button>
        }
        <button type="button"
                class="btn btn-addBtn"
                id="btnSendSelectedEmail"
                style="display:none;">
            <i class="bi bi-envelope"></i>
            Send Email
        </button>

        <button type="button"
                class="btn btn-addBtn"
                id="btnVerifySelected"
                style="display:none;">
            <i class="bi bi-check-circle"></i>
            Verify Salary
        </button>
    </section>
</div>


<div class="table-responsive py-3">

    <!-- ============================= -->
    <!-- FILTERS -->
    <!-- ============================= -->

    <div class="row mb-3">

        <div class="col-md-2">

            <label for="yearDropdown">
                Year
            </label>

            <div class="custom-select-wrapper">

                <select class="form-select custom-select"
                        id="yearDropdown">
                </select>

            </div>

        </div>


        <div class="col-md-2">

            <label for="monthDropdown">
                Month
            </label>

            <div class="custom-select-wrapper">

                <select class="form-select custom-select"
                        id="monthDropdown">
                </select>

            </div>

        </div>


    </div>

    <!-- ===================================================== -->
    <!-- SALARY CALCULATION RESULT -->
    <!-- ===================================================== -->

    <div id="salaryCalculationResult"
         class="mb-3"
         style="display:none;">

        <!-- SUMMARY -->
        <div class="salary-summary d-flex align-items-center flex-wrap gap-4 p-3 border rounded bg-light">

            <div>
                <strong>Total:</strong>
                <span id="salaryTotalProcessed">0</span>
            </div>

            <div>
                <strong>Inserted:</strong>
                <span id="salaryInsertedRecords"
                      class="text-success">
                    0
                </span>
            </div>

            <div>
                <strong>Updated:</strong>
                <span id="salaryUpdatedRecords"
                      class="text-primary">
                    0
                </span>
            </div>

            <div>
                <strong>Skipped:</strong>
                <span id="salarySkippedRecords"
                      class="text-warning">
                    0
                </span>
            </div>

            <div>
                <strong>Failed:</strong>
                <span id="salaryFailedRecords"
                      class="text-danger">
                    0
                </span>
            </div>

        </div>


        <!-- ERROR MESSAGES -->
        <div id="salaryCalculationErrors"
             class="mt-3"
             style="display:none;">

            <div class="alert alert-danger mb-2">

                <strong>
                    Salary Calculation Errors
                </strong>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>

                            <th>
                                Employee ID
                            </th>

                            <th>
                                Payroll Type
                            </th>

                            <th>
                                Gross Salary
                            </th>

                            <th>
                                Error Message
                            </th>

                            <th>
                                Error Date
                            </th>

                        </tr>

                    </thead>

                    <tbody id="salaryCalculationErrorBody">
                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- ============================= -->
    <!-- SALARY TABLE -->
    <!-- ============================= -->

    <table id="tblMonthlySalary"
           class="table table-striped body-text"
           style="width:100%">

        <thead>
            <tr>

                <!-- Employee Selection -->
                <th>
                    <input type="checkbox"
                           id="selectAllEmployees"
                           class="form-check-input"
                           title="Select All Employees">
                </th>

                <!-- Employee Number -->
                <th>
                    Employee Number
                </th>

                <!-- Employee Name -->
                <th>
                    Employee Name
                </th>

                <!-- Payroll Type -->
                <th>
                    Payroll Type
                </th>

                <!-- Salary Month -->
                    <th>
                        Salary Month
                    </th>

                <!-- Revised Gross -->
                <th>
                    Revised Gross
                </th>

                <!-- Basic -->
                <th>
                    Basic
                </th>

                <!-- HRA -->
                <th>
                    HRA
                </th>

                <!-- Conveyance -->
                <th>
                    Conveyance
                </th>

                <!-- Special Allowance -->
                <th>
                    Special Allowance
                </th>

                <!-- Net Payable -->
                <th>
                    Net Payable
                </th>

                <!-- Verification Status -->
                <th>
                    Verification Status
                </th>

                <!-- Action -->
                <th>
                    Action
                </th>

            </tr>
        </thead>

    </table>

</div>


<!-- ===================================================== -->
<!-- EMAIL SALARY SLIP MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="emailSalaryModal"
     tabindex="-1"
     aria-labelledby="emailSalaryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="emailSalaryModalLabel">

                    Email Salary Slips

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->

            <div class="modal-body">

                <!-- Employee ID -->

                <input type="hidden"
                       id="selectedEmployeeID" />


                <!-- Employee Name -->

                <div class="mb-3">

                    <label class="form-label">
                        Employee
                    </label>

                    <input type="text"
                           id="selectedEmployeeName"
                           class="form-control"
                           readonly />

                </div>


                <!-- Salary Months -->

                <div class="mb-3">

                    <label class="form-label">
                        Select Salary Months
                    </label>


                    <div id="salaryMonthList"
                         class="border rounded p-3">

                        <div class="text-muted">
                            Loading salary months...
                        </div>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button type="button"
                        class="btn btn-primary"
                        id="btnSendSalaryEmail">

                    <i class="bi bi-envelope"></i>

                    Send Email

                </button>

            </div>

        </div>

    </div>

</div>

<script type="text/javascript">

    $(document).ready(function () {


        // =====================================================
        // INITIALIZATION
        // =====================================================

        populateYearDropdown();

        populateMonthDropdown();

        initializeDataTable();

        registerDropdownChange();


        // =====================================================
        // YEAR DROPDOWN
        // =====================================================

        function populateYearDropdown() {

            var currentYear =
                new Date().getFullYear();

            var startYear =
                currentYear - 5;

            var endYear =
                currentYear + 1;


            var yearDropdown =
                $('#yearDropdown');


            yearDropdown.empty();


            yearDropdown.append(
                '<option value="">Select Year</option>'
            );


            for (
                var y = endYear;
                y >= startYear;
                y--
            ) {

                yearDropdown.append(
                    new Option(y, y)
                );

            }


            yearDropdown.val(currentYear);
        }


        // =====================================================
        // MONTH DROPDOWN
        // =====================================================

        function populateMonthDropdown() {

            var months = [

                "January",
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December"

            ];


            var currentMonth =
                new Date().getMonth() + 1;


            var monthDropdown =
                $('#monthDropdown');


            monthDropdown.empty();


            monthDropdown.append(
                '<option value="">Select Month</option>'
            );


            for (
                var m = 1;
                m <= 12;
                m++
            ) {

                monthDropdown.append(
                    new Option(
                        months[m - 1],
                        m
                    )
                );

            }


            monthDropdown.val(currentMonth);
        }


        // =====================================================
        // DATATABLE
        // =====================================================

        function initializeDataTable() {

            $('#tblMonthlySalary').DataTable({

                processing: true,

                serverSide: true,

                destroy: true,

                responsive: true,


                ajax: {

                    url:
                        '@Url.Action("MonthlySalary", "Payroll")',

                    type: 'POST',

                    datatype: 'json',


                    data: function (d) {


                        var sortColumn =
                            d.order &&
                            d.order.length > 0

                                ? d.columns[
                                    d.order[0].column
                                  ].data

                                : 'EmployeeID';


                        var sortDirection =
                            d.order &&
                            d.order.length > 0

                                ? d.order[0].dir

                                : 'asc';


                        return {

                            sEcho:
                                d.draw,

                            iDisplayStart:
                                d.start,

                            iDisplayLength:
                                d.length,

                            sSearch:
                                d.search.value,

                            sortCol:
                                sortColumn,

                            sortDir:
                                sortDirection,

                            year:
                                $('#yearDropdown').val(),

                            month:
                                $('#monthDropdown').val()

                        };

                    }

                },


                // =================================================
                // COLUMNS
                // =================================================

                    columns: [

        // Employee Checkbox
        {
            data: null,
            orderable: false,
            searchable: false,
            render: function (data, type, row) {
                return `
                    <input type="checkbox"
                           class="form-check-input employee-select"
                           value="${row.employeeID}"
                           data-name="${row.employeeName || ''}"
                           data-email="${row.officialEmail || ''}"
                           title="Select Employee">
                `;
            }
        },

        // Employee Number
        {
            data: "employeeNumber"
        },

        // Employee Name
        {
            data: "employeeName"
        },

        // Payroll Type
        {
            data: "payrollTypeName",
            title: "Payroll Type"
        },

        // Salary Month
    {
        data: null,
        title: "Salary Month",
        render: function (data, type, row) {

            if (!row.salaryMonth || !row.salaryYear) {
                return "";
            }

            var months = [
                "January",
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December"
            ];

            var monthName =
                months[parseInt(row.salaryMonth) - 1];

            return `${monthName} ${row.salaryYear}`;
        }
    },

        // Revised Gross
        {
            data: "revisedGross"
        },

        // Basic
        {
            data: "basicFixed"
        },

        // HRA
        {
            data: "hraFixed"
        },

        // Conveyance
        {
            data: "conveyanceFixed"
        },

        // Special Allowance
        {
            data: "specialAllowanceFixed"
        },

        // Net Payable
        {
            data: "netPayable"
        },

        // Verification Status
        {
            data: "isVerified",
            orderable: false,
            searchable: false,
            render: function (data, type, row) {

                if (data === true || data === 1) {
                    return `
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i>
                            Verified
                        </span>
                    `;
                }

                return `
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-clock"></i>
                        Not Verified
                    </span>
                `;
            }
        },

        // Action
        {
            data: null,
            orderable: false,
            searchable: false,
            render: function (data, type, row) {
                return `
                    <a class="item text-success"
                       href="/admin/Payroll/CalculateSalary?id=${row.encryptedSalaryID}"
                       data-bs-toggle="tooltip"
                       title="Edit Salary">

                        <i class="bi bi-pencil-fill"
                           style="font-size:18px;">
                        </i>

                    </a>
                `;
            }
        }
    ]

            });

        }


        // =====================================================
        // YEAR / MONTH CHANGE
        // =====================================================

        function registerDropdownChange() {

            $('#yearDropdown, #monthDropdown')
                .on('change', function () {


                    $('#tblMonthlySalary')
                        .DataTable()
                        .ajax
                        .reload();


                });

        }

    });



    // =========================================================
    // INDIVIDUAL EMPLOYEE SELECTION
    // =========================================================

    $(document).on(
        'change',
        '.employee-select',
        function () {

            var totalEmployees =
                $('.employee-select').length;

            var selectedEmployees =
                $('.employee-select:checked').length;

            // If all visible employees are selected
            if (
                totalEmployees > 0 &&
                selectedEmployees === totalEmployees
            ) {

                $('#selectAllEmployees')
                    .prop('checked', true);

            }
            else {

                $('#selectAllEmployees')
                    .prop('checked', false);
            }

            // Update Verify / Email buttons
            updateSelectedSalaryButtons();
        }
    );






    // =========================================================
    // LOAD EMPLOYEE SALARY MONTHS
    // =========================================================

    function loadSalaryMonths(employeeId) {


        $.ajax({

            url:
                '@Url.Action("GetEmployeeSalaryMonths", "Payroll")',

            type: 'GET',

            data: {

                employeeId:
                    employeeId

            },


            success: function (response) {


                var html = '';


                // ---------------------------------------------
                // No records
                // ---------------------------------------------

                if (
                    !response ||
                    response.length === 0
                ) {


                    html = `

                        <div class="text-muted">

                            No salary records available.

                        </div>

                    `;


                }


                // ---------------------------------------------
                // Salary records
                // ---------------------------------------------

                else {


                    response.forEach(
                        function (item) {


                            html += `

                                <div class="form-check mb-2">


                                    <input type="checkbox"

                                           class="form-check-input salary-month"

                                           value="${item.month}-${item.year}"

                                           data-month="${item.month}"

                                           data-year="${item.year}">


                                    <label class="form-check-label">

                                        ${item.monthName}
                                        ${item.year}

                                    </label>


                                </div>

                            `;

                        }
                    );

                }


                $('#salaryMonthList')
                    .html(html);

            },


            error: function () {


                $('#salaryMonthList').html(`

                    <div class="text-danger">

                        Unable to load salary months.

                    </div>

                `);


                $.toast({

                    heading:
                        "Error",

                    text:
                        "Unable to load salary months.",

                    icon:
                        "error",

                    position:
                        "top-right"

                });

            }

        });

    }


    // =========================================================
    // SEND SALARY EMAIL
    // =========================================================

    $(document).on(
        'click',
        '#btnSendSalaryEmail',
        function () {


            var employeeId =
                $('#selectedEmployeeID').val();


            var months = [];


            // -----------------------------------------------
            // Collect selected months
            // -----------------------------------------------

            $('.salary-month:checked')
                .each(function () {


                    months.push({

                        month:
                            parseInt(
                                $(this).data('month')
                            ),

                        year:
                            parseInt(
                                $(this).data('year')
                            )

                    });


                });


            // -----------------------------------------------
            // Validate
            // -----------------------------------------------

            if (!employeeId) {

                $.toast({

                    heading:
                        "Warning",

                    text:
                        "Employee not selected.",

                    icon:
                        "warning",

                    position:
                        "top-right"

                });

                return;

            }


            if (months.length === 0) {

                $.toast({

                    heading:
                        "Warning",

                    text:
                        "Please select at least one salary month.",

                    icon:
                        "warning",

                    position:
                        "top-right"

                });

                return;

            }


            // -----------------------------------------------
            // Button
            // -----------------------------------------------

            var button =
                $(this);


            button.prop(
                'disabled',
                true
            );


            button.html(`

                <i class="bi bi-hourglass-split"></i>

                Sending...

            `);


            // -----------------------------------------------
            // AJAX
            // -----------------------------------------------

            $.ajax({

                url:
                    '@Url.Action("EmailMultipleSalarySlips", "Payroll")',

                type:
                    'POST',

                contentType:
                    'application/json',

                data:
                    JSON.stringify({

                        employeeID:
                            parseInt(employeeId),

                        months:
                            months

                    }),


                success:
                    function (response) {


                        if (response.success) {


                            // -------------------------------
                            // Hide Modal
                            // -------------------------------

                            var modalElement =
                                document.getElementById(
                                    'emailSalaryModal'
                                );


                            var modal =
                                bootstrap.Modal
                                    .getOrCreateInstance(
                                        modalElement
                                    );


                            modal.hide();


                            // -------------------------------
                            // Success
                            // -------------------------------

                            $.toast({

                                heading:
                                    "Success",

                                text:
                                    response.message,

                                icon:
                                    "success",

                                position:
                                    "top-right"

                            });


                            // Uncheck employee
                            $('.employee-select[value="' +
                                employeeId +
                                '"]')
                                .prop(
                                    'checked',
                                    false
                                );

                            $('#selectAllEmployees')
                                .prop('checked', false);

                            updateSelectedSalaryButtons();


                        }

                        else {


                            $.toast({

                                heading:
                                    "Error",

                                text:
                                    response.message,

                                icon:
                                    "error",

                                position:
                                    "top-right"

                            });

                        }

                    },


                error:
                    function () {


                        $.toast({

                            heading:
                                "Error",

                            text:
                                "Unable to send salary slips.",

                            icon:
                                "error",

                            position:
                                "top-right"

                        });

                    },


                complete:
                    function () {


                        button.prop(
                            'disabled',
                            false
                        );


                        button.html(`

                            <i class="bi bi-envelope"></i>

                            Send Email

                        `);

                    }

            });

        }
    );


    // =========================================================
    // RESET MODAL WHEN CLOSED
    // =========================================================

    $('#emailSalaryModal')
        .on(
            'hidden.bs.modal',
            function () {


                $('#selectedEmployeeID')
                    .val('');


                $('#selectedEmployeeName')
                    .val('');


                $('#salaryMonthList')
                    .html(`

                        <div class="text-muted">

                            Select an employee to load salary months.

                        </div>

                    `);


                $('.salary-month')
                    .prop(
                        'checked',
                        false
                    );

            }
        );

            // =========================================================
    // EXPORT SALARY
    // =========================================================

    $(document).on('click', '#btnExportSalary', function () {

        var year = $('#yearDropdown').val();
        var month = $('#monthDropdown').val();

        var table = $('#tblMonthlySalary').DataTable();

        var search = table.search();

        if (!year) {
            $.toast({
                heading: "Warning",
                text: "Please select Year.",
                icon: "warning",
                position: "top-right"
            });

            return;
        }

        if (!month) {
            $.toast({
                heading: "Warning",
                text: "Please select Month.",
                icon: "warning",
                position: "top-right"
            });

            return;
        }

        // Show loading
        var button = $(this);

        button.prop('disabled', true);

        button.html(`
            <i class="bi bi-hourglass-split"></i>
            Exporting...
        `);

        // Build export URL
        var url =
            '@Url.Action("ExportMonthlySalary", "Payroll")' +
            '?year=' + encodeURIComponent(year) +
            '&month=' + encodeURIComponent(month) +
            '&search=' + encodeURIComponent(search || '');

        // Start download
        window.location.href = url;

        // Re-enable button
        setTimeout(function () {

            button.prop('disabled', false);

            button.html(`
                <i class="bi bi-download"></i>
                Export
            `);

        }, 1500);

    });
        // =========================================================
    // AUTO CALCULATE ALL MONTH SALARY
    // =========================================================

    $(document).on('click', '#btnAutoCalculateSalary', function () {

        var year = $('#yearDropdown').val();
        var month = $('#monthDropdown').val();

        if (!year) {
            $.toast({
                heading: "Warning",
                text: "Please select Year.",
                icon: "warning",
                position: "top-right"
            });

            return;
        }

        if (!month) {
            $.toast({
                heading: "Warning",
                text: "Please select Month.",
                icon: "warning",
                position: "top-right"
            });

            return;
        }

        var button = $(this);

        button.prop('disabled', true);

        button.html(`
            <i class="bi bi-hourglass-split"></i>
            Calculating...
        `);

        $.ajax({

            url: '@Url.Action("AutoCalculateEmployeeSalary", "Payroll")',

            type: 'POST',

            contentType: 'application/json',

            data: JSON.stringify({
                month: parseInt(month),
                year: parseInt(year)
            }),

    success: function (response) {

        console.log(
            "Auto Salary Response:",
            response
        );


        if (!response) {

            $.toast({
                heading: "Error",
                text: "No response received from salary calculation.",
                icon: "error",
                position: "top-right"
            });

            return;
        }


        // =================================================
        // GET SUMMARY
        // =================================================

        var summary = null;


        if (
            response.autoSalaryCalculationList &&
            response.autoSalaryCalculationList.length > 0
        ) {

            summary =
                response.autoSalaryCalculationList[0];

        }


        if (!summary) {

            $.toast({
                heading: "Error",
                text: "Salary calculation summary was not returned.",
                icon: "error",
                position: "top-right"
            });

            return;
        }


        // =================================================
        // SHOW SUMMARY + ERROR MESSAGES
        // =================================================

        showSalaryCalculationResult(
            summary,
            response.autoSalaryCalculationErrors
        );


        // =================================================
        // TOAST
        // =================================================

        var message =
            "Total: " +
            (summary.totalProcessed ?? 0) +

            " | Inserted: " +
            (summary.insertedRecords ?? 0) +

            " | Updated: " +
            (summary.updatedRecords ?? 0) +

            " | Skipped: " +
            (summary.skippedRecords ?? 0) +

            " | Failed: " +
            (summary.failedRecords ?? 0);


        if (
            (summary.failedRecords ?? 0) > 0
        ) {

            $.toast({
                heading: "Completed with errors",
                text: message,
                icon: "warning",
                position: "top-right",
                hideAfter: 8000
            });

        }
        else {

            $.toast({
                heading: "Success",
                text: message,
                icon: "success",
                position: "top-right",
                hideAfter: 6000
            });

        }


        // =================================================
        // RELOAD DATATABLE
        // =================================================

        $('#tblMonthlySalary')
            .DataTable()
            .ajax
            .reload(null, false);

    },

            error: function (xhr) {

                var message =
                    "Unable to calculate employee salaries.";

                if (xhr.responseJSON &&
                    xhr.responseJSON.message) {

                    message = xhr.responseJSON.message;

                }

                $.toast({
                    heading: "Error",
                    text: message,
                    icon: "error",
                    position: "top-right"
                });
            },

            complete: function () {

                button.prop('disabled', false);

                button.html(`
                    <i class="bi bi-calculator"></i>
                    Calculate All Month Salary
                `);

            }

        });

    });
    // =========================================================
    // SHOW SALARY CALCULATION RESULT
    // =========================================================

    function showSalaryCalculationResult(summary, errors) {

        // =====================================================
        // SUMMARY
        // =====================================================

        $('#salaryTotalProcessed')
            .text(summary.totalProcessed ?? 0);

        $('#salaryInsertedRecords')
            .text(summary.insertedRecords ?? 0);

        $('#salaryUpdatedRecords')
            .text(summary.updatedRecords ?? 0);

        $('#salarySkippedRecords')
            .text(summary.skippedRecords ?? 0);

        $('#salaryFailedRecords')
            .text(summary.failedRecords ?? 0);


        // =====================================================
        // SHOW RESULT
        // =====================================================

        $('#salaryCalculationResult')
            .show();


        // =====================================================
        // ERROR TABLE
        // =====================================================

        var tbody =
            $('#salaryCalculationErrorBody');

        tbody.empty();


        // =====================================================
        // CHECK ERRORS
        // =====================================================

        if (
            !errors ||
            errors.length === 0
        ) {

            $('#salaryCalculationErrors')
                .hide();

            return;
        }


        // =====================================================
        // SHOW ERROR SECTION
        // =====================================================

        $('#salaryCalculationErrors')
            .show();


        // =====================================================
        // ADD ERRORS
        // =====================================================

        errors.forEach(function (error) {

            tbody.append(`

                <tr>

                    <td>
                        ${error.employeeID ?? ''}
                    </td>

                    <td>
                        ${error.payrollTypeID ?? ''}
                    </td>

                    <td>
                        ${error.grossSalary ?? ''}
                    </td>

                    <td class="text-danger fw-semibold">
                        ${error.errorMessage ?? 'Unknown error'}
                    </td>

                    <td>
                        ${
                            error.errorDate
                                ? new Date(
                                    error.errorDate
                                  ).toLocaleString()
                                : ''
                        }
                    </td>

                </tr>

            `);

        });

    }
    // =========================================================
    // UPDATE SELECTED BUTTONS
    // =========================================================

    function updateSelectedSalaryButtons() {

        var selectedCount =
            $('.employee-select:checked').length;


        // Hide buttons first
        $('#btnSendSelectedEmail').hide();

        $('#btnVerifySelected').hide();


        // Nothing selected
        if (selectedCount === 0) {

            return;
        }


        // =====================================================
        // VERIFY
        // =====================================================

        // Verify works for SINGLE and MULTIPLE
        $('#btnVerifySelected').show();


        // =====================================================
        // EMAIL
        // =====================================================

        // Email works only for SINGLE employee
        if (selectedCount === 1) {

            $('#btnSendSelectedEmail').show();
        }
    }
        // =========================================================
    // SEND EMAIL BUTTON
    // =========================================================

    $(document).on(
        'click',
        '#btnSendSelectedEmail',
        function () {

            var selected =
                $('.employee-select:checked');

            // Only one employee can be emailed
            if (selected.length !== 1) {

                $.toast({
                    heading: "Warning",
                    text: "Please select exactly one employee.",
                    icon: "warning",
                    position: "top-right"
                });

                return;
            }

            var checkbox =
                selected.first();

            // -----------------------------------------------
            // Employee ID
            // -----------------------------------------------

            var employeeId =
                checkbox.val();

            // -----------------------------------------------
            // Employee Name
            // -----------------------------------------------

            var employeeName =
                checkbox.data('name');

            // -----------------------------------------------
            // Set selected employee
            // -----------------------------------------------

            $('#selectedEmployeeID')
                .val(employeeId);

            $('#selectedEmployeeName')
                .val(employeeName || '');

            // -----------------------------------------------
            // Show loading
            // -----------------------------------------------

            $('#salaryMonthList').html(`

                <div class="text-muted">

                    Loading salary months...

                </div>

            `);

            // -----------------------------------------------
            // YOUR EXISTING FUNCTIONALITY
            // -----------------------------------------------

            loadSalaryMonths(employeeId);

            // -----------------------------------------------
            // OPEN EMAIL MODAL
            // -----------------------------------------------

            var modalElement =
                document.getElementById(
                    'emailSalaryModal'
                );

            if (!modalElement) {

                console.error(
                    'emailSalaryModal not found.'
                );

                return;
            }

            var modal =
                bootstrap.Modal
                    .getOrCreateInstance(
                        modalElement
                    );

            modal.show();

        }
    );
        // =========================================================
    // SELECT ALL EMPLOYEES
    // =========================================================

    $(document).on(
        'change',
        '#selectAllEmployees',
        function () {

            var isChecked = $(this).is(':checked');

            // Select / unselect all employee checkboxes
            // currently displayed in the DataTable
            $('.employee-select').prop(
                'checked',
                isChecked
            );

            // Update buttons
            updateSelectedSalaryButtons();
        }
    );

    // =========================================================
    // VERIFY SELECTED SALARY - SINGLE + MULTIPLE
    // =========================================================

    $(document).on(
        'click',
        '#btnVerifySelected',
        function () {

            var selected =
                $('.employee-select:checked');


            // =====================================================
            // VALIDATION
            // =====================================================

            if (selected.length === 0) {

                $.toast({
                    heading: "Warning",
                    text: "Please select at least one employee.",
                    icon: "warning",
                    position: "top-right"
                });

                return;
            }


            var employeeIDs = [];


            selected.each(function () {

                employeeIDs.push(
                    parseInt($(this).val())
                );

            });


            var year =
                parseInt($('#yearDropdown').val());

            var month =
                parseInt($('#monthDropdown').val());


            if (!year || !month) {

                $.toast({
                    heading: "Warning",
                    text: "Please select Year and Month.",
                    icon: "warning",
                    position: "top-right"
                });

                return;
            }


            // =====================================================
            // BUTTON
            // =====================================================

            var button = $(this);

            button.prop('disabled', true);

            button.html(`
                <i class="bi bi-hourglass-split"></i>
                Verifying...
            `);


            // =====================================================
            // AJAX
            // =====================================================

            $.ajax({

                url:
                    '@Url.Action("VerifyEmployeeSalary", "Payroll")',

                type: 'POST',

                contentType: 'application/json',

                data: JSON.stringify({

                    employeeIDs: employeeIDs,

                    month: month,

                    year: year

                }),


                // =================================================
                // SUCCESS HTTP RESPONSE
                // =================================================

          success: function (response) {

    console.log("VERIFY RESPONSE:", response);


    // =====================================================
    // NO RESPONSE
    // =====================================================

    if (!response) {

        $.toast({
            heading: "Error",
            text: "No response received from server.",
            icon: "error",
            position: "top-right"
        });

        return;
    }


    // =====================================================
    // GET MESSAGE
    // =====================================================

    var message =
        response.message ||
        response.Message ||
        "";


    // =====================================================
    // GET PKNO
    // =====================================================

    var pkNo = 0;


    // Normal ASP.NET JSON
    if (response.pkNo !== undefined &&
        response.pkNo !== null) {

        pkNo = parseInt(response.pkNo);

    }

    // Possible PascalCase response
    else if (response.PKNo !== undefined &&
             response.PKNo !== null) {

        pkNo = parseInt(response.PKNo);

    }

    // Possible pKNo response
    else if (response.pKNo !== undefined &&
             response.pKNo !== null) {

        pkNo = parseInt(response.pKNo);

    }

    // Result may be inside Data
    else if (
        response.data &&
        response.data.pkNo !== undefined &&
        response.data.pkNo !== null
    ) {

        pkNo = parseInt(response.data.pkNo);

    }

    // Result may be inside Data with PascalCase
    else if (
        response.data &&
        response.data.PKNo !== undefined &&
        response.data.PKNo !== null
    ) {

        pkNo = parseInt(response.data.PKNo);

    }


    console.log("PKNo:", pkNo);
    console.log("Message:", message);


    // =====================================================
    // CHECK MESSAGE COUNTS
    // =====================================================

    var verifiedMatch =
        message.match(/Verified:\s*(\d+)/i);

    var failedMatch =
        message.match(/Failed:\s*(\d+)/i);


    var verifiedCount =
        verifiedMatch
            ? parseInt(verifiedMatch[1])
            : 0;


    var failedCount =
        failedMatch
            ? parseInt(failedMatch[1])
            : 0;


    console.log(
        "Verified Count:",
        verifiedCount
    );

    console.log(
        "Failed Count:",
        failedCount
    );


    // =====================================================
    // COMPLETE SUCCESS
    // =====================================================

    if (
        verifiedCount > 0 &&
        failedCount === 0
    ) {

        $.toast({

            heading: "Success",

            text:
                message ||
                "Salary verification completed successfully.",

            icon: "success",

            position: "top-right",

            hideAfter: 5000

        });

    }


    // =====================================================
    // PARTIAL SUCCESS
    // =====================================================

    else if (
        verifiedCount > 0 &&
        failedCount > 0
    ) {

        $.toast({

            heading: "Partial Success",

            text:
                message ||
                "Some salaries could not be verified.",

            icon: "warning",

            position: "top-right",

            hideAfter: 10000

        });

    }


    // =====================================================
    // COMPLETE FAILURE
    // =====================================================

    else {

        $.toast({

            heading: "Verification Failed",

            text:
                message ||
                "Salary verification failed.",

            icon: "error",

            position: "top-right",

            hideAfter: 10000

        });

    }


    // =====================================================
    // RELOAD TABLE
    // =====================================================

    $('#tblMonthlySalary')
        .DataTable()
        .ajax
        .reload(null, false);


    // =====================================================
    // CLEAR SELECTION
    // =====================================================

    $('.employee-select')
        .prop(
            'checked',
            false
        );


    $('#selectAllEmployees')
        .prop(
            'checked',
            false
        );


    updateSelectedSalaryButtons();

},


                // =================================================
                // HTTP ERROR
                // =================================================

                error: function (xhr) {

                    console.log(
                        "VERIFY HTTP ERROR:",
                        xhr
                    );


                    var message =
                        "Unable to verify salary.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $.toast({

                        heading: "Error",

                        text: message,

                        icon: "error",

                        position: "top-right",

                        hideAfter: 10000

                    });

                },


                // =================================================
                // COMPLETE
                // =================================================

                complete: function () {

                    button.prop(
                        'disabled',
                        false
                    );


                    button.html(`
                        <i class="bi bi-check-circle"></i>
                        Verify Selected
                    `);

                }

            });

        }
    );

</script>
