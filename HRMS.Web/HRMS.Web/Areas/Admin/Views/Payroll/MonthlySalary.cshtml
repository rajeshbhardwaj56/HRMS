        // =========================================================
        // VERIFY SELECTED SALARY
        // =========================================================

        $(document).on(
            'click',
            '#btnVerifySelected',
            function () {

                // =================================================
                // VALIDATION
                // =================================================

                if (
                    selectedEmployeeIDs.size === 0
                ) {

                    $.toast({

                        heading:
                            "Warning",

                        text:
                            "Please select at least one employee.",

                        icon:
                            "warning",

                        position:
                            "top-right"

                    });

                    return;

                }


                // =================================================
                // GET ALL SELECTED EMPLOYEE IDs
                // =================================================

                var employeeIDs =
                    Array.from(
                        selectedEmployeeIDs
                    );


                console.log(
                    "Employee IDs to Verify:",
                    employeeIDs
                );


                var year =
                    parseInt(
                        $('#yearDropdown').val()
                    );


                var month =
                    parseInt(
                        $('#monthDropdown').val()
                    );


                if (!year || !month) {

                    $.toast({

                        heading:
                            "Warning",

                        text:
                            "Please select Year and Month.",

                        icon:
                            "warning",

                        position:
                            "top-right"

                    });

                    return;

                }


                // =================================================
                // BUTTON
                // =================================================

                var button =
                    $(this);


                button.prop(
                    'disabled',
                    true
                );


                button.html(`

                    <i class="bi bi-hourglass-split"></i>

                    Verifying...

                `);


                // =================================================
                // AJAX
                // =================================================

                $.ajax({

                    url:
                        '@Url.Action("VerifyEmployeeSalary", "Payroll")',

                    type:
                        'POST',

                    contentType:
                        'application/json',

                    data:
                        JSON.stringify({

                            employeeIDs:
                                employeeIDs,

                            month:
                                month,

                            year:
                                year

                        }),


                    // =================================================
                    // SUCCESS
                    // =================================================

                    success:
                        function (response) {

                            console.log(
                                "VERIFY RESPONSE:",
                                response
                            );


                            // =================================================
                            // NO RESPONSE
                            // =================================================

                            if (!response) {

                                $.toast({

                                    heading:
                                        "Error",

                                    text:
                                        "No response received from server.",

                                    icon:
                                        "error",

                                    position:
                                        "top-right"

                                });

                                return;

                            }


                            // =================================================
                            // GET MESSAGE
                            // =================================================

                            var message =
                                response.message ||
                                response.Message ||
                                "";


                            // =================================================
                            // GET PKNO
                            // =================================================

                            var pkNo = 0;


                            if (
                                response.pkNo !== undefined &&
                                response.pkNo !== null
                            ) {

                                pkNo =
                                    parseInt(
                                        response.pkNo
                                    );

                            }
                            else if (
                                response.PKNo !== undefined &&
                                response.PKNo !== null
                            ) {

                                pkNo =
                                    parseInt(
                                        response.PKNo
                                    );

                            }
                            else if (
                                response.pKNo !== undefined &&
                                response.pKNo !== null
                            ) {

                                pkNo =
                                    parseInt(
                                        response.pKNo
                                    );

                            }
                            else if (
                                response.data &&
                                response.data.pkNo !== undefined &&
                                response.data.pkNo !== null
                            ) {

                                pkNo =
                                    parseInt(
                                        response.data.pkNo
                                    );

                            }
                            else if (
                                response.data &&
                                response.data.PKNo !== undefined &&
                                response.data.PKNo !== null
                            ) {

                                pkNo =
                                    parseInt(
                                        response.data.PKNo
                                    );

                            }


                            console.log(
                                "PKNo:",
                                pkNo
                            );


                            console.log(
                                "Message:",
                                message
                            );


                            // =================================================
                            // CHECK MESSAGE COUNTS
                            // =================================================

                            var verifiedMatch =
                                message.match(
                                    /Verified:\s*(\d+)/i
                                );


                            var failedMatch =
                                message.match(
                                    /Failed:\s*(\d+)/i
                                );


                            var verifiedCount =
                                verifiedMatch
                                    ? parseInt(
                                        verifiedMatch[1]
                                      )
                                    : 0;


                            var failedCount =
                                failedMatch
                                    ? parseInt(
                                        failedMatch[1]
                                      )
                                    : 0;


                            console.log(
                                "Verified Count:",
                                verifiedCount
                            );


                            console.log(
                                "Failed Count:",
                                failedCount
                            );


                            // =================================================
                            // COMPLETE SUCCESS
                            // =================================================

                            if (
                                verifiedCount > 0 &&
                                failedCount === 0
                            ) {

                                $.toast({

                                    heading:
                                        "Success",

                                    text:
                                        message ||
                                        "Salary verification completed successfully.",

                                    icon:
                                        "success",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        5000

                                });

                            }


                            // =================================================
                            // PARTIAL SUCCESS
                            // =================================================

                            else if (
                                verifiedCount > 0 &&
                                failedCount > 0
                            ) {

                                $.toast({

                                    heading:
                                        "Partial Success",

                                    text:
                                        message ||
                                        "Some salaries could not be verified.",

                                    icon:
                                        "warning",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        10000

                                });

                            }


                            // =================================================
                            // COMPLETE FAILURE
                            // =================================================

                            else {

                                $.toast({

                                    heading:
                                        "Verification Failed",

                                    text:
                                        message ||
                                        "Salary verification failed.",

                                    icon:
                                        "error",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        10000

                                });

                            }


                            // =================================================
                            // CLEAR SELECTION
                            // =================================================

                            clearEmployeeSelection();


                            // =================================================
                            // RELOAD TABLE
                            // =================================================

                            $('#tblMonthlySalary')
                                .DataTable()
                                .ajax
                                .reload(
                                    null,
                                    false
                                );

                        },


                    // =================================================
                    // HTTP ERROR
                    // =================================================

                    error:
                        function (xhr) {

                            console.log(
                                "VERIFY HTTP ERROR:",
                                xhr
                            );


                            var message =
                                "Unable to verify salary.";


                            if (
                                xhr.responseJSON &&
                                xhr.responseJSON.message
                            ) {

                                message =
                                    xhr.responseJSON.message;

                            }


                            $.toast({

                                heading:
                                    "Error",

                                text:
                                    message,

                                icon:
                                    "error",

                                position:
                                    "top-right",

                                hideAfter:
                                    10000

                            });

                        },


                    // =================================================
                    // COMPLETE
                    // =================================================

                    complete:
                        function () {

                            button.prop(
                                'disabled',
                                false
                            );


                            button.html(`

                                <i class="bi bi-check-circle"></i>

                                Verify Selected

                            `);

                        }

                });

            }
        );


    });


    // =========================================================
    // FORMAT PAYROLL DATE
    // =========================================================

    function formatPayrollDate(dateValue) {

        if (!dateValue) {
            return "";
        }


        var date =
            new Date(dateValue);


        if (isNaN(date.getTime())) {
            return "";
        }


        var day =
            String(
                date.getDate()
            ).padStart(
                2,
                '0'
            );


        var month =
            String(
                date.getMonth() + 1
            ).padStart(
                2,
                '0'
            );


        var year =
            date.getFullYear();


        return (
            day +
            "-" +
            month +
            "-" +
            year
        );

    }

</script>
