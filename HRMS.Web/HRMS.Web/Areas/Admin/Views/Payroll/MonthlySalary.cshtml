        // =========================================================
        // AUTO CALCULATE ALL MONTH SALARY
        // =========================================================

        $(document).on(
            'click',
            '#btnAutoCalculateSalary',
            function() {

                var year =
                    $('#yearDropdown').val();

                var month =
                    $('#monthDropdown').val();


                // =================================================
                // VALIDATE YEAR
                // =================================================

                if (!year) {

                    $.toast({

                        heading:
                            "Warning",

                        text:
                            "Please select Year.",

                        icon:
                            "warning",

                        position:
                            "top-right"

                    });

                    return;
                }


                // =================================================
                // VALIDATE MONTH
                // =================================================

                if (!month) {

                    $.toast({

                        heading:
                            "Warning",

                        text:
                            "Please select Month.",

                        icon:
                            "warning",

                        position:
                            "top-right"

                    });

                    return;
                }


                var button =
                    $(this);


                button.prop(
                    'disabled',
                    true
                );


                button.html(`

                <i class="bi bi-hourglass-split"></i>

                Calculating...

            `);


                $.ajax({

                    url:
                        '@Url.Action("AutoCalculateEmployeeSalary", "Payroll")',

                    type:
                        'POST',

                    contentType:
                        'application/json',

                    data:
                        JSON.stringify({

                            month:
                                parseInt(month),

                            year:
                                parseInt(year)

                        }),


                    // =================================================
                    // SUCCESS
                    // =================================================

                    success:
                        function(response) {

                            console.log(
                                "Auto Salary Response:",
                                response
                            );


                            // =================================================
                            // NO RESPONSE
                            // =================================================

                            if (!response) {

                                $.toast({

                                    heading:
                                        "Error",

                                    text:
                                        "No response received from salary calculation.",

                                    icon:
                                        "error",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        false,

                                    stack:
                                        false

                                });

                                return;
                            }


                            // =================================================
                            // CUTOFF / VALIDATION ERROR
                            // =================================================

                            if (response.success === false) {

                                $.toast({

                                    heading:
                                        "Error",

                                    text:
                                        response.message ||
                                        "Salary calculation is not allowed.",

                                    icon:
                                        "error",

                                    position:
                                        "top-right",

                                    // Keep toast visible
                                    // until user closes it
                                    hideAfter:
                                        10000,

                                    stack:
                                        false

                                });

                                return;
                            }


                            // =================================================
                            // GET SUMMARY
                            // =================================================

                            var summary =
                                null;


                            if (
                                response.autoSalaryCalculationList &&
                                response.autoSalaryCalculationList.length > 0
                            ) {

                                summary =
                                    response.autoSalaryCalculationList[0];

                            }


                            // =================================================
                            // SUMMARY NOT FOUND
                            // =================================================

                            if (!summary) {

                                $.toast({

                                    heading:
                                        "Error",

                                    text:
                                        "Salary calculation summary was not returned.",

                                    icon:
                                        "error",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        false,

                                    stack:
                                        false

                                });

                                return;
                            }


                            // =================================================
                            // SHOW SUMMARY
                            // =================================================

                            showSalaryCalculationResult(
                                summary,
                                response.autoSalaryCalculationErrors
                            );


                            // =================================================
                            // CREATE SUMMARY MESSAGE
                            // =================================================

                            var message =
                                "Total: " +
                                (summary.totalProcessed ?? 0) +

                                " | Inserted: " +
                                (summary.insertedRecords ?? 0) +

                                " | Updated: " +
                                (summary.updatedRecords ?? 0) +

                                " | Skipped: " +
                                (summary.skippedRecords ?? 0) +

                                " | Failed: " +
                                (summary.failedRecords ?? 0);


                            // =================================================
                            // SHOW RESULT TOAST
                            // =================================================

                            if (
                                (summary.failedRecords ?? 0) > 0
                            ) {

                                $.toast({

                                    heading:
                                        "Completed with errors",

                                    text:
                                        message,

                                    icon:
                                        "warning",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        8000

                                });

                            }
                            else {

                                $.toast({

                                    heading:
                                        "Success",

                                    text:
                                        message,

                                    icon:
                                        "success",

                                    position:
                                        "top-right",

                                    hideAfter:
                                        6000

                                });

                            }


                            // =================================================
                            // CLEAR SELECTION
                            // =================================================

                            clearEmployeeSelection();


                            // =================================================
                            // RELOAD DATATABLE
                            // =================================================

                            $('#tblMonthlySalary')
                                .DataTable()
                                .ajax
                                .reload(
                                    null,
                                    false
                                );

                        },


                    // =================================================
                    // AJAX ERROR
                    // =================================================

                    error:
                        function(xhr) {

                            console.log(
                                "Auto Calculate Salary Error:",
                                xhr.responseText
                            );


                            var message =
                                "Unable to calculate employee salaries.";


                            if (
                                xhr.responseJSON &&
                                xhr.responseJSON.message
                            ) {

                                message =
                                    xhr.responseJSON.message;

                            }


                            $.toast({

                                heading:
                                    "Error",

                                text:
                                    message,

                                icon:
                                    "error",

                                position:
                                    "top-right",

                                // Keep error visible
                                // until user closes it
                                hideAfter:
                                    false,

                                stack:
                                    false

                            });

                        },


                    // =================================================
                    // COMPLETE
                    // =================================================

                    complete:
                        function() {

                            button.prop(
                                'disabled',
                                false
                            );


                            button.html(`

                            <i class="bi bi-calculator"></i>

                            Calculate All Month Salary

                        `);

                        }

                });

            }
        );


        // =========================================================
        // SHOW SALARY CALCULATION RESULT
        // =========================================================

        function showSalaryCalculationResult(
            summary,
            errors
        ) {

            // =====================================================
            // SUMMARY
            // =====================================================

            $('#salaryTotalProcessed')
                .text(
                    summary.totalProcessed ?? 0
                );


            $('#salaryInsertedRecords')
                .text(
                    summary.insertedRecords ?? 0
                );


            $('#salaryUpdatedRecords')
                .text(
                    summary.updatedRecords ?? 0
                );


            $('#salarySkippedRecords')
                .text(
                    summary.skippedRecords ?? 0
                );


            $('#salaryFailedRecords')
                .text(
                    summary.failedRecords ?? 0
                );


            // =====================================================
            // SHOW RESULT
            // =====================================================

            $('#salaryCalculationResult')
                .show();


            // =====================================================
            // ERROR TABLE
            // =====================================================

            var tbody =
                $('#salaryCalculationErrorBody');


            tbody.empty();


            // =====================================================
            // CHECK ERRORS
            // =====================================================

            if (
                !errors ||
                errors.length === 0
            ) {

                $('#salaryCalculationErrors')
                    .hide();

                return;

            }


            // =====================================================
            // SHOW ERROR SECTION
            // =====================================================

            $('#salaryCalculationErrors')
                .show();


            // =====================================================
            // ADD ERRORS
            // =====================================================

            errors.forEach(function (error) {

                tbody.append(`

                    <tr>

                        <td>
                            ${error.employeeID ?? ''}
                        </td>

                        <td>
                            ${error.payrollTypeID ?? ''}
                        </td>

                        <td>
                            ${error.grossSalary ?? ''}
                        </td>

                        <td class="text-danger fw-semibold">
                            ${error.errorMessage ?? 'Unknown error'}
                        </td>

                        <td>
                            ${
                                error.errorDate
                                    ? new Date(
                                        error.errorDate
                                      ).toLocaleString()
                                    : ''
                            }
                        </td>

                    </tr>

                `);

            });

        }


