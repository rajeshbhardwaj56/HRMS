@using HRMS.Models.Employee
@using Microsoft.AspNetCore.Http

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model EmploymentHistory

@{
    Layout = $"~/Areas/{HttpContextAccessor.HttpContext.Session.GetString(HRMS.Models.Common.Constants.AreaName)}/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Employment History";
}

<style>

    .page-split-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 100px);
    }

    .form-section,
    .table-section {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        border-bottom: 1px solid #ccc;
    }

    .table-section {
        background-color: #f9f9f9;
    }

    .main-header.anim {
        position: sticky;
        top: 0;
        background: white;
        z-index: 1;
        padding-top: 10px;
    }

</style>


<div class="main-header anim fs-6">
    Add / Edit Employment History
</div>


<div class="page-split-container">

    <!-- ========================= -->
    <!-- FORM SECTION -->
    <!-- ========================= -->

    <div class="form-section">

        <form id="employmentHistoryForm" method="post">

            <div class="Container">

                <div class="group-box anim" style="--delay: .3s">

                    @Html.HiddenFor(m => m.EmployeeID)

                    @Html.HiddenFor(m => m.EmploymentHistoryID)


                    <div class="row mb-3">

                        <!-- Company Name -->
                        <div class="col-md-4 form-group">
                            <label>
                                Company Name
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.CompanyName,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })
                        </div>


                        <!-- Employment ID -->
                        <div class="col-md-4 form-group">
                            <label>
                                Employment ID
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.EmploymentID,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })
                        </div>


                        <!-- From -->
                        <div class="col-md-4 form-group">
                            <label>
                                From Date
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.From,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date",
                                    required = "required"
                                })
                        </div>


                        <!-- To -->
                        <div class="col-md-4 form-group">
                            <label>
                                To Date
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.To,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date",
                                    required = "required"
                                })
                        </div>


                        <!-- Address -->
                        <div class="col-md-4 form-group">
                            <label>
                                Address
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.Address,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })
                        </div>


                        <!-- City -->
                        <div class="col-md-4 form-group">
                            <label>
                                City
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.City,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })
                        </div>


                        <!-- State -->
                        <div class="col-md-4 form-group">
                            <label>
                                State
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.State,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })
                        </div>


                        <!-- Country -->
                        <div class="col-md-4 form-group">

                            <label>
                                Country
                                <span class="Mandetory">*</span>
                            </label>

                            <div class="position-relative">

                                @Html.DropDownListFor(
                                    x => x.CountryID,
                                    Model.Countries,
                                    HRMS.Models.Common.Constants.SelectCountry,
                                    new
                                    {
                                        @class = "form-control",
                                        required = "required"
                                    })

                                <i class="fa fa-chevron-down position-absolute"
                                   style="
                                   font-size:10px;
                                   color:gray;
                                   right:10px;
                                   top:50%;
                                   transform:translateY(-50%);
                                   pointer-events:none;">
                                </i>

                            </div>

                        </div>


                        <!-- Postal Code -->
                        <div class="col-md-4 form-group">

                            <label>
                                Postal Code
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.PostalCode,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Phone -->
                        <div class="col-md-4 form-group">

                            <label>
                                Phone
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.Phone,
                                new
                                {
                                    @class = "form-control mobile-mask",
                                    required = "required"
                                })

                        </div>


                        <!-- Designation -->
                        <div class="col-md-4 form-group">

                            <label>
                                Designation
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.Designition,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Gross Salary -->
                        <div class="col-md-4 form-group">

                            <label>
                                Gross Salary
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.GrossSalary,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Reason -->
                        <div class="col-md-4 form-group">

                            <label>
                                Reason For Leaving
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.ReasionFoLeaving,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Supervisor Name -->
                        <div class="col-md-4 form-group">

                            <label>
                                Supervisor Name
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.SupervisorName,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Supervisor Designation -->
                        <div class="col-md-4 form-group">

                            <label>
                                Supervisor Designation
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.SupervisorDesignition,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- Supervisor Contact -->
                        <div class="col-md-4 form-group">

                            <label>
                                Supervisor Contact No
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.SupervisorContactNo,
                                new
                                {
                                    @class = "form-control mobile-mask",
                                    required = "required"
                                })

                        </div>


                        <!-- HR Name -->
                        <div class="col-md-4 form-group">

                            <label>
                                HR Name
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.HRName,
                                new
                                {
                                    @class = "form-control",
                                    required = "required"
                                })

                        </div>


                        <!-- HR Email -->
                        <div class="col-md-4 form-group">

                            <label>
                                HR Email
                            </label>

                            @Html.TextBoxFor(
                                m => m.HREmail,
                                new
                                {
                                    @class = "form-control",
                                    type = "email",
                                    required = "required"
                                })

                        </div>


                        <!-- HR Contact -->
                        <div class="col-md-4 form-group">

                            <label>
                                HR Contact No
                                <span class="Mandetory">*</span>
                            </label>

                            @Html.TextBoxFor(
                                m => m.HRContactNo,
                                new
                                {
                                    @class = "form-control mobile-mask",
                                    required = "required"
                                })

                        </div>


                        <!-- Buttons -->
                        <div class="col-md-12">

                            <input type="submit"
                                   value="Submit"
                                   class="btn btn-success" />

                            <button type="button"
                                    id="cancelButton"
                                    class="btn btn-danger">
                                Cancel
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </form>


        <!-- ========================= -->
        <!-- TABLE SECTION -->
        <!-- ========================= -->

        <div class="table-section">

            <div class="main-header anim fs-6">
                Employee Employment History
            </div>


            <div class="table-responsive py-3">

                <table id="employmentGrid"
                       class="table table-striped body-text"
                       style="width:100%">

                    <thead>

                        <tr>

                            <th style="display:none;">
                                EmploymentHistoryID
                            </th>

                            <th style="display:none;">
                                EmployeeID
                            </th>

                            <th>
                                Company Name
                            </th>

                            <th>
                                From
                            </th>

                            <th>
                                To
                            </th>

                            <th>
                                Designation
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<script src="/js/mobilemasking.js"></script>


@section Scripts {

<script>

    /* =========================================================
       TOAST
       ========================================================= */

    function toastMessage(type, message) {

        $.toast({
            heading: type,
            text: message,
            showHideTransition: 'slide',
            icon: type === 'Success' ? 'success' : 'error',
            position: 'top-right'
        });

    }


    /* =========================================================
       DOCUMENT READY
       ========================================================= */

    $(document).ready(function () {

        var employeeId = $('#EmployeeID').val();

        console.log("EmployeeID:", employeeId);


        /* =====================================================
           EMPLOYMENT HISTORY DATATABLE
           ===================================================== */

        var employmentTable = $('#employmentGrid').DataTable({

            processing: true,

            serverSide: false,

            destroy: true,

            ordering: true,

            paging: true,

            searching: true,

            info: true,

            responsive: true,


            ajax: {

                url: '@Url.Action("GetEmploymentHistoryDetails", "Employee", new { area = "HR" })',

                type: 'POST',

                dataType: 'json',


                data: function (d) {

                    d.EmployeeID = employeeId;

                    console.log(
                        "Sending EmployeeID:",
                        d.EmployeeID
                    );

                },


                beforeSend: function () {

                    console.log(
                        "Loading Employment History..."
                    );

                },


                dataSrc: function (json) {

                    console.log(
                        "Employment History API Response:",
                        json
                    );


                    if (!json) {

                        console.warn(
                            "Empty response received."
                        );

                        return [];

                    }


                    if (json.error) {

                        console.error(
                            "Server Error:",
                            json.error
                        );

                        return [];

                    }


                    if (Array.isArray(json.data)) {

                        console.log(
                            "Records received:",
                            json.data.length
                        );

                        return json.data;

                    }


                    if (Array.isArray(json)) {

                        console.log(
                            "Direct array received:",
                            json.length
                        );

                        return json;

                    }


                    console.warn(
                        "No employment history data found."
                    );

                    return [];

                },


                error: function (
                    xhr,
                    status,
                    error
                ) {

                    console.error(
                        "Employment History AJAX Error:",
                        error
                    );

                    console.error(
                        "Status:",
                        status
                    );

                    console.error(
                        "Response:",
                        xhr.responseText
                    );

                }

            },


            /* =================================================
               COLUMNS
               ================================================= */

            columns: [

                {
                    data: 'employmentHistoryID',
                    visible: false,
                    defaultContent: ''
                },


                {
                    data: 'employeeID',
                    visible: false,
                    defaultContent: ''
                },


                {
                    data: 'companyName',
                    defaultContent: ''
                },


                {
                    data: 'from',
                    defaultContent: '',

                    render: function (data) {

                        if (!data) {
                            return '';
                        }

                        var date = new Date(data);

                        if (isNaN(date.getTime())) {
                            return '';
                        }

                        return date.toLocaleDateString(
                            'en-GB'
                        );

                    }

                },


                {
                    data: 'to',
                    defaultContent: '',

                    render: function (data) {

                        if (!data) {
                            return '';
                        }

                        var date = new Date(data);

                        if (isNaN(date.getTime())) {
                            return '';
                        }

                        return date.toLocaleDateString(
                            'en-GB'
                        );

                    }

                },


                {
                    data: 'designition',
                    defaultContent: ''
                },


                {
                    data: 'phone',
                    defaultContent: ''
                },


                {
                    data: 'employmentHistoryID',

                    orderable: false,

                    searchable: false,

                    defaultContent: '',

                    render: function (
                        data,
                        type,
                        row
                    ) {

                        return `
                            <div class="table-data-feature">

                                <a class="item"
                                   href="javascript:void(0)"
                                   onclick="editEmploymentHistory(${data})"
                                   title="Edit">

                                    <img src="/assets/img/edit.png"
                                         width="20"
                                         height="20" />

                                </a>


                                <a class="item delete-entry"
                                   href="javascript:void(0)"
                                   data-id="${data}"
                                   title="Delete">

                                    <img src="/assets/img/delete.png"
                                         width="20"
                                         height="20" />

                                </a>

                            </div>
                        `;

                    }

                }

            ]

        });


        /* =====================================================
           FORM SUBMIT
           ===================================================== */

        $('#employmentHistoryForm').on(
            'submit',
            function (e) {

                e.preventDefault();

                var form = $(this);

                var formData = form.serialize();


                $.ajax({

                    url: form.attr('action') ||
                         window.location.pathname,

                    type: 'POST',

                    data: formData,


                    success: function (result) {

                        console.log(
                            "Save Response:",
                            result
                        );


                        if (
                            result &&
                            result.success
                        ) {

                            employmentTable
                                .ajax
                                .reload(
                                    null,
                                    false
                                );


                            form[0].reset();


                            $('#EmployeeID').val(
                                employeeId
                            );


                            $('#EmploymentHistoryID')
                                .val('');


                            toastMessage(
                                'Success',
                                result.message ||
                                'Employment history saved successfully.'
                            );

                        }
                        else {

                            toastEMessage(
                                'Error',
                                result?.message ||
                                'Unable to save employment history.'
                            );

                        }

                    },


                    error: function (
                        xhr,
                        status,
                        error
                    ) {

                        console.error(
                            "Save Error:",
                            error
                        );

                        console.error(
                            xhr.responseText
                        );


                        toastEMessage(
                            'Error',
                            'Error submitting form.'
                        );

                    }

                });

            }
        );


        /* =====================================================
           CANCEL BUTTON
           ===================================================== */

        $('#cancelButton').on(
            'click',
            function () {

                $('#employmentHistoryForm')[0]
                    .reset();


                $('#EmployeeID').val(
                    employeeId
                );


                $('#EmploymentHistoryID')
                    .val('');

            }
        );


        /* =====================================================
           DELETE
           ===================================================== */

        $(document).on(
            'click',
            '.delete-entry',
            function (e) {

                e.preventDefault();


                const id = $(this).data('id');


                const confirmed = confirm(
                    'Are you sure you want to delete this employment history?'
                );


                if (!confirmed) {
                    return;
                }


                $.ajax({

                    url: '/HR/Employee/DeleteEmploymentHistory',

                    type: 'POST',

                    data: {
                        encodedId: id
                    },


                    success: function (response) {

                        console.log(
                            "Delete Response:",
                            response
                        );


                        if (response.success) {

                            const currentId =
                                $('#EmploymentHistoryID')
                                    .val();


                            if (
                                currentId == id
                            ) {

                                $('#EmploymentHistoryID')
                                    .val('');

                            }


                            employmentTable
                                .ajax
                                .reload(
                                    null,
                                    false
                                );


                            toastMessage(
                                'Success',
                                response.message
                            );

                        }
                        else {

                            toastEMessage(
                                'Error',
                                response.message ||
                                'Unable to delete record.'
                            );

                        }

                    },


                    error: function (
                        xhr,
                        status,
                        error
                    ) {

                        console.error(
                            "Delete Error:",
                            error
                        );


                        toastEMessage(
                            'Error',
                            'Error deleting employment history.'
                        );

                    }

                });

            }
        );

    });


    /* =========================================================
       EDIT EMPLOYMENT HISTORY
       ========================================================= */

    function editEmploymentHistory(id) {

        var table =
            $('#employmentGrid').DataTable();


        var rowData =
            table
                .rows()
                .data()
                .toArray()
                .find(function (row) {

                    return String(
                        row.employmentHistoryID
                    ) === String(id);

                });


        if (!rowData) {

            alert(
                'Record not found!'
            );

            return;

        }


        $('#EmployeeID')
            .val(rowData.employeeID);


        $('#EmploymentHistoryID')
            .val(rowData.employmentHistoryID);


        $('#CompanyName')
            .val(rowData.companyName);


        $('#EmploymentID')
            .val(rowData.employmentID);


        $('#From')
            .val(
                rowData.from
                    ? new Date(rowData.from)
                        .toISOString()
                        .split('T')[0]
                    : ''
            );


        $('#To')
            .val(
                rowData.to
                    ? new Date(rowData.to)
                        .toISOString()
                        .split('T')[0]
                    : ''
            );


        $('#Address')
            .val(rowData.address);


        $('#Phone')
            .val(rowData.phone);


        $('#City')
            .val(rowData.city);


        $('#State')
            .val(rowData.state);


        $('#CountryID')
            .val(rowData.countryID)
            .trigger('change');


        $('#PostalCode')
            .val(rowData.postalCode);


        $('#ReasionFoLeaving')
            .val(rowData.reasionFoLeaving);


        $('#Designition')
            .val(rowData.designition);


        $('#GrossSalary')
            .val(rowData.grossSalary);


        $('#SupervisorName')
            .val(rowData.supervisorName);


        $('#SupervisorDesignition')
            .val(rowData.supervisorDesignition);


        $('#SupervisorContactNo')
            .val(rowData.supervisorContactNo);


        $('#HRName')
            .val(rowData.hrName);


        $('#HREmail')
            .val(rowData.hrEmail);


        $('#HRContactNo')
            .val(rowData.hrContactNo);

    }


    /* =========================================================
       ERROR TOAST
       ========================================================= */

    function toastEMessage(
        type,
        message
    ) {

        $.toast({

            heading: type,

            text: message,

            showHideTransition: 'slide',

            icon: 'error',

            position: 'top-right'

        });

    }


    /* =========================================================
       MOBILE MASK
       ========================================================= */

    $(document).ready(function () {

        $('.mobile-mask').mask(
            '(0000)-000-000'
        );

    });

</script>

}